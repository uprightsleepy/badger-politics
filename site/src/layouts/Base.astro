---
import "../styles/global.css";
// The latin files are the ones nearly every page needs; preloading them
// avoids a late swap from the fallback face. Other subsets load on demand.
import overpassLatin from "@fontsource-variable/overpass/files/overpass-latin-wght-normal.woff2?url";
import atkinsonLatin from "@fontsource-variable/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-wght-normal.woff2?url";
import { meta, usesLegiscan } from "../lib/db";
import { LEGISCAN_LICENSE_URL, LEGISCAN_WI_URL } from "../lib/legiscan";
import { fmtDate } from "../lib/format";
interface Props {
  title: string;
  description?: string;
  /** Share-card image and its alt text; pages may override the sitewide
   * card (lib/share). */
  image?: string;
  imageAlt?: string;
  /** Index this page's main content for search. Off for roll-call pages,
   * which are name lists whose substance lives on the bill and member
   * pages already. */
  searchable?: boolean;
  /** Keep the page out of search engines while leaving it crawlable and
   * linkable. Same reasoning as `searchable`, applied outward. */
  noindex?: boolean;
  /** Ancestor trail, nearest-last, excluding this page. Emitted as
   * BreadcrumbList so a result shows its place in the site rather than a
   * bare URL. */
  breadcrumbs?: { name: string; url: string }[];
  /** Search facets for this page, baked into the Pagefind index at build
   * time ("type: Bill", "session: 2025-2026"). The homepage search UI
   * offers them as filters; a page without them is still indexed but
   * only appears in unfiltered results. */
  filters?: Record<string, string>;
  /** "wide" is the redesigned page frame (1160px, roomier gutters). Pages
   * that have not been redesigned yet keep the original 1024px column. */
  layout?: "legacy" | "wide";
}
const {
  title,
  description = "Free, independent tracking of the Wisconsin Legislature. Every bill, every vote, and where each one stands, in plain words.",
  image = "/og.png",
  imageAlt = "Badger Politics: Wisconsin's Legislature, in plain words.",
  searchable = true,
  noindex = false,
  breadcrumbs,
  filters,
  layout = "legacy",
} = Astro.props;
const crumbJson = breadcrumbs?.length
  ? JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        ...breadcrumbs.map((c, i) => ({
          "@type": "ListItem",
          position: i + 1,
          name: c.name,
          item: new URL(c.url, Astro.site).href,
        })),
        // the current page closes the trail with no `item`, per schema.org
        { "@type": "ListItem", position: breadcrumbs.length + 1, name: title },
      ],
    }).replace(/</g, "\\u003c")
  : null;
// absolute URLs: crawlers and chat apps will not resolve relative ones
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
// Search engines cut a title around 60 characters. On a long page title
// the suffix is the part that gets dropped, so drop it deliberately rather
// than letting it be truncated to "· Badger Poli…".
const fullTitle = title.length > 42 ? title : `${title} · Badger Politics`;
const dataThrough = meta().data_through;
// two different freshness facts: the newest action the Legislature has
// recorded, and when we last pulled the records to look
const pulledOn = meta().imported_at?.slice(0, 10);
const NAV_GROUPS: { label: string; items: [string, string][] }[] = [
  {
    label: "Bills",
    items: [
      ["/bills/", "All bills"],
      ["/laws/", "New laws"],
      ["/subjects/", "Bills by subject"],
      ["/governors-desk/", "Governor's decisions"],
      ["/vetoes/", "Vetoes"],
      ["/hearing-none/", "Bills that never got a hearing"],
    ],
  },
  {
    label: "Lawmakers",
    items: [
      ["/legislators/", "State lawmakers"],
      ["/districts/", "Districts"],
      ["/committees/", "Committees"],
      ["/federal/", "Members of Congress"],
      ["/local/", "City councils"],
    ],
  },
  {
    label: "Money",
    items: [
      ["/money/", "Campaign money"],
      ["/money/independent/", "Outside spending"],
    ],
  },
];
const NAV_DIRECT: [string, string][] = [
  ["/this-week/", "This week"],
  ["/calendar/", "Calendar"],
  ["/elections/2026/", "Elections"],
  ["/following/", "Following"],
];
const mainClass =
  layout === "wide"
    ? "mx-auto w-full max-w-[72.5rem] px-5 pb-8 pt-6 focus:outline-none sm:px-8 sm:pt-9"
    : "mx-auto max-w-5xl px-4 py-8 focus:outline-none";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* installable from the browser menu; no service worker, so a saved
        copy can never serve yesterday's records */}
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preload" href={overpassLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={atkinsonLatin} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={pageUrl} />
    {/* follow, not none: these pages still pass authority on to the bills
        and members they link to. */}
    {noindex && <meta name="robots" content="noindex, follow" />}
    {crumbJson && (
      <script type="application/ld+json" is:inline set:html={crumbJson} />
    )}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Badger Politics" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
  </head>
  <body class="min-h-screen bg-limestone text-spruce antialiased">
    <a
      href="#main"
      class="sr-only rounded-[0.625rem] bg-spruce px-4 py-3 font-bold text-white focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50"
    >
      Skip to content
    </a>
    <header class="border-b border-rule bg-white">
      <nav aria-label="Main" class="mx-auto max-w-[72.5rem] px-2 py-2 lg:px-8 lg:py-3">
        <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
          <!-- the wordmark may wrap at very large text sizes rather than push
               the page sideways -->
          <a href="/" class="flex min-h-11 min-w-0 items-center gap-2.5 pl-2 text-spruce no-underline lg:shrink-0 lg:whitespace-nowrap lg:pl-0">
            <img src="/mark.svg" alt="" width="26" height="27" class="h-[27px] w-[26px] shrink-0 lg:h-8 lg:w-[30px]" />
            <span class="font-display text-[1.1875rem] font-extrabold leading-tight lg:text-[1.3125rem]">Badger Politics</span>
          </a>
          <!-- phones and small tablets: a search shortcut and a native
               disclosure menu. This menu comes first in the DOM on purpose:
               it is the header menu the narrow-viewport checks open. -->
          <div class="ml-auto flex items-center gap-0.5 lg:hidden">
            <a href="/#search" class="inline-flex h-11 w-11 items-center justify-center rounded-[0.625rem] text-spruce hover:bg-fog" aria-label="Search">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="M15.5 15.5 21 21" /></svg>
            </a>
            <details data-nav-menu class="relative">
              <summary class="flex h-11 cursor-pointer list-none items-center gap-2 rounded-[0.625rem] px-2.5 font-display font-bold text-spruce hover:bg-fog [&::-webkit-details-marker]:hidden">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
                Menu
              </summary>
              <div class="absolute right-0 top-full z-50 mt-2 max-h-[80vh] w-80 max-w-[calc(100vw-1rem)] overflow-y-auto rounded-2xl border border-rule bg-white p-3 shadow-[0_8px_24px_rgba(24,36,31,0.16)]">
                <form action="/#search" method="get" role="search" class="pb-3">
                  <label class="sr-only" for="nav-search">Search bills, lawmakers and money</label>
                  <input
                    id="nav-search"
                    type="search"
                    name="q"
                    placeholder="Search"
                    class="min-h-12 w-full rounded-[0.625rem] border-2 border-edge bg-limestone px-3 text-body text-spruce placeholder:text-granite"
                  />
                </form>
                <a href="/my-reps/" data-nav-my-reps class="btn btn-primary w-full">Find your lawmakers</a>
                <!-- categories collapse so every one is visible at once -->
                {NAV_GROUPS.map((g) => (
                  <details data-nav-group class="group mt-2 border-t border-rule pt-1">
                    <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between rounded-[0.625rem] px-3 font-display font-bold hover:bg-fog [&::-webkit-details-marker]:hidden">
                      {g.label}
                      <svg width="14" height="14" viewBox="0 0 10 10" aria-hidden="true" class="shrink-0 transition-transform group-open:rotate-180">
                        <path d="M1 3l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                      </svg>
                    </summary>
                    <ul class="pb-1">
                      {g.items.map(([href, label]) => (
                        <li>
                          <a href={href} class="flex min-h-11 items-center rounded-[0.625rem] pl-6 pr-3 text-spruce hover:bg-fog">{label}</a>
                        </li>
                      ))}
                    </ul>
                  </details>
                ))}
                <ul class="mt-2 border-t border-rule pt-1">
                  {NAV_DIRECT.map(([href, label]) => (
                    <li>
                      <a href={href} class="flex min-h-12 items-center rounded-[0.625rem] px-3 font-display font-bold text-spruce hover:bg-fog">{label}</a>
                    </li>
                  ))}
                </ul>
              </div>
            </details>
          </div>

          <!-- desktop, first row: search and the reader's districts -->
          <form action="/#search" method="get" role="search" class="hidden min-h-11 max-w-[30rem] flex-1 items-center gap-2 rounded-[0.625rem] border-2 border-edge bg-limestone px-3 focus-within:border-lake lg:ml-4 lg:flex">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" class="shrink-0 text-granite"><circle cx="10.5" cy="10.5" r="6.5" /><path d="M15.5 15.5 21 21" /></svg>
            <label class="sr-only" for="nav-search-wide">Search bills, lawmakers and money</label>
            <input id="nav-search-wide" type="search" name="q" placeholder="Search bills, lawmakers and money" class="min-w-0 flex-1 bg-transparent text-base text-spruce placeholder:text-granite focus:outline-none" />
          </form>
          <!-- "Find your lawmakers" until an address is saved; then the
               reader's own districts, the one Prairie thing in the header -->
          <a
            href="/my-reps/"
            data-nav-my-reps
            data-nav-chip
            class="ml-auto hidden min-h-11 items-center gap-2 rounded-full border-2 border-edge bg-white px-4 text-small font-semibold text-spruce hover:border-spruce lg:inline-flex data-[saved]:border-prairie data-[saved]:bg-prairie-tint"
          >
            Find your lawmakers
          </a>
        </div>
        <!-- desktop, second row: the sections -->
        <div class="-ml-2.5 mt-1 hidden items-center gap-x-1 lg:flex">
          {NAV_GROUPS.map((g) => (
            <details data-nav-menu class="group relative">
              <summary class="flex min-h-11 cursor-pointer list-none items-center gap-1.5 rounded-[0.625rem] px-2.5 font-display font-semibold text-spruce hover:bg-fog [&::-webkit-details-marker]:hidden">
                {g.label}
                <svg width="12" height="12" viewBox="0 0 10 10" aria-hidden="true" class="transition-transform group-open:rotate-180">
                  <path d="M1 3l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                </svg>
              </summary>
              <ul class="absolute left-0 top-full z-50 mt-2 w-72 rounded-2xl border border-rule bg-white p-2 shadow-[0_8px_24px_rgba(24,36,31,0.16)]">
                {g.items.map(([href, label]) => (
                  <li><a href={href} class="flex min-h-11 items-center rounded-[0.625rem] px-3 text-spruce hover:bg-fog">{label}</a></li>
                ))}
              </ul>
            </details>
          ))}
          {NAV_DIRECT.map(([href, label]) => (
            <a href={href} class="flex min-h-11 items-center rounded-[0.625rem] px-2.5 font-display font-semibold text-spruce hover:bg-fog">{label}</a>
          ))}
        </div>
        <!-- phones: the saved districts sit under the bar, shown only once
             an address is saved -->
        <a
          href="/my-reps/"
          data-nav-my-reps
          data-nav-chip
          class="mx-2 mb-1 mt-1 hidden min-h-11 items-center gap-2 rounded-full border-2 border-prairie bg-prairie-tint px-4 text-small text-spruce data-[saved]:flex lg:hidden lg:data-[saved]:hidden"
        >
          Find your lawmakers
        </a>
      </nav>
    </header>

    <main id="main" tabindex="-1" class={mainClass} {...(searchable ? { "data-pagefind-body": true } : {})}>
      {/* one element per facet: Pagefind reads the value from content, and
          the inline colon syntax cannot carry more than one filter */}
      {searchable && filters &&
        Object.entries(filters).map(([k, v]) => (
          <meta content={v} data-pagefind-filter={`${k}[content]`} />
        ))}
      <slot />
    </main>

    <footer class="mt-14 border-t border-rule bg-white">
      <div class="mx-auto max-w-[72.5rem] space-y-3 px-5 pb-10 pt-7 text-small text-granite sm:px-8">
        <p class="font-bold text-spruce" data-disclaimer>
          Badger Politics is an independent project, not affiliated with the State of Wisconsin.
        </p>
        <p class="max-w-[45rem]">
          Built from the Wisconsin Legislature's official records{pulledOn && <span>, last checked <strong class="font-semibold text-spruce">{fmtDate(pulledOn)}</strong></span>}{dataThrough && <span>. The newest action they record is from <strong class="font-semibold text-spruce">{fmtDate(dataThrough)}</strong></span>}.
          Every page links to the <a href="https://docs.legis.wisconsin.gov" class="underline">official source</a> so you can check our work.
          {usesLegiscan() && (
            <>Some records come from <a href={LEGISCAN_WI_URL} class="underline">LegiScan</a>, used under the <a href={LEGISCAN_LICENSE_URL} class="underline">CC BY 4.0 license</a>, and each one says so on its page. </>
          )}
          Free, with no ads and no tracking cookies.
        </p>
        <div class="grid gap-6 border-t border-rule pt-5 sm:grid-cols-3">
          <div>
            <h2 class="t-label text-spruce">Take part</h2>
            <ul class="mt-1">
              <li><a href="/testify/" class="inline-block py-1.5 underline">Have your say at a hearing</a></li>
              <li><a href="/my-reps/" class="inline-block py-1.5 underline">Find your lawmakers</a></li>
              <li><a href="/federal/" class="inline-block py-1.5 underline">See how your members of Congress vote</a></li>
              <li><a href="/following/" class="inline-block py-1.5 underline">Follow bills you care about</a></li>
              <li><a href="/calendar/hearings.ics" class="inline-block py-1.5 underline">Add committee hearings to your calendar</a></li>
            </ul>
          </div>
          <div>
            <h2 class="t-label text-spruce">How it works</h2>
            <ul class="mt-1">
              <li><a href="/glossary/" class="inline-block py-1.5 underline">Words the Legislature uses</a></li>
              <li><a href="/partial-veto/" class="inline-block py-1.5 underline">How the partial veto works</a></li>
              <li><a href="/governors-desk/" class="inline-block py-1.5 underline">The governor's decisions</a></li>
              <li><a href="/hearing-none/" class="inline-block py-1.5 underline">Bills that never got a hearing</a></li>
              <li><a href="/feeds/weekly.xml" class="inline-block py-1.5 underline">This week in the Legislature, in a feed reader</a></li>
            </ul>
          </div>
          <div>
            <h2 class="t-label text-spruce">About</h2>
            <ul class="mt-1">
              <li><a href="/about/" class="inline-block py-1.5 underline">About us and corrections</a></li>
              <li><a href="/data/" class="inline-block py-1.5 underline">Data and API</a></li>
              <li><a href="https://github.com/uprightsleepy/badger-politics" class="inline-block py-1.5 underline">Source code</a></li>
            </ul>
          </div>
        </div>
      </div>
    </footer>

    <script>
      // nav dropdowns: one open at a time; click-outside and Escape close
      const menus = [...document.querySelectorAll<HTMLDetailsElement>("[data-nav-menu]")];
      for (const menu of menus) {
        menu.addEventListener("toggle", () => {
          if (menu.open) for (const other of menus) if (other !== menu) other.open = false;
        });
      }
      document.addEventListener("click", (e) => {
        for (const menu of menus) {
          if (menu.open && e.target instanceof Node && !menu.contains(e.target)) menu.open = false;
        }
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") for (const menu of menus) menu.open = false;
      });
    </script>

    <script>
      import { markAsMine, savedDistrict } from "../lib/district";
      import type { Reps } from "../lib/wire";

      // "Your reps" chip: district saved by /my-reps lives in localStorage only
      const saved = savedDistrict();
      if (saved) {
        const { ad, sd } = saved;
        document.querySelectorAll<HTMLElement>("[data-nav-my-reps]").forEach((link) => {
          link.textContent = `Your districts: Assembly ${ad}, Senate ${sd}`;
          link.setAttribute("aria-label", `Your lawmakers: Assembly District ${ad}, Senate District ${sd}`);
          link.toggleAttribute("data-saved", true);
          if (link.hasAttribute("data-nav-chip")) {
            const dot = document.createElement("span");
            dot.className = "h-2.5 w-2.5 shrink-0 rounded-full bg-spruce";
            dot.setAttribute("aria-hidden", "true");
            link.prepend(dot);
          }
        });
        // the user's own district pages highlight the same way their reps do
        const districtLinks: [string, string][] = [
          [`/districts/assembly-${ad}/`, "Your Assembly district: "],
          [`/districts/senate-${sd}/`, "Your Senate district: "],
        ];
        // a district's own page says so when it is the reader's
        document.querySelectorAll<HTMLElement>("[data-mine-seat]").forEach((el) => {
          if (el.dataset.mineSeat === `assembly-${ad}` || el.dataset.mineSeat === `senate-${sd}`) el.hidden = false;
        });
        for (const [href, srLabel] of districtLinks) {
          document.querySelectorAll<HTMLAnchorElement>(`a[href="${href}"]`).forEach((a) => {
            if (!a.closest("nav") && !a.closest("[data-no-rep-highlight]")) markAsMine(a, srLabel);
          });
        }
        // highlight the saved district's reps anywhere they appear; every
        // legislator reference sitewide is a profile link, so the href is
        // the reliable hook. Roll-call rows mark themselves.
        fetch("/data/reps.json")
          .then((r) => r.json())
          .then((reps: Reps) => {
            const slugs = [reps.assembly[ad]?.slug, reps.senate[sd]?.slug].filter(Boolean);
            const spoken: [string | undefined, string][] = [
              [reps.assembly[ad]?.slug, "Your representative: "],
              [reps.senate[sd]?.slug, "Your state senator: "],
            ];
            // a bill page names the reader's own lawmakers when they are
            // among its authors or supporters
            const note = document.querySelector<HTMLElement>("[data-sponsor-note]");
            if (note) {
              const authors = Number(note.dataset.authors ?? 0);
              const found: { title: string; text: string }[] = [];
              const mine: [string | undefined, string][] = [
                [reps.assembly[ad]?.slug, "representative"],
                [reps.senate[sd]?.slug, "state senator"],
              ];
              for (const [slug, who] of mine) {
                const row = slug ? document.querySelector<HTMLElement>(`[data-sponsor-slug="${slug}"]`) : null;
                if (!row) continue;
                const name = row.dataset.sponsorName ?? "";
                if (row.dataset.sponsorRole === "author") {
                  found.push({
                    title: `Your ${who} is ${authors === 1 ? "the author" : "an author"}`,
                    text: authors === 1
                      ? `Your ${who}, ${name}, is this bill's author.`
                      : `Your ${who}, ${name}, is one of this bill's ${authors} authors.`,
                  });
                } else {
                  found.push({
                    title: `Your ${who} signed on`,
                    text: `Your ${who}, ${name}, signed on in support of this bill.`,
                  });
                }
              }
              if (found.length) {
                note.querySelector("[data-sponsor-note-title]")!.textContent =
                  found.length === 1 ? found[0].title : "Your lawmakers are behind this bill";
                note.querySelector("[data-sponsor-note-text]")!.textContent = found.map((f) => f.text).join(" ");
                note.hidden = false;
              }
            }
            // a lawmaker's own page says so when they represent the reader
            document.querySelectorAll<HTMLElement>("[data-mine-person]").forEach((el) => {
              if (slugs.includes(el.dataset.minePerson)) el.hidden = false;
            });
            for (const [slug, srLabel] of spoken) {
              if (!slug) continue;
              document.querySelectorAll<HTMLAnchorElement>(`a[href="/legislators/${slug}/"]`).forEach((a) => {
                if (
                  a.closest("[data-vote-row]") ||
                  a.closest("nav") ||
                  a.closest("[data-no-rep-highlight]")
                ) return;
                markAsMine(a, srLabel);
              });
            }
          })
          .catch(() => {});
      }
      // external links (docs.legis sources, GitHub, ...) open in a new tab
      document.querySelectorAll<HTMLAnchorElement>("a[href^='http']").forEach((a) => {
        if (new URL(a.href).origin !== location.origin) {
          a.target = "_blank";
          a.rel = "noopener";
          const label = a.getAttribute("aria-label");
          if (label) {
            a.setAttribute("aria-label", `${label} (opens in a new tab)`);
          } else {
            const note = document.createElement("span");
            note.className = "sr-only";
            note.textContent = " (opens in a new tab)";
            a.appendChild(note);
          }
        }
      });
    </script>
    <script
      is:inline
      data-goatcounter="https://badgerpolitics.goatcounter.com/count"
      async
      src="//gc.zgo.at/count.js"></script>
  </body>
</html>
