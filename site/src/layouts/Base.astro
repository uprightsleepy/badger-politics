---
import "../styles/global.css";
import { meta } from "../lib/db";
import { fmtDate } from "../lib/format";
interface Props {
  title: string;
  description?: string;
  /** Share-card image; pages may override the sitewide card. */
  image?: string;
  /** Index this page's main content for search. Off for roll-call pages,
   * which are name lists whose substance lives on the bill and member
   * pages already. */
  searchable?: boolean;
  /** Keep the page out of search engines while leaving it crawlable and
   * linkable. Same reasoning as `searchable`, applied outward. */
  noindex?: boolean;
}
const {
  title,
  description = "Free, independent tracking of the Wisconsin Legislature. Every bill, every vote, and every committee graveyard.",
  image = "/og.png",
  searchable = true,
  noindex = false,
} = Astro.props;
// absolute URLs: crawlers and chat apps will not resolve relative ones
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
// Search engines cut a title around 60 characters. On a long page title
// the suffix is the part that gets dropped, so drop it deliberately rather
// than letting it be truncated to "· Badger Poli…".
const fullTitle = title.length > 42 ? title : `${title} · Badger Politics`;
const dataThrough = meta().data_through;
// two different freshness facts: the newest action the Legislature has
// recorded, and when we last pulled the records to look
const pulledOn = meta().imported_at?.slice(0, 10);
const NAV_GROUPS: { label: string; items: [string, string][] }[] = [
  {
    label: "Legislation",
    items: [
      ["/bills/", "Bills"],
      ["/laws/", "New laws"],
      ["/subjects/", "Subjects"],
      ["/governors-desk/", "Governor's desk"],
      ["/vetoes/", "Veto tracker"],
      ["/hearing-none/", "Hearing None"],
    ],
  },
  {
    label: "People",
    items: [
      ["/legislators/", "Legislators"],
      ["/districts/", "Districts"],
      ["/committees/", "Committees"],
    ],
  },
  {
    label: "Money",
    items: [
      ["/money/", "Campaign money"],
      ["/money/independent/", "For & against"],
      ["/lobbying/", "Lobbying"],
    ],
  },
];
const NAV_DIRECT: [string, string][] = [
  ["/calendar/", "Calendar"],
  ["/elections/2026/", "2026 Ballot"],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={pageUrl} />
    {/* follow, not none: these pages still pass authority on to the bills
        and members they link to. */}
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Badger Politics" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Badger Politics — Wisconsin's Legislature, in plain sight." />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
  </head>
  <body class="min-h-screen bg-paper text-ink antialiased">
    <a
      href="#main"
      class="sr-only rounded bg-navy-900 px-3 py-2 text-white focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50"
    >
      Skip to content
    </a>
    <header class="border-b border-navy-100 bg-navy-900 text-white">
      <nav class="mx-auto max-w-5xl px-4 py-3 text-sm">
        <div class="flex items-center justify-between gap-4">
          <a href="/" class="flex items-center gap-2 text-base font-bold tracking-tight">
            <img src="/wisconsin.svg" alt="" width="22" height="22" />
            Badger Politics
          </a>
          <!-- phones and small tablets get a native disclosure menu -->
          <details data-nav-menu class="relative md:hidden">
            <summary class="flex cursor-pointer list-none items-center gap-2 rounded-lg border border-navy-600 px-3 py-2 font-semibold [&::-webkit-details-marker]:hidden">
              <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
                <path stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M2 4h12M2 8h12M2 12h12" />
              </svg>
              Menu
            </summary>
            <div class="absolute right-0 top-full z-50 mt-2 max-h-[80vh] w-72 overflow-y-auto rounded-lg border border-navy-700 bg-navy-900 p-2 shadow-lg">
              <!-- the site's primary action leads; it was previously last,
                   below the fold on a phone -->
              <form action="/" method="get" class="px-1 pb-2">
                <label class="sr-only" for="nav-search">Search the site</label>
                <input
                  id="nav-search"
                  type="search"
                  name="q"
                  placeholder="Search bills, people, laws…"
                  class="w-full rounded-lg border border-navy-600 bg-navy-800 px-3 py-2 text-sm text-white placeholder:text-navy-300"
                />
              </form>
              <a
                href="/my-reps/"
                data-nav-my-reps
                class="block rounded-lg bg-gold-500 px-3 py-2.5 text-center font-bold text-navy-900 hover:bg-gold-600"
              >
                Find my legislators
              </a>
              <a href="/following/" class="mt-1 block rounded-lg border border-navy-600 px-3 py-2 text-center font-semibold hover:bg-navy-800">
                Following
              </a>

              <!-- categories collapse so every one is visible at once
                   instead of a fifteen-item scroll -->
              {NAV_GROUPS.map((g) => (
                <details data-nav-group class="group mt-1 border-t border-navy-700 pt-1">
                  <summary class="flex cursor-pointer list-none items-center justify-between rounded px-3 py-2 font-semibold hover:bg-navy-800 [&::-webkit-details-marker]:hidden">
                    {g.label}
                    <svg width="12" height="12" viewBox="0 0 10 10" aria-hidden="true" class="shrink-0 transition-transform group-open:rotate-180">
                      <path d="M1 3l4 4 4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                    </svg>
                  </summary>
                  <ul class="pb-1">
                    {g.items.map(([href, label]) => (
                      <li>
                        <a href={href} class="block rounded py-2 pl-6 pr-3 text-sm hover:bg-navy-800">{label}</a>
                      </li>
                    ))}
                  </ul>
                </details>
              ))}

              <ul class="mt-1 border-t border-navy-700 pt-1">
                {NAV_DIRECT.map(([href, label]) => (
                  <li>
                    <a href={href} class="block rounded px-3 py-2 hover:bg-navy-800">{label}</a>
                  </li>
                ))}
              </ul>
            </div>
          </details>
          <div class="hidden flex-wrap items-center gap-x-6 gap-y-2 md:flex">
            {NAV_GROUPS.map((g) => (
              <details data-nav-menu class="group relative">
                <summary class="flex cursor-pointer list-none items-center gap-1 py-1 hover:text-gold-500 [&::-webkit-details-marker]:hidden">
                  {g.label}
                  <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true" class="transition-transform group-open:rotate-180">
                    <path d="M1 3l4 4 4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                  </svg>
                </summary>
                <ul class="absolute left-0 top-full z-50 mt-2 w-52 space-y-1 rounded-lg border border-navy-700 bg-navy-900 p-2 shadow-lg">
                  {g.items.map(([href, label]) => (
                    <li><a href={href} class="block rounded px-3 py-2 hover:bg-navy-800">{label}</a></li>
                  ))}
                </ul>
              </details>
            ))}
            {NAV_DIRECT.map(([href, label]) => (
              <a href={href} class="py-1 hover:text-gold-500">{label}</a>
            ))}
            <a href="/my-reps/" data-nav-my-reps class="rounded-full bg-navy-700 px-3 py-1 hover:bg-navy-600">
              Find my legislators
            </a>
          </div>
        </div>
      </nav>
    </header>

    <main id="main" tabindex="-1" class="mx-auto max-w-5xl px-4 py-8 focus:outline-none" {...(searchable ? { "data-pagefind-body": true } : {})}>
      <slot />
    </main>

    <footer class="mt-16 border-t border-navy-100 bg-white">
      <div class="mx-auto max-w-5xl space-y-3 px-4 py-8 text-sm text-navy-700">
        <p class="font-semibold text-ink">
          Badger Politics is an independent project, not affiliated with the State of Wisconsin.
        </p>
        <p>
          Built from official Wisconsin Legislature records
          {pulledOn && <span>, last pulled <strong>{fmtDate(pulledOn)}</strong></span>}{dataThrough && <span>; the Legislature's most recent recorded action is from <strong>{fmtDate(dataThrough)}</strong></span>}.
          Every page links to the <a href="https://docs.legis.wisconsin.gov" class="underline">official source</a> so you can check our work.
        </p>
        <div class="grid gap-6 border-t border-navy-100 pt-4 sm:grid-cols-3">
          <div>
            <h2 class="text-xs font-semibold uppercase tracking-wide text-navy-600">What you can do</h2>
            <ul class="mt-1">
              <li><a href="/testify/" class="inline-block py-1 underline">Testify at a hearing</a></li>
              <li><a href="/my-reps/" class="inline-block py-1 underline">Find your legislators</a></li>
              <li><a href="/following/" class="inline-block py-1 underline">Follow bills you care about</a></li>
              <li><a href="/calendar/hearings.ics" class="inline-block py-1 underline">Subscribe to the hearings calendar</a></li>
            </ul>
          </div>
          <div>
            <h2 class="text-xs font-semibold uppercase tracking-wide text-navy-600">Understand the process</h2>
            <ul class="mt-1">
              <li><a href="/glossary/" class="inline-block py-1 underline">Glossary of legislative terms</a></li>
              <li><a href="/partial-veto/" class="inline-block py-1 underline">How the partial veto works</a></li>
              <li><a href="/governors-desk/" class="inline-block py-1 underline">The governor's desk</a></li>
              <li><a href="/hearing-none/" class="inline-block py-1 underline">Bills that died without a hearing</a></li>
              <li><a href="/feeds/weekly.xml" class="inline-block py-1 underline">This week in the Legislature (Atom)</a></li>
            </ul>
          </div>
          <div>
            <h2 class="text-xs font-semibold uppercase tracking-wide text-navy-600">About the project</h2>
            <ul class="mt-1">
              <li><a href="/about/" class="inline-block py-1 underline">About &amp; corrections</a></li>
              <li><a href="/data/" class="inline-block py-1 underline">Data &amp; API</a></li>
              <li><a href="https://github.com/uprightsleepy/badger-politics" class="inline-block py-1 underline">Source code</a></li>
            </ul>
          </div>
        </div>
      </div>
    </footer>

    <script>
      // nav dropdowns: one open at a time; click-outside and Escape close
      const menus = [...document.querySelectorAll<HTMLDetailsElement>("[data-nav-menu]")];
      for (const menu of menus) {
        menu.addEventListener("toggle", () => {
          if (menu.open) for (const other of menus) if (other !== menu) other.open = false;
        });
      }
      document.addEventListener("click", (e) => {
        for (const menu of menus) {
          if (menu.open && e.target instanceof Node && !menu.contains(e.target)) menu.open = false;
        }
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") for (const menu of menus) menu.open = false;
      });
    </script>

    <script>
      import { savedDistrict } from "../lib/district";

      // "Your reps" chip: district saved by /my-reps lives in localStorage only
      const saved = savedDistrict();
      if (saved) {
        const { ad, sd } = saved;
        document.querySelectorAll("[data-nav-my-reps]").forEach((link) => {
          link.textContent = `Your reps · AD ${ad} / SD ${sd}`;
          link.setAttribute("aria-label", `Your legislators: Assembly District ${ad}, Senate District ${sd}`);
        });
        // the user's own district pages highlight the same way their reps do
        const districtLinks: [string, string][] = [
          [`/districts/assembly-${ad}/`, "Your Assembly district: "],
          [`/districts/senate-${sd}/`, "Your Senate district: "],
        ];
        for (const [href, srLabel] of districtLinks) {
          document.querySelectorAll<HTMLAnchorElement>(`a[href="${href}"]`).forEach((a) => {
            if (a.closest("nav")) return;
            a.classList.add("bg-gold-100", "rounded", "px-1", "font-semibold");
            const sr = document.createElement("span");
            sr.className = "sr-only";
            sr.textContent = srLabel;
            a.prepend(sr);
          });
        }
        // highlight the saved district's reps anywhere they appear; every
        // legislator reference sitewide is a profile link, so the href is
        // the reliable hook. Roll-call rows mark themselves.
        fetch("/data/reps.json")
          .then((r) => r.json())
          .then((reps: { assembly: Record<string, { slug: string }>; senate: Record<string, { slug: string }> }) => {
            const slugs = [reps.assembly[ad]?.slug, reps.senate[sd]?.slug].filter(Boolean);
            for (const slug of slugs) {
              document.querySelectorAll<HTMLAnchorElement>(`a[href="/legislators/${slug}/"]`).forEach((a) => {
                if (
                  a.closest("[data-vote-row]") ||
                  a.closest("nav") ||
                  a.closest("[data-no-rep-highlight]")
                ) return;
                a.classList.add("bg-gold-100", "rounded", "px-1", "font-semibold");
                const sr = document.createElement("span");
                sr.className = "sr-only";
                sr.textContent = "Your representative: ";
                a.prepend(sr);
              });
            }
          })
          .catch(() => {});
      }
      // external links (docs.legis sources, GitHub, ...) open in a new tab
      document.querySelectorAll<HTMLAnchorElement>("a[href^='http']").forEach((a) => {
        if (new URL(a.href).origin !== location.origin) {
          a.target = "_blank";
          a.rel = "noopener";
          const label = a.getAttribute("aria-label");
          if (label) {
            a.setAttribute("aria-label", `${label} (opens in a new tab)`);
          } else {
            const note = document.createElement("span");
            note.className = "sr-only";
            note.textContent = " (opens in a new tab)";
            a.appendChild(note);
          }
        }
      });
    </script>
    <script
      is:inline
      data-goatcounter="https://badgerpolitics.goatcounter.com/count"
      async
      src="//gc.zgo.at/count.js"></script>
  </body>
</html>
