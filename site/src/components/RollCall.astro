---
import PartyChip from "./PartyChip.astro";
import { chamberName, personSlug } from "../lib/format";
import type { VoteEvent } from "../lib/db";
import { voteRecordsFor } from "../lib/db";
interface Props { event: VoteEvent; compact?: boolean; headingLevel?: "h2" | "h3" }
const { event, compact = false, headingLevel = "h3" } = Astro.props;
const Heading = headingLevel;
const SubHeading = headingLevel === "h2" ? "h3" : "h4";
const records = voteRecordsFor(event.id);
const byOption = (opt: string) => records.filter((r) => r.option === opt);
const groups = [
  { key: "yes", label: "Aye", rows: byOption("yes"), style: "text-moss-600" },
  { key: "no", label: "Nay", rows: byOption("no"), style: "text-badger-700" },
  {
    key: "other",
    label: "Not voting",
    rows: records.filter((r) => r.option !== "yes" && r.option !== "no"),
    style: "text-navy-600",
  },
];
---
<div class="rounded-lg border border-navy-100 bg-white p-4" data-rollcall data-chamber={event.chamber}>
  <div class="mb-2 flex flex-wrap items-baseline gap-x-3 gap-y-1">
    <Heading class="font-semibold">
      {chamberName(event.chamber)}: {event.motion ?? "Vote"}
    </Heading>
    <span class={`text-sm font-bold ${event.result === "pass" ? "text-moss-600" : "text-badger-700"}`}>
      {event.result === "pass" ? "Passed" : "Failed"}
      {event.yes_count != null && ` ${event.yes_count}–${event.no_count ?? 0}`}
    </span>
    <span class="text-sm text-navy-600">{event.date}</span>
    {event.source_url && (
      <a href={event.source_url} class="text-sm underline">official source</a>
    )}
    {!compact && <a href={`/votes/${event.id}/`} class="text-sm underline">full page</a>}
  </div>
  <p class="mb-3 hidden rounded border-l-4 border-gold-600 bg-gold-100 px-3 py-2 text-sm font-medium" data-your-reps-note></p>
  {records.length === 0 ? (
    <p class="text-sm text-navy-600">
      No individual roll call was recorded for this vote. Committee votes and
      some older sessions record totals only.
    </p>
  ) : (
    <div class="grid gap-3 sm:grid-cols-3">
      {groups.filter((g) => g.rows.length).map((group) => (
        <div>
          <SubHeading class={`mb-1 text-xs font-bold uppercase tracking-wide ${group.style}`}>
            {group.label} · {group.rows.length}
          </SubHeading>
          <ul class="text-sm">
            {group.rows.map((r) => (
              <li
                class="flex min-h-6 items-center gap-1.5 rounded border-l-4 border-transparent px-1"
                data-vote-row
                data-chamber={r.chamber}
                data-district={r.district}
                data-option={group.label}
              >
                <PartyChip party={r.party} size="sm" />
                <a href={`/legislators/${personSlug(r.person_id)}/`} class="truncate py-1 hover:underline">
                  {r.name}
                </a>
                {r.district != null && <span class="text-xs text-navy-600">({r.district})</span>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  )}
</div>

<script>
  // Pin the saved district's reps in every roll call on the page. Lives in
  // the component so bill pages and standalone vote pages both get it.
  const saved = localStorage.getItem("bp-district");
  if (saved) {
    const { ad, sd } = JSON.parse(saved);
    document.querySelectorAll("[data-rollcall]").forEach((block) => {
      const wanted =
        block.getAttribute("data-chamber") === "upper" ? String(sd) : String(ad);
      const names: string[] = [];
      block.querySelectorAll("[data-vote-row]").forEach((row) => {
        if (row.getAttribute("data-district") === wanted) {
          row.classList.remove("border-transparent");
          row.classList.add("bg-gold-100", "font-semibold", "border-gold-600");
          const a = row.querySelector("a");
          if (a) {
            names.push(`${a.textContent!.trim()} voted ${row.getAttribute("data-option")}`);
            const sr = document.createElement("span");
            sr.className = "sr-only";
            sr.textContent = "Your representative: ";
            a.prepend(sr);
          }
        }
      });
      const note = block.querySelector("[data-your-reps-note]");
      if (note && names.length) {
        note.textContent = `Your rep: ${names.join("; ")}`;
        note.classList.remove("hidden");
      }
    });
  }
</script>
