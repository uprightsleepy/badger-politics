---
/** A member of Congress's campaign money by reporting period: the FEC's
 * two-year summary for their federal committees, and any Wisconsin
 * campaign they run, kept apart because the two are different systems. */
import MoneyFilters from "./MoneyFilters.astro";
import { moneyPeriods, currentMoneyCycle } from "../lib/money-periods";
import StateCampaignMoney from "./StateCampaignMoney.astro";
import { federalMoneyFor, stateCampaignsFor } from "../lib/db";
import { fmtDate, fmtMoney, fmtMoneyShort } from "../lib/format";
import { longDate } from "../lib/federal";

interface Props { bioguide: string; }
const { bioguide } = Astro.props;
const federal = federalMoneyFor(bioguide);
const state = stateCampaignsFor(bioguide);
// the FEC reports cents
const dollars = (cents: number | null) => (cents === null ? "Not reported" : fmtMoney(cents / 100));
const short = (cents: number | null) => (cents === null ? null : fmtMoneyShort(cents / 100));
const current = String(currentMoneyCycle());
---
<section class="flex flex-col gap-4" aria-labelledby="money">
  <h2 id="money" class="t-section scroll-mt-4">Campaign money</h2>
  <MoneyFilters office={false} />
  {moneyPeriods().map((period) => {
    const selectedFederal = federal.filter((f) => period.key === "all" || String(f.cycle) === period.key);
    const selectedState = state.filter((c) => period.key === "all" || String(c.cycle) === period.key);
    return <div data-money-period={period.key} hidden={period.key !== current} data-pagefind-ignore={period.key !== current ? "all" : undefined} class="flex flex-col gap-8">
      {selectedFederal.length === 0 && selectedState.length === 0 && (
        <p>
          Campaign money isn't collected for this period. That's a gap in our records, not a sign of no
          fundraising.
        </p>
      )}
      {selectedFederal.map((f) => (
        <article class="flex flex-col gap-3 border-t border-rule pt-4" aria-labelledby={`fec-${period.key}-${f.cycle}`}>
          <h3 id={`fec-${period.key}-${f.cycle}`} class="t-question text-[1.1875rem]">Federal campaign, {f.cycle - 1}–{f.cycle}</h3>
          {f.receipts === null ? (
            <p>The FEC file we collected has no summary for this cycle yet.</p>
          ) : (
            <p>
              Reported <span class="figure">{short(f.receipts)}</span> in receipts and
              {" "}<span class="figure">{short(f.disbursements) ?? "an unreported amount"}</span> in spending
              {f.coverage_end && ` through ${longDate(f.coverage_end)}`}{f.cash_end !== null && <>, with <span class="figure">{short(f.cash_end)}</span> in cash on hand</>}.
            </p>
          )}
          {f.receipts !== null && (
            <>
          <dl class="grid grid-cols-1 gap-x-8 gap-y-3 min-[400px]:grid-cols-2 sm:grid-cols-4">
            {[["Receipts", f.receipts], ["Spending", f.disbursements],
              ["Cash on hand", f.cash_end], ["Debts owed", f.debts]].map(([label, value]) => (
              <div>
                <dt class="text-small text-granite">{label}</dt>
                <dd class="whitespace-nowrap font-display text-[1.25rem] font-bold tabular-nums">{dollars(value as number | null)}</dd>
              </div>
            ))}
          </dl>
          <details>
            <summary class="inline-flex min-h-11 cursor-pointer items-center font-display font-bold text-lake underline">Where the receipts came from, and transfers</summary>
            <dl class="mt-2 grid max-w-[36rem] grid-cols-[minmax(0,1fr)_auto] gap-x-4 border-b border-rule">
              {[["Individuals", f.individual_contributions], ["Other political committees", f.committee_contributions],
                ["Party committees", f.party_contributions], ["The candidate", f.candidate_contributions],
                ["Transfers from their other committees", f.transfers_in],
                ["Transfers to their other committees", f.transfers_out],
                ["Refunds to individuals", f.individual_refunds], ["Refunds to committees", f.committee_refunds]]
                .map(([label, value]) => <><dt class="border-t border-rule py-2">{label}</dt><dd class="border-t border-rule py-2 text-right tabular-nums">{dollars(value as number | null)}</dd></>)}
            </dl>
          </details>
            </>
          )}
          <p class="text-small text-granite">
            The FEC's two-year totals across the member's own (authorized) committees. Receipts include more
            than donations, spending is what the FEC calls disbursements, and a transfer between their
            committees can count the same money twice, so transfers are listed apart. Outside spending and state campaigns aren't included. Retrieved
            {" "}{fmtDate(f.fetched_at.slice(0, 10))}.
            {" "}<a class="underline" href={`https://www.fec.gov/data/candidate/${f.candidate_id}/?cycle=${f.cycle}&election_full=false`}>Every itemized record at the FEC ({f.candidate_id})</a>
          </p>
        </article>
      ))}
      {selectedState.map((c) => <StateCampaignMoney campaign={c} />)}
    </div>;
  })}
</section>
