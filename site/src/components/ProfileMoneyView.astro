---
/** One reporting period of a legislator's campaign money: the total, how
 * it came in over time, where it came from, and the largest givers. */
import MoneyTimeline from "./MoneyTimeline.astro";
import MoneyCoverage from "./MoneyCoverage.astro";
import MoneyMix from "./MoneyMix.astro";
import MoneyRows from "./MoneyRows.astro";
import { moneyFor, hasDonorPage, termsFor } from "../lib/db";
import { fmtMoney } from "../lib/format";
import type { moneyViews } from "../lib/money-periods";
interface Props { personId: string; view: ReturnType<typeof moneyViews>[number]; }
const { personId, view } = Astro.props;
const money = moneyFor(personId, view.bounds);
const terms = termsFor(personId);
const TYPE_LABELS: Record<string, string> = {
  Individual: "Individuals",
  Registrant: "Political committees",
  Business: "Businesses and other entities",
  Self: "The candidate themselves",
};
// a fixed order so each source keeps its tone from page to page
// (Individuals in Spruce, committees in Lake, as on the overview)
const TYPE_ORDER = ["Individual", "Registrant", "Business", "Self"];
const rank = (t: string) => (TYPE_ORDER.indexOf(t) + 1 || TYPE_ORDER.length + 1);
const byType = [...(money?.byType ?? [])].sort((a, b) => rank(a.type) - rank(b.type));
const period = view.period.key === "all" ? "in all the history we have" : `in ${view.period.label.replace(" · Current", "")}`;
const plural = (n: number, one: string, many: string) => `${n.toLocaleString()} ${n === 1 ? one : many}`;
---
{!money ? (
  <p>
    We haven't collected receipts for this legislator's campaign committees. That's a gap in our
    records, not a sign they raised nothing.
  </p>
) : money.n === 0 ? (
  <MoneyCoverage period={view.period} first={null} last={null} scope={view.scope} />
) : (
  <div class="flex flex-col gap-6">
    <div class="flex flex-col gap-2">
      <p class="sm:text-lead">
        Reported <span class="figure">{fmtMoney(money.total)}</span> in receipts
        {period}{view.scope === "office" ? " while in legislative office" : ""}, across {plural(money.n, "record", "records")}.
      </p>
      <MoneyCoverage period={view.period} first={money.first} last={money.last} scope={view.scope} />
      <MoneyTimeline quarters={money.quarters} entry={view.period.key === "all" ? money.first! : view.period.start}
        terms={view.scope === "office" ? terms : []} />
    </div>

    {money.byType.length > 0 && (
      <div class="flex flex-col gap-3">
        <h3 class="t-question">Where it came from</h3>
        <MoneyMix
          parts={byType.map((t) => ({ label: TYPE_LABELS[t.type] ?? t.type, amount: t.total, tone: rank(t.type) - 1 }))}
          total={money.total}
        />
        <p class="text-fine text-granite">Source types exactly as the committee reported each receipt.</p>
      </div>
    )}

    <div class="grid gap-8 lg:grid-cols-2 lg:gap-x-12">
      {money.committees.length > 0 && (
        <div class="min-w-0">
          <h3 class="t-question">Committees that gave the most</h3>
          <p class="mt-1 text-small text-granite">PACs, party and other political committees.</p>
          <div class="mt-3">
            <MoneyRows
              label="committees that gave the most"
              rows={money.committees.map((c) => ({
                name: c.name, href: hasDonorPage(c.entityId) ? `/money/committees/${c.entityId}/` : null,
                logoId: c.entityId, amount: c.total,
              }))}
            />
          </div>
        </div>
      )}
      {money.individuals.length > 0 && (
        <div class="min-w-0">
          <h3 class="t-question">Individuals who gave the most</h3>
          <p class="mt-1 text-small text-granite">In this period, grouped by the donor's identity in the filings.</p>
          <div class="mt-3">
            <MoneyRows
              label="individuals who gave the most"
              rows={money.individuals.map((d) => ({ name: d.name, meta: plural(d.n, "receipt", "receipts"), amount: d.total }))}
            />
          </div>
        </div>
      )}
      {money.occupations.length > 0 && (
        <div class="min-w-0">
          <h3 class="t-question">What individual donors do for a living</h3>
          <p class="mt-1 text-small text-granite">
            As donors reported it. Individuals gave {fmtMoney(money.individualTotal)} in all.
          </p>
          <div class="mt-3">
            <MoneyRows
              label="donor occupations"
              rows={money.occupations.map((o) => ({ name: o.occupation, amount: o.total }))}
            />
          </div>
        </div>
      )}
    </div>

    <p class="text-fine text-granite">
      From the Wisconsin Ethics Commission's campaign finance filings, refreshed nightly. Wisconsin law
      bars corporations from giving to candidates, so money comes from individuals and political
      committees. Totals cover the candidate's own committees, including runs for other offices, and
      can include loans, transfers, refunds and in-kind support. Our history starts no earlier than July
      2008 and may have gaps. <a href="/about/#money" class="underline">Full methodology</a>
    </p>
  </div>
)}
