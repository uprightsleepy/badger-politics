---
/** One legislator-year of floor attendance, voting days only: every cell
 * is a day the chamber held recorded floor votes (empty days don't
 * render, so the strip stays dense). Navy-green = voted on everything;
 * gold = present but not voting on some; badger red = missed votes;
 * pale = out of office that day. Pure static HTML — details via title
 * attributes and the screen-reader summary. */
interface Day {
  date: string;
  total: number; // chamber floor votes that day
  cast: number; // this person's aye/nay
  nv: number; // this person's recorded not-voting/excused
  served?: boolean; // false = out of office that day (recall, resignation)
}
interface Props {
  year: number;
  days: Day[];
}
const { year, days } = Astro.props;
const ordered = [...days].sort((a, b) => (a.date < b.date ? -1 : 1));
const prettyDate = (date: string) =>
  new Date(date + "T00:00:00Z").toLocaleDateString("en-US", { month: "short", day: "numeric", timeZone: "UTC" });
const missedList = ordered
  .filter((d) => d.served !== false && d.total - d.cast - d.nv > 0)
  .map((d) => ({ label: prettyDate(d.date), missed: d.total - d.cast - d.nv, total: d.total }));
const servedDays = ordered.filter((d) => d.served !== false).length;
const summaryLabel =
  `${year} floor attendance: ${servedDays} voting days in office` +
  (servedDays < ordered.length ? `, out of office for ${ordered.length - servedDays}` : "") +
  ", " +
  (missedList.length
    ? `missed votes on ${missedList.length} day${missedList.length > 1 ? "s" : ""}, listed below`
    : "no missed votes");

function cellFor(day: Day) {
  const pretty = prettyDate(day.date);
  if (day.served === false) {
    return { cls: "bg-navy-100 text-navy-600", title: `${pretty}: not in office` };
  }
  const missed = day.total - day.cast - day.nv;
  if (missed > 0)
    return {
      cls: "hm-miss text-white",
      title: `${pretty}: missed ${missed} of ${day.total} floor vote${day.total > 1 ? "s" : ""}`,
    };
  if (day.nv > 0)
    return {
      cls: "bg-gold-600 text-navy-900",
      title: `${pretty}: present, not voting on ${day.nv} of ${day.total}`,
    };
  return {
    cls: "bg-moss-600 text-white",
    title: `${pretty}: voted in all ${day.total} floor vote${day.total > 1 ? "s" : ""}`,
  };
}

const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const byMonth: { label: string; cells: { dayNum: number; cls: string; title: string }[] }[] = [];
for (const d of ordered) {
  const label = MONTHS[Number(d.date.slice(5, 7)) - 1];
  if (!byMonth.length || byMonth[byMonth.length - 1].label !== label) {
    byMonth.push({ label, cells: [] });
  }
  const c = cellFor(d);
  byMonth[byMonth.length - 1].cells.push({ dayNum: Number(d.date.slice(8, 10)), ...c });
}
---
<div tabindex="0" role="img" aria-label={summaryLabel}>
  <div class="flex flex-wrap gap-x-4 gap-y-2" aria-hidden="true">
    {byMonth.map((m) => (
      <div>
        <div class="text-[0.625rem] font-semibold uppercase tracking-wide text-navy-600">{m.label}</div>
        <div class="mt-0.5 flex flex-wrap gap-[3px]">
          {m.cells.map((c) => (
            <div class={`hm-cell flex h-5 w-5 items-center justify-center rounded-[3px] text-[0.5625rem] font-semibold tabular-nums ${c.cls}`} title={c.title}>{c.dayNum}</div>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>
{missedList.length > 0 && (
  <details class="mt-2 text-xs text-navy-700">
    <summary class="cursor-pointer">
      Missed-vote days in {year} · {missedList.length}
    </summary>
    <ul class="mt-1 flex flex-wrap gap-x-4 gap-y-0.5">
      {missedList.map((d) => (
        <li>{d.label}: missed {d.missed} of {d.total}</li>
      ))}
    </ul>
  </details>
)}
