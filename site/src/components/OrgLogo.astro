---
/** Logo tile for a verified org mapping; monogram fallback otherwise.
 * The logo never replaces the name in the UI, only accompanies it. */
import { existsSync } from "node:fs";
import { join } from "node:path";
import orgDomains from "../data/org-domains.json";
interface Props { entityId: number | string | null; name: string }
const { entityId, name } = Astro.props;

const entry = entityId != null ? (orgDomains as Record<string, any>)[String(entityId)] : null;
// resolve from the project root: import.meta.url points into the build bundle
const hasLogo = entry ? existsSync(join(process.cwd(), "public", "logos", `${entityId}.png`)) : false;
const initials = name
  .split(/\s+/)
  .filter((w) => /^[A-Za-z]/.test(w))
  .slice(0, 2)
  .map((w) => w[0].toUpperCase())
  .join("");
---
{hasLogo ? (
  <img
    src={`/logos/${entityId}.png`}
    alt=""
    width="20"
    height="20"
    loading="lazy"
    class="h-5 w-5 shrink-0 rounded bg-white object-contain"
  />
) : (
  <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded bg-navy-100 text-[0.5625rem] font-bold text-navy-700" aria-hidden="true">
    {initials}
  </span>
)}
