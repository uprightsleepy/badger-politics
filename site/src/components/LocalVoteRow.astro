---
import { fmtDate } from "../lib/format";
import { actionLabel, castStyle } from "../lib/localGloss";
import { recordText } from "../lib/recordText.mjs";

interface Props {
  v: {
    date: string; value?: string; title: string | null; action: string;
    matter_file: string | null; matter_url: string | null; insite_url: string;
  };
  dissent?: boolean;
}
const { v, dissent = false } = Astro.props;
---
<li class="px-4 py-3" data-y={dissent ? v.date.slice(0, 4) : undefined}>
  <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs">
    {v.value && (
      <span class={`shrink-0 rounded-full px-3 py-0.5 text-center font-bold ${castStyle(v.value)}`}>{v.value}</span>
    )}
    <time datetime={v.date} class="shrink-0 tabular-nums text-navy-600">{fmtDate(v.date)}</time>
    {v.matter_file && (
      <a href={v.matter_url || v.insite_url} class="min-h-6 break-words font-semibold leading-6 underline">{v.matter_file}</a>
    )}
    {Astro.slots.has("tally") && <span class="ml-auto"><slot name="tally" /></span>}
  </div>
  <p class="mt-1.5 whitespace-pre-line break-words">
    {recordText(v.title) || "Untitled item"}
  </p>
  <p class="mt-1 whitespace-pre-line break-words text-xs text-navy-600">
    <span class="font-semibold">Action:</span>{" "}{recordText(actionLabel(v.action))}
    {" · "}<a href={v.insite_url} class="inline-block min-h-6 leading-6 underline">Meeting record</a>
  </p>
</li>
