---
/** A member's official portrait.
 *
 * Source framing varies a lot, so the crop is biased upward rather than
 * centred: headshots put the head high, and centring cut faces off in a
 * grid. Where the state has no photo on file, a neutral silhouette stands
 * in. It is drawn inline rather than loaded, so it costs no request and
 * takes the site's own palette instead of a generic grey.
 *
 * Sized explicitly so the layout never shifts while an image loads.
 */
interface Props {
  src?: string | null;
  name: string;
  size?: number;
  className?: string;
}
const { src, name, size = 48, className = "" } = Astro.props;
const dim = `${size}px`;
// clipPath ids must be unique in a document, so derive one per member
const uid = `pc-${name.replace(/[^a-z0-9]/gi, "").toLowerCase()}-${size}`;
---
{src ? (
  <img
    src={src}
    alt=""
    width={size}
    height={size}
    loading="lazy"
    decoding="async"
    class={`shrink-0 rounded-full border border-navy-100 bg-navy-50 object-cover object-[50%_25%] ${className}`}
    style={`width:${dim};height:${dim}`}
  />
) : (
  <svg
    viewBox="0 0 48 48"
    width={size}
    height={size}
    class={`shrink-0 rounded-full border border-navy-100 ${className}`}
    style={`width:${dim};height:${dim}`}
    role="img"
    aria-label={`No official portrait on file for ${name}`}
  >
    <circle cx="24" cy="24" r="24" fill="var(--color-navy-50)" />
    {/* head and shoulders, clipped so the shoulders meet the circle's edge */}
    <clipPath id={uid}><circle cx="24" cy="24" r="24" /></clipPath>
    <g clip-path={`url(#${uid})`} fill="var(--color-navy-300)">
      <circle cx="24" cy="19" r="7.5" />
      <rect x="10" y="30.5" width="28" height="24" rx="12" />
    </g>
  </svg>
)}
