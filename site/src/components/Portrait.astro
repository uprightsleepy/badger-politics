---
/** A member's official portrait, or their initials when the state has no
 * photo on file. Sized explicitly so the surrounding layout never shifts
 * while the image loads. */
interface Props {
  src?: string | null;
  name: string;
  size?: number;
  className?: string;
}
const { src, name, size = 48, className = "" } = Astro.props;
const initials = name
  .split(/\s+/)
  .filter((w) => /^[A-Za-z]/.test(w))
  .slice(0, 2)
  .map((w) => w[0].toUpperCase())
  .join("");
const dim = `${size}px`;
---
{src ? (
  <img
    src={src}
    alt=""
    width={size}
    height={size}
    loading="lazy"
    decoding="async"
    class={`shrink-0 rounded-full border border-navy-100 bg-navy-50 object-cover object-[50%_25%] ${className}`}
    style={`width:${dim};height:${dim}`}
  />
) : (
  <span
    class={`inline-flex shrink-0 items-center justify-center rounded-full border border-navy-100 bg-navy-50 font-bold text-navy-600 ${className}`}
    style={`width:${dim};height:${dim};font-size:${Math.round(size * 0.36)}px`}
    aria-hidden="true"
  >{initials}</span>
)}
