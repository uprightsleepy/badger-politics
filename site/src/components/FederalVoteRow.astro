---
/** One roll call in a member's record: the date, how they voted in words,
 * what the vote was on, and the outcome, with the chamber's own record
 * and the bill on congress.gov where there is one. */
import type { federalVotesFor } from "../lib/db";
import { fmtDate } from "../lib/format";
import { castWords, documentUrlFragment, ordinal } from "../lib/federal";
import { safeHref } from "../lib/html";

interface Props {
  v: ReturnType<typeof federalVotesFor>[number];
}
const { v } = Astro.props;
const documentPath = v.document ? documentUrlFragment(v.congress, v.document) : null;
const record = safeHref(v.source_url);
const subject = v.title ?? v.question ?? "A roll call";
---
<li class="flex flex-col gap-0.5 border-t border-rule py-3 sm:flex-row sm:gap-5">
  <span class="shrink-0 text-small tabular-nums text-granite sm:w-28 sm:pt-0.5">{fmtDate(v.date)}</span>
  <div class="min-w-0 flex-1 [overflow-wrap:anywhere]">
    <p><span class="font-bold">{castWords(v.vote_cast)}</span> on {subject}{v.document && (
      documentPath
        ? <> (<a href={`https://www.congress.gov/bill/${ordinal(v.congress)}-congress/${documentPath}`} class="underline">{v.document}</a>)</>
        : ` (${v.document})`
    )}.</p>
    <p class="text-small text-granite">
      {v.title && v.question && `${v.question}. `}{v.result ? `${v.result}, ` : ""}{v.yeas} to {v.nays}.
      {record && <>{" "}<a href={record} class="underline">The official record<span class="sr-only"> of the {fmtDate(v.date)} vote</span></a></>}
    </p>
  </div>
</li>
