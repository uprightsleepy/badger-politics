---
/** Proportional bill flows, rendered as static SVG with a phone-friendly text view. */
interface Props {
  flow: {
    introduced: number; enacted: number; vetoed: number; died: number;
    noHearing: number; passedBoth: number; heard: number; moving: number;
  };
  session: string;
}
const { flow, session } = Astro.props;
const num = (n: number) => n.toLocaleString();
const share = (n: number) => flow.introduced ? n / flow.introduced * 100 : 0;
const pct = (n: number) => n > 0 && share(n) < 0.1 ? "<0.1" : share(n).toLocaleString(undefined, {
  maximumFractionDigits: 1,
});
const tipFor = (label: string, n: number) => `${label}: ${num(n)} bills, ${pct(n)}% of all introduced`;

const branches = [
  {
    key: "passed", label: "Passed both chambers", n: flow.passedBoth, color: "#2d4a73",
    href: "/governors-desk/",
    leaves: [
      {
        key: "enacted", label: "Became law", n: flow.enacted, color: "#3e7051",
        href: `/bills/${session}/status/enacted/`,
        note: "Passed both chambers and signed by the governor.",
      },
      {
        key: "vetoed", label: "Vetoed by the governor", n: flow.vetoed, color: "#a87a1e",
        href: `/bills/${session}/status/vetoed/`,
        note: "Cleared the legislature, then stopped at the governor's desk.",
      },
    ],
  },
  {
    key: "moving", label: "Still moving", n: flow.moving, color: "#657c98",
    href: `/bills/${session}/`,
    leaves: [
      {
        key: "moving", label: "Still moving", n: flow.moving, color: "#657c98",
        href: `/bills/${session}/`,
        note: "Neither finished nor recorded as failed when this page was built.",
      },
    ],
  },
  {
    key: "died", label: "Died without passing", n: flow.died, color: "#b33a2b",
    href: `/bills/${session}/status/failed_sjr1/`,
    leaves: [
      {
        key: "heard", label: "Heard, then went no further", n: flow.heard, color: "#657c98",
        href: `/bills/${session}/status/failed_sjr1/`,
        note: "Got a public hearing but never finished the trip.",
      },
      {
        key: "nohearing", label: "Never got a public hearing", n: flow.noHearing, color: "#b33a2b",
        href: `/hearing-none/${session}/`,
        note: "Not voted down. Never taken up at all: a committee chair alone decides whether a bill gets heard.",
      },
    ],
  },
].filter((b) => b.n > 0);

const terminals = branches.flatMap((b) => b.leaves.map((l) => ({ ...l, g: b.key })));
const WIDTH = 1000, PAD = 84, GAP = 64, NODE_W = 4;
const X0 = 32, X1 = 360, X2 = 698;
// Every ribbon uses the same scale; spacing never changes a bill count's width.
const scale = flow.introduced ? 224 / flow.introduced : 0;
const h = (n: number) => n * scale;
const gaps = Math.max(0, terminals.length - 1) * GAP;
const HEIGHT = PAD + h(flow.introduced) + gaps + 24;
let cursor = PAD;
const leaves = terminals.map((l) => {
  const node = { ...l, y: cursor, h: h(l.n) };
  cursor += node.h + GAP;
  return node;
});
const nodes = branches.map((b) => {
  const children = leaves.filter((l) => l.g === b.key);
  const first = children[0], last = children[children.length - 1];
  return { ...b, h: h(b.n), y: (first.y + last.y + last.h - h(b.n)) / 2, children };
});
const introTop = PAD + gaps / 2;
const introLabelY = Math.max(64, introTop - 45);
const r2 = (n: number) => Math.round(n * 100) / 100;
const ribbon = (xa: number, ya: number, xb: number, yb: number, height: number) => {
  const bend = (xb - xa) * 0.48;
  return `M${xa} ${r2(ya)}C${xa + bend} ${r2(ya)} ${xb - bend} ${r2(yb)} ${xb} ${r2(yb)}`
    + `v${r2(height)}C${xb - bend} ${r2(yb + height)} ${xa + bend} ${r2(ya + height)} ${xa} ${r2(ya + height)}Z`;
};
let sourceY = introTop;
const ribbons = nodes.flatMap((b) => {
  const incoming = {
    key: b.key, g: b.key, l: "", href: b.href, tip: tipFor(b.label, b.n),
    path: ribbon(X0 + NODE_W, sourceY, X1, b.y, b.h),
    x1: X0 + NODE_W, x2: X1, from: "#657c98", to: b.color,
  };
  sourceY += b.h;
  let branchY = b.y;
  const outgoing = b.children.filter((l) => l.n > 0).map((l) => {
    const path = ribbon(X1 + NODE_W, branchY, X2, l.y, l.h);
    branchY += l.h;
    return {
      key: `${b.key}-${l.key}`, g: b.key, l: l.key, href: l.href,
      tip: tipFor(l.label, l.n), path, x1: X1 + NODE_W, x2: X2, from: b.color, to: l.color,
    };
  });
  return [incoming, ...outgoing];
});
const alt = `Flow of ${num(flow.introduced)} bills: `
  + terminals.map((l) => `${num(l.n)} ${l.label.toLowerCase()}`).join("; ") + ".";
---

<figure class="bf-figure mt-6" data-billflow>
  {flow.introduced > 0 ? (
    <>
      <svg viewBox={`0 0 ${WIDTH} ${HEIGHT}`} class="bf-chart w-full" aria-label={alt}>
        <defs>
          {ribbons.map((r) => (
            <linearGradient id={`bf-${r.key}`} gradientUnits="userSpaceOnUse" x1={r.x1} x2={r.x2}>
              <stop offset="0" stop-color={r.from} stop-opacity="0.12" />
              <stop offset="1" stop-color={r.to} stop-opacity="0.32" />
            </linearGradient>
          ))}
        </defs>
        <g class="bf-headings" aria-hidden="true">
          <text x={X0} y="16">INTRODUCED</text>
          <text x={X1} y="16">LEGISLATURE</text>
          <text x={X2} y="16">OUTCOME</text>
        </g>
        {ribbons.map((r) => (
          <a href={r.href} tabindex="-1" aria-hidden="true" data-g={r.g} data-l={r.l} class="bf-ribbon">
            <path d={r.path} fill={`url(#bf-${r.key})`}><title>{r.tip}</title></path>
          </a>
        ))}
        <rect x={X0} y={r2(introTop)} width={NODE_W} height={r2(h(flow.introduced))} fill="#2d4a73" rx="2" />
        <text x={X0} y={r2(introLabelY - 20)} class="bf-count">{num(flow.introduced)}</text>
        <text x={X0} y={r2(introLabelY)} class="bf-label">bills introduced</text>
        {nodes.map((b) => (
          <a href={b.href} data-g={b.key} class="bf-node" aria-label={tipFor(b.label, b.n)}>
            <rect x={X1} y={r2(b.y)} width={NODE_W} height={r2(b.h)} fill={b.color} rx="2" />
            <text x={X1} y={r2(b.y - 40)} class="bf-count">{num(b.n)}</text>
            <text x={X1} y={r2(b.y - 20)} class="bf-label">{b.label}</text>
          </a>
        ))}
        {leaves.map((l) => (
          <a href={l.href} data-g={l.g} data-l={l.key} class="bf-node" aria-label={tipFor(l.label, l.n)}>
            <rect x={X2} y={r2(l.y)} width={NODE_W} height={r2(l.h)} fill={l.color} rx="2" />
            <text x={X2 + 18} y={r2(l.y + l.h / 2 - 3)} class="bf-count">
              {num(l.n)}<tspan dx="10" class="bf-share">{pct(l.n)}%</tspan>
            </text>
            <text x={X2 + 18} y={r2(l.y + l.h / 2 + 17)} class="bf-label">{l.label}</text>
          </a>
        ))}
      </svg>

      <ul class="bf-outcomes divide-y divide-navy-100">
        {terminals.map((l) => (
          <li>
            <a href={l.href} class="bf-outcome block py-4">
              <span class="flex items-baseline justify-between gap-4">
                <span class="flex items-center gap-2.5 text-sm font-medium">
                  <span class="h-2 w-2 shrink-0 rounded-full" style={`background:${l.color}`} aria-hidden="true"></span>
                  {l.label}
                </span>
                <span class="text-lg font-semibold tabular-nums">{num(l.n)}</span>
              </span>
              <span class="mt-2 block h-1 w-full overflow-hidden rounded-full bg-navy-50" aria-hidden="true">
                <span class="block h-full rounded-full" style={`width:${share(l.n)}%;background:${l.color}`}></span>
              </span>
              <span class="mt-2 block text-xs leading-relaxed text-navy-600">{pct(l.n)}% of all bills. {l.note}</span>
            </a>
          </li>
        ))}
      </ul>
    </>
  ) : <p class="text-sm text-navy-600">No bills recorded for this session yet.</p>}
</figure>

<style>
  .bf-figure { container-type: inline-size; }
  .bf-chart { display: none; }
  @container (min-width: 840px) {
    .bf-chart { display: block; }
    .bf-outcomes { display: none; }
  }
  .bf-headings { fill: var(--color-navy-600); font-size: 10px; font-weight: 600; letter-spacing: 1.6px; }
  .bf-count { fill: var(--color-ink); font-size: 22px; font-weight: 600; font-variant-numeric: tabular-nums; }
  .bf-share { fill: var(--color-navy-600); font-size: 13px; font-weight: 400; }
  .bf-label { fill: var(--color-navy-700); font-size: 15px; }
  .bf-ribbon { transition: opacity 0.2s ease; }
  .bf-chart.bf-focus .bf-ribbon:not(.bf-hot) { opacity: 0.2; }
  .bf-node:hover .bf-label, .bf-node:focus-visible .bf-label, .bf-outcome:hover { text-decoration: underline; }
  .bf-node:focus-visible { outline: 2px solid var(--color-navy-700); outline-offset: 5px; }
  @media (prefers-reduced-motion: reduce) {
    .bf-ribbon { transition: none; }
  }
  @media (forced-colors: active) {
    .bf-chart { display: none; }
    .bf-outcomes { display: block; }
  }
</style>

<script>
  for (const figure of document.querySelectorAll<HTMLElement>("[data-billflow]")) {
    const svg = figure.querySelector("svg");
    if (!svg) continue;
    const emphasize = (target: EventTarget | null) => {
      const node = target instanceof Element ? target.closest<SVGElement>("[data-g]") : null;
      svg.classList.toggle("bf-focus", !!node);
      for (const ribbon of svg.querySelectorAll<SVGElement>(".bf-ribbon")) {
        const sameBranch = ribbon.dataset.g === node?.dataset.g;
        const sameLeaf = !node?.dataset.l || !ribbon.dataset.l || ribbon.dataset.l === node.dataset.l;
        ribbon.classList.toggle("bf-hot", sameBranch && sameLeaf);
      }
    };
    figure.addEventListener("pointerover", (event) => emphasize(event.target));
    figure.addEventListener("pointerleave", () => emphasize(figure.contains(document.activeElement) ? document.activeElement : null));
    figure.addEventListener("focusin", (event) => emphasize(event.target));
    figure.addEventListener("focusout", (event) => emphasize(event.relatedTarget));
  }
</script>
