---
// Hide filtered rows without removing them from the page or search index.
interface Props {
  id: string;
  statusId: string;
  label: string;
  placeholder: string;
  facetAttr?: string;
  facetLabel?: string;
  facets?: { key: string; label: string; count: number }[];
  /** Redesigned pages (Base layout="wide"): a visible label and brand
   * controls, in the page flow rather than pinned over the list. */
  wide?: boolean;
}
const { id, statusId, label, placeholder, facetAttr, facetLabel, facets, wide = false } = Astro.props;
const chips = facets?.filter((f) => f.count > 0) ?? [];
const total = chips.reduce((sum, f) => sum + f.count, 0);
const CHIP = "min-h-11 max-w-full rounded-full border px-3 py-2 text-sm font-semibold";
---
<div
  class:list={[
    wide
      ? "py-3"
      : "sticky top-0 z-20 -mx-4 border-b border-navy-100 bg-paper/95 px-4 py-3 backdrop-blur",
  ]}
  data-pagefind-ignore
>
  <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
    <label class={wide ? "basis-full text-small font-bold" : "sr-only"} for={id}>{label}</label>
    <input
      type="search"
      id={id}
      placeholder={placeholder}
      class={wide
        ? "min-h-12 min-w-0 max-w-full flex-1 rounded-[0.625rem] border-2 border-edge bg-white px-3 text-body focus:border-lake sm:max-w-[min(28rem,100%)] sm:flex-none sm:basis-96 lg:min-h-11"
        : "min-h-11 min-w-0 flex-1 rounded-lg border border-navy-100 bg-white px-3 py-2 text-sm sm:max-w-md sm:flex-none sm:basis-96"}
    />
    <p id={statusId} role="status" class={wide ? "min-w-0 max-w-full text-small text-granite" : "shrink-0 text-sm text-navy-600"}></p>
    <button type="button" data-filter-clear={id} class={wide ? "hidden min-h-11 px-2 text-small font-bold text-lake underline" : "hidden min-h-11 px-2 text-sm font-semibold underline"}>Clear filters</button>
  </div>
  {chips.length > 1 && (
    <div class={wide ? "mt-3 flex flex-wrap gap-2" : "mt-2 flex flex-wrap gap-1.5"} role="group" aria-label={facetLabel}>
      <button
        type="button"
        data-facet=""
        data-facet-for={facetAttr}
        aria-pressed="true"
        class={wide ? "chip" : `${CHIP} border-navy-800 bg-navy-800 text-white`}
      >
        All {wide ? <span class="figure">{total.toLocaleString()}</span> : total.toLocaleString()}
      </button>
      {chips.map((f) => (
        <button
          type="button"
          data-facet={f.key}
          data-facet-for={facetAttr}
          aria-pressed="false"
          class={wide ? "chip" : `${CHIP} border-navy-100 bg-white`}
        >
          {f.label} {wide ? <span class="figure">{f.count.toLocaleString()}</span> : f.count.toLocaleString()}
        </button>
      ))}
    </div>
  )}
  <slot />
</div>
