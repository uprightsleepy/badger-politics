---
// Hide filtered rows without removing them from the page or search index.
interface Props {
  id: string;
  statusId: string;
  label: string;
  placeholder: string;
  facetAttr?: string;
  facetLabel?: string;
  facets?: { key: string; label: string; count: number }[];
}
const { id, statusId, label, placeholder, facetAttr, facetLabel, facets } = Astro.props;
const chips = facets?.filter((f) => f.count > 0) ?? [];
const total = chips.reduce((sum, f) => sum + f.count, 0);
const CHIP = "min-h-11 max-w-full rounded-full border px-3 py-2 text-sm font-semibold";
---
<div
  class="sticky top-0 z-20 -mx-4 border-b border-navy-100 bg-paper/95 px-4 py-3 backdrop-blur"
  data-pagefind-ignore
>
  <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
    <label class="sr-only" for={id}>{label}</label>
    <input
      type="search"
      id={id}
      placeholder={placeholder}
      class="min-h-11 min-w-0 flex-1 rounded-lg border border-navy-100 bg-white px-3 py-2 text-sm sm:max-w-md sm:flex-none sm:basis-96"
    />
    <p id={statusId} role="status" class="shrink-0 text-sm text-navy-600"></p>
    <button type="button" data-filter-clear={id} class="hidden min-h-11 px-2 text-sm font-semibold underline">Clear filters</button>
  </div>
  {chips.length > 1 && (
    <div class="mt-2 flex flex-wrap gap-1.5" role="group" aria-label={facetLabel}>
      <button
        type="button"
        data-facet=""
        data-facet-for={facetAttr}
        aria-pressed="true"
        class={`${CHIP} border-navy-800 bg-navy-800 text-white`}
      >
        All {total.toLocaleString()}
      </button>
      {chips.map((f) => (
        <button
          type="button"
          data-facet={f.key}
          data-facet-for={facetAttr}
          aria-pressed="false"
          class={`${CHIP} border-navy-100 bg-white`}
        >
          {f.label} {f.count.toLocaleString()}
        </button>
      ))}
    </div>
  )}
  <slot />
</div>
