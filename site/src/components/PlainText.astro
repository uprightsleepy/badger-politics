---
/** One plain sentence (or a few) where [[term-id|words]] marks a term of
 * art. Each marked term becomes a dotted-underlined button that opens its
 * definition; the definitions themselves are rendered once per page by
 * TermPopovers. Punctuation right after a term stays on its line (a word
 * joiner forbids the break), while a long term can still wrap inside its
 * own box at large text sizes. */
import { termRuns } from "../lib/billStory";
interface Props {
  text: string;
}
const { text } = Astro.props;
const runs = termRuns(text);
const parts: { term?: string; text: string; tail?: string }[] = [];
for (let i = 0; i < runs.length; i++) {
  const run = runs[i];
  if (!("term" in run)) {
    parts.push({ text: run.text });
    continue;
  }
  const next = runs[i + 1];
  const tail = next && !("term" in next) ? /^[.,;:!?”’)\]]+/.exec(next.text)?.[0] : undefined;
  if (tail && next) {
    runs[i + 1] = { text: next.text.slice(tail.length) };
  }
  parts.push({ term: run.term, text: run.text, tail });
}
---
{parts.map((part) =>
  part.term ? (
    <><button type="button" class="term" popovertarget={`term-${part.term}`}>{part.text}</button>{part.tail && `\u2060${part.tail}`}</>
  ) : (
    part.text
  ),
)}
