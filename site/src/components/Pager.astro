---
/** Crawlable pagination. Ordinary <a href> links, because crawlers do not
 * click filter chips or "load more" buttons, and because a page that needs
 * JavaScript to reach its own second page is not much of a public record.
 * Page 2+ are self-canonical: they hold different bills, so pointing them
 * at page 1 would tell search engines those bills do not exist. */
interface Props {
  page: number;
  pages: number;
  /** Given a page number, the path for it. Page 1 is usually the bare URL. */
  href: (page: number) => string;
  label: string;
}
const { page, pages, href, label } = Astro.props;

// first, last, and a window around the current page — enough to navigate
// without printing eighty links on a long session
const window = new Set<number>([1, pages, page - 1, page, page + 1]);
const shown = [...window].filter((n) => n >= 1 && n <= pages).sort((a, b) => a - b);
const LINK =
  "inline-flex min-h-11 min-w-11 items-center justify-center rounded-[0.625rem] border-2 border-edge bg-white px-3 font-display font-bold text-spruce no-underline hover:border-spruce";
---
{pages > 1 && (
  <nav class="mt-6 flex flex-wrap items-center gap-2 text-small" aria-label={label}>
    {page > 1 && (
      <a class={LINK} rel="prev" href={href(page - 1)}>Previous</a>
    )}
    {shown.map((n, i) => (
      <>
        {i > 0 && shown[i - 1] !== n - 1 && <span class="px-1 text-granite">…</span>}
        {n === page ? (
          <span class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-[0.625rem] border-2 border-spruce bg-spruce px-3 font-display font-bold text-white" aria-current="page">
            <span class="sr-only">Page </span>{n}
          </span>
        ) : (
          <a class={LINK} href={href(n)}><span class="sr-only">Page </span>{n}</a>
        )}
      </>
    ))}
    {page < pages && (
      <a class={LINK} rel="next" href={href(page + 1)}>Next</a>
    )}
  </nav>
)}
