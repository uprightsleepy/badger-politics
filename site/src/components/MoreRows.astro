---
/** A list whose first rows are in view and the rest one tap away, in the
 * same order; every row stays in the page and the search index. The
 * caller passes the first rows as the default slot and the rest in the
 * "rest" slot, already rendered as <li> rows. */
interface Props {
  /** How many rows are in the "rest" slot. */
  rest: number;
  /** Names the list for the "show more" control, e.g. "vetoed bills". */
  label: string;
  ordered?: boolean;
}
const { rest, label, ordered = false } = Astro.props;
const List = ordered ? "ol" : "ul";
---
<div>
  <List class="border-b border-rule" role="list"><slot /></List>
  {rest > 0 && (
    <details class="group">
      <summary class="inline-flex min-h-11 cursor-pointer list-none items-center font-display font-bold text-lake underline underline-offset-4 [&::-webkit-details-marker]:hidden">
        <span class="group-open:hidden">Show {rest.toLocaleString()} more<span class="sr-only"> {label}</span></span>
        <span class="hidden group-open:inline">Show fewer<span class="sr-only"> {label}</span></span>
      </summary>
      <List class="border-b border-rule" role="list"><slot name="rest" /></List>
    </details>
  )}
</div>
