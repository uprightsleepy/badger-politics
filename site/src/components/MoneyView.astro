---
import OrgLogo from "./OrgLogo.astro";
import PartyChip from "./PartyChip.astro";
import MaybeLink from "./MaybeLink.astro";
import RankedRow from "./RankedRow.astro";
import ScrollPanel from "./ScrollPanel.astro";
import { fmtMoney, personSlug, roleAbbr } from "../lib/format";
import { hasDonorPage } from "../lib/db";
import type { moneyOverview } from "../lib/db";

interface Props {
  m: ReturnType<typeof moneyOverview>;
  cycle?: string;
}
const { m, cycle } = Astro.props;
const pctIndividual = m.total ? Math.round((m.individualTotal / m.total) * 100) : 0;
const pctSmall = m.individualTotal ? Math.round((m.smallDollarTotal / m.individualTotal) * 100) : 0;
const donorHref = (entityId: number) =>
  hasDonorPage(entityId) ? `/money/committees/${entityId}/` : null;
const scope = cycle
  ? `receipts to today's members during the ${cycle} cycle, while in office`
  : "receipts since each member took office";

// Where the money came from, as shares of one bar. "Other" is whatever the
// filings classify as neither an individual nor a registered committee
// (businesses, the candidate themselves, and so on) and is derived rather
// than queried, so the three always sum to the total shown above.
const otherTotal = Math.max(0, m.total - m.individualTotal - m.committeeTotal);
const share = (n: number) => (m.total ? (n / m.total) * 100 : 0);
const composition = [
  { label: "Individuals", amount: m.individualTotal, tone: "bg-navy-600" },
  { label: "Committees and PACs", amount: m.committeeTotal, tone: "bg-moss-600" },
  { label: "Other sources", amount: otherTotal, tone: "bg-gold-500" },
].filter((c) => c.amount > 0);
---

{m.total > 0 && (
  <section class="mt-4 rounded-lg border border-navy-100 bg-white p-4">
    <h3 class="font-bold">Where the money came from</h3>
    <div
      class="mt-2 flex h-4 w-full overflow-hidden rounded-full"
      role="img"
      aria-label={composition
        .map((c) => `${c.label} ${Math.round(share(c.amount))}%`)
        .join(", ")}
    >
      {composition.map((c) => (
        <div class={c.tone} style={`width:${share(c.amount)}%`}></div>
      ))}
    </div>
    <ul class="mt-3 grid gap-x-6 gap-y-1 text-sm sm:grid-cols-3">
      {composition.map((c) => (
        <li class="flex items-baseline gap-2">
          <span class={`mt-1 inline-block h-2.5 w-2.5 shrink-0 rounded-full ${c.tone}`} aria-hidden="true"></span>
          <span class="min-w-0 flex-1">
            <span class="font-semibold">{c.label}</span>
            <span class="block text-navy-600">
              {fmtMoney(c.amount)} · {Math.round(share(c.amount))}%
            </span>
          </span>
        </li>
      ))}
    </ul>
  </section>
)}

<div class="mt-4 grid gap-3 sm:grid-cols-3">
  <div class="rounded-lg border border-navy-100 bg-white p-4">
    <p class="text-2xl font-bold">{fmtMoney(m.total)}</p>
    <p class="text-sm text-navy-600">
      raised across {m.n.toLocaleString()} reported receipts{cycle ? ` in the ${cycle} cycle,` : ","} while in office
    </p>
  </div>
  <div class="rounded-lg border border-navy-100 bg-white p-4">
    <p class="text-2xl font-bold">{pctIndividual}%</p>
    <p class="text-sm text-navy-600">
      from individual donors ({fmtMoney(m.individualTotal)}); committees gave {fmtMoney(m.committeeTotal)}
    </p>
  </div>
  <div class="rounded-lg border border-navy-100 bg-white p-4">
    <p class="text-2xl font-bold">{pctSmall}%</p>
    <p class="text-sm text-navy-600">
      of individual money arrived in small receipts (under $200)
    </p>
  </div>
</div>

<div class="mt-6 grid gap-6 lg:grid-cols-2">
  <section class="min-w-0">
    <h2 class="text-xl font-bold">Top contributing committees</h2>
    <p class="mt-1 text-sm text-navy-600">
      PACs, party and other political committees, ranked by {scope}. Wisconsin
      law bars corporations from giving to candidates directly.
    </p>
    <div class="mt-2">
      <ScrollPanel label="Top contributing committees" max="max-h-80" count={m.topCommittees.length}>
        <ol class="space-y-1 p-4 text-sm">
      {m.topCommittees.map((c, i) => (
        <RankedRow rank={i + 1} meta={`${c.recipients} legislator${c.recipients > 1 ? "s" : ""}`} amount={c.total}>
          <OrgLogo entityId={c.entityId} name={c.name} />
          <MaybeLink href={donorHref(c.entityId)} title={c.name}>{c.name}</MaybeLink>
        </RankedRow>
      ))}
    </ol>
      </ScrollPanel>
    </div>
  </section>

  <section class="min-w-0">
    <h2 class="text-xl font-bold">Top fundraising legislators</h2>
    <p class="mt-1 text-sm text-navy-600">
      {cycle
        ? `Each member's ${cycle}-cycle receipts, counted only while in office.`
        : "Each legislator's rolling total since they took office, including any runs for other offices. Long tenure and statewide runs both push members up this list."}
    </p>
    <div class="mt-2">
      <ScrollPanel label="Top fundraising legislators" max="max-h-80" count={m.topLegislators.length}>
        <ol class="space-y-1 p-4 text-sm">
      {m.topLegislators.map((p, i) => (
        <RankedRow rank={i + 1} meta={`${roleAbbr(p.chamber)} ${p.district}`} amount={p.total}>
          <PartyChip party={p.party} size="sm" />
          <MaybeLink href={`/legislators/${personSlug(p.id)}/`}>{p.name}</MaybeLink>
        </RankedRow>
      ))}
    </ol>
      </ScrollPanel>
    </div>
  </section>

  <section class="min-w-0">
    <h2 class="text-xl font-bold">Money by party</h2>
    <p class="mt-1 text-sm text-navy-600">
      Grouped by the recipient's party. Totals follow the person, so a few
      members running for statewide or federal office can dominate their
      party's number. This is not a measure of party strength in
      legislative races.
    </p>
    <ul class="mt-2 space-y-1 rounded-lg border border-navy-100 bg-white p-4 text-sm">
      {m.byParty.map((p) => (
        <RankedRow meta={`${p.legislators} legislator${p.legislators > 1 ? "s" : ""}`} amount={p.total}>
          <PartyChip party={p.party} size="sm" decorative />
          <span class="min-w-0 flex-1 truncate">{p.party ?? "Unknown"}</span>
        </RankedRow>
      ))}
    </ul>
  </section>

  <section class="min-w-0">
    <h2 class="text-xl font-bold">Top occupations of individual donors</h2>
    <p class="mt-1 text-sm text-navy-600">
      As reported by donors on their filings. Blank occupations are left out.
    </p>
    <ol class="mt-2 space-y-1 rounded-lg border border-navy-100 bg-white p-4 text-sm">
      {m.topOccupations.map((o, i) => (
        <RankedRow rank={i + 1} meta={`${o.n.toLocaleString()} receipts`} amount={o.total}>
          <span class="min-w-0 flex-1 truncate">{o.occupation}</span>
        </RankedRow>
      ))}
    </ol>
  </section>

  <section class="min-w-0">
    <h2 class="text-xl font-bold">Widest reach</h2>
    <p class="mt-1 text-sm text-navy-600">
      Committees ranked by how many members they fund, not by dollars.
      Breadth says something totals miss.
    </p>
    <div class="mt-2">
      <ScrollPanel label="Widest reach" max="max-h-80" count={m.widestCommittees.length}>
        <ol class="space-y-1 p-4 text-sm">
      {m.widestCommittees.map((c, i) => (
        <RankedRow rank={i + 1} meta={`${c.recipients} of ${m.sitting}`} amount={c.total}>
          <OrgLogo entityId={c.entityId} name={c.name} />
          <MaybeLink href={donorHref(c.entityId)} title={c.name}>{c.name}</MaybeLink>
        </RankedRow>
      ))}
    </ol>
      </ScrollPanel>
    </div>
  </section>
</div>
