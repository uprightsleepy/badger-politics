---
/** One reporting period of the money overview: where today's legislators'
 * campaign money came from, who gave the most, and who received the most.
 * Rendered inline for the current period and as a fetched fragment for
 * the others (MoneyFilters). */
import MoneyCoverage from "./MoneyCoverage.astro";
import MoneyMix from "./MoneyMix.astro";
import MoneyRows from "./MoneyRows.astro";
import type { moneyViews } from "../lib/money-periods";
import { fmtMoney, partyLetter, partyPlural, partyWord, personSlug, chamberName } from "../lib/format";
import { hasDonorPage } from "../lib/db";
import type { moneyOverview } from "../lib/db";

interface Props {
  m: ReturnType<typeof moneyOverview>;
  view: ReturnType<typeof moneyViews>[number];
  /** Heading level for this view's sections. */
  level?: "h2" | "h3";
}
const { m, view, level = "h2" } = Astro.props;
const H = level;
const headClass = level === "h3" ? "t-question text-[1.1875rem]" : "t-section";
const pctIndividual = m.total ? Math.round((m.individualTotal / m.total) * 100) : 0;
const pctSmall = m.individualTotal ? Math.round((m.smallDollarTotal / m.individualTotal) * 100) : 0;
const donorHref = (entityId: number) =>
  hasDonorPage(entityId) ? `/money/committees/${entityId}/` : null;
const period = view.period.key === "all" ? "across all available history" : `in ${view.period.label.replace(" · Current", "")}`;
const inOffice = view.scope === "office" ? ", while in legislative office" : "";

// Keep signed amounts; refunds can make a source's net receipts negative.
const otherTotal = m.total - m.individualTotal - m.committeeTotal;
const parts = [
  { label: "Individuals", amount: m.individualTotal },
  { label: "Committees and PACs", amount: m.committeeTotal },
  { label: "Other sources", amount: otherTotal },
];
// party totals are only compared when every sitting member's receipts
// are collected (docs/brand.md, "Party totals")
const fullCoverage = m.covered >= m.sitting;
const parties = [...new Set(m.topLegislators.map((p) => p.party).filter(Boolean))].sort() as string[];
const key = parties.map((p) => `${partyLetter(p)}: ${partyWord(p)}`).join(". ");
const plural = (n: number, one: string, many: string) => `${n.toLocaleString()} ${n === 1 ? one : many}`;
---

<div class="flex flex-col gap-10">
  <section class="flex flex-col gap-4" aria-labelledby={`mix-${view.period.key}-${view.scope}`}>
    <H id={`mix-${view.period.key}-${view.scope}`} class={headClass}>Where the money came from</H>
    {m.n > 0 ? (
      <p class="max-w-[47.5rem] sm:text-lead">
        Today's legislators reported <span class="figure">{fmtMoney(m.total)}</span> in receipts {period}{inOffice},
        across {plural(m.n, "collected record", "collected records")}.
        {m.individualTotal > 0 && (
          <> Individuals gave <span class="figure">{pctIndividual}%</span> of it, and <span class="figure">{pctSmall}%</span> of
          that came in amounts under $200.</>
        )}
      </p>
    ) : null}
    <MoneyCoverage period={view.period} first={m.first} last={m.last} scope={view.scope} />
    {m.n > 0 && <MoneyMix parts={parts} total={m.total} />}
  </section>

  {m.n > 0 && (
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-x-14">
      <section class="min-w-0" aria-labelledby={`top-cmte-${view.period.key}-${view.scope}`}>
        <H id={`top-cmte-${view.period.key}-${view.scope}`} class={headClass}>Committees that gave the most</H>
        <p class="mt-2 text-small text-granite">
          PACs, party and other political committees, by what they gave today's legislators. Wisconsin
          law bars corporations from giving to candidates directly.
        </p>
        <div class="mt-4">
          <MoneyRows
            label="committees that gave the most"
            rows={m.topCommittees.map((c) => ({
              name: c.name, href: donorHref(c.entityId), logoId: c.entityId,
              meta: `To ${plural(c.recipients, "legislator", "legislators")}`, amount: c.total,
            }))}
          />
        </div>
      </section>

      <section class="min-w-0" aria-labelledby={`top-leg-${view.period.key}-${view.scope}`}>
        <H id={`top-leg-${view.period.key}-${view.scope}`} class={headClass}>Legislators who received the most</H>
        <p class="mt-2 text-small text-granite">
          Receipts in this period{view.scope === "office" ? ", during recorded legislative service" : ", including before taking office"}.
          Totals can include runs for other offices.{key && ` ${key}.`}
        </p>
        <div class="mt-4">
          <MoneyRows
            label="legislators who received the most"
            rows={m.topLegislators.map((p) => ({
              name: p.name, href: `/legislators/${personSlug(p.id)}/`,
              suffix: p.party ? ` (${partyLetter(p.party)})` : "",
              meta: p.district != null ? `${chamberName(p.chamber)} District ${p.district}` : undefined,
              amount: p.total,
            }))}
          />
        </div>
      </section>

      <section class="min-w-0" aria-labelledby={`reach-${view.period.key}-${view.scope}`}>
        <H id={`reach-${view.period.key}-${view.scope}`} class={headClass}>Committees that gave to the most legislators</H>
        <p class="mt-2 text-small text-granite">
          Ranked by how many of the {m.sitting.toLocaleString()} sitting legislators they gave to, not by dollars.
        </p>
        <div class="mt-4">
          <MoneyRows
            label="committees that gave to the most legislators"
            rows={m.widestCommittees.map((c) => ({
              name: c.name, href: donorHref(c.entityId), logoId: c.entityId,
              meta: `To ${c.recipients.toLocaleString()} of ${m.sitting.toLocaleString()} legislators`, amount: c.total,
            }))}
          />
        </div>
      </section>

      <section class="min-w-0" aria-labelledby={`occ-${view.period.key}-${view.scope}`}>
        <H id={`occ-${view.period.key}-${view.scope}`} class={headClass}>What individual donors do for a living</H>
        <p class="mt-2 text-small text-granite">
          As donors reported it on their filings. Blank occupations are left out.
        </p>
        <div class="mt-4">
          <MoneyRows
            label="donor occupations"
            rows={m.topOccupations.map((o) => ({
              name: o.occupation, meta: plural(o.n, "receipt", "receipts"), amount: o.total,
            }))}
          />
        </div>
      </section>

      {fullCoverage && m.byParty.length > 0 && (
        <section class="min-w-0" aria-labelledby={`party-${view.period.key}-${view.scope}`}>
          <H id={`party-${view.period.key}-${view.scope}`} class={headClass}>Receipts by the legislator's party</H>
          <p class="mt-2 text-small text-granite">
            Totals follow the person, so a few members running for statewide or federal office can
            dominate their party's number. This isn't a measure of party strength in legislative races.
          </p>
          <div class="mt-4">
            <MoneyRows
              label="receipts by party"
              ranked={false}
              rows={m.byParty.map((p) => ({
                name: p.party ? partyPlural(p.party) : "Party not recorded",
                meta: plural(p.legislators, "legislator", "legislators"), amount: p.total,
              }))}
            />
          </div>
        </section>
      )}
    </div>
  )}
</div>
