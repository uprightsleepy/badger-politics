---
/** "Terms on this page": every term of art the page used, defined in one
 * plain sentence, with the official term and a link to the glossary. The
 * dotted terms in the text open the same definitions as popovers (see
 * TermPopovers); browsers without popover support still have this list. */
import { TERMS, type TermId } from "../lib/glossary";
interface Props {
  terms: TermId[];
  headingLevel?: "h2" | "h3";
  /** Unique per page when the list is rendered in two places. */
  headingId?: string;
}
const { terms, headingLevel = "h2", headingId = "terms-heading" } = Astro.props;
const Heading = headingLevel;
const unique = [...new Set(terms)];
---
{unique.length > 0 && (
  <section aria-labelledby={headingId} data-pagefind-ignore>
    <Heading id={headingId} class="t-label mb-1.5 text-[1.1875rem]">Terms on this page</Heading>
    <div class="border-b border-rule">
      {unique.map((id, i) => {
        const t = TERMS[id];
        return (
          <details class="group border-t border-rule py-1" open={i === 0}>
            <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-3 font-display font-bold [&::-webkit-details-marker]:hidden">
              {t.label}
              <span aria-hidden="true" class="text-xl leading-none text-granite group-open:hidden">+</span>
              <span aria-hidden="true" class="hidden text-xl leading-none text-granite group-open:inline">–</span>
            </summary>
            <p class="text-small">{t.short}</p>
            <p class="mt-1 pb-2 text-fine text-granite">
              {"official" in t && t.official && <>Official term: {t.official}. </>}
              <a href={`/glossary/#${t.glossary}`} class="underline">More in the glossary</a>
            </p>
          </details>
        );
      })}
    </div>
  </section>
)}
