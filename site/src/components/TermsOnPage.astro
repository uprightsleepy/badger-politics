---
/** "Terms on this page": every term of art the page used, defined in one
 * plain sentence, with the official term and a link to the glossary.
 * Also renders each definition once as a native popover, which the dotted
 * terms in the text open. No script: browsers without popover support
 * still have this list. */
import { TERMS, type TermId } from "../lib/glossary";
interface Props {
  terms: TermId[];
  headingLevel?: "h2" | "h3";
}
const { terms, headingLevel = "h2" } = Astro.props;
const Heading = headingLevel;
const unique = [...new Set(terms)];
---
{unique.length > 0 && (
  <section aria-labelledby="terms-heading" data-pagefind-ignore>
    <Heading id="terms-heading" class="t-label mb-1.5 text-[1.1875rem]">Terms on this page</Heading>
    <div class="border-b border-rule">
      {unique.map((id, i) => {
        const t = TERMS[id];
        return (
          <details class="group border-t border-rule py-3" open={i === 0}>
            <summary class="flex min-h-7 cursor-pointer list-none items-center justify-between gap-3 font-display font-bold [&::-webkit-details-marker]:hidden">
              {t.label}
              <span aria-hidden="true" class="text-xl leading-none text-granite group-open:hidden">+</span>
              <span aria-hidden="true" class="hidden text-xl leading-none text-granite group-open:inline">–</span>
            </summary>
            <p class="mt-1.5 text-small">{t.short}</p>
            <p class="mt-1 text-fine text-granite">
              {"official" in t && t.official && <>Official term: {t.official}. </>}
              <a href={`/glossary/#${t.glossary}`} class="underline">More in the glossary</a>
            </p>
          </details>
        );
      })}
    </div>
  </section>
)}
{unique.map((id) => {
  const t = TERMS[id];
  return (
    <div id={`term-${id}`} popover class="term-pop" data-pagefind-ignore>
      <p class="t-question">{t.label}</p>
      <p class="mt-1.5">{t.short}</p>
      {"official" in t && t.official && <p class="mt-1.5 text-small text-granite">Official term: {t.official}</p>}
      <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
        <a href={`/glossary/#${t.glossary}`} class="underline">More in the glossary</a>
        <button type="button" class="btn btn-secondary" popovertarget={`term-${id}`} popovertargetaction="hide">Close</button>
      </div>
    </div>
  );
})}
