---
/** The contributing-committee list for one period view: coverage line
 * plus one filterable row per donor page. Shared by the committees index
 * (default view inline) and its on-demand fragments. */
import MoneyCoverage from "./MoneyCoverage.astro";
import OrgLogo from "./OrgLogo.astro";
import { donorCommitteesFor, cfTypeOf } from "../lib/db";
import { fmtMoney } from "../lib/format";
import type { moneyViews } from "../lib/money-periods";
interface Props { view: ReturnType<typeof moneyViews>[number]; unknownType: string }
const { view, unknownType } = Astro.props;
const selected = donorCommitteesFor(view.bounds);
const dates = selected.flatMap((c) => [c.first, c.last]).filter(Boolean).sort();
---
<MoneyCoverage period={view.period} first={dates[0] ?? null} last={dates.at(-1) ?? null} scope={view.scope} />
<ul class="mt-4 divide-y divide-navy-100 rounded-lg border border-navy-100 bg-white text-sm">
  {selected.map((c) => (
    <li data-committee-row data-ctype={cfTypeOf(c.entityId) ?? unknownType} data-text={c.name.toLowerCase()}>
      <a href={`/money/committees/${c.entityId}/`} class="flex items-center gap-3 px-4 py-2 hover:bg-navy-50">
        <OrgLogo entityId={c.entityId} name={c.name} />
        <span class="min-w-0 flex-1 truncate underline">{c.name}</span>
        {cfTypeOf(c.entityId) && (
          <span class="hidden shrink-0 rounded-full bg-navy-50 px-2 py-0.5 text-xs text-navy-700 sm:inline">
            {cfTypeOf(c.entityId)}
          </span>
        )}
        <span class="sr-only shrink-0 text-xs text-navy-600 sm:not-sr-only sm:inline">
          {c.recipients} legislator{c.recipients > 1 ? "s" : ""}
        </span>
        <span class="w-24 shrink-0 text-right font-semibold">{fmtMoney(c.total)}</span>
      </a>
    </li>
  ))}
</ul>
