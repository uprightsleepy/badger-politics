---
/** The contributing-committee list for one period view: coverage line
 * plus one filterable row per donor page. Shared by the committees index
 * (default view inline) and its on-demand fragments. */
import MoneyCoverage from "./MoneyCoverage.astro";
import OrgLogo from "./OrgLogo.astro";
import { donorCommitteesFor, cfTypeOf } from "../lib/db";
import { fmtMoney } from "../lib/format";
import type { moneyViews } from "../lib/money-periods";
interface Props { view: ReturnType<typeof moneyViews>[number]; unknownType: string }
const { view, unknownType } = Astro.props;
const selected = donorCommitteesFor(view.bounds);
const dates = selected.flatMap((c) => [c.first, c.last]).filter(Boolean).sort();
---
<MoneyCoverage period={view.period} first={dates[0] ?? null} last={dates.at(-1) ?? null} scope={view.scope} />
<ul class="mt-4 border-b border-rule" role="list">
  {selected.map((c) => (
    <li
      class="flex items-start gap-3 border-t border-rule py-3"
      data-committee-row
      data-ctype={cfTypeOf(c.entityId) ?? unknownType}
      data-text={c.name.toLowerCase()}
    >
      <span class="pt-1"><OrgLogo entityId={c.entityId} name={c.name} /></span>
      <span class="min-w-0 flex-1 [overflow-wrap:anywhere]">
        <a href={`/money/committees/${c.entityId}/`} class="underline">{c.name}</a>
        <span class="block text-small text-granite">
          {[cfTypeOf(c.entityId), `To ${c.recipients.toLocaleString()} ${c.recipients === 1 ? "legislator" : "legislators"}`].filter(Boolean).join(". ")}
        </span>
      </span>
      <span class="shrink-0 font-display font-bold tabular-nums">{fmtMoney(c.total)}</span>
    </li>
  ))}
</ul>
