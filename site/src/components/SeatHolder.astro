---
/** Who holds a seat, for dense seat lists: the name as a link to their
 * page and the party as a letter, which the list keys on the same screen. */
import type { Person } from "../lib/db";
import { partyLetter, personSlug } from "../lib/format";
interface Props { holder?: Person }
const { holder } = Astro.props;
---
{holder ? (
  <><a href={`/legislators/${personSlug(holder.id)}/`} class="underline">{holder.name}</a>{holder.party ? ` (${partyLetter(holder.party)})` : ""}</>
) : (
  <span class="text-granite">Vacant</span>
)}
