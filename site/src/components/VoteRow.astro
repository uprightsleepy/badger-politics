---
/** One row of a legislator's vote history: how they voted, on which bill,
 * on what motion, and when. The vote is a word, never a color. */
import LegiscanCredit from "./LegiscanCredit.astro";
import { fmtDate } from "../lib/format";
interface Props {
  v: {
    option: string; vote_event_id: string; identifier: string;
    motion: string | null; title: string | null; date: string | null;
    source: string | null; source_url: string | null; session_id: string;
  };
}
const { v } = Astro.props;
const word = v.option === "yes" ? "Yes" : v.option === "no" ? "No" : "Didn't vote";
---
<li class="flex flex-wrap items-baseline gap-x-3 gap-y-0.5 border-t border-rule/60 px-1 py-1.5 text-small first:border-t-0">
  <span class="w-[6.5rem] max-w-full shrink-0 font-display font-bold">{word}</span>
  <span class="min-w-0 flex-[1_1_14rem] truncate">
    <a href={`/votes/${v.vote_event_id}/`} class="font-semibold underline">{v.identifier}</a>
    {" "}<span class="text-granite">{v.motion ?? v.title}</span>
  </span>
  <span class="ml-auto shrink-0 text-fine tabular-nums text-granite">{fmtDate(v.date)}</span>
  <LegiscanCredit v={v} class="basis-full" />
</li>
