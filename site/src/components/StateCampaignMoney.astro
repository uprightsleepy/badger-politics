---
/** One state campaign committee's reported spending and receipts for a
 * cycle, shown only once every month of the cycle is collected. */
import type { stateCampaignMoney } from "../lib/db";
import { fmtCents, fmtDate } from "../lib/format";

interface Props {
  campaign: ReturnType<typeof stateCampaignMoney>;
  title?: string;
}
const { campaign: c, title = `${c.office} campaign, ${c.cycle}` } = Astro.props;
// "2026-10" -> "October 2026"
const through = new Date(`${c.end}-01T00:00:00Z`).toLocaleDateString("en-US", { month: "long", year: "numeric", timeZone: "UTC" });
const months = `${c.months.length} ${c.months.length === 1 ? "month" : "months"}`;
---
<article class="flex min-w-0 flex-col gap-4 border-t border-rule pt-4">
  <div>
    <h3 class="t-section text-[1.375rem]">{title}</h3>
    <p class="mt-1 text-small text-granite">{c.committee}, {c.cycle - 1}–{c.cycle}</p>
  </div>
  {!c.totals ? (
    <p>
      <span class="font-bold">Totals aren't ready yet.</span> We've collected {months} of the cycle so far;
      totals appear once every month through {through} is checked. Missing records don't mean nothing was
      raised or spent.
    </p>
  ) : (
    <>
      <dl data-campaign-totals class="flex flex-wrap gap-x-8 gap-y-3">
        <div>
          <dt class="text-small text-granite">Reported spending</dt>
          <dd class="whitespace-nowrap font-display text-[1.5rem] font-bold tabular-nums">{fmtCents(c.totals.spending ?? 0)}</dd>
        </div>
        <div>
          <dt class="text-small text-granite">Reported receipts</dt>
          <dd class="whitespace-nowrap font-display text-[1.5rem] font-bold tabular-nums">{fmtCents(c.totals.receipts ?? 0)}</dd>
        </div>
      </dl>
      <p class="text-small text-granite">
        {c.totals.count.toLocaleString()} transactions collected for {c.cycle - 1}–{c.cycle}.
        {c.totals.first && ` Earliest: ${fmtDate(c.totals.first)}.`}
        {c.totals.last && ` Latest: ${fmtDate(c.totals.last)}.`}
        Includes committee activity before the campaign was announced, and any transfers or other income.
        Some filings or amendments may be missing, and these totals don't show cash on hand.
      </p>
      {c.donors.length > 0 && (
        <details class="group border-t border-rule pt-2">
          <summary class="inline-flex min-h-11 cursor-pointer items-center font-display font-bold text-lake underline">Largest reported sources of receipts</summary>
          <dl class="mt-2 grid grid-cols-[minmax(0,1fr)_auto] gap-x-4 gap-y-2 text-small">
            {c.donors.map((d) => <><dt class="[overflow-wrap:anywhere]">{d.name}</dt><dd class="font-display font-bold tabular-nums">{fmtCents(d.total)}</dd></>)}
          </dl>
        </details>
      )}
    </>
  )}
  <p class="text-small"><a class="underline" href={c.source_url}>The committee's filings at the Ethics Commission</a></p>
</article>
