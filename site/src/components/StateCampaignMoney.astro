---
import type { stateCampaignMoney } from "../lib/db";
import { fmtDate } from "../lib/format";

interface Props {
  campaign: ReturnType<typeof stateCampaignMoney>;
  title?: string;
}
const { campaign: c, title = `${c.office} campaign · ${c.cycle}` } = Astro.props;
const fmtMoney = (value: number) => value.toLocaleString("en-US", {
  style: "currency", currency: "USD", minimumFractionDigits: 2, maximumFractionDigits: 2,
});
---
<article class="min-w-0 rounded-xl border border-navy-100 bg-white p-4 sm:p-5">
  <h3 class="text-lg font-bold">{title}</h3>
  <p class="mt-1 text-sm text-navy-600">{c.committee} · {c.cycle - 1}–{c.cycle}</p>
  {!c.totals ? <p class="mt-4 rounded-lg bg-gold-100 p-3 text-sm">
    <strong>Spending not yet available.</strong> Collection is incomplete ({c.months.length} months collected).
    Totals will appear after every month through {c.end} is verified. Missing records do not mean zero spending or receipts.
  </p> : <>
    <dl data-campaign-totals class="mt-4 flex flex-wrap gap-4">
      <div class="flex-auto"><dt class="text-sm text-navy-600">Reported spending</dt>
        <dd class="mt-1 whitespace-nowrap text-xl font-bold tabular-nums sm:text-2xl">{fmtMoney(c.totals.spending ?? 0)}</dd></div>
      <div class="flex-auto"><dt class="text-sm text-navy-600">Reported receipts</dt>
        <dd class="mt-1 whitespace-nowrap text-xl font-bold tabular-nums sm:text-2xl">{fmtMoney(c.totals.receipts ?? 0)}</dd></div>
    </dl>
    <p class="mt-3 text-sm text-navy-600">
      {c.totals.count.toLocaleString()} transactions collected for {c.start}–{c.end}.
      {c.totals.last && ` Latest reported transaction: ${fmtDate(c.totals.last)}.`}
      Includes committee activity before the campaign announcement and any transfers or other income.
      These totals do not establish cash on hand.
    </p>
    {c.donors.length > 0 && <details class="mt-3 text-sm">
      <summary class="cursor-pointer py-1 font-semibold">Largest reported sources of receipts</summary>
      <dl class="mt-2 grid grid-cols-[minmax(0,1fr)_auto] gap-x-4 gap-y-2">
        {c.donors.map((d) => <><dt class="break-words">{d.name}</dt><dd class="tabular-nums">{fmtMoney(d.total)}</dd></>)}
      </dl>
    </details>}
  </>}
  <p class="mt-3 text-sm"><a class="inline-block min-h-6 leading-6 underline" href={c.source_url}>Committee filings and transactions at CFIS ↗</a></p>
</article>
