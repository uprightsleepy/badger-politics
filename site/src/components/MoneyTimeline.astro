---
/** Quarterly fundraising bars since taking office, rendered as static
 * SVG at build time. Bar width adapts to the span so the drawing keeps
 * its aspect ratio; a tick marks election quarters alongside the gold
 * fill, and a details table carries the per-quarter numbers for
 * keyboard, touch, and screen reader use. */
import { fmtMoney, monthYear } from "../lib/format";

interface Props {
  quarters: { q: string; total: number }[];
  entry: string;
}
const { quarters, entry } = Astro.props;

const byQ = new Map(quarters.map((d) => [d.q, d.total]));
const startYear = Number(entry.slice(0, 4));
const startQ = Math.floor((Number(entry.slice(5, 7)) + 2) / 3);
const last = quarters[quarters.length - 1]?.q ?? `${startYear}-Q${startQ}`;
const endYear = Number(last.slice(0, 4));
const endQ = Number(last.slice(6));

const series: { q: string; year: number; qn: number; total: number }[] = [];
for (let y = startYear; y <= endYear; y++) {
  for (let qn = y === startYear ? startQ : 1; qn <= (y === endYear ? endQ : 4); qn++) {
    const q = `${y}-Q${qn}`;
    series.push({ q, year: y, qn, total: byQ.get(q) ?? 0 });
  }
}
const max = Math.max(...series.map((d) => d.total), 1);
const peak = series.reduce((a, b) => (b.total > a.total ? b : a), series[0]);

const GAP = 2, H = 96, PAD_TOP = 6, PAD_BOTTOM = 18;
// aim for a stable drawing width so short careers don't stretch
const BAR = Math.max(3, Math.round(560 / series.length) - GAP);
const width = series.length * (BAR + GAP) + GAP;
const height = H + PAD_TOP + PAD_BOTTOM;
const x = (i: number) => GAP + i * (BAR + GAP);
const barH = (v: number) => Math.max(v > 0 ? 1.5 : 0, (v / max) * H);
const isElectionQ = (d: { year: number; qn: number }) => d.year % 2 === 0 && d.qn === 4;
const label = `Quarterly fundraising since taking office, ${monthYear(entry)}: ${series.length} quarters`;
---

{series.length > 1 && (
  <figure class="mt-3">
    <svg
      viewBox={`0 0 ${width} ${height}`}
      class="w-full max-w-2xl"
      role="img"
      aria-label={label}
    >
      <line x1="0" y1={PAD_TOP + H} x2={width} y2={PAD_TOP + H} stroke="#d9e2ee" stroke-width="1" />
      {series.map((d, i) => (
        <>
          <rect
            x={x(i)}
            y={PAD_TOP + H - barH(d.total)}
            width={BAR}
            height={barH(d.total)}
            fill={isElectionQ(d) ? "#a87a1e" : "#2d4a73"}
          />
          {isElectionQ(d) && (
            <rect x={x(i)} y={PAD_TOP + H + 2} width={BAR} height="3" fill="#a87a1e" />
          )}
        </>
      ))}
      {series.map((d, i) =>
        d.qn === 1 && d.year % 2 === 1 ? (
          <text x={x(i)} y={height - 4} font-size="9" fill="#2d4a73">{d.year}</text>
        ) : null,
      )}
    </svg>
    <figcaption class="mt-1 text-xs text-navy-600">
      Receipts by quarter since taking office. Gold bars with a tick under
      them are election quarters; peak {fmtMoney(peak.total)} in {peak.q.replace("-", " ")}.
    </figcaption>
    <details class="mt-1 text-xs text-navy-700">
      <summary class="cursor-pointer text-navy-600">Quarter by quarter</summary>
      <ul class="mt-1 flex flex-wrap gap-x-4 gap-y-0.5">
        {quarters.map((d) => (
          <li>{d.q.replace("-", " ")}: {fmtMoney(d.total)}</li>
        ))}
      </ul>
    </details>
  </figure>
)}
