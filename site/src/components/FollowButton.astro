---
/** Device-only follow toggle; state lives in localStorage. */
interface Props {
  kind: "bills" | "legislators" | "committees" | "districts" | "races";
  id: string;
}
const { kind, id } = Astro.props;
---
<button
  type="button"
  data-follow-kind={kind}
  data-follow-id={id}
  aria-pressed="false"
  class="rounded-full border border-navy-600 bg-white px-3 py-1.5 text-sm font-semibold
         hover:ring-2 hover:ring-navy-600 focus-visible:ring-2 focus-visible:ring-navy-600
         aria-pressed:border-navy-800 aria-pressed:bg-navy-800 aria-pressed:text-white"
>
  Follow
</button>

<script>
  import { isFollowing, toggleFollow } from "../scripts/follows";
  document.querySelectorAll<HTMLButtonElement>("[data-follow-kind]").forEach((btn) => {
    const kind = btn.dataset.followKind as keyof import("../scripts/follows").Follows;
    const id = btn.dataset.followId!;
    const paint = (on: boolean) => {
      btn.setAttribute("aria-pressed", String(on));
      btn.textContent = on ? "Following" : "Follow";
    };
    paint(isFollowing(kind, id));
    btn.addEventListener("click", () => paint(toggleFollow(kind, id)));
  });
</script>
