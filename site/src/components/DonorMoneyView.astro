---
/** One reporting period of a contributing committee's page: what it gave
 * today's legislators and to whom, then its own reported money and any
 * spending for or against candidates. */
import MoneyCoverage from "./MoneyCoverage.astro";
import MoneyRows from "./MoneyRows.astro";
import StanceChip from "./StanceChip.astro";
import { donorCommitteeFor, cfCommitteeFor, moneyCoverage } from "../lib/db";
import { chamberName, fmtMoney, fmtDate, partyLetter, partyPlural, partyWord, personSlug } from "../lib/format";
import type { moneyViews } from "../lib/money-periods";
interface Props { entityId: number; name: string; view: ReturnType<typeof moneyViews>[number]; }
const { entityId, name, view } = Astro.props;
const { recipients, byParty, summary } = donorCommitteeFor(entityId, view.bounds);
const committee = { entityId, name, total: 0, n: 0, recipients: 0, first: null, last: null, ...summary };
const own = cfCommitteeFor(entityId, view.bounds);
// party totals only when every sitting member's receipts are collected
// (docs/brand.md, "Party totals")
const { covered, sitting } = moneyCoverage();
const fullCoverage = covered >= sitting;
// party never orders a list: alphabetical, with no party recorded last
const partySplit = [...byParty].sort((a, b) => (a.party ?? "~").localeCompare(b.party ?? "~"));
const joiner = (i: number, n: number) => (i === 0 ? "" : i < n - 1 ? ", " : n === 2 ? " and " : ", and ");
const parties = [...new Set(recipients.map((r) => r.party).filter(Boolean))].sort() as string[];
const key = parties.map((p) => `${partyLetter(p)}: ${partyWord(p)}`).join(". ");
const period = view.period.key === "all" ? "in all the history we have" : `in ${view.period.label.replace(" · Current", "")}`;
const plural = (n: number, one: string, many: string) => `${n.toLocaleString()} ${n === 1 ? one : many}`;
const uid = `${view.period.key}-${view.scope}`;
---
<div class="flex flex-col gap-10">
  <section class="flex max-w-[47.5rem] flex-col gap-3" aria-labelledby={`gave-${uid}`}>
    <h2 id={`gave-${uid}`} class="t-section">What it gave</h2>
    <p class="sm:text-lead">
      {committee.n > 0
        ? <>It gave <span class="figure">{fmtMoney(committee.total)}</span> to {committee.recipients.toLocaleString()} of today's {sitting.toLocaleString()} legislators {period}{view.scope === "office" ? " while they were in office" : ""}, across {plural(committee.n, "receipt", "receipts")}.</>
        : <>No gifts to today's legislators are recorded {period}.</>}
    </p>
    {committee.n > 0 && (fullCoverage ? partySplit.length > 0 && (
      <p>
        By the legislator's party: {partySplit.map((p, i) => (
          <>{joiner(i, partySplit.length)}<span class="figure">{fmtMoney(p.total)}</span> to {p.party ? partyPlural(p.party) : "legislators with no party recorded"}</>
        ))}.
      </p>
    ) : (
      <p class="text-small text-granite">
        Totals by party appear once we have receipts for all {sitting.toLocaleString()} sitting legislators;
        we have {covered.toLocaleString()} so far.
      </p>
    ))}
    <MoneyCoverage period={view.period} first={committee.first} last={committee.last} scope={view.scope} />
  </section>

  {recipients.length > 0 && (
    <section class="max-w-[47.5rem]" aria-labelledby={`recipients-${uid}`}>
      <h2 id={`recipients-${uid}`} class="t-section">Who received it</h2>
      {key && <p class="mt-2 text-small text-granite">{key}.</p>}
      <div class="mt-3">
        <MoneyRows
          label="recipients"
          rows={recipients.map((r) => ({
            name: r.name, href: `/legislators/${personSlug(r.id)}/`,
            suffix: r.party ? ` (${partyLetter(r.party)})` : "",
            meta: [r.district != null ? `${chamberName(r.chamber)} District ${r.district}` : null, plural(r.n, "receipt", "receipts")].filter(Boolean).join(". "),
            amount: r.total,
          }))}
        />
      </div>
      <p class="mt-3 text-fine text-granite">
        Counts gifts to today's legislators only. A committee's money comes from its own contributors,
        listed under “Its own money” when it files its own reports.
      </p>
    </section>
  )}

  {own && own.n > 0 && (
    <section class="flex flex-col gap-4" aria-labelledby={`own-${uid}`}>
      <h2 id={`own-${uid}`} class="t-section">Its own money</h2>
      <p class="max-w-[47.5rem]">
        In its own reports{own.first && own.last ? `, ${fmtDate(own.first)} to ${fmtDate(own.last)}` : ""}, {name} reported
        {" "}<span class="figure">{fmtMoney(own.raised)}</span> in receipts and <span class="figure">{fmtMoney(own.spent)}</span> in
        spending, across {plural(own.n, "transaction", "transactions")}.
      </p>
      <p class="max-w-[47.5rem] text-small text-granite">
        Contributions under the state's itemization threshold are reported as totals, not by donor, so the
        lists below show its itemized money, never every dollar.
      </p>
      <div class="grid gap-8 lg:grid-cols-2 lg:gap-x-12">
        {own.donors.length > 0 && (
          <div class="min-w-0">
            <h3 class="t-question">Largest itemized donors to it</h3>
            <div class="mt-3">
              <MoneyRows label="largest itemized donors" rows={own.donors.map((d) => ({ name: d.name, meta: d.type ?? undefined, amount: d.total }))} />
            </div>
          </div>
        )}
        {own.payees.length > 0 && (
          <div class="min-w-0">
            <h3 class="t-question">Largest payees</h3>
            <div class="mt-3">
              <MoneyRows label="largest payees" rows={own.payees.map((d) => ({ name: d.name, amount: d.total }))} />
            </div>
          </div>
        )}
      </div>
    </section>
  )}

  {own && own.advocacy.length > 0 && (
    <section class="max-w-[47.5rem]" aria-labelledby={`advocacy-${uid}`}>
      <h2 id={`advocacy-${uid}`} class="t-section">Spending for and against candidates</h2>
      <p class="mt-2 text-small text-granite">
        Money spent on its own to support or oppose a candidate. It never appears in that candidate's
        filings. {plural(own.advocacy.length, "filing", "filings")}.
      </p>
      <ul class="mt-3 border-b border-rule" role="list">
        {own.advocacy.map((a) => (
          <li class="flex flex-wrap items-center gap-x-3 gap-y-1 border-t border-rule py-2.5">
            <span class="w-28 shrink-0 text-small text-granite">{fmtDate(a.date)}</span>
            <StanceChip stance={a.stance} />
            <span class="min-w-0 flex-1">
              {a.related_name ?? "Candidate not named in the filing"}
              {(a.related_office || a.related_district) && (
                <span class="block text-small text-granite">{[a.related_office, a.related_district].filter(Boolean).join(" ")}</span>
              )}
            </span>
            <span class="shrink-0 font-display font-bold tabular-nums">{fmtMoney(a.amount)}</span>
          </li>
        ))}
      </ul>
    </section>
  )}
</div>
