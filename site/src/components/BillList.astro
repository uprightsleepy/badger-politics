---
/** Rows of bills: the number and official title, then where the bill
 * stands, told the way its own page tells it (a small route and the
 * status headline). Shared by the session lists, their status views and
 * the homepage, so every list of bills reads the same.
 *
 * The link is the number and title; the rest of the row is its target
 * too, except the status line, which stays selectable. The route is drawn
 * for sighted readers; the headline beside it says the same thing in
 * words. The status line is left out of the search index: repeated on
 * every row, it would rank whole lists above the bills themselves.
 *
 * The styles are global but scoped under .bill-rows: a scoped style would
 * stamp an attribute on every element of every row. */
import { billSlug, fmtDate, shortTitle } from "../lib/format";
import { rowStory } from "../lib/billRows";
import type { Bill } from "../lib/db";
interface Props {
  bills: Bill[];
  /** Extra classes for the list, such as its top margin. */
  class?: string;
}
const { bills, class: extra = "" } = Astro.props;
---
<ul class:list={["bill-rows border-y border-rule", extra]} role="list">
  {bills.map((b) => {
    const s = rowStory(b);
    const title = shortTitle(b.title);
    return (
      <li
        class="bill-row"
        data-bill-row
        data-status={b.status}
        data-text={`${b.identifier} ${billSlug(b.identifier)} ${b.title ?? ""}`.toLowerCase()}
      >
        <a href={`/bills/${b.session_id}/${billSlug(b.identifier)}/`} class="bill-link">
          <span class="bill-id">{b.identifier}</span>
          {title && <span class="bill-title">{title}</span>}
        </a>
        <p class="bill-state" data-pagefind-ignore>
          <span class="route-mini" aria-hidden="true">
            {s.stops.map((stop) => <i data-s={stop.state}></i>)}
          </span>
          <span class="font-display font-bold">{s.headline}<span class="sr-only">.</span></span>
          {b.latest_action_date && (
            <span class="text-granite">Last action {fmtDate(b.latest_action_date)}</span>
          )}
        </p>
      </li>
    );
  })}
</ul>

<style is:global>
  .bill-rows .bill-row {
    position: relative;
    display: grid;
    gap: 0.375rem;
    padding: 1rem 0;
  }
  /* the row filter hides rows with this class; beat display: grid */
  .bill-rows .bill-row.sorted-hidden {
    display: none;
  }
  .bill-rows .bill-row + .bill-row {
    border-top: 1px solid var(--color-rule);
  }
  .bill-rows .bill-link {
    display: grid;
    gap: 0.125rem;
    color: var(--color-spruce);
    text-decoration: none;
  }
  /* the row is the link's target */
  .bill-rows .bill-link::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .bill-rows .bill-row:hover .bill-title {
    text-decoration: underline;
  }
  .bill-rows .bill-link:focus-visible {
    outline: none;
  }
  .bill-rows .bill-link:focus-visible::after {
    outline: 3px solid var(--color-lake);
    outline-offset: 2px;
    border-radius: 0.25rem;
  }
  .bill-rows .bill-id {
    font: 700 1.0625rem/1.3 var(--font-display);
    color: var(--color-lake);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .bill-rows .bill-title {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
    overflow-wrap: break-word;
  }
  /* above the link's target, so the status can be selected and copied */
  .bill-rows .bill-state {
    position: relative;
    z-index: 1;
    justify-self: start;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.75rem;
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
  }
  @media (min-width: 48rem) {
    .bill-rows .bill-row {
      grid-template-columns: 6rem minmax(0, 1fr);
      column-gap: 1rem;
    }
    .bill-rows .bill-link {
      grid-column: 1 / -1;
      grid-template-columns: subgrid;
    }
    .bill-rows .bill-title {
      -webkit-line-clamp: 2;
      line-clamp: 2;
    }
    .bill-rows .bill-state {
      grid-column: 2;
    }
  }

  /* the small route: Lake road behind, dashed road ahead, a Spruce ring
     where the bill is now. Prairie stays for the reader's own things, so a
     list of bills doesn't light up every row (docs/brand.md, "Bill rows"). */
  .route-mini {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    height: 1.25rem;
  }
  .route-mini i {
    position: relative;
    width: 10px;
    height: 10px;
    box-sizing: border-box;
    border: 2px solid var(--color-edge);
    border-radius: 50%;
    background: #fff;
  }
  .route-mini i + i {
    margin-left: 10px;
  }
  .route-mini i + i::before {
    content: "";
    position: absolute;
    right: calc(100% + 1px);
    top: 50%;
    width: 11px;
    border-top: 2px dashed var(--color-edge);
    transform: translateY(-50%);
  }
  .route-mini i[data-s="done"] {
    border-color: var(--color-lake);
    background: var(--color-lake);
  }
  .route-mini i[data-s="done"]::before,
  .route-mini i[data-s="here"]::before {
    border-top-style: solid;
    border-color: var(--color-lake);
  }
  .route-mini i[data-s="here"] {
    width: 16px;
    height: 16px;
    border: 4px solid var(--color-spruce);
  }
  .route-mini i[data-s="here"]::before {
    right: calc(100% + 3px);
  }
  @media (forced-colors: active) {
    .route-mini {
      forced-color-adjust: none;
    }
    .route-mini i {
      border-color: CanvasText;
      background: Canvas;
    }
    .route-mini i[data-s="done"] {
      background: CanvasText;
    }
    .route-mini i[data-s="here"] {
      border-color: Highlight;
    }
    .route-mini i + i::before,
    .route-mini i[data-s]::before {
      border-color: CanvasText;
    }
    .bill-rows .bill-link:focus-visible::after {
      outline-color: Highlight;
    }
  }
</style>
