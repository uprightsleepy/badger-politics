---
/** Single-select year filter for a complete list (never a truncated one:
 * chips over a window would read as the whole record). Chips hide rows
 * rather than dropping them, so the full list stays in the page and the
 * search index; wiring in scripts/yearChips.ts. */
interface Props {
  target: string;
  label: string;
  years: { year: string; n: number }[];
}
const { target, label, years } = Astro.props;
const total = years.reduce((sum, y) => sum + y.n, 0);
---
{years.length > 1 && (
  <div
    class="mt-3 flex flex-wrap gap-2"
    role="group"
    aria-label={label}
    data-yearchips={target}
    data-pagefind-ignore
  >
    <button type="button" data-year="" aria-pressed="true" class="chip">
      All <span class="figure font-normal">{total.toLocaleString()}</span>
    </button>
    {years.map((y) => (
      <button type="button" data-year={y.year} aria-pressed="false" class="chip tabular-nums">
        {y.year} <span class="figure font-normal">{y.n.toLocaleString()}</span>
      </button>
    ))}
  </div>
)}
<script>
  import "../scripts/yearChips";
</script>
