---
import { fmtDate } from "../lib/format";
import type { MoneyPeriod } from "../lib/money-periods";
interface Props {
  period: MoneyPeriod;
  first: string | null;
  last: string | null;
  scope?: string;
}
const { period, first, last, scope = "all" } = Astro.props;
---
<p class="text-small text-granite" data-money-coverage>
  {period.key === "all" ? "All available history." : `${fmtDate(period.start)} to ${fmtDate(period.end)}.`}
  {" "}{scope === "office" ? "Receipts during recorded legislative service only." : "Includes receipts collected before taking office."}
  {last ? <> Latest reported transaction: {fmtDate(last)}.
    {first && <> Earliest collected receipt here: {fmtDate(first)}.</>}</>
    : <> No receipts collected for this selection. That doesn't mean no money was raised.</>}
  {" "}Some filings and amendments may be missing, so totals cover the records we have.
</p>
