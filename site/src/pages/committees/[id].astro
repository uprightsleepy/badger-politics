---
import Base from "../../layouts/Base.astro";
import SourceStrip from "../../components/SourceStrip.astro";
import FollowButton from "../../components/FollowButton.astro";
import PartyChip from "../../components/PartyChip.astro";
import { existsSync } from "node:fs";
import { allCommittees, committeeFor, committeeRecord } from "../../lib/db";
import { chamberName, committeeSlug, personSlug, fmtDate, fmtTime, roleAbbr } from "../../lib/format";

export function getStaticPaths() {
  return allCommittees().map((c) => ({
    params: { id: committeeSlug(c.id) },
    props: { committeeId: c.id },
  }));
}
const { committeeId } = Astro.props;
const { committee, members, hearings, graveyard } = committeeFor(committeeId);
// a committee only gets a hearings feed if it has ever held one; linking
// a feed that does not exist is a 404 the link check rightly rejects
const hasFeed = existsSync(
  new URL(`../../../public/feeds/committees/${committeeSlug(committee.id)}.xml`, import.meta.url),
);
const record = committeeRecord(committeeId);
const today = new Date().toISOString().slice(0, 10);
const upcoming = hearings.filter((h) => (h.date ?? "") >= today).reverse();
const recent = hearings.filter((h) => (h.date ?? "") < today);
const roleLabel = (role: string) =>
  role === "member" ? null : role.replace(/\b\w/g, (c) => c.toUpperCase());
---

<Base
  title={committee.name}
  filters={{ type: "Committee", chamber: chamberName(committee.chamber) || "Joint" }}
  description={`${chamberName(committee.chamber) || "Joint"} committee: members, hearings, and bills that died here without a hearing.`}
  breadcrumbs={[{ name: "Committees", url: "/committees/" }]}
>
  <p class="text-sm text-navy-600"><a href="/committees/" class="underline">Committees</a></p>
  <div class="mt-1 flex flex-wrap items-center gap-3">
    <h1 class="text-2xl font-bold">
      {committee.chamber ? `${chamberName(committee.chamber)} ` : ""}{committee.name}
    </h1>
    <span class="ml-auto flex items-center gap-3" data-pagefind-ignore>
      <FollowButton kind="committees" id={committeeSlug(committee.id)} />
      {hasFeed && (
        <a href={`/feeds/committees/${committeeSlug(committee.id)}.xml`} class="text-xs underline">Atom feed</a>
      )}
    </span>
  </div>
  <p class="mt-1 max-w-3xl text-sm text-navy-700">
    This committee's members, its hearings, and the bills referred here, including the ones that never got a hearing.
  </p>
  <SourceStrip sources={[{ label: "Wisconsin Legislature", href: "https://docs.legis.wisconsin.gov" }]} />

  {record && (
    <section class="mt-4 rounded-lg border border-navy-100 bg-white p-4">
      <h2 class="font-bold">What this committee did</h2>
      <p class="mt-1 max-w-3xl text-sm text-navy-600">
        Committees decide which bills get hearings. A chair alone decides
        whether a bill is heard, which makes these small rooms the most
        consequential places in the Capitol.
      </p>
      <div class="mt-3 grid gap-3 sm:grid-cols-2">
        <div class="rounded-lg border border-navy-100 bg-paper px-4 py-3">
          <p class="text-2xl font-bold tabular-nums">{record.hearingsHeld.toLocaleString()}</p>
          <p class="text-sm text-navy-600">
            public hearings held, across every session on record
          </p>
        </div>
        <a
          href={graveyard.length > 0 ? `/hearing-none/${graveyard[0].session_id}/` : "/hearing-none/"}
          class="rounded-lg border border-badger-600/30 bg-badger-50 px-4 py-3 hover:border-badger-600"
        >
          <p class="text-2xl font-bold tabular-nums text-badger-700">
            {record.diedUnheard.toLocaleString()}
          </p>
          <p class="text-sm text-navy-700">
            bills died here without ever getting one &rarr;
          </p>
        </a>
      </div>
    </section>
  )}

  <div class="mt-4 grid gap-6 lg:grid-cols-2">
    <section class="min-w-0">
      <h2 class="text-xl font-bold">Members · {members.length}</h2>
      <div
        class="mt-2 max-h-96 overflow-y-auto rounded-lg border border-navy-100 bg-white scroll-body"
        role="region"
        tabindex="0"
        aria-label="Committee members"
      >
      <ul class="divide-y divide-navy-100 text-sm">
        {members.map((m) => (
          <li class="flex items-center gap-2 px-4 py-1.5">
            <PartyChip party={m.party} size="sm" />
            <a href={`/legislators/${personSlug(m.id)}/`} class="min-w-0 flex-1 truncate py-1 underline">
              {m.name}
            </a>
            {roleLabel(m.role) && (
              <span class="shrink-0 rounded-full bg-gold-100 px-2 py-0.5 text-xs font-semibold">
                {roleLabel(m.role)}
              </span>
            )}
            <span class="sr-only shrink-0 text-xs text-navy-600 sm:not-sr-only sm:inline">
              {roleAbbr(m.chamber)} {m.district}
            </span>
          </li>
        ))}
      </ul>
      </div>
    </section>

    <section class="min-w-0">
      <h2 class="text-xl font-bold">Hearing None record</h2>
      <p class="mt-1 text-sm text-navy-600">
        Bills referred here that died at session's end without a public hearing.
      </p>
      {graveyard.length > 0 ? (
        <div
          class="mt-2 max-h-96 overflow-y-auto rounded-lg border border-navy-100 bg-white scroll-body"
          role="region"
          tabindex="0"
          aria-label="Hearing None record by session"
        >
        <ul class="divide-y divide-navy-100 text-sm">
          {graveyard.map((g) => (
            <li class="flex items-center gap-3 px-4 py-2">
              <span class="w-16 shrink-0 font-semibold">{g.session_id}</span>
              <span class="min-w-0 flex-1">{g.n} bill{g.n > 1 ? "s" : ""} died without a hearing</span>
              <a href={`/hearing-none/${g.session_id}/`} class="shrink-0 py-1 text-xs underline">details</a>
            </li>
          ))}
        </ul>
        </div>
      ) : (
        <p class="mt-2 rounded-lg border border-navy-100 bg-white p-4 text-sm text-navy-600">
          No bills on record died in this committee without a hearing.
        </p>
      )}

      {(upcoming.length > 0 || recent.length > 0) && (
        <h2 class="mt-6 text-xl font-bold">
          {upcoming.length > 0 ? "Upcoming hearings" : "Recent hearings"}
        </h2>
      )}
      {(upcoming.length > 0 || recent.length > 0) && (
        <div
          class="mt-2 max-h-96 space-y-2 overflow-y-auto scroll-body scroll-on-paper"
          role="region"
          tabindex="0"
          aria-label={upcoming.length > 0 ? "Upcoming hearings" : "Recent hearings"}
        >
          {(upcoming.length > 0 ? upcoming : recent).map((h) => (
            <p class="rounded-lg border border-navy-100 bg-white px-4 py-2 text-sm">
              <span class="font-semibold">{fmtDate(h.date)}</span>
              {h.time && ` · ${fmtTime(h.time)}`}
              {h.location && ` · ${h.location}`}
              {h.source_url && (
                <a href={h.source_url} class="ml-2 underline">official notice</a>
              )}
              {h.video_url && (
                <a href={h.video_url} class="ml-2 font-semibold underline">watch on WisconsinEye</a>
              )}
            </p>
          ))}
        </div>
      )}
    </section>
  </div>
</Base>
