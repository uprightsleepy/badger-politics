---
import Base from "../../layouts/Base.astro";
import FilterBar from "../../components/FilterBar.astro";
import SourceStrip from "../../components/SourceStrip.astro";
import { allCommittees } from "../../lib/db";
import { committeeSlug, personSlug, fmtDate } from "../../lib/format";

const committees = allCommittees();
const CHAMBERS: Record<string, string> = { lower: "Assembly", upper: "Senate" };
const chamberKey = (c: string | null) => (c == null ? "joint" : c);
const chamberLabel = (c: string | null) => CHAMBERS[c ?? ""] ?? "Joint";
const facets = [
  { key: "lower", label: "Assembly" },
  { key: "upper", label: "Senate" },
  { key: "joint", label: "Joint and legislative" },
].map((f) => ({ ...f, count: committees.filter((c) => chamberKey(c.chamber) === f.key).length }));
---

<Base
  title="Committees"
  description="Every Wisconsin Legislature committee: members, chairs, hearings, and the bills that died there without a hearing."
  breadcrumbs={[{ name: "Legislature", url: "/bills/" }]}
>
  <h1 class="text-2xl font-bold">Committees</h1>
  <p class="mt-1 max-w-3xl text-sm text-navy-700">
    Committees decide which bills get hearings. A chair alone decides whether
    a bill is heard, which makes these small rooms the most consequential
    places in the Capitol.
  </p>
  <SourceStrip sources={[{ label: "Wisconsin Legislature", href: "https://docs.legis.wisconsin.gov" }]} />

  <div class="mt-4">
    <FilterBar
      id="cmte-filter"
      statusId="cmte-filter-status"
      label="Filter committees"
      placeholder="e.g. education, Jagler, agriculture…"
      facetAttr="chamber"
      facetLabel="Chamber"
      facets={facets}
    />
  </div>

  <ul class="mt-3 divide-y divide-navy-100 rounded-lg border border-navy-100 bg-white text-sm">
    {committees.map((c) => (
      <li
        data-cmte-row
        data-text={`${c.name} ${c.chair_name ?? ""} ${chamberLabel(c.chamber)}`.toLowerCase()}
        data-chamber={chamberKey(c.chamber)}
        class="flex flex-wrap items-center gap-x-4 gap-y-1 px-4 py-2.5"
      >
        <span class="min-w-0 flex-1 basis-56">
          <a href={`/committees/${committeeSlug(c.id)}/`} class="font-semibold underline">
            {c.name}
          </a>
          <span class="ml-2 rounded-full bg-navy-50 px-2 py-0.5 text-xs text-navy-700">
            {chamberLabel(c.chamber)}
          </span>
        </span>
        {c.chair_name && (
          <span class="text-xs text-navy-600">
            Chair:{" "}
            {c.chair_person_id ? (
              <a href={`/legislators/${personSlug(c.chair_person_id)}/`} class="inline-block py-1.5 underline">
                {c.chair_name}
              </a>
            ) : (
              c.chair_name
            )}
          </span>
        )}
        <span class="shrink-0 text-xs tabular-nums text-navy-600">{c.member_count} members</span>
        <span class="shrink-0 text-xs tabular-nums text-navy-600">
          {c.hearings_held.toLocaleString()} hearings
        </span>
        {c.next_hearing ? (
          <span class="shrink-0 text-xs font-semibold text-moss-600">
            Next hearing {fmtDate(c.next_hearing)}
          </span>
        ) : (
          c.died_here > 0 && (
            <a
              href={`/committees/${committeeSlug(c.id)}/`}
              class="inline-block shrink-0 py-1.5 text-xs tabular-nums text-badger-700 underline"
            >
              {c.died_here.toLocaleString()} died here
            </a>
          )
        )}
      </li>
    ))}
  </ul>
  <p id="cmte-no-match" class="mt-3 hidden rounded-lg border border-navy-100 bg-white p-4 text-sm text-navy-600">
    No committees match. Try a shorter word, or clear the chamber filter.
  </p>

  <script>
    import { initRowFilter } from "../../scripts/rowFilter";
    initRowFilter({
      input: "cmte-filter",
      rows: "[data-cmte-row]",
      status: "cmte-filter-status",
      noMatch: "cmte-no-match",
      noun: "committees",
      facetAttr: "chamber",
    });
  </script>
</Base>
