---
import Base from "../../layouts/Base.astro";
import FilterBar from "../../components/FilterBar.astro";
import { allCommittees, meta } from "../../lib/db";
import { committeeChamber, committeeSlug, committeeTitle, personSlug, fmtDate } from "../../lib/format";

const committees = allCommittees();
const chamberKey = (c: string | null) => (c == null ? "joint" : c);
const facets = [
  { key: "lower", label: "Assembly" },
  { key: "upper", label: "Senate" },
  { key: "joint", label: "Joint and legislative" },
].map((f) => ({ ...f, count: committees.filter((c) => chamberKey(c.chamber) === f.key).length }));
const n = (x: number) => x.toLocaleString();
const plural = (x: number, one: string, many: string) => `${n(x)} ${x === 1 ? one : many}`;
const pulledOn = meta().imported_at?.slice(0, 10);
---

<Base
  title="Committees"
  description="Every Wisconsin Legislature committee: members, chairs, hearings, and the bills that died there without a hearing."
  breadcrumbs={[{ name: "Legislature", url: "/bills/" }]}
  layout="wide"
>
  <header class="flex max-w-[47.5rem] flex-col gap-2.5">
    <h1 class="t-display">Committees</h1>
    <p class="sm:text-lead">
      Most bills are sent to a committee first. The committee's chair decides whether a bill gets a
      public hearing, and a bill that never gets one rarely moves.
    </p>
  </header>

  <div class="mt-4 max-w-[47.5rem]">
    <FilterBar
      wide
      id="cmte-filter"
      statusId="cmte-filter-status"
      label="Find a committee"
      placeholder="A topic or a chair's name"
      facetAttr="chamber"
      facetLabel="Show committees from"
      facets={facets}
    />
  </div>

  <ul class="cmte-rows mt-3 border-t border-rule" role="list">
    {committees.map((c) => (
      <li
        data-cmte-row
        data-text={`${c.name} ${c.chair_name ?? ""} ${committeeChamber(c.chamber)}`.toLowerCase()}
        data-chamber={chamberKey(c.chamber)}
        class="cmte-row flex flex-col gap-1 border-b border-rule py-4"
      >
        <h2 class="t-question">
          <a href={`/committees/${committeeSlug(c.id)}/`} class="underline">{committeeTitle(c.name, c.chamber)}</a>
        </h2>
        <p class="text-small">
          {c.chair_name && (
            <>Chair: {c.chair_person_id ? (
              <a href={`/legislators/${personSlug(c.chair_person_id)}/`} class="underline">{c.chair_name}</a>
            ) : c.chair_name}. </>
          )}
          {plural(c.member_count, "member", "members")}. {plural(c.hearings_held, "public hearing", "public hearings")} on record.
        </p>
        {c.next_hearing ? (
          <p class="text-small font-bold">Next hearing: {fmtDate(c.next_hearing)}</p>
        ) : (
          c.died_here > 0 && (
            <p class="text-small text-granite">
              {plural(c.died_here, "bill", "bills")} sent here never got a hearing.
            </p>
          )
        )}
      </li>
    ))}
  </ul>
  <p id="cmte-no-match" class="mt-4 hidden text-granite"></p>

  <p class="mt-8 text-fine text-granite">
    From the <a href="https://docs.legis.wisconsin.gov/committees" class="underline">Legislature's committee pages</a>
    and hearing notices{pulledOn && `, checked ${fmtDate(pulledOn)}`}.
  </p>

  <script>
    import { initRowFilter } from "../../scripts/rowFilter";
    initRowFilter({
      input: "cmte-filter",
      rows: "[data-cmte-row]",
      status: "cmte-filter-status",
      noMatch: "cmte-no-match",
      noun: "committees",
      facetAttr: "chamber",
    });
  </script>
</Base>

<style>
  @media (min-width: 48rem) {
    .cmte-rows {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 2.5rem;
    }
  }
  .cmte-row:global(.sorted-hidden) {
    display: none;
  }
</style>
