---
/** What the site publishes for reuse (JSON API, feeds, calendars, bulk downloads), what
 * it leaves out, and how the records are collected and checked. The paths
 * match pipeline/dataproducts (api.py, feeds.py, ical.py, bulk.py). */
import Base from "../layouts/Base.astro";
import { meta, usesLegiscan } from "../lib/db";
import { fmtDate } from "../lib/format";
const m = meta();
const pulledOn = m.imported_at?.slice(0, 10);

const api: [string, string][] = [
  ["/api/v1/meta.json", "When the records were last checked, and the newest recorded action."],
  ["/api/v1/sessions.json", "Every session on record."],
  ["/api/v1/bills/2025/index.json", "Every bill in one session, briefly. Swap 2025 for any session."],
  ["/api/v1/bills/2025/ab656.json", "One bill with its sponsors, every action, its roll calls, and links to every version, amendment and document on the Legislature's site. The name matches the bill page's address."],
  ["/api/v1/votes/{id}.json", "One roll call with every member's vote. The id matches the roll call page's address."],
  ["/api/v1/legislators/index.json", "Every state lawmaker on record."],
  ["/api/v1/legislators/{name}.json", "One lawmaker: their profile, election, bills and votes. The name matches their page's address."],
  ["/api/v1/executive-orders.json", "Every governor's executive orders, newest first, each with its official link."],
  ["/api/v1/elections/statewide.json", "Statewide races on the 2026 ballot, and past statewide results."],
  ["/api/v1/elections/us-house.json", "U.S. House candidates on the 2026 ballot."],
  ["/api/v1/elections/seats/assembly-15.json", "One legislative seat: who holds it, their 2026 race, and its certified results, each labeled with the district maps it was held under. Swap in any seat, like senate-5."],
  ["/api/v1/elections/judicial.json", "Certified Supreme Court and Court of Appeals results, with each race's official canvass file."],
  ["/api/v1/elections/referenda.json", "Certified results of statewide referendum questions, with each one's official canvass file."],
  ["/api/v1/committees/index.json", "Every committee and its chair."],
  ["/api/v1/committees/{id}.json", "One committee: its members, and its upcoming and past hearings. The id matches the committee page's address."],
  ["/api/v1/hearings.json", "Every committee hearing on record, with the bills on its agenda."],
  ["/api/v1/subjects/index.json", "Every heading in the Legislature's subject index, with how many bills it holds."],
  ["/api/v1/subjects/{subject}.json", "The bills filed under one subject. The name matches the subject page's address."],
  ["/api/v1/federal/index.json", "Wisconsin's members of Congress."],
  ["/api/v1/federal/{name}.json", "One member of Congress and every floor roll call they voted on. The name matches their page's address."],
  ["/api/v1/local/{city}/index.json", "One city council's members."],
  ["/api/v1/local/{city}/{member}.json", "One council member and their latest votes."],
];
// kept apart from the lawmaker files above, so money never sits beside votes
const moneyApi: [string, string][] = [
  ["/api/v1/money/legislators/{name}.json", "A state lawmaker's collected campaign receipts in all the history we have: totals, by kind of source and by quarter, the committees that gave the most, and what individual donors reported doing for a living."],
  ["/api/v1/money/committees/index.json", "Committees that gave today's legislators $1,000 or more."],
  ["/api/v1/money/committees/{id}.json", "One committee: what it gave and to whom, and its own reported money. The id matches its page's address."],
  ["/api/v1/money/independent.json", "Every outside-spending filing, exactly as filed, with the Ethics Commission's transaction ID and report."],
];
const feeds: [string, string][] = [
  ["/feeds/bills/{id}.xml", "Each step in one bill's history. Linked from the bill's page."],
  ["/feeds/legislators/{name}.xml", "A state lawmaker's roll-call votes."],
  ["/feeds/committees/{id}.xml", "A committee's hearings."],
  ["/feeds/local/{city}/{member}.xml", "A city council member's votes."],
  ["/feeds/districts/assembly-15.xml", "The roll-call votes of whoever holds one seat now. Swap in any seat, like senate-5."],
  ["/feeds/subjects/{subject}.xml", "The newest steps on bills under one subject. The name matches the subject page's address."],
  ["/feeds/laws.xml", "New laws, as the governor's approval numbers each act."],
  ["/feeds/vetoes.xml", "Vetoes, partial vetoes and veto override attempts."],
  ["/feeds/money/independent.xml", "New outside-spending filings, one at a time, with each one's transaction ID."],
];
const RELEASES = "https://github.com/uprightsleepy/badger-politics/releases/latest/download";
const downloads: [string, string][] = [
  ["badger-politics-csv.zip", "CSV files for every session: bills, their actions, sponsors, roll calls and each member's vote, plus every lawmaker."],
  ["wi-filtered.sqlite.gz", "The site's whole database (SQLite, compressed), with what's left out below removed."],
  ["SHA256SUMS", "Checksums for checking a download."],
  ["README.txt", "What each file holds, and where the records come from."],
];
---

<Base
  title="Data and API"
  description="Free JSON API, Atom feeds, calendars and bulk downloads of Wisconsin political records, with what's left out and how the records are checked."
  layout="wide"
>
  <header class="flex max-w-[47.5rem] flex-col gap-2.5">
    <h1 class="t-display">Data and API</h1>
    <p class="sm:text-lead">
      Everything behind this site is free to reuse, with no key or sign-up. It's collected from official
      public records{pulledOn && <>, last checked <strong>{fmtDate(pulledOn)}</strong></>}.
      {m.data_through && <> The Legislature's newest recorded action is from <strong>{fmtDate(m.data_through)}</strong>.</>}
    </p>
  </header>

  <div class="mt-10 flex max-w-[47.5rem] flex-col gap-12">
    <section aria-labelledby="api-heading">
      <h2 id="api-heading" class="t-section">JSON API</h2>
      <p class="mt-2">Static JSON files, one for each record, rebuilt with every update of the site.</p>
      <dl class="paths mt-3">
        {api.map(([path, what]) => (
          <div>
            <dt><code>{path}</code></dt>
            <dd>{what}</dd>
          </div>
        ))}
      </dl>
      <h3 class="t-question mt-6">Campaign money</h3>
      <p class="mt-2">
        The figures behind the <a href="/money/" class="underline">money pages</a>, over all the history we
        have, in their own files so they're never beside a vote. Individual donors appear only in totals, never by name. Each file
        carries the notes needed to read it: corporations can't give to Wisconsin candidates, a PAC's money
        is its own, and a contribution isn't an endorsement of any vote.
        {" "}<a href="/about/#money" class="underline">Full methodology</a>
      </p>
      <dl class="paths mt-3">
        {moneyApi.map(([path, what]) => (
          <div>
            <dt><code>{path}</code></dt>
            <dd>{what}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section aria-labelledby="feeds-heading">
      <h2 id="feeds-heading" class="t-section">Feeds</h2>
      <p class="mt-2">
        Atom feeds for any feed reader. Each page that has one links to it next to its Follow button. For a
        summary of the whole Legislature, there's <a href="/feeds/weekly.xml" class="underline">this week in the
        Legislature</a>.
      </p>
      <dl class="paths mt-3">
        {feeds.map(([path, what]) => (
          <div>
            <dt><code>{path}</code></dt>
            <dd>{what}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section aria-labelledby="calendars-heading">
      <h2 id="calendars-heading" class="t-section">Calendars</h2>
      <p class="mt-2">Calendar files (iCal) that any calendar app can subscribe to or import.</p>
      <ul class="mt-2 flex flex-col" role="list">
        <li><a href="/calendar/hearings.ics" class="inline-flex min-h-11 items-center underline">Committee hearings</a></li>
        <li><a href="/calendar/election-days.ics" class="inline-flex min-h-11 items-center underline">2026 election days</a></li>
      </ul>
      <p class="mt-1 text-small text-granite">Each hearing on the <a href="/calendar/#hearings" class="underline">calendar</a> also has its own file.</p>
    </section>

    <section aria-labelledby="bulk-heading">
      <h2 id="bulk-heading" class="t-section">Bulk downloads</h2>
      <p class="mt-2">
        Each release of this site publishes the whole record on GitHub, beside the
        {" "}<a href="https://github.com/uprightsleepy/badger-politics" class="underline">source code</a>. These
        addresses always lead to the newest files:
      </p>
      <dl class="paths mt-3">
        {downloads.map(([file, what]) => (
          <div>
            <dt><a href={`${RELEASES}/${file}`} class="underline"><code>{file}</code></a></dt>
            <dd>{what}</dd>
          </div>
        ))}
      </dl>
      <p class="mt-2 text-small text-granite">
        Earlier copies are on the <a href="https://github.com/uprightsleepy/badger-politics/releases" class="underline">releases page</a>.
        Individual donors appear in the database only in totals: each of their receipts keeps its amount,
        date and recipient, without a name, occupation or filer ID.
      </p>
      <h3 class="t-question mt-6">Query the database on your own computer</h3>
      <p class="mt-2">
        The database is one SQLite file, so any SQLite tool can open it, such as the free
        {" "}<a href="https://sqlitebrowser.org/" class="underline">DB Browser for SQLite</a> or the
        {" "}<a href="https://sqlite.org/cli.html" class="underline"><code>sqlite3</code> command-line tool</a>.
        Unzip it first:
      </p>
      <pre class="mt-3 overflow-x-auto" tabindex="0" aria-label="Example commands"><code>gunzip wi-filtered.sqlite.gz
sqlite3 wi-filtered.sqlite ".tables"
sqlite3 wi-filtered.sqlite "SELECT identifier, title FROM bills WHERE session_id = '2025' LIMIT 10"</code></pre>
      <p class="mt-2 text-small text-granite">
        Check the download against <code>SHA256SUMS</code> with <code>sha256sum -c --ignore-missing SHA256SUMS</code>.
      </p>
    </section>

    <section aria-labelledby="left-out-heading">
      <h2 id="left-out-heading" class="t-section">What's left out</h2>
      <ul class="mt-3 flex list-disc flex-col gap-2 pl-5 marker:text-granite">
        <li>
          {usesLegiscan()
            ? <>Bills and roll calls that came from LegiScan appear on the site, credited and linked under its
              {" "}<a href="https://creativecommons.org/licenses/by/4.0/" class="underline">CC BY 4.0 license</a>,
              but they're left out of every API file, feed and download.</>
            : <>No records on the site come from LegiScan. If any ever do, they'll be credited and linked under
              its <a href="https://creativecommons.org/licenses/by/4.0/" class="underline">CC BY 4.0 license</a>
              {" "}and left out of every API file, feed and download.</>}
        </li>
        <li>Eye on Lobbying registrations are withheld from the site and from everything published here.</li>
      </ul>
    </section>

    <section aria-labelledby="method-heading">
      <h2 id="method-heading" class="t-section">How the records are collected</h2>
      <p class="mt-2">
        Every night, the Legislature's official pages are read with the open-source Open States scrapers
        and loaded into a single database behind hard checks. Roll-call totals must match the official
        counts, and a lawmaker's name that could mean two people stops the update rather than being
        guessed. <a href="/about/" class="underline">Every source and check</a> is on the About page, and the
        {" "}<a href="https://github.com/uprightsleepy/badger-politics" class="underline">code is on GitHub</a>.
      </p>
    </section>
  </div>
</Base>

<style>
  .paths {
    border-bottom: 1px solid var(--color-rule);
  }
  .paths > div {
    border-top: 1px solid var(--color-rule);
    padding: 0.75rem 0;
  }
  .paths code {
    font-size: var(--text-small);
    font-weight: 700;
    overflow-wrap: anywhere;
  }
  .paths dd {
    margin-top: 0.125rem;
    color: var(--color-granite);
    font-size: var(--text-small);
  }
</style>
