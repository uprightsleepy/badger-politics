---
import Base from "../layouts/Base.astro";
import { PLACES_KEY } from "../lib/placesKey";
import { ELECTION_CYCLE } from "../lib/ballot";
import ELECTION_DAYS from "../data/election-days.json";

// the general election this cycle's ballot answers point at
const general =
  (ELECTION_DAYS as [string, string][]).find(
    ([date, name]) => date.startsWith(String(ELECTION_CYCLE)) && /general/i.test(name),
  )?.[0] ?? "";
---

<Base
  title="Find your state lawmakers"
  description="Enter your address once to see your representative and state senator: how they vote, how often they show up, and whether they're on your ballot. Your districts are remembered on this device only."
  layout="wide"
>
  <!-- phones read top to bottom: intro, map or form, then what you'll see;
       wider screens put the map or the preview beside them -->
  <div class="grid grid-cols-[minmax(0,1fr)] gap-x-12 gap-y-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,25rem)] lg:items-center">
    <div class="flex max-w-[37.5rem] flex-col gap-3">
      <h1 id="page-title" tabindex="-1" class="t-display">Find your state lawmakers</h1>
      <p id="intro-start" class="sm:text-lead">
        Everyone in Wisconsin has two: a representative in the Assembly and a
        senator in the Senate. Enter your address to see yours.
      </p>
      <p id="intro-result" class="sm:text-lead" hidden></p>
      <p id="change-wrap" hidden>
        <button type="button" id="change-addr" class="inline-flex min-h-11 cursor-pointer items-center font-bold text-lake underline underline-offset-4 hover:text-spruce">
          Change address
        </button>
      </p>
    </div>

    <figure id="map" class="m-0 flex flex-col gap-2 lg:col-start-2 lg:row-start-1" hidden>
      <img id="map-img" alt="" width="400" height="280" class="aspect-[10/7] h-auto w-full rounded-[0.75rem] bg-fog" />
      <figcaption id="map-caption" class="text-fine text-granite"></figcaption>
    </figure>

    <div id="lookup" class="flex max-w-[35rem] flex-col gap-4 lg:col-start-1">
      <form id="addr-form" class="flex flex-col gap-2.5">
        <label for="addr" class="t-label">Your Wisconsin address</label>
        <input
          id="addr"
          type="text"
          required
          autocomplete="street-address"
          placeholder="Street and city, e.g. 7525 W Greenfield Ave, West Allis"
          class="min-h-13 w-full rounded-[0.625rem] border-2 border-edge bg-white px-3.5 text-body text-spruce placeholder:text-granite focus:border-lake"
        />
        <button type="submit" class="btn btn-primary">Find my lawmakers</button>
        <button
          type="button"
          id="geo-btn"
          class="inline-flex min-h-11 cursor-pointer items-center justify-center gap-2 font-bold text-lake underline underline-offset-4 hover:text-spruce"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
          Use my location instead
        </button>
      </form>
      <p class="flex items-start gap-2.5 text-small text-granite">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="mt-0.5 shrink-0 text-spruce"><rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></svg>
        <span>
          {PLACES_KEY
            ? "As you type, suggestions come from Google Places. The address you pick goes to the U.S. Census to find your districts, then it's forgotten."
            : "Your address goes to the U.S. Census to find your districts, then it's forgotten."}
          {" "}Only the district numbers stay, on this device. <a href="/about/#districts" class="underline">Details</a>
        </span>
      </p>
    </div>

    <aside id="preview" class="flex flex-col gap-3 border-t border-rule pt-5 lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:self-start lg:border-l lg:border-t-0 lg:pl-8 lg:pt-0" aria-labelledby="preview-heading">
      <h2 id="preview-heading" class="t-label text-[1.1875rem]">What you'll see</h2>
      <ul class="flex list-disc flex-col gap-1.5 pl-5">
        <li>Who they are and how to reach them</li>
        <li>How they vote, and how often they show up</li>
        <li>Whether they're on your ballot this November</li>
      </ul>
    </aside>
  </div>

  <p id="status" class="mt-3 max-w-[35rem] text-small text-granite" role="status"></p>

  <section id="result" class="mt-8 hidden" aria-labelledby="result-heading">
    <h2 id="result-heading" class="sr-only">Your lawmakers</h2>
    <div id="reps" class="flex flex-wrap items-start gap-6" data-no-rep-highlight data-general={general}></div>
    <p class="mt-6 flex max-w-[45rem] items-start gap-2.5 rounded-[0.75rem] bg-prairie-tint px-4 py-3.5">
      <span class="mt-2 h-2.5 w-2.5 shrink-0 rounded-full bg-spruce" aria-hidden="true"></span>
      <span>From now on, every bill page shows how these two voted, and they're marked wherever they appear on this site.</span>
    </p>
    <p class="mt-4 text-fine text-granite">
      Districts follow the Legislature's 2024 maps. Records from the Wisconsin
      Legislature and the Wisconsin Elections Commission. Your districts are
      saved on this device only.{" "}
      <button id="forget" type="button" class="inline-flex min-h-11 cursor-pointer items-center font-bold text-lake underline underline-offset-4 hover:text-spruce">Forget my districts</button>
    </p>
  </section>

  <section id="polling" class="mt-10 flex max-w-[35rem] flex-col gap-2.5 border-t border-rule pt-6" aria-labelledby="polling-heading">
    <h2 id="polling-heading" class="t-label text-[1.25rem]">Where do I vote?</h2>
    <p>
      Your polling place depends on your ward and can change between
      elections. <a href="https://myvote.wi.gov/en-us/Find-My-Polling-Place" class="underline">Find your polling place on MyVote Wisconsin</a>,
      the state's official voter site.
    </p>
    <p class="text-small text-granite">Want it handy on election day? Save it here. It stays on this device.</p>
    <form id="polling-form" class="flex flex-wrap gap-2">
      <label class="sr-only" for="polling-input">Polling place</label>
      <input
        id="polling-input"
        type="text"
        placeholder="e.g. West Allis City Hall, 7525 W Greenfield Ave"
        class="min-h-12 min-w-0 flex-[1_1_16rem] rounded-[0.625rem] border-2 border-edge bg-white px-3 text-spruce placeholder:text-granite focus:border-lake"
      />
      <button type="submit" class="btn btn-secondary">Save</button>
    </form>
    <p id="polling-saved" role="status" class="hidden">
      Saved: <strong id="polling-value"></strong>
      <button id="polling-forget" type="button" class="ml-1 inline-flex min-h-11 cursor-pointer items-center font-bold text-lake underline underline-offset-4">Forget</button>
      <span class="block text-small text-granite">Check MyVote before each election. Locations can change.</span>
    </p>
  </section>

  <script>
    import { savedDistrict, saveDistrict, forgetDistrict } from "../lib/district";
    import { forgetCityDistrict, resolveCity, savedCityDistrict } from "../lib/cityDistrict";
    import { attachSuggest } from "../scripts/addressSuggest";
    import { isFollowing, toggleFollow } from "../scripts/follows";
    import { esc } from "../lib/html";
    import { ballotStatus } from "../lib/ballot";
    import { clip, fmtDate, partyPlural, partyWord } from "../lib/format";
    import { districtForAddress, districtForBrowser } from "../lib/lookup";
    import { forgetPollingPlace, savePollingPlace, savedPollingPlace } from "../lib/pollingPlace";
    import type { LocalReps, RepSlim, RepSummaries, RepSummary, Reps, Typical } from "../lib/wire";

    const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
    const statusEl = $("status");
    const resultEl = $("result");
    const repsEl = $("reps");
    const general = repsEl.dataset.general ?? "";
    let reps: Reps | null = null;
    let summaries: RepSummaries | null = null;
    let localReps: LocalReps | null = null;

    // The boundaries and the point-in-polygon test live in lib/lookup, shared
    // with the homepage. What this page loads on its own is the roster it
    // needs to draw the cards.
    async function loadData() {
      if (!reps) {
        // only speak up when nothing else is in progress, and only clear
        // our own message
        const loading = "Loading your districts…";
        if (!statusEl.textContent) statusEl.textContent = loading;
        [reps, summaries, localReps] = await Promise.all([
          fetch("/data/reps.json").then((r) => r.json()),
          fetch("/data/rep-summaries.json").then((r) => r.json()).catch(() => null),
          fetch("/data/local-reps.json").then((r) => r.json()).catch(() => null),
        ]);
        if (statusEl.textContent === loading) statusEl.textContent = "";
      }
    }

    // ---- small pieces ----
    const fig = (n: number | string) => `<span class="figure">${esc(String(n))}</span>`;
    const link = (href: string, text: string) => `<a href="${esc(href)}" class="underline">${esc(text)}</a>`;
    const plural = (n: number, one: string, many: string) => (n === 1 ? one : many);
    const a = (word: string) => (/^[aeiou]/i.test(word) ? "an" : "a");
    const round = (n: number) => Math.round(n);
    // sentences spell the month out: "November 3, 2026"
    const longDate = (iso: string) => {
      const [y, m, d] = iso.split("-").map(Number);
      return new Date(Date.UTC(y, m - 1, d)).toLocaleDateString("en-US", {
        month: "long", day: "numeric", year: "numeric", timeZone: "UTC",
      });
    };
    // "Avery Lund, a Republican, and Jordan Pike, a Democrat"
    const people = (list: { name: string; party: string | null }[]) => {
      const each = list.map((p) =>
        p.party ? `${esc(p.name)}, ${a(partyWord(p.party))} ${esc(partyWord(p.party))}` : esc(p.name),
      );
      if (each.length < 2) return each.join("");
      if (each.length === 2) return `${each[0]}, and ${each[1]}`;
      return `${each.slice(0, -1).join("; ")}; and ${each.at(-1)}`;
    };
    const question = (q: string, body: string) =>
      `<div class="flex flex-col gap-1.5 border-t border-rule pt-4"><h3 class="t-question">${esc(q)}</h3>${body}</div>`;

    /** One value against the middle half of the chamber. Text says it all;
     * the bar is the same fact drawn. */
    function rangeBar(opts: {
      value: number; min: number; max: number; typical: Typical;
      left: string; right: string;
    }) {
      const span = Math.max(opts.max - opts.min, 1);
      const pos = (n: number) => Math.min(100, Math.max(0, ((n - opts.min) / span) * 100));
      const lo = pos(opts.typical.low);
      const width = Math.max(pos(opts.typical.high) - lo, 2);
      return (
        // the sentence beside the bar carries the same facts, so the bar
        // itself is hidden from assistive tech
        '<div class="range mt-1" aria-hidden="true">' +
        '<div class="relative mx-2.5 h-2.5 rounded-full bg-fog">' +
        `<span class="absolute inset-y-0 rounded-full bg-lake-tint" style="left:${lo.toFixed(1)}%;width:${width.toFixed(1)}%"></span>` +
        `<span class="absolute top-1/2 h-5 w-5 -translate-x-1/2 -translate-y-1/2 rounded-full border-[3px] border-white bg-spruce" style="left:${pos(opts.value).toFixed(1)}%"></span>` +
        '</div>' +
        `<div class="mt-1.5 flex justify-between text-fine text-granite"><span>${esc(opts.left)}</span><span>${esc(opts.right)}</span></div>` +
        '</div>'
      );
    }

    const PORTRAIT_FALLBACK =
      '<svg width="72" height="72" viewBox="0 0 48 48" aria-hidden="true" class="shrink-0 rounded-full">' +
      '<circle cx="24" cy="24" r="24" fill="#E6EBE7"/><circle cx="24" cy="19" r="7.5" fill="#848E88"/>' +
      '<rect x="10" y="30.5" width="28" height="24" rx="12" fill="#848E88"/></svg>';

    const ROLE_RANK = (role: string) =>
      /^chair/i.test(role) ? 0 : /^co-chair/i.test(role) ? 1 : /^vice/i.test(role) ? 2 : 3;
    const ROLE_LABEL = (role: string) =>
      /^chair/i.test(role) ? "Chair" : /^co-chair/i.test(role) ? "Co-chair" : /^vice/i.test(role) ? "Vice-chair" : "Member";

    // ---- one lawmaker ----
    function personCard(house: "assembly" | "senate", district: number, slim: RepSlim | undefined, full: RepSummary | undefined): string {
      const chamber = house === "assembly" ? "Assembly" : "Senate";
      const title = house === "assembly" ? "representative" : "state senator";
      const members = house === "assembly" ? "representatives" : "senators";
      const districtHref = `/districts/${house}-${district}/`;
      if (!slim) {
        return (
          '<section class="sheet flex min-w-0 flex-[1_1_26rem] flex-col gap-2 p-5 sm:p-7">' +
          `<h2 class="t-section">${chamber} District ${esc(String(district))}</h2>` +
          `<p>This seat is empty right now. ${link(districtHref, `See ${chamber} District ${district}`)}</p></section>`
        );
      }
      const headingId = `rep-${house}`;
      const portrait = slim.image
        ? `<img src="${esc(slim.image)}" alt="" width="72" height="72" loading="lazy" decoding="async" class="h-[72px] w-[72px] shrink-0 rounded-full bg-fog object-cover object-[50%_20%]">`
        : PORTRAIT_FALLBACK;
      const head =
        // the portrait moves above the name when text is very large
        '<div class="flex flex-wrap items-center gap-4">' + portrait +
        '<div class="min-w-0 flex-[1_1_12rem]">' +
        `<h2 id="${headingId}" class="t-section"><a href="/legislators/${esc(slim.slug)}/" class="text-spruce no-underline hover:underline">${esc(slim.name)}</a></h2>` +
        `<p class="text-granite">Your ${title} for ${link(districtHref, `${chamber} District ${district}`)}.` +
        `${slim.party ? ` ${esc(partyWord(slim.party))}.` : ""}</p>` +
        '</div></div>';

      const blocks: string[] = [];
      if (full?.contact) {
        const tel = full.contact.phone?.replace(/\D/g, "");
        blocks.push(
          '<div class="flex flex-wrap gap-2.5">' +
          `<a class="btn btn-secondary max-w-full flex-wrap [overflow-wrap:anywhere]" href="mailto:${esc(full.contact.email)}">Email <span class="font-sans font-normal">${esc(full.contact.email)}</span></a>` +
          (tel ? `<a class="btn btn-secondary" href="tel:${esc(tel)}">Call <span class="font-sans font-normal">${esc(full.contact.phone!)}</span></a>` : "") +
          '</div>',
        );
      }

      if (full) {
        const typical = summaries?.typical?.[house];
        // 1. how often they vote: yes or no, out of every roll call held
        // while they served, against the rest of their chamber
        const v = full.voted;
        if (v && v.total > 0) {
          const skipped = v.total - v.cast;
          let body = skipped === 0
            ? `<p>Voted on all ${fig(v.total.toLocaleString())} roll call votes this session.</p>`
            : `<p>Voted on ${fig(v.cast.toLocaleString())} of ${fig(v.total.toLocaleString())} roll call votes this session. Didn't vote on ${fig(skipped.toLocaleString())}.</p>`;
          const t = typical?.notVoting;
          if (t) {
            const rate = (skipped / v.total) * 100;
            const pct = (n: number) => (n > 0 && n < 1 ? "under 1%" : `${round(n)}%`);
            const words = round(t.high) === 0 && t.high < 0.5
              ? `The middle half of ${members} voted on every one, or nearly.`
              : `The middle half of ${members} didn't vote on ${pct(t.low)} to ${pct(t.high)} of them.`;
            const top = Math.max(5, Math.ceil(Math.max(t.max, rate)));
            body += rangeBar({
              value: rate, min: 0, max: top, typical: t,
              left: "Voted on all", right: `Didn't vote on ${top}%`,
            }) + `<p class="text-fine text-granite">${esc(words)} Not voting counts being away and choosing not to vote alike.</p>`;
          }
          blocks.push(question("How often do they vote?", body));
        } else {
          blocks.push(question("How often do they vote?", "<p>No roll call votes are recorded for them yet this session.</p>"));
        }

        // 2. party agreement, Democrats and Republicans only
        if (slim.party === "Democratic" || slim.party === "Republican") {
          const l = full.loyalty;
          let body: string;
          if (l) {
            const pct = round(l.pct);
            body = `<p>Voted with most ${esc(partyPlural(slim.party))} on ${fig(`${pct}%`)} of ${fig(l.n.toLocaleString())} votes in the ${esc(l.label)}.</p>`;
            const t = typical?.loyalty;
            if (t && t.session === l.session) {
              const words = `The middle half of ${members} voted with their party ${round(t.low)}% to ${round(t.high)}% of the time.`;
              body += rangeBar({
                value: l.pct, min: 50, max: 100, typical: t,
                left: "50%", right: "100%",
              }) + `<p class="text-fine text-granite">${esc(words)}</p>`;
            }
          } else {
            body = "<p>Not enough recorded votes yet this session to measure.</p>";
          }
          blocks.push(question("How often do they vote with their party?", body));
        }

        // 3. bills
        const au = full.authored;
        const bills = [
          au.total > 0
            ? `Led ${fig(au.total)} ${plural(au.total, "bill", "bills")} this session.` +
              (au.enacted === 0 ? " None became law." : ` ${fig(au.enacted)} became law.`) +
              (au.vetoed ? ` ${fig(au.vetoed)} ${plural(au.vetoed, "was", "were")} vetoed.` : "") +
              (au.noHearing ? ` ${fig(au.noHearing)} never got a hearing.` : "")
            : "They haven't led a bill this session.",
          au.signedOn ? ` Signed on in support of ${fig(au.signedOn)} more.` : "",
        ].join("");
        blocks.push(question("What have they tried to pass?",
          `<p>${bills} ${link(`/legislators/${slim.slug}/#bills-led`, "See their bills")}</p>`));

        // 4. committees, leaders first
        const cs = (full.committees ?? []).slice().sort((x, y) => ROLE_RANK(x.role) - ROLE_RANK(y.role));
        if (cs.length) {
          const byRole = new Map<string, string[]>();
          for (const c of cs) {
            const role = ROLE_LABEL(c.role);
            byRole.set(role, [...(byRole.get(role) ?? []), link(`/committees/${c.slug}/`, c.name)]);
          }
          blocks.push(question("Which committees are they on?",
            '<ul class="flex flex-col gap-1">' +
            [...byRole.entries()].map(([role, list]) => `<li><span class="font-bold">${role}:</span> ${list.join(", ")}</li>`).join("") +
            '</ul>'));
        }

        // 5. the ballot
        const status = ballotStatus(full.election);
        const seat = `/elections/${status.kind !== "none" ? status.year : ""}/${house}-${district}/`;
        const opponents = full.opponents ?? [];
        const when = general ? longDate(general) : "";
        const raceLink = status.kind !== "none" && status.kind !== "future" ? ` ${link(seat, "See the race")}` : "";
        const writeIns = full.writeInPending ?? [];
        // a write-in nominee may exist that the certified results don't name
        const writeInLine = writeIns.length
          ? ` The ${esc(writeIns.join(" and "))} primary had no printed candidate, so a write-in nominee may also be on the ballot.`
          : "";
        let ballot = "";
        if (status.kind === "on-ballot") {
          ballot = summaries?.phase === "general"
            ? opponents.length
              ? `Yes. ${when ? `On ${esc(when)}, they` : "They"} face ${people(opponents)}.`
              : writeIns.length
                ? `Yes. No other candidate's name is on the ballot for this seat${when ? ` on ${esc(when)}` : ""}.`
                : `Yes. They're running unopposed${when ? ` on ${esc(when)}` : ""}.`
            : `Yes, they're on the ${status.year} ballot.` + (opponents.length ? ` Others approved for this seat: ${people(opponents)}.` : "");
          ballot += writeInLine;
        } else if (status.kind === "not-running") {
          // not on the November ballot: retired, lost a primary, or not
          // approved; the report doesn't say which, so neither do we
          ballot = `No. They're not on the November ${status.year} ballot.` +
            (opponents.length ? ` On the ballot for this seat: ${people(opponents)}.` : "") + writeInLine;
        } else if (status.kind === "pending") {
          ballot = `The Elections Commission hasn't posted yet whether they're running in ${status.year}.`;
        } else if (status.kind === "future") {
          ballot = `Not this year. This seat is next on the ballot in ${status.year}.`;
        }
        if (ballot) {
          blocks.push(question("Are they on your ballot?",
            `<p>${ballot}${raceLink}</p>` +
            (status.kind !== "future"
              ? '<p class="text-fine text-granite">From the Elections Commission\'s ballot report. Check MyVote Wisconsin for your own ballot.</p>'
              : "")));
        }

        // 6. the latest vote, then the few before it
        const votes = full.recentVotes ?? [];
        const voteLine = (v: RepSummary["recentVotes"][number], long: boolean) => {
          const how = v.option === "yes" ? "Voted yes" : v.option === "no" ? "Voted no" : "Didn't vote";
          // the official title, as written, after its "Relating to:"
          const about = (v.title ?? "").replace(/^\s*relating to:\s*/i, "").replace(/\.\s*$/, "");
          const subject = about ? `, relating to ${esc(clip(about, long ? 90 : 60))}` : "";
          return `${how} on ${link(`/bills/${v.session}/${v.slug}/`, v.identifier)}${subject}. ${esc(fmtDate(v.date))}. ${link(`/votes/${v.event}/`, long ? "See the vote" : "Vote")}` +
            (v.motion ? `<span class="block text-fine text-granite">Official motion: “${esc(v.motion)}”</span>` : "");
        };
        if (votes.length) {
          let body = `<p>${voteLine(votes[0], true)}</p>`;
          if (votes.length > 1) {
            body +=
              '<details class="group"><summary class="inline-flex min-h-11 cursor-pointer list-none items-center font-display font-bold text-lake underline underline-offset-4 [&::-webkit-details-marker]:hidden">' +
              `<span class="group-open:hidden">See ${votes.length - 1} earlier ${plural(votes.length - 1, "vote", "votes")}</span><span class="hidden group-open:inline">Hide earlier votes</span></summary>` +
              '<ul class="flex flex-col">' +
              votes.slice(1).map((v) => `<li class="border-t border-rule py-2 text-small">${voteLine(v, false)}</li>`).join("") +
              '</ul></details>';
          }
          blocks.push(question("How did they vote most recently?", body));
        }
      }

      const foot =
        '<div class="flex flex-wrap items-center gap-5 border-t border-rule pt-4">' +
        `<button type="button" class="btn btn-secondary aria-pressed:border-lake" data-follow-kind="legislators" data-follow-id="${esc(slim.slug)}" aria-pressed="false" aria-describedby="${headingId}"><span data-follow-text>Follow</span></button>` +
        `<a href="/legislators/${esc(slim.slug)}/" class="font-bold underline">Full record</a>` +
        '</div>';

      return (
        `<section class="sheet flex min-w-0 flex-[1_1_26rem] flex-col gap-5 break-words p-5 sm:p-7" aria-labelledby="${headingId}">` +
        head + blocks.join("") + foot + '</section>'
      );
    }

    /** The council card, for addresses inside a covered city. */
    function cityCard(): string {
      const saved = savedCityDistrict();
      const info = saved && localReps ? localReps[saved.t] : null;
      if (!saved || !info) return "";
      const alders = info.districts[String(saved.d)] ?? [];
      return (
        '<section class="sheet flex min-w-0 flex-[1_1_26rem] flex-col gap-3 p-5 sm:p-7" aria-labelledby="rep-city">' +
        `<h2 id="rep-city" class="t-label text-[1.1875rem]">Your city council: ${link(`/local/${info.slug}/`, `${info.council}, District ${saved.d}`)}</h2>` +
        alders.map((m) =>
          '<p class="flex items-center gap-3">' +
          (m.image
            ? `<img src="${esc(m.image)}" alt="" width="48" height="48" loading="lazy" decoding="async" class="h-12 w-12 shrink-0 rounded-full bg-fog object-cover object-[50%_25%]">`
            : "") +
          `<a class="t-question text-spruce no-underline hover:underline" href="/local/${esc(info.slug)}/${esc(m.slug)}/">${esc(m.name)}</a></p>`,
        ).join("") +
        `<p>${link(`/local/${info.slug}/`, `How the ${info.city} council votes`)}</p>` +
        '</section>'
      );
    }

    function paintFollows() {
      repsEl.querySelectorAll<HTMLButtonElement>("[data-follow-kind]").forEach((btn) => {
        const id = btn.dataset.followId!;
        const text = btn.querySelector<HTMLElement>("[data-follow-text]")!;
        const paint = (on: boolean) => {
          btn.setAttribute("aria-pressed", String(on));
          text.textContent = on ? "Following" : "Follow";
        };
        paint(isFollowing("legislators", id));
        btn.addEventListener("click", () => paint(toggleFollow("legislators", id)));
      });
    }

    // ---- the two states of the page ----
    const titleEl = $("page-title");
    const introStart = $("intro-start");
    const introResult = $("intro-result");
    const changeWrap = $("change-wrap");
    const lookupEl = $("lookup");
    const mapEl = $("map");
    const previewEl = $("preview");

    function showStart() {
      titleEl.textContent = "Find your state lawmakers";
      introStart.hidden = false;
      introResult.hidden = true;
      changeWrap.hidden = true;
      lookupEl.hidden = false;
      mapEl.hidden = true;
      previewEl.hidden = false;
      resultEl.classList.add("hidden");
    }

    function show(props: { ad: number; sd: number }, announce = false) {
      saveDistrict(props);
      const { ad, sd } = props;
      titleEl.textContent = "Your state lawmakers";
      introStart.hidden = true;
      introResult.textContent =
        `You live in Assembly District ${ad} and Senate District ${sd}. ` +
        "Everyone in Wisconsin has two state lawmakers: one in each half of the Legislature.";
      introResult.hidden = false;
      changeWrap.hidden = false;
      lookupEl.hidden = true;
      previewEl.hidden = true;
      // Wisconsin nests three Assembly districts in each Senate district
      if (Math.ceil(ad / 3) === sd) {
        const img = $<HTMLImageElement>("map-img");
        img.src = `/data/maps/assembly-${ad}.svg`;
        img.alt = `Map: Assembly District ${ad} inside Senate District ${sd}`;
        $("map-caption").textContent = `Assembly District ${ad} (yellow) sits inside Senate District ${sd} (outlined).`;
        mapEl.hidden = false;
      } else {
        mapEl.hidden = true;
      }
      repsEl.innerHTML = [
        personCard("assembly", ad, reps!.assembly[ad], summaries?.assembly?.[ad]),
        personCard("senate", sd, reps!.senate[sd], summaries?.senate?.[sd]),
        cityCard(),
      ].filter(Boolean).join("");
      paintFollows();
      resultEl.classList.remove("hidden");
      if (announce) {
        statusEl.textContent = `Found: Assembly District ${ad}, Senate District ${sd}.`;
        titleEl.focus();
      }
    }

    $("addr-form").addEventListener("submit", async (e) => {
      e.preventDefault();
      const addr = $<HTMLInputElement>("addr").value;
      statusEl.textContent = "Looking up address…";
      const [result] = await Promise.all([districtForAddress(addr), loadData()]);
      if ("error" in result) {
        statusEl.textContent = result.error;
        return;
      }
      await resolveCity(result.lng, result.lat);
      show(result.district, true);
    });

    attachSuggest($<HTMLInputElement>("addr"), () => $<HTMLFormElement>("addr-form").requestSubmit());

    $("geo-btn").addEventListener("click", async () => {
      statusEl.textContent = "Asking your browser for your location…";
      try {
        const result = await districtForBrowser();
        if ("error" in result) {
          statusEl.textContent = result.error;
          return;
        }
        await loadData();
        await resolveCity(result.lng, result.lat);
        show(result.district, true);
        // browser locations can be off by blocks; say so instead of
        // silently saving no council district
        if (!savedCityDistrict()) {
          statusEl.textContent += " No covered city at your browser's location;"
            + " a street address is more precise.";
        }
      } catch {
        statusEl.textContent = "Couldn't load district data. Try again in a minute.";
      }
    });

    $("change-addr").addEventListener("click", () => {
      lookupEl.hidden = false;
      changeWrap.hidden = true;
      $<HTMLInputElement>("addr").focus();
    });

    $("forget").addEventListener("click", () => {
      forgetDistrict();
      forgetCityDistrict();
      showStart();
      statusEl.textContent = "Forgotten. Your districts are no longer saved on this device.";
      $<HTMLInputElement>("addr").focus();
    });

    const saved = savedDistrict();
    if (saved) {
      loadData().then(() => show(saved));
    }

    // polling place: user-entered, device-only
    const pollingInput = $<HTMLInputElement>("polling-input");
    const pollingSaved = $("polling-saved");
    const pollingValue = $("polling-value");
    function renderPolling() {
      const place = savedPollingPlace();
      pollingSaved.classList.toggle("hidden", !place);
      if (place) {
        pollingValue.textContent = place;
        pollingInput.value = place;
      }
    }
    $("polling-form").addEventListener("submit", (e) => {
      e.preventDefault();
      const value = pollingInput.value.trim();
      if (value) {
        savePollingPlace(value);
        renderPolling();
      }
    });
    $("polling-forget").addEventListener("click", () => {
      forgetPollingPlace();
      pollingInput.value = "";
      renderPolling();
      pollingInput.focus();
    });
    renderPolling();
  </script>
</Base>

<style is:global>
  /* the range bar keeps its track and marks in Windows High Contrast */
  @media (forced-colors: active) {
    .range,
    .range * {
      forced-color-adjust: none;
    }
  }
</style>
