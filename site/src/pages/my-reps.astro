---
import Base from "../layouts/Base.astro";
---

<Base title="Find my legislators" description="Enter your address once. Your Assembly and Senate districts are remembered on this device only.">
  <h1 class="text-2xl font-bold">Find my legislators</h1>
  <p class="mt-2 max-w-2xl text-navy-700">
    Enter your address, or use your location. Your district is saved
    <strong>on this device only</strong>. Your address is never stored. It is sent
    to one place, the U.S. Census geocoder, just to get coordinates. After that,
    every bill page shows how your two legislators voted.
  </p>

  <form id="addr-form" class="mt-5 flex max-w-xl flex-wrap gap-2">
    <label class="sr-only" for="addr">Street address in Wisconsin</label>
    <input
      id="addr"
      type="text"
      required
      autocomplete="street-address"
      placeholder="e.g. 7120 W National Ave, West Allis, WI"
      class="min-w-0 flex-1 rounded-lg border border-navy-100 bg-white px-3 py-2"
    />
    <button type="submit" class="rounded-lg bg-navy-800 px-4 py-2 font-semibold text-white hover:bg-navy-700">
      Find
    </button>
    <button type="button" id="geo-btn" class="rounded-lg border border-navy-100 bg-white px-4 py-2 hover:bg-navy-50">
      Use my location
    </button>
  </form>
  <p id="status" class="mt-3 text-sm text-navy-600" role="status"></p>

  <div id="result" class="mt-6 hidden max-w-3xl rounded-lg border border-navy-100 bg-white p-4">
    <h2 id="result-heading" tabindex="-1" class="text-lg font-bold">Your districts</h2>
    <div id="reps" class="mt-2 space-y-4" data-no-rep-highlight></div>
    <p class="mt-3 text-xs text-navy-600">
      Districts follow the Legislature's official 2024 boundaries. Saved in
      your browser only. <button id="forget" class="underline">Forget this</button>.
    </p>
  </div>

  <div id="polling" class="mt-4 max-w-xl rounded-lg border border-navy-100 bg-white p-4">
    <h2 class="text-lg font-bold">Your polling place</h2>
    <p class="mt-1 text-sm text-navy-700">
      Polling places are assigned by ward and can change between elections, so
      the official lookup is the source of truth.
      <a href="https://myvote.wi.gov/en-us/Find-My-Polling-Place" class="font-semibold underline">
        Look yours up on MyVote ↗
      </a>
      then save it here. It stays on this device and shows up on election days.
    </p>
    <form id="polling-form" class="mt-3 flex flex-wrap gap-2">
      <label class="sr-only" for="polling-input">Polling place</label>
      <input
        id="polling-input"
        type="text"
        placeholder="e.g. West Allis City Hall, 7525 W Greenfield Ave"
        class="min-w-0 flex-1 rounded-lg border border-navy-100 bg-white px-3 py-2 text-sm"
      />
      <button type="submit" class="rounded-lg bg-navy-800 px-4 py-2 text-sm font-semibold text-white hover:bg-navy-700">
        Save
      </button>
    </form>
    <p id="polling-saved" role="status" class="mt-2 hidden text-sm">
      Saved: <strong id="polling-value"></strong>
      <button id="polling-forget" class="ml-2 text-xs underline">forget</button>
      <span class="mt-1 block text-xs text-navy-600">
        Double-check on MyVote before each election. Locations can change.
      </span>
    </p>
  </div>

  <script>
    import { savedDistrict } from "../lib/district";
    import { esc } from "../lib/html";
    import { fmtDate, partyLetter, partyStyle, shortTitle } from "../lib/format";
    import { districtAt, districtForAddress, saveDistrict } from "../lib/lookup";

    const statusEl = document.getElementById("status")!;
    const resultEl = document.getElementById("result")!;
    const repsEl = document.getElementById("reps")!;
    let reps: any = null;
    let summaries: any = null;

    // The boundaries and the point-in-polygon test live in lib/lookup, shared
    // with the homepage. What this page loads on its own is the roster it
    // needs to draw the cards.
    async function loadData() {
      if (!reps) {
        statusEl.textContent = "Loading your districts…";
        [reps, summaries] = await Promise.all([
          fetch("/data/reps.json").then((r) => r.json()),
          fetch("/data/rep-summaries.json").then((r) => r.json()).catch(() => null),
        ]);
      }
    }

    const VOTE_STYLES: Record<string, { label: string; cls: string }> = {
      yes: { label: "Aye", cls: "bg-moss-50 text-moss-600" },
      no: { label: "Nay", cls: "bg-badger-50 text-badger-700" },
    };
    const voteStyle = (option: string) =>
      VOTE_STYLES[option] ?? { label: "No vote", cls: "bg-navy-50 text-navy-600" };

    // chair, then co-chair, then vice-chair, then rank-and-file
    const roleRank = (role: string) =>
      /^chair/i.test(role) ? 0 : /^co-chair/i.test(role) ? 1 : /^vice/i.test(role) ? 2 : 3;
    const titleCase = (text: string) => text.replace(/\b\w/g, (c) => c.toUpperCase());

    const MAIL_ICON =
      '<svg class="h-4 w-4 shrink-0 text-navy-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">' +
      '<path d="M3 4h14a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Zm.6 2L10 10.4 16.4 6H3.6Z"/></svg>';
    const PHONE_ICON =
      '<svg class="h-4 w-4 shrink-0 text-navy-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">' +
      '<path d="M6.6 2.5 8.4 6 6.9 7.9a11 11 0 0 0 5.2 5.2L14 11.6l3.5 1.8v3.1a1 1 0 0 1-1.1 1A14.4 14.4 0 0 1 2.5 3.6a1 1 0 0 1 1-1.1h3.1Z"/></svg>';

    /** One number, one label. Counts read at a glance instead of buried in prose. */
    const tile = (value: number, label: string, tone = "text-ink") =>
      '<div class="rounded-lg border border-navy-100 bg-paper px-3 py-2">' +
      `<p class="text-xl font-bold tabular-nums ${tone}">${value.toLocaleString()}</p>` +
      `<p class="text-xs leading-tight text-navy-600">${esc(label)}</p></div>`;

    const contactChip = (href: string, label: string, icon: string) =>
      '<a class="inline-flex min-w-0 max-w-full items-center gap-1.5 rounded-lg border border-navy-100' +
      ` bg-paper px-2.5 py-1.5 text-sm hover:bg-navy-50" href="${esc(href)}">` +
      `${icon}<span class="truncate">${esc(label)}</span></a>`;

    const sectionLabel = (text: string) =>
      `<p class="mt-4 text-xs font-semibold uppercase tracking-wide text-navy-600">${esc(text)}</p>`;

    function repCard(seat: string, districtHref: string, slim: any, full: any): string {
      if (!slim) return "";
      const party = slim.party ?? null;
      const head =
        '<div class="flex items-start gap-3">' +
        '<div class="min-w-0 flex-1">' +
        '<a class="inline-block py-1 text-xs font-semibold uppercase tracking-wide text-navy-600 hover:underline"' +
        ` href="${esc(districtHref)}">${esc(seat)}</a>` +
        `<p class="mt-0.5"><a class="text-lg font-bold leading-tight hover:underline" href="/legislators/${esc(slim.slug)}/">${esc(slim.name)}</a></p>` +
        '</div>' +
        `<span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-xs font-bold ${partyStyle(party)}"` +
        ` role="img" aria-label="${esc(party ?? "party unknown")}"><span aria-hidden="true">${esc(partyLetter(party))}</span></span>` +
        '</div>';
      const shell = (body: string) =>
        `<div class="rounded-lg border border-navy-100 p-4">${head}${body}</div>`;
      if (!full) return shell("");

      const ballotText =
        full.election?.cycle_year === 2026
          ? full.election.on_ballot === 1
            ? "On the November 2026 ballot"
            : full.election.on_ballot === 0
              ? "Not running in November 2026"
              : ""
          : full.election
            ? `Seat next on the ballot in ${full.election.cycle_year}`
            : "";
      const onBallot = full.election?.cycle_year === 2026 && full.election.on_ballot === 1;
      const ballot = ballotText
        ? `<p class="mt-2"><span class="inline-block rounded-full px-2.5 py-1 text-xs font-semibold ${
            onBallot ? "bg-gold-100 text-navy-900" : "bg-navy-50 text-navy-700"
          }">${esc(ballotText)}</span></p>`
        : "";

      const att = full.attendance;
      const au = full.authored;
      const tiles = [
        att.total > 0
          ? tile(
              att.missed,
              att.missed === 1 ? "Floor vote missed" : "Floor votes missed",
              att.missed > 0 ? "text-badger-700" : "text-moss-600",
            )
          : "",
        att.total > 0 ? tile(att.total, "Floor votes held") : "",
        tile(au.total, "Bills led"),
        tile(au.signedOn, "Bills cosigned"),
      ].filter(Boolean);
      const statGrid = tiles.length
        ? `<div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-4">${tiles.join("")}</div>`
        : "";
      const caption =
        (au.total > 0
          ? `Of the ${au.total} bills they led this session, ${au.enacted} became law, ` +
            `${au.vetoed} ${au.vetoed === 1 ? "was" : "were"} vetoed, and ${au.noHearing} ` +
            `died without a hearing.`
          : "They have not led a bill this session.") +
        (att.total > 0 ? " Floor-vote counts cover this biennium." : "");
      const captionEl = `<p class="mt-2 text-xs leading-relaxed text-navy-600">${esc(caption)}</p>`;

      const contact = full.contact
        ? '<div class="mt-3 flex flex-wrap gap-2">' +
          contactChip(`mailto:${full.contact.email}`, full.contact.email, MAIL_ICON) +
          (full.contact.phone
            ? contactChip(
                `tel:${full.contact.phone.replace(/\D/g, "")}`,
                full.contact.phone,
                PHONE_ICON,
              )
            : "") +
          '</div>'
        : "";

      const cs = (full.committees ?? [])
        .slice()
        .sort((a: any, b: any) => roleRank(a.role) - roleRank(b.role));
      const committees = cs.length
        ? sectionLabel(`Committees \u00b7 ${cs.length}`) +
          '<div class="mt-1 flex flex-wrap gap-1.5">' +
          cs
            .map(
              (c: any) =>
                '<a class="inline-flex max-w-full items-center gap-1.5 rounded-lg border border-navy-100' +
                ` bg-paper px-2.5 py-1 text-xs leading-snug hover:bg-navy-50" href="/committees/${esc(c.slug)}/">` +
                `<span>${esc(c.name)}</span>` +
                (roleRank(c.role) < 3
                  ? `<span class="shrink-0 font-bold text-gold-600">${esc(titleCase(c.role))}</span>`
                  : "") +
                '</a>',
            )
            .join("") +
          '</div>'
        : "";

      // Two lines per vote: verdict and bill up top, the bill's own title below
      // with room to actually read it. The motion is what separates two
      // same-day votes on the same bill.
      const votes = (full.recentVotes ?? [])
        .map((v: any) => {
          const vs = voteStyle(v.option);
          return (
            '<li class="border-t border-navy-100 py-2 first:border-t-0 first:pt-0">' +
            '<div class="flex items-center gap-2">' +
            `<span class="w-16 shrink-0 rounded px-1 py-0.5 text-center text-xs font-bold ${vs.cls}">${esc(vs.label)}</span>` +
            `<a class="font-semibold hover:underline" href="/bills/${esc(v.session)}/${esc(v.slug)}/">${esc(v.identifier)}</a>` +
            `<span class="ml-auto shrink-0 text-xs tabular-nums text-navy-600">${esc(fmtDate(v.date ?? null))}</span>` +
            '</div>' +
            `<p class="mt-1 line-clamp-2 text-sm leading-snug text-navy-700">${esc(shortTitle(v.title ?? null))}</p>` +
            '<p class="mt-0.5 flex items-baseline gap-x-2 text-xs text-navy-600">' +
            `<span class="min-w-0 flex-1 truncate">${esc(v.motion ?? "")}</span>` +
            `<a class="shrink-0 py-1 underline" href="/votes/${esc(v.event)}/">roll call</a></p>` +
            '</li>'
          );
        })
        .join("");
      const voteBlock = votes
        ? sectionLabel("Latest roll-call votes") + `<ul class="mt-1">${votes}</ul>`
        : "";

      return shell(
        ballot +
          statGrid +
          captionEl +
          contact +
          committees +
          voteBlock +
          `<p class="mt-3"><a class="inline-block py-1 text-sm font-semibold underline" href="/legislators/${esc(slim.slug)}/">Full profile &rarr;</a></p>`,
      );
    }

    function show(props: { ad: number; sd: number }, announce = false) {
      saveDistrict(props);
      repsEl.innerHTML = [
        repCard(
          `Assembly District ${props.ad}`,
          `/districts/assembly-${props.ad}/`,
          reps.assembly[props.ad],
          summaries?.assembly?.[props.ad],
        ),
        repCard(
          `Senate District ${props.sd}`,
          `/districts/senate-${props.sd}/`,
          reps.senate[props.sd],
          summaries?.senate?.[props.sd],
        ),
        '<p class="rounded-lg bg-navy-50 px-3 py-2 text-sm text-navy-700">Every bill page will now pin how these two voted, and they are highlighted anywhere they appear.</p>',
      ]
        .filter(Boolean)
        .join("");
      resultEl.classList.remove("hidden");
      if (announce) {
        statusEl.textContent = `Found: Assembly District ${props.ad}, Senate District ${props.sd}.`;
        document.getElementById("result-heading")!.focus();
      }
    }

    async function resolvePoint(lng: number, lat: number) {
      const [props] = await Promise.all([districtAt(lng, lat), loadData()]);
      if (props) {
        show(props, true);
      } else {
        statusEl.textContent =
          "That point doesn't fall inside a Wisconsin legislative district.";
      }
    }

    document.getElementById("addr-form")!.addEventListener("submit", async (e) => {
      e.preventDefault();
      const addr = (document.getElementById("addr") as HTMLInputElement).value;
      statusEl.textContent = "Looking up address…";
      const [result] = await Promise.all([districtForAddress(addr), loadData()]);
      if ("error" in result) {
        statusEl.textContent = result.error;
        return;
      }
      show(result.district, true);
    });

    document.getElementById("geo-btn")!.addEventListener("click", () => {
      statusEl.textContent = "Asking your browser for your location…";
      navigator.geolocation.getCurrentPosition(
        (pos) =>
          resolvePoint(pos.coords.longitude, pos.coords.latitude).catch(
            () => (statusEl.textContent = "Couldn't load district data. Try again in a minute."),
          ),
        () => (statusEl.textContent = "Location unavailable or denied."),
      );
    });

    document.getElementById("forget")!.addEventListener("click", () => {
      localStorage.removeItem("bp-district");
      resultEl.classList.add("hidden");
      statusEl.textContent = "Forgotten.";
      (document.getElementById("addr") as HTMLInputElement).focus();
    });

    const saved = savedDistrict();
    if (saved) {
      loadData().then(() => show(saved));
    }

    // polling place: user-entered, device-only
    const pollingInput = document.getElementById("polling-input") as HTMLInputElement;
    const pollingSaved = document.getElementById("polling-saved")!;
    const pollingValue = document.getElementById("polling-value")!;
    function renderPolling() {
      const place = localStorage.getItem("bp-polling");
      pollingSaved.classList.toggle("hidden", !place);
      if (place) {
        pollingValue.textContent = place;
        pollingInput.value = place;
      }
    }
    document.getElementById("polling-form")!.addEventListener("submit", (e) => {
      e.preventDefault();
      const value = pollingInput.value.trim();
      if (value) {
        localStorage.setItem("bp-polling", value);
        renderPolling();
      }
    });
    document.getElementById("polling-forget")!.addEventListener("click", () => {
      localStorage.removeItem("bp-polling");
      pollingInput.value = "";
      renderPolling();
      pollingInput.focus();
    });
    renderPolling();
  </script>
</Base>
