---
import Base from "../layouts/Base.astro";
import JsonLd from "../components/JsonLd.astro";
import StatusBadge from "../components/StatusBadge.astro";
import { builtSessions, sessionStats, recentlyActedBills } from "../lib/db";
import { billSlug, fmtDate, shortTitle } from "../lib/format";
const sessions = builtSessions();
const current = sessions.find((s) => s.id === "2025") ?? sessions[0];
const stats = sessionStats(current.id);
const recent = recentlyActedBills(sessions.map((s) => s.id), 8);
---

<Base
  title="Wisconsin politics, in plain language"
  description="Track every Wisconsin bill, vote, veto and campaign contribution. Free, independent, and built entirely from official public records."
>
  <JsonLd
    data={{
      "@type": "WebSite",
      name: "Badger Politics",
      url: "https://badgerpolitics.org/",
      description:
        "Free, independent tracking of the Wisconsin Legislature: every bill, every vote, and every committee graveyard.",
      inLanguage: "en-US",
      isAccessibleForFree: true,
      publisher: {
        "@type": "Organization",
        name: "Badger Politics",
        url: "https://badgerpolitics.org/",
      },
      potentialAction: {
        "@type": "SearchAction",
        target: {
          "@type": "EntryPoint",
          urlTemplate: "https://badgerpolitics.org/?q={search_term_string}",
        },
        "query-input": "required name=search_term_string",
      },
    }}
  />
  <section class="py-8 text-center">
    <h1 class="mx-auto max-w-2xl text-4xl font-bold tracking-tight">
      What is the Wisconsin Legislature doing?
    </h1>
    <p class="mx-auto mt-3 max-w-xl text-lg text-navy-700">
      Every bill, every vote, and every committee graveyard. Plain language,
      updated nightly from official records.
    </p>
    <div class="mx-auto mt-6 max-w-xl text-left">
      <label class="sr-only" for="q">Search bills</label>
      <input
        id="q"
        type="search"
        placeholder="Search bills. Try “child marriage” or “AB 656”"
        class="w-full rounded-lg border border-navy-100 bg-white px-4 py-3 shadow-sm"
        autocomplete="off"
      />
      <p id="search-status" role="status" class="sr-only"></p>
      <div id="search-results" class="mt-2 space-y-2"></div>
    </div>
    <p class="mt-4 text-sm">
      <a href="/my-reps/" class="font-semibold text-navy-700 underline">
        Enter your address once
      </a>
      and every page shows how <em>your</em> legislators voted.
    </p>
  </section>

  <section class="grid gap-3 sm:grid-cols-3">
    <a href={`/bills/${current.id}/`} class="rounded-lg border border-navy-100 bg-white p-4 text-center hover:border-navy-600">
      <div class="text-3xl font-bold">{stats.bills.toLocaleString()}</div>
      <div class="text-sm text-navy-600">proposals this session →</div>
    </a>
    <a href={`/bills/${current.id}/?status=enacted`} class="rounded-lg border border-navy-100 bg-white p-4 text-center hover:border-moss-600">
      <div class="text-3xl font-bold text-moss-600">{stats.enacted}</div>
      <div class="text-sm text-navy-600">became law →</div>
    </a>
    <a href={`/hearing-none/${current.id}/`} class="rounded-lg border border-badger-600/30 bg-badger-50 p-4 text-center hover:border-badger-600">
      <div class="text-3xl font-bold text-badger-700">{stats.graveyard.toLocaleString()}</div>
      <div class="text-sm text-badger-700">died without a hearing →</div>
    </a>
  </section>

  <section class="mt-10">
    <h2 class="text-xl font-bold">Recently acted on</h2>
    <ul class="mt-2 divide-y divide-navy-100 rounded-lg border border-navy-100 bg-white">
      {recent.map((b) => (
        <li class="flex items-center gap-3 px-4 py-2.5 text-sm">
          <a href={`/bills/${b.session_id}/${billSlug(b.identifier)}/`} class="w-20 shrink-0 font-bold underline">
            {b.identifier}
          </a>
          <span class="min-w-0 flex-1 truncate">{shortTitle(b.title)}</span>
          <StatusBadge status={b.status} />
          <span class="hidden w-24 shrink-0 text-right text-xs text-navy-600 sm:block">
            {fmtDate(b.latest_action_date)}
          </span>
        </li>
      ))}
    </ul>
  </section>

  <script is:inline type="module">
    // Thin custom UI over the Pagefind API.
    // is:inline (needed for the runtime /pagefind/ import) can't reach the
    // bundled lib/html escaper, so this one script carries its own copy
    const esc = (s) =>
      s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]);
    const input = document.getElementById("q");
    const box = document.getElementById("search-results");
    const status = document.getElementById("search-status");
    let pagefind;
    let timer;

    // Pagefind fuzzes unmatched terms down to fragments ("pedophiles" can
    // highlight "P." or even "PEOs"). A highlight only validates a result
    // if it shares a real stem with some query word.
    const degenerate = (excerpt, query) => {
      const words = query.toLowerCase().split(/\s+/).map((w) => w.replace(/[^a-z0-9]/g, ""));
      const marks = [...excerpt.matchAll(/<mark>(.*?)<\/mark>/g)].map((m) =>
        m[1].replace(/[^A-Za-z0-9]/g, "").toLowerCase(),
      );
      const shared = (a, b) => {
        let n = 0;
        while (n < a.length && n < b.length && a[n] === b[n]) n++;
        return n;
      };
      const valid = (m) =>
        m.length >= 3 && words.some((w) => shared(m, w) >= Math.min(4, m.length, w.length));
      return marks.length > 0 && !marks.some(valid);
    };

    let seq = 0;
    async function run() {
      const mySeq = ++seq;
      const q = input.value.trim();
      if (q.length < 2) {
        box.innerHTML = "";
        status.textContent = "";
        return;
      }
      pagefind ??= await import("/pagefind/pagefind.js");
      const search = await pagefind.debouncedSearch(q);
      if (search === null || mySeq !== seq) return; // superseded
      // load excerpts lazily: 8 first, top up only if the junk filter bites
      const loaded = await Promise.all(search.results.slice(0, 8).map((r) => r.data()));
      if (mySeq !== seq) return;
      let good = loaded.filter((r) => !degenerate(r.excerpt, q));
      if (good.length < 8 && search.results.length > 8) {
        const extra = await Promise.all(search.results.slice(8, 12).map((r) => r.data()));
        if (mySeq !== seq) return;
        good = good.concat(extra.filter((r) => !degenerate(r.excerpt, q)));
      }
      good = good.slice(0, 8);
      box.innerHTML = good.length
        ? good
            .map(
              (r) => `
        <a href="${esc(r.url)}" class="block rounded-lg border border-navy-100 bg-white p-3 hover:border-navy-600">
          <span class="font-bold">${esc(r.meta?.title ?? r.url)}</span>
          <span class="mt-0.5 block text-sm text-navy-700">…${r.excerpt}…</span>
        </a>`,
            )
            .join("")
        : `<p class="rounded-lg border border-navy-100 bg-white p-3 text-sm text-navy-600">No bills match “${q.replace(/[<>&]/g, "")}”.</p>`;
      status.textContent = good.length
        ? `${good.length} result${good.length > 1 ? "s" : ""}. Press Enter to open the first.`
        : "No results.";
    }

    input.addEventListener("input", () => {
      clearTimeout(timer);
      timer = setTimeout(run, 300);
    });
    // ?q= lets other pages (404, external links) hand off a search
    const q = new URLSearchParams(location.search).get("q");
    if (q) {
      input.value = q;
      input.focus();
      run();
    }
    input.addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        box.querySelector("a")?.click();
      } else if (e.key === "Escape") {
        box.innerHTML = "";
        status.textContent = "";
      }
    });
  </script>
</Base>
