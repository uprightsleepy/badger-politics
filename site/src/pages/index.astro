---
import Base from "../layouts/Base.astro";
import JsonLd from "../components/JsonLd.astro";
import StatusBadge from "../components/StatusBadge.astro";
import BillFlow from "../components/BillFlow.astro";
import { builtSessions, sessionBillFlow, recentlyActedBills } from "../lib/db";
import { billSlug, fmtDate, shortTitle } from "../lib/format";
const sessions = builtSessions();
const current = sessions.find((s) => s.id === "2025") ?? sessions[0];
const recent = recentlyActedBills(sessions.map((s) => s.id), 6);
const flow = sessionBillFlow(current.id);
const sessionName = current.name ?? current.id;
---

<Base
  title="Wisconsin Politics, in Plain Language"
  description="Track every Wisconsin bill, vote, veto and campaign contribution. Free, independent, and built entirely from official public records."
>
  <JsonLd
    data={{
      "@type": "WebSite",
      name: "Badger Politics",
      url: "https://badgerpolitics.org/",
      description:
        "Free, independent tracking of the Wisconsin Legislature: every bill, every vote, and every committee graveyard.",
      inLanguage: "en-US",
      isAccessibleForFree: true,
      publisher: {
        "@type": "Organization",
        name: "Badger Politics",
        url: "https://badgerpolitics.org/",
      },
      potentialAction: {
        "@type": "SearchAction",
        target: {
          "@type": "EntryPoint",
          urlTemplate: "https://badgerpolitics.org/?q={search_term_string}",
        },
        "query-input": "required name=search_term_string",
      },
    }}
  />
  <section class="py-8">
    <h1 class="max-w-3xl text-4xl font-bold tracking-tight sm:text-5xl">
      Wisconsin politics, without the Capitol jargon.
    </h1>
    <p class="mt-3 max-w-2xl text-lg text-navy-700">
      Bills, votes, lawmakers, money and elections, built from official state
      records and explained in plain language.
    </p>

    <div class="mt-6 grid gap-4 lg:grid-cols-2">
      <div class="rounded-lg border border-navy-100 bg-white p-4">
        <h2 id="home-addr-heading" class="font-bold">Start with your address</h2>
        <p id="home-addr-intro" class="mt-1 text-sm text-navy-700">
          See your two legislators, how they voted, what they sponsored, and who
          funds them. After that, every page marks them for you.
        </p>
        <div id="home-addr-saved" class="hidden">
          <p id="home-addr-districts" class="mt-1 text-sm text-navy-700"></p>
          <div class="mt-3 flex flex-wrap gap-2">
            <button
              type="button"
              id="home-addr-change"
              class="rounded-lg border border-navy-100 bg-white px-4 py-2 text-sm font-semibold hover:bg-navy-50"
            >
              Change address
            </button>
            <button
              type="button"
              id="home-addr-forget"
              class="rounded-lg border border-navy-100 bg-white px-4 py-2 text-sm text-navy-700 hover:bg-navy-50"
            >
              Forget
            </button>
          </div>
          <p class="mt-2 text-xs text-navy-600">
            Saved in this browser only. Every page marks your two legislators.
          </p>
        </div>
        <form id="home-addr-form" class="mt-3 flex flex-wrap gap-2">
          <label class="sr-only" for="home-addr">Your Wisconsin address</label>
          <input
            id="home-addr"
            type="text"
            required
            autocomplete="street-address"
            placeholder="e.g. 7120 W National Ave, West Allis"
            class="min-w-0 flex-1 rounded-lg border border-navy-100 bg-white px-3 py-2.5"
          />
          <button
            type="submit"
            class="rounded-lg bg-navy-800 px-4 py-2.5 font-semibold text-white hover:bg-navy-700"
          >
            Find
          </button>
          <button
            type="button"
            id="home-geo"
            class="rounded-lg border border-navy-100 bg-white px-4 py-2.5 hover:bg-navy-50"
          >
            Use my location
          </button>
        </form>
        <p id="home-addr-status" role="status" class="mt-2 text-sm text-navy-700"></p>
        <p id="home-addr-privacy" class="mt-2 flex items-start gap-1.5 text-xs text-navy-600">
          <svg class="mt-0.5 h-3.5 w-3.5 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 1.5 3.5 4v5.2c0 4 2.8 7.7 6.5 8.8 3.7-1.1 6.5-4.8 6.5-8.8V4L10 1.5Zm0 2.1 4.5 1.7v4.9c0 3-2 5.9-4.5 6.8-2.5-.9-4.5-3.8-4.5-6.8V5.3L10 3.6Z"/></svg>
          <span>
            <strong>Private by design.</strong> Your address goes to the U.S.
            Census geocoder to identify your district and is never stored. The
            district stays in this browser.
          </span>
        </p>
      </div>

      <div class="rounded-lg border border-navy-100 bg-white p-4">
        <h2 class="font-bold">Or look something up</h2>
        <p class="mt-1 text-sm text-navy-700">
          Search every bill, legislator, committee and campaign donor.
        </p>
        <div class="relative mt-3">
          <label class="sr-only" for="q">Search bills, people and committees</label>
          <input
            id="q"
            type="search"
            placeholder="Try child care, property tax, or AB 656"
            class="w-full rounded-lg border border-navy-100 bg-white px-4 py-2.5"
            autocomplete="off"
          />
          {/* facets baked into the index at build time; "All" is no filter */}
          <div id="search-filters" class="mt-2 flex flex-wrap items-center gap-1.5" data-pagefind-ignore>
            {["All", "Bills", "Legislators", "Committees", "Topics", "Districts", "Campaign money"].map((t, i) => (
              <button
                type="button"
                data-type-chip={t === "All" ? "" : t === "Bills" ? "Bill|Resolution" : t === "Campaign money" ? "Campaign money" : t.slice(0, -1)}
                aria-pressed={i === 0 ? "true" : "false"}
                class="rounded-full border border-navy-100 px-2.5 py-1 text-xs font-semibold text-navy-700 transition-colors hover:border-navy-600 aria-pressed:border-navy-800 aria-pressed:bg-navy-800 aria-pressed:text-white"
              >
                {t === "Campaign money" ? "Money" : t}
              </button>
            ))}
            <span id="bill-filters" class="hidden items-center gap-1.5">
              <label class="sr-only" for="f-session">Session</label>
              <select id="f-session" class="rounded-full border border-navy-100 bg-white px-2 py-1 text-xs text-navy-700">
                <option value="">All sessions</option>
                {sessions.map((se) => (
                  <option value={se.name ?? se.id}>{se.name ?? se.id}</option>
                ))}
              </select>
              <label class="sr-only" for="f-outcome">Outcome</label>
              <select id="f-outcome" class="rounded-full border border-navy-100 bg-white px-2 py-1 text-xs text-navy-700">
                <option value="">Any outcome</option>
                <option>Became law</option>
                <option>Vetoed</option>
                <option>Died at session end</option>
                <option>Passed one chamber</option>
                <option>Adopted</option>
              </select>
            </span>
          </div>
          <p id="search-status" role="status" class="sr-only"></p>
          <div
            id="search-results"
            class="absolute inset-x-0 top-full z-40 mt-2 hidden max-h-[24rem] space-y-2 overflow-y-auto rounded-lg border border-navy-100 bg-paper p-2 shadow-lg"
          >
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="my-reps-home" class="mt-2 hidden">
    <h2 class="text-xl font-bold">Your representatives</h2>
    <div id="my-reps-cards" class="mt-2 grid gap-3 sm:grid-cols-2" data-no-rep-highlight></div>
    <p class="mt-2 text-sm">
      <a href="/my-reps/" class="underline">Full profiles and recent votes &rarr;</a>
    </p>
  </section>

  <section class="mt-10">
    <h2 class="text-xl font-bold">
      What happened to {flow.introduced.toLocaleString()} bills?
    </h2>
    <p class="mt-1 max-w-3xl text-sm text-navy-600">
      Every bill of the {sessionName}, traced from introduction to where it
      stopped. The farther a path reaches, the farther the bill got; the
      branches add up to the total at each split, counted from the official
      bill histories.
    </p>
    <BillFlow flow={flow} session={current.id} />
    <p class="mt-3 max-w-3xl text-xs text-navy-600">
      Bills only. The {flow.resolutions.toLocaleString()} resolutions this
      session are counted separately, because they never go to the governor
      and cannot become law.
      <a href={`/bills/${current.id}/`} class="inline-block underline">Browse them all &rarr;</a>
    </p>
  </section>

  <section class="mt-10">
    <h2 class="text-xl font-bold">Latest activity</h2>
    <p class="mt-1 text-sm text-navy-600">
      The most recent action on any bill, from the official histories.
    </p>
    <ul class="mt-3 grid gap-2 sm:grid-cols-2">
      {recent.map((b) => (
        <li>
          <a
            href={`/bills/${b.session_id}/${billSlug(b.identifier)}/`}
            class="flex h-full flex-col gap-1.5 rounded-lg border border-navy-100 bg-white p-3 hover:border-navy-600"
          >
            <span class="flex items-center gap-2">
              <span class="font-bold underline">{b.identifier}</span>
              <StatusBadge status={b.status} short />
              <span class="ml-auto text-xs text-navy-600">{fmtDate(b.latest_action_date)}</span>
            </span>
            <span class="line-clamp-2 text-sm leading-snug text-navy-700">{shortTitle(b.title)}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-3 text-sm">
      <a href={`/bills/${current.id}/`} class="underline">
        All {(flow.introduced + flow.resolutions).toLocaleString()} proposals this session &rarr;
      </a>
    </p>
  </section>

  <section class="mt-10 rounded-lg border border-navy-100 bg-white p-4">
    <h2 class="font-bold">Official records. No ads. No tracking.</h2>
    <ul class="mt-2 grid gap-x-6 gap-y-1 text-sm text-navy-700 sm:grid-cols-2">
      <li>Rebuilt nightly from Wisconsin state sources</li>
      <li>Every page links to the official record</li>
      <li>Your address is never stored</li>
      <li>Corrections are public; the data is free to reuse</li>
    </ul>
    <p class="mt-2 text-sm">
      <a href="/about/" class="underline">How Badger Politics works</a> &middot;
      <a href="/data/" class="underline">Data &amp; API</a>
    </p>
  </section>

  <script is:inline type="module">
    // Thin custom UI over the Pagefind API.
    // is:inline (needed for the runtime /pagefind/ import) can't reach the
    // bundled lib/html escaper, so this one script carries its own copy
    const esc = (s) =>
      s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]);
    const input = document.getElementById("q");
    const box = document.getElementById("search-results");
    const status = document.getElementById("search-status");
    const chips = [...document.querySelectorAll("[data-type-chip]")];
    const billOnly = document.getElementById("bill-filters");
    const fSession = document.getElementById("f-session");
    const fOutcome = document.getElementById("f-outcome");
    let pagefind;
    let timer;

    // "Bills" is two page types, so a chip carries any-of values split on |
    const activeFilters = () => {
      const chip = chips.find((c) => c.getAttribute("aria-pressed") === "true");
      const types = chip?.dataset.typeChip ? chip.dataset.typeChip.split("|") : null;
      const f = {};
      if (types) f.type = { any: types };
      const billsMode = types?.includes("Bill") ?? false;
      billOnly.classList.toggle("hidden", !billsMode);
      billOnly.classList.toggle("inline-flex", billsMode);
      if (billsMode && fSession.value) f.session = fSession.value;
      if (billsMode && fOutcome.value) f.outcome = fOutcome.value;
      return f;
    };
    for (const c of chips) {
      c.addEventListener("click", () => {
        for (const o of chips) o.setAttribute("aria-pressed", String(o === c));
        run();
      });
    }
    fSession.addEventListener("change", run);
    fOutcome.addEventListener("change", run);

    // Pagefind fuzzes unmatched terms down to fragments ("pedophiles" can
    // highlight "P." or even "PEOs"). A highlight only validates a result
    // if it shares a real stem with some query word.
    const degenerate = (excerpt, query) => {
      const words = query.toLowerCase().split(/\s+/).map((w) => w.replace(/[^a-z0-9]/g, ""));
      const marks = [...excerpt.matchAll(/<mark>(.*?)<\/mark>/g)].map((m) =>
        m[1].replace(/[^A-Za-z0-9]/g, "").toLowerCase(),
      );
      const shared = (a, b) => {
        let n = 0;
        while (n < a.length && n < b.length && a[n] === b[n]) n++;
        return n;
      };
      const valid = (m) =>
        m.length >= 3 && words.some((w) => shared(m, w) >= Math.min(4, m.length, w.length));
      return marks.length > 0 && !marks.some(valid);
    };

    // Recent searches, device-only like everything else personal here.
    const RECENTS_KEY = "bp-recent-q";
    const recents = () => {
      try { return JSON.parse(localStorage.getItem(RECENTS_KEY)) ?? []; } catch { return []; }
    };
    const remember = (q) => {
      try {
        const list = [q, ...recents().filter((r) => r !== q)].slice(0, 6);
        localStorage.setItem(RECENTS_KEY, JSON.stringify(list));
      } catch {}
    };
    const showRecents = () => {
      const list = recents();
      if (!list.length || input.value.trim().length >= 2) return;
      box.innerHTML =
        `<p class="flex items-baseline justify-between px-1 text-xs text-navy-600"><span class="font-semibold uppercase tracking-wide">Recent searches</span><button type="button" data-clear-recents class="underline">Clear</button></p>` +
        list.map((q) => `<button type="button" data-recent="${esc(q)}" class="block w-full rounded-lg border border-navy-100 bg-white px-3 py-2 text-left text-sm hover:border-navy-600">${esc(q)}</button>`).join("");
      box.classList.remove("hidden");
    };
    box.addEventListener("click", (e) => {
      const r = e.target.closest("[data-recent]");
      if (r) { input.value = r.dataset.recent; run(); return; }
      if (e.target.closest("[data-clear-recents]")) {
        try { localStorage.removeItem(RECENTS_KEY); } catch {}
        box.innerHTML = ""; box.classList.add("hidden"); input.focus();
      }
      if (e.target.closest("[data-clear-filters]")) {
        for (const c of chips) c.setAttribute("aria-pressed", String(!c.dataset.typeChip));
        fSession.value = ""; fOutcome.value = "";
        run();
      }
    });
    input.addEventListener("focus", showRecents);

    // one compact metadata line per result, from the facets baked into the
    // index: "Bill · 2025-2026 Regular Session · Became law"
    const metaLine = (filters) => {
      if (!filters) return "";
      const first = (k) => filters[k]?.[0];
      const parts = [first("type"), first("session") ?? first("party"),
                     first("outcome") ?? first("chamber")].filter(Boolean);
      return parts.length
        ? `<span class="mb-0.5 block text-xs text-navy-600">${esc(parts.join(" · "))}</span>`
        : "";
    };

    // an exact identifier should beat fuzzy prose matches
    const BILL_ID = /^(ab|sb|ajr|sjr|ar|sr)\s*(\d+)$/i;
    const SEAT = /^(assembly|senate)\s+(?:district\s+)?(\d{1,3})$/i;

    let seq = 0;
    async function run() {
      const mySeq = ++seq;
      const q = input.value.trim();
      if (q.length < 2) {
        box.innerHTML = "";
        box.classList.add("hidden");
        status.textContent = "";
        showRecents();
        return;
      }
      pagefind ??= await import("/pagefind/pagefind.js");
      const search = await pagefind.debouncedSearch(q, { filters: activeFilters() });
      if (search === null || mySeq !== seq) return; // superseded
      // load excerpts lazily: 8 first, top up only if the junk filter bites
      const loaded = await Promise.all(search.results.slice(0, 8).map((r) => r.data()));
      if (mySeq !== seq) return;
      let good = loaded.filter((r) => !degenerate(r.excerpt, q));
      if (good.length < 8 && search.results.length > 8) {
        const extra = await Promise.all(search.results.slice(8, 12).map((r) => r.data()));
        if (mySeq !== seq) return;
        good = good.concat(extra.filter((r) => !degenerate(r.excerpt, q)));
      }
      good = good.slice(0, 8);
      // exact identifiers first: "sb 268" ranks the bill above every page
      // that merely mentions it
      const idMatch = q.match(BILL_ID);
      if (idMatch) {
        const ident = `${idMatch[1].toUpperCase()} ${idMatch[2]}`;
        good.sort((a, b) =>
          Number((b.meta?.title ?? "").startsWith(ident)) -
          Number((a.meta?.title ?? "").startsWith(ident)));
      }
      const seat = q.match(SEAT);
      const seatCard = seat
        ? `<a href="/districts/${seat[1].toLowerCase()}-${Number(seat[2])}/" class="block rounded-lg border border-navy-600 bg-white p-3 hover:bg-navy-50"><span class="mb-0.5 block text-xs text-navy-600">District</span><span class="font-bold">${seat[1][0].toUpperCase()}${seat[1].slice(1).toLowerCase()} District ${Number(seat[2])}</span></a>`
        : "";
      if (good.length) remember(q);
      const anyFilter =
        chips.some((c) => c.dataset.typeChip && c.getAttribute("aria-pressed") === "true") ||
        fSession.value || fOutcome.value;
      box.innerHTML = good.length || seatCard
        ? seatCard + good
            .map(
              (r) => `
        <a href="${esc(r.url)}" class="block rounded-lg border border-navy-100 bg-white p-3 hover:border-navy-600">
          ${metaLine(r.filters)}<span class="font-bold">${esc(r.meta?.title ?? r.url)}</span>
          <span class="mt-0.5 block text-sm text-navy-700">…${r.excerpt}…</span>
        </a>`,
            )
            .join("")
        : `<div class="rounded-lg border border-navy-100 bg-white p-3 text-sm text-navy-600">
             <p>Nothing matches “${q.replace(/[<>&]/g, "")}”${anyFilter ? " with these filters" : ""}.</p>
             <p class="mt-2 flex flex-wrap gap-x-4 gap-y-1">
               ${anyFilter ? '<button type="button" data-clear-filters class="font-semibold underline">Clear filters</button>' : ""}
               <a href="/my-reps/" class="underline">Find my legislators</a>
               <a href="https://docs.legis.wisconsin.gov/search?q=${encodeURIComponent(q)}" class="underline">Search the official record</a>
             </p>
           </div>`;
      box.classList.remove("hidden");
      status.textContent = good.length
        ? `${good.length} result${good.length > 1 ? "s" : ""}. Press Enter to open the first.`
        : "No results.";
    }

    input.addEventListener("input", () => {
      clearTimeout(timer);
      timer = setTimeout(run, 300);
    });
    // ?q= lets other pages (404, external links) hand off a search
    const q = new URLSearchParams(location.search).get("q");
    if (q) {
      input.value = q;
      input.focus();
      run();
    }
    input.addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        box.querySelector("a")?.click();
      } else if (e.key === "Escape") {
        box.innerHTML = "";
        box.classList.add("hidden");
        status.textContent = "";
      }
    });
    // clicking away closes the panel; returning to the box brings it back
    const searchCard = box.closest(".rounded-lg.border");
    document.addEventListener("pointerdown", (e) => {
      if (!searchCard.contains(e.target)) box.classList.add("hidden");
    });
    input.addEventListener("focus", () => {
      if (box.innerHTML.trim()) box.classList.remove("hidden");
    });
  </script>

<script>
  import { savedDistrict, saveDistrict, forgetDistrict } from "../lib/district";
  import { forgetCityDistrict, saveCityDistrict, savedCityDistrict } from "../lib/cityDistrict";
  import { cityDistrictAt, districtAt, districtForAddress } from "../lib/lookup";
  import { esc } from "../lib/html";
  import { partyChipHtml } from "../lib/format";
  import type { RepSlim, RepSummaries, RepSummary, Reps } from "../lib/wire";

  // Returning visitors get their own two legislators on the front page.
  // Everything here is read from localStorage and a static JSON file; the
  // site never learns who is asking.
  // The lookup completes on this page. Sending someone to /my-reps/ to
  // finish the homepage's primary action was a needless hand-off.
  const form = document.getElementById("home-addr-form") as HTMLFormElement | null;
  const addr = document.getElementById("home-addr") as HTMLInputElement | null;
  const addrStatus = document.getElementById("home-addr-status");
  const geoBtn = document.getElementById("home-geo");

  const heading = document.getElementById("home-addr-heading");
  const cardSaved = document.getElementById("home-addr-saved");
  const districtsLine = document.getElementById("home-addr-districts");
  // the prompt-state pieces, toggled as a set
  const promptEls = ["home-addr-intro", "home-addr-form", "home-addr-privacy"]
    .map((id) => document.getElementById(id));

  const showSaved = (d: { ad: number; sd: number }) => {
    if (heading) heading.textContent = "Your districts";
    if (districtsLine) {
      const c = savedCityDistrict();
      const city = c && (c.t === "milwaukee" ? "Milwaukee" : c.t === "westalliswi" ? "West Allis" : null);
      districtsLine.textContent = `Assembly District ${d.ad}, Senate District ${d.sd}.`
        + (city ? ` ${city} Common Council District ${c.d}.` : "");
    }
    for (const el of promptEls) el?.classList.add("hidden");
    cardSaved?.classList.remove("hidden");
    if (addrStatus) addrStatus.textContent = "";
  };
  const showPrompt = () => {
    if (heading) heading.textContent = "Start with your address";
    for (const el of promptEls) el?.classList.remove("hidden");
    cardSaved?.classList.add("hidden");
    addr?.focus();
  };

  const resolveCity = async (lng: number, lat: number) => {
    // covered-city lookup on the same point; the address goes nowhere new
    const hit = await cityDistrictAt(lng, lat).catch(() => null);
    if (hit) saveCityDistrict({ t: hit.tenant, d: hit.district });
    else forgetCityDistrict();
  };

  const settle = (d: { ad: number; sd: number }) => {
    saveDistrict(d);
    showSaved(d);
    render(d);
  };

  document.getElementById("home-addr-change")?.addEventListener("click", showPrompt);
  document.getElementById("home-addr-forget")?.addEventListener("click", () => {
    forgetDistrict();
    forgetCityDistrict();
    document.getElementById("my-reps-home")?.classList.add("hidden");
    showPrompt();
    if (addrStatus) addrStatus.textContent = "Forgotten.";
  });

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!addr?.value.trim()) return;
    if (addrStatus) addrStatus.textContent = "Looking up your address…";
    const result = await districtForAddress(addr.value.trim());
    if ("error" in result) {
      if (addrStatus) addrStatus.textContent = result.error;
      return;
    }
    await resolveCity(result.lng, result.lat);
    settle(result.district);
  });

  geoBtn?.addEventListener("click", () => {
    if (addrStatus) addrStatus.textContent = "Asking your browser for your location…";
    navigator.geolocation.getCurrentPosition(
      async (pos) => {
        const d = await districtAt(pos.coords.longitude, pos.coords.latitude);
        if (!d) {
          if (addrStatus) addrStatus.textContent = "That location isn't inside a Wisconsin district.";
          return;
        }
        await resolveCity(pos.coords.longitude, pos.coords.latitude);
        settle(d);
      },
      () => {
        if (addrStatus) addrStatus.textContent = "Location unavailable or denied.";
      },
    );
  });

  const saved = savedDistrict();
  if (saved) {
    showSaved(saved);
    render(saved);
  }

  function render(saved: { ad: number; sd: number }) {
    const section = document.getElementById("my-reps-home")!;
    const cards = document.getElementById("my-reps-cards")!;
    Promise.all([
      fetch("/data/reps.json").then((r) => r.json()),
      fetch("/data/rep-summaries.json").then((r) => r.json()).catch(() => null),
    ])
      .then(([reps, summaries]: [Reps, RepSummaries | null]) => {
        const seats: [string, string, RepSlim | undefined, RepSummary | undefined][] = [
          [`Assembly District ${saved.ad}`, `/districts/assembly-${saved.ad}/`,
           reps.assembly?.[saved.ad], summaries?.assembly?.[saved.ad]],
          [`Senate District ${saved.sd}`, `/districts/senate-${saved.sd}/`,
           reps.senate?.[saved.sd], summaries?.senate?.[saved.sd]],
        ];
        const html = seats
          .map(([seat, districtHref, slim, full]) => {
            if (!slim) return "";
            const uid = `pc-${slim.slug.replace(/[^a-z0-9]/gi, "")}`;
            const photo = slim.image
              ? `<img src="${esc(slim.image)}" alt="" width="56" height="56" loading="lazy" decoding="async" class="h-14 w-14 shrink-0 rounded-full border border-navy-100 bg-navy-50 object-cover object-[50%_25%]">`
              : `<svg viewBox="0 0 48 48" width="56" height="56" class="h-14 w-14 shrink-0 rounded-full border border-navy-100" role="img" aria-label="No official portrait on file for ${esc(slim.name)}">` +
                `<circle cx="24" cy="24" r="24" fill="var(--color-navy-50)"></circle>` +
                `<clipPath id="${uid}"><circle cx="24" cy="24" r="24"></circle></clipPath>` +
                `<g clip-path="url(#${uid})" fill="var(--color-navy-300)">` +
                `<circle cx="24" cy="19" r="7.5"></circle>` +
                `<rect x="10" y="30.5" width="28" height="24" rx="12"></rect></g></svg>`;
            const stat = (value: number, label: string) =>
              `<div><p class="text-lg font-bold tabular-nums">${value.toLocaleString()}</p>` +
              `<p class="text-xs leading-tight text-navy-600">${esc(label)}</p></div>`;
            const stats = full
              ? `<div class="mt-3 grid grid-cols-3 gap-2">` +
                stat(full.attendance?.missed ?? 0, "Floor votes missed") +
                stat(full.authored?.total ?? 0, "Bills led") +
                stat(full.authored?.signedOn ?? 0, "Bills cosigned") +
                `</div>`
              : "";
            const latest = full?.recentVotes?.[0];
            const lastVote = latest
              ? `<p class="mt-3 border-t border-navy-100 pt-2 text-sm text-navy-700">Most recent vote: ` +
                `<strong>${latest.option === "yes" ? "Aye" : latest.option === "no" ? "Nay" : "No vote"}</strong> on ` +
                `<a class="underline" href="/bills/${esc(latest.session)}/${esc(latest.slug)}/">${esc(latest.identifier)}</a></p>`
              : "";
            return (
              `<div class="rounded-lg border border-navy-100 bg-white p-4">` +
              `<div class="flex items-start gap-3">` +
              photo +
              `<div class="min-w-0 flex-1">` +
              `<a class="inline-block py-1 text-xs font-semibold uppercase tracking-wide text-navy-600 hover:underline" href="${esc(districtHref)}">${esc(seat)}</a>` +
              `<p class="mt-0.5"><a class="text-lg font-bold leading-tight hover:underline" href="/legislators/${esc(slim.slug)}/">${esc(slim.name)}</a></p>` +
              `</div>` +
              partyChipHtml(slim.party, { dims: "h-6 w-6 text-xs" }) +
              `</div>${stats}${lastVote}</div>`
            );
          })
          .join("");
        if (html) {
          cards.innerHTML = html;
          section.classList.remove("hidden");
        }
      })
      .catch(() => {});
  }
</script>
</Base>
