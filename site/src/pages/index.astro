---
import Base from "../layouts/Base.astro";
import { PLACES_KEY } from "../lib/placesKey";
import JsonLd from "../components/JsonLd.astro";
import BillList from "../components/BillList.astro";
import SessionOutcomes from "../components/SessionOutcomes.astro";
import { builtSessions, recentlyActedBills, subjectIndex } from "../lib/db";
import { subjectSlug } from "../lib/subjects";
import { sessionPlainName } from "../lib/format";
import { sessionCounts, sessionOutcomes } from "../lib/billRows";
const sessions = builtSessions();
const current = sessions.find((s) => s.id === "2025") ?? sessions[0];
const recent = recentlyActedBills(sessions.map((s) => s.id), 6);
const outcomes = sessionOutcomes(current.id);
const everything = sessionCounts(current.id).total;
const sessionName = current.name ?? current.id;
const plain = sessionPlainName(current.id, sessionName);
const n = (x: number) => x.toLocaleString();
const SEARCH_TYPES: [string, string][] = [
  // label, Pagefind type facet ("Bills" is two page types, split on |)
  ["All", ""],
  ["Bills", "Bill|Resolution"],
  ["Lawmakers", "Legislator"],
  ["Committees", "Committee"],
  ["Topics", "Topic"],
  ["Districts", "District"],
  ["Money", "Campaign money"],
];
// Topic doors in the words people use. Each opens the Legislature's own
// subject page when this build has one, otherwise a search for the topic.
const subjectSlugs = new Set(subjectIndex().map((x) => x.slug));
const TOPICS: { label: string; examples: string; subjects: string[]; q: string }[] = [
  { label: "Schools", examples: "School funding, vouchers, testing, teachers", subjects: ["Education", "Public instruction", "School districts"], q: "school" },
  { label: "Taxes", examples: "Property, income and sales taxes", subjects: ["Taxation", "Property tax", "Income tax"], q: "tax" },
  { label: "Roads and transit", examples: "Highways, road repair, buses, the gas tax", subjects: ["Highways", "Transportation"], q: "highway" },
  { label: "Health care", examples: "Medicaid, prescriptions, hospitals, insurance", subjects: ["Health", "Medical assistance", "Health insurance"], q: "health" },
  { label: "Guns", examples: "Concealed carry, background checks, hunting", subjects: ["Weapons", "Firearms"], q: "firearm" },
  { label: "Abortion", examples: "Abortion laws and reproductive health care", subjects: ["Abortion"], q: "abortion" },
  { label: "Water and land", examples: "PFAS, lakes, farms, state parks", subjects: ["Natural resources", "Water", "Environment"], q: "water" },
  { label: "Jobs and wages", examples: "Minimum wage, unemployment, workers' rights", subjects: ["Employment", "Labor"], q: "employment" },
];
const topicHref = (t: (typeof TOPICS)[number]) => {
  const slug = t.subjects.map(subjectSlug).find((x) => subjectSlugs.has(x));
  return slug ? `/subjects/${slug}/` : `/?q=${encodeURIComponent(t.q)}#search`;
};
const FIELD =
  "min-h-12 min-w-0 rounded-[0.625rem] border-2 border-edge bg-white px-3 text-body text-spruce placeholder:text-granite focus:border-lake lg:min-h-11";
---

<Base
  title="Wisconsin politics in plain words"
  description="Track every Wisconsin bill, vote, veto and campaign contribution. Free, independent, and built entirely from official public records."
  layout="wide"
>
  <JsonLd
    data={{
      "@type": "WebSite",
      name: "Badger Politics",
      url: "https://badgerpolitics.org/",
      description:
        "Free, independent tracking of the Wisconsin Legislature: every bill, every vote, and every bill that never got a hearing.",
      inLanguage: "en-US",
      isAccessibleForFree: true,
      publisher: {
        "@type": "Organization",
        name: "Badger Politics",
        url: "https://badgerpolitics.org/",
      },
      potentialAction: {
        "@type": "SearchAction",
        target: {
          "@type": "EntryPoint",
          urlTemplate: "https://badgerpolitics.org/?q={search_term_string}",
        },
        "query-input": "required name=search_term_string",
      },
    }}
  />

  {/* the one bold moment: a prairie-gold field holding the question the
      site answers and the first step toward answering it */}
  <div class="rounded-[1.75rem] bg-prairie px-5 py-8 sm:px-10 sm:py-12 lg:grid lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:items-center lg:gap-12">
    <div class="flex max-w-[40rem] flex-col gap-4">
      <h1 class="t-display lg:text-[3.25rem] lg:leading-[1.06]">What are your lawmakers doing about the things you care about?</h1>
      <p class="sm:text-lead">
        Plain-language answers from the state's official records. Free, with no ads and nothing
        to sign up for.
      </p>
    </div>
    <section class="sheet mt-8 flex min-w-0 flex-col gap-3 p-5 sm:p-7 lg:mt-0" aria-labelledby="home-addr-heading">
      <h2 id="home-addr-heading" class="t-section">Who represents me?</h2>
      <p id="home-addr-intro">
        Enter your address to meet your state representative and state senator: how they vote
        and what they're trying to pass.
      </p>
      <div id="home-addr-saved" class="hidden min-w-0 flex-1">
        <div class="flex flex-col gap-3">
          <div class="min-w-0">
            <p id="home-addr-districts" class="font-bold"></p>
            <p class="text-small text-granite">Saved on this device only. Every page marks your two lawmakers.</p>
          </div>
          <div class="flex flex-wrap gap-2.5">
            <button type="button" id="home-addr-change" class="btn btn-secondary">Change address</button>
            <button type="button" id="home-addr-forget" class="btn btn-secondary">Forget</button>
          </div>
        </div>
      </div>
      <form id="home-addr-form" class="flex flex-col gap-2">
        <label class="text-small font-bold" for="home-addr">Your Wisconsin address</label>
        <input
          id="home-addr"
          type="text"
          required
          autocomplete="street-address"
          placeholder="Street address and city"
          class={`${FIELD} w-full`}
        />
        <div class="mt-1 flex flex-wrap gap-2.5">
          <button type="submit" class="btn btn-primary">Find my lawmakers</button>
          <button type="button" id="home-geo" class="btn btn-secondary">Use my location instead</button>
        </div>
      </form>
      <p id="home-addr-status" role="status" class="text-small empty:hidden"></p>
      <p id="home-addr-privacy" class="flex items-start gap-2 text-small text-granite">
        <svg class="mt-0.5 h-[18px] w-[18px] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
        <span>
          Your address goes only to the U.S. Census geocoder to find your districts, and is never
          stored. Your districts stay on this device.{PLACES_KEY && (
            <> Suggestions as you type come from Google Places, so what you type is sent to
            Google.</>
          )}
        </span>
      </p>
    </section>

  </div>

  <section id="my-reps-home" class="mt-14 hidden" aria-labelledby="my-reps-home-heading">
    <h2 id="my-reps-home-heading" class="t-section">Your lawmakers</h2>
    <div id="my-reps-cards" class="mt-4 grid items-start gap-5 lg:grid-cols-2" data-no-rep-highlight></div>
    <p class="mt-4">
      <a href="/my-reps/" class="font-bold underline">See their committees, ballot and contact details on My reps</a>
    </p>
  </section>

  <section class="mt-14" aria-labelledby="topics-heading">
    <h2 id="topics-heading" class="t-section">What do you want to know about?</h2>
    <p class="mt-2 max-w-[47.5rem]">Pick a topic to see the bills about it and where each one stands.</p>
    <ul class="mt-5 grid grid-cols-2 gap-3 lg:grid-cols-4" role="list">
      {TOPICS.map((t) => (
        <li>
          <a href={topicHref(t)} class="sheet flex h-full flex-col gap-1.5 p-4 no-underline outline-offset-2 transition-colors hover:bg-prairie-tint sm:p-5">
            <span class="font-display text-[1.125rem] leading-tight font-bold text-cranberry sm:text-[1.25rem]">{t.label}</span>
            <span class="text-small text-granite">{t.examples}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-4"><a href="/subjects/" class="underline">Every topic in the Legislature's index</a></p>
  </section>

  <div class="mt-14">
    <section id="search" class="sheet flex min-w-0 scroll-mt-4 flex-col gap-3 p-5 sm:p-7">
      <h2 id="search-heading" class="t-section">Search for anything</h2>
      <p>A bill number like AB 656, a lawmaker's name, a committee or a campaign donor.</p>
      <form id="search-form" action="/#search" method="get" class="flex flex-col gap-2" role="search" aria-labelledby="search-heading">
        <label class="text-small font-bold" for="q">Search bills, people and committees</label>
        <div class="flex flex-wrap gap-2.5">
          <input
            id="q"
            name="q"
            type="search"
            placeholder="Try child care or AB 656"
            class={`${FIELD} flex-1 basis-48`}
            autocomplete="off"
          />
          <button type="submit" class="btn btn-secondary">Search</button>
        </div>
        {/* facets baked into the index at build time; "All" is no filter */}
        <div id="search-filters" class="mt-2 flex flex-wrap items-center gap-2" role="group" aria-label="Show only" data-pagefind-ignore>
          {SEARCH_TYPES.map(([label, type], i) => (
            <button type="button" data-type-chip={type} aria-pressed={i === 0 ? "true" : "false"} class="chip">
              {label}
            </button>
          ))}
          <span id="bill-filters" class="hidden w-full flex-wrap items-center gap-2">
            <label class="sr-only" for="f-session">Session</label>
            <select id="f-session" class={`${FIELD} max-w-full text-small`}>
              <option value="">All sessions</option>
              {sessions.map((se) => (
                <option value={se.name ?? se.id}>{se.name ?? se.id}</option>
              ))}
            </select>
            <label class="sr-only" for="f-outcome">Where it ended up</label>
            <select id="f-outcome" class={`${FIELD} max-w-full text-small`}>
              <option value="">Any outcome</option>
              <option value="Became law">Became law</option>
              <option value="Vetoed">Vetoed</option>
              <option value="Died at session end">Stopped when the session ended</option>
              <option value="Passed one chamber">Passed one chamber</option>
              <option value="Adopted">Adopted</option>
            </select>
          </span>
        </div>
        <div class="flex flex-wrap items-center justify-between gap-2">
          <p id="search-status" role="status" class="text-small text-granite"></p>
          <button id="search-clear" type="button" class="hidden min-h-11 px-1 text-small font-bold text-lake underline">Clear filters</button>
        </div>
        <div id="search-results" class="hidden divide-y divide-rule border-y border-rule"></div>
        <button id="search-more" type="button" class="btn btn-secondary mt-2 hidden self-start">Show more results</button>
      </form>
    </section>
  </div>


  <section class="mt-14 max-w-[47.5rem]" aria-labelledby="outcomes-heading">
    <h2 id="outcomes-heading" class="t-section">
      Most bills never become law. Here's how far the {plain}'s {n(outcomes.bills)} got.
    </h2>
    <p class="mt-2">
      Each bill is counted once, at the furthest point it reached.
    </p>
    <div class="mt-5">
      <SessionOutcomes session={current.id} />
    </div>
    <p class="mt-3 text-small text-granite">
      Bills only. Resolutions never go to the governor and can't become law{outcomes.resolutions > 0
        ? `, so the session's ${n(outcomes.resolutions)} ${outcomes.resolutions === 1 ? "resolution is" : "resolutions are"} left out`
        : ""}.
    </p>
    <p class="mt-3 flex flex-wrap gap-x-6 gap-y-2">
      <a href={`/bills/${current.id}/`} class="underline">Every bill and resolution</a>
      <a href="/governors-desk/" class="underline">The governor's decisions</a>
    </p>
  </section>

  <section class="mt-14" aria-labelledby="latest-heading">
    <h2 id="latest-heading" class="t-section">What changed most recently</h2>
    <p class="mt-2">The bills that moved last in the official record, newest first.</p>
    <BillList bills={recent} class="mt-4" />
    <p class="mt-4">
      <a href={`/bills/${current.id}/`} class="font-bold underline">
        All {n(everything)} bills and resolutions this session
      </a>
    </p>
  </section>

  <section class="mt-14 border-t border-rule pt-8" aria-labelledby="trust-heading">
    <h2 id="trust-heading" class="t-section">Where this comes from</h2>
    <ul class="mt-4 grid max-w-[60rem] gap-x-10 gap-y-3 sm:grid-cols-2" role="list">
      <li>Rebuilt every night from Wisconsin's official state records.</li>
      <li>Every page links to the official record it came from.</li>
      <li>Your address is never stored. No ads and no tracking cookies.</li>
      <li>Corrections are public, and the data is free to reuse.</li>
    </ul>
    <p class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
      <a href="/about/" class="underline">How Badger Politics works</a>
      <a href="/data/" class="underline">Data and API</a>
    </p>
  </section>

  <style is:global>
    /* Pagefind marks matched words; bold reads as "here's your word"
       without spending the one Prairie highlight. */
    #search-results mark {
      background: transparent;
      color: inherit;
      font-weight: 700;
    }
  </style>

  <script is:inline type="module">
    // Thin custom UI over the Pagefind API.
    // is:inline (needed for the runtime /pagefind/ import) can't reach the
    // bundled lib/html escaper, so this one script carries its own copy
    const esc = (s) =>
      s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]);
    const input = document.getElementById("q");
    const box = document.getElementById("search-results");
    const status = document.getElementById("search-status");
    const chips = [...document.querySelectorAll("[data-type-chip]")];
    const billOnly = document.getElementById("bill-filters");
    const fSession = document.getElementById("f-session");
    const fOutcome = document.getElementById("f-outcome");
    const more = document.getElementById("search-more");
    const clear = document.getElementById("search-clear");
    let pagefind;
    let timer;

    // "Bills" is two page types, so a chip carries any-of values split on |
    const activeFilters = () => {
      const chip = chips.find((c) => c.getAttribute("aria-pressed") === "true");
      const types = chip?.dataset.typeChip ? chip.dataset.typeChip.split("|") : null;
      const f = {};
      if (types) f.type = { any: types };
      const billsMode = types?.includes("Bill") ?? false;
      billOnly.classList.toggle("hidden", !billsMode);
      billOnly.classList.toggle("inline-flex", billsMode);
      if (billsMode && fSession.value) f.session = fSession.value;
      if (billsMode && fOutcome.value) f.outcome = fOutcome.value;
      clear.classList.toggle("hidden", !types);
      return f;
    };
    for (const c of chips) {
      c.addEventListener("click", () => {
        for (const o of chips) o.setAttribute("aria-pressed", String(o === c));
        run();
      });
    }
    fSession.addEventListener("change", () => run());
    fOutcome.addEventListener("change", () => run());
    const clearFilters = () => {
      for (const c of chips) c.setAttribute("aria-pressed", String(!c.dataset.typeChip));
      fSession.value = "";
      fOutcome.value = "";
      run();
    };
    clear.addEventListener("click", clearFilters);

    // Short highlights need a real stem match, not Pagefind's prefix fallback.
    const resultFilter = (query, pagefind, filters) => {
      const words = [...new Set(query.toLowerCase().split(/\s+/)
        .map((w) => w.replace(/[^a-z0-9]/g, "")).filter(Boolean))];
      const exact = new Map();
      const shared = (a, b) => {
        let n = 0;
        while (n < a.length && n < b.length && a[n] === b[n]) n++;
        return n;
      };
      return async (result) => {
        const data = await result.data();
        const marks = [...data.excerpt.matchAll(/<mark>(.*?)<\/mark>/g)].map((m) =>
          m[1].replace(/[^A-Za-z0-9]/g, "").toLowerCase(),
        );
        if (!marks.length) return data;
        for (const word of words) {
          if (marks.some((m) => m.length >= 3 && shared(m, word) >= Math.min(4, word.length))) {
            return data;
          }
        }
        for (const word of words) {
          if (!marks.some((m) => m.length === 3 && shared(m, word) === 3)) continue;
          if (!exact.has(word)) {
            // Quoted terms retain stemming (taxes → tax, running → run).
            exact.set(word, pagefind.search(`"${word}"`, { filters })
              .then((search) => new Set(search.results.map((r) => r.id))));
          }
          if ((await exact.get(word)).has(result.id)) return data;
        }
        return null;
      };
    };

    // Recent searches, device-only like everything else personal here.
    const RECENTS_KEY = "bp-recent-q";
    const recents = () => {
      try { return JSON.parse(localStorage.getItem(RECENTS_KEY)) ?? []; } catch { return []; }
    };
    const remember = (q) => {
      try {
        const list = [q, ...recents().filter((r) => r !== q)].slice(0, 6);
        localStorage.setItem(RECENTS_KEY, JSON.stringify(list));
      } catch {}
    };
    const showRecents = () => {
      const list = recents();
      if (!list.length || input.value.trim().length >= 2) return;
      box.innerHTML =
        `<div class="flex flex-wrap items-center gap-x-4 gap-y-1 py-2"><span class="text-small font-bold text-granite">Recent searches</span>` +
        list.map((q) => `<button type="button" data-recent="${esc(q)}" class="min-h-11 px-1 text-left text-lake underline">${esc(q)}</button>`).join("") +
        `<button type="button" data-clear-recents class="ml-auto min-h-11 px-1 text-small font-bold text-granite underline">Clear</button></div>`;
      box.classList.remove("hidden");
    };
    box.addEventListener("click", (e) => {
      const r = e.target.closest("[data-recent]");
      if (r) { input.value = r.dataset.recent; run(); return; }
      if (e.target.closest("[data-clear-recents]")) {
        try { localStorage.removeItem(RECENTS_KEY); } catch {}
        box.innerHTML = ""; box.classList.add("hidden"); input.focus();
      }
      if (e.target.closest("[data-clear-filters]")) {
        clearFilters();
      }
    });
    input.addEventListener("focus", showRecents);

    // one compact metadata line per result, from the facets baked into the
    // index: "Bill · 2025-2026 Regular Session · Became law"
    const metaLine = (filters) => {
      if (!filters) return "";
      const first = (k) => filters[k]?.[0];
      const parts = [first("type"), first("session") ?? first("party"),
                     first("outcome") ?? first("chamber")].filter(Boolean);
      return parts.length
        ? `<span class="mb-0.5 block text-fine text-granite">${esc(parts.join(" · "))}</span>`
        : "";
    };

    // an exact identifier should beat fuzzy prose matches
    const BILL_ID = /^(ab|sb|ajr|sjr|ar|sr)\s*(\d+)$/i;
    const SEAT = /^(assembly|senate)\s+(?:district\s+)?(\d{1,3})$/i;

    let seq = 0;
    let results;
    const saveSearch = () => {
      const url = new URL(location.href);
      const type = chips.find(c => c.getAttribute("aria-pressed") === "true")?.dataset.typeChip ?? "";
      for (const [key, value] of Object.entries({
        q: input.value.trim(), type,
        session: type === "Bill|Resolution" ? fSession.value : "",
        outcome: type === "Bill|Resolution" ? fOutcome.value : "",
      })) {
        if (value) url.searchParams.set(key, value);
        else url.searchParams.delete(key);
      }
      history.replaceState(null, "", url);
    };

    async function run() {
      const mySeq = ++seq;
      const q = input.value.trim();
      const filters = activeFilters();
      saveSearch();
      results = null;
      more.classList.add("hidden");
      box.innerHTML = "";
      if (q.length < 2) {
        box.classList.add("hidden");
        status.textContent = "";
        showRecents();
        return;
      }
      status.textContent = "Searching…";
      try {
        pagefind ??= await import("/pagefind/pagefind.js");
        if (mySeq !== seq) return;
        const search = await pagefind.search(q, { filters });
        if (mySeq !== seq) return;
        const seat = q.match(SEAT);
        if (seat && (!filters.type || filters.type.any.includes("District"))) {
          box.innerHTML = `<a href="/districts/${seat[1].toLowerCase()}-${Number(seat[2])}/" class="group block px-1 py-3 text-spruce no-underline hover:bg-fog"><span class="mb-0.5 block text-fine text-granite">District</span><span class="font-display font-bold text-lake underline">${seat[1][0].toUpperCase()}${seat[1].slice(1).toLowerCase()} District ${Number(seat[2])}</span></a>`;
        }
        results = { seq: mySeq, q, filters, candidates: search.results, offset: 0, count: 0, filter: resultFilter(q, pagefind, filters) };
        await loadMore(results);
      } catch {
        if (mySeq === seq) status.textContent = "Search is unavailable. Try Search again.";
      }
    }

    async function loadMore(state) {
      if (!state || state.seq !== seq) return;
      more.disabled = true;
      status.textContent = "Loading results…";
      const good = [];
      const start = state.offset;
      try {
        while (good.length < 8 && state.offset < state.candidates.length) {
          const batch = state.candidates.slice(state.offset, state.offset + 8);
          const loaded = await Promise.all(batch.map(state.filter));
          if (state.seq !== seq) return;
          state.offset += batch.length;
          good.push(...loaded.filter(Boolean));
        }
      } catch {
        if (state.seq === seq) {
          state.offset = start;
          state.filter = resultFilter(state.q, pagefind, state.filters);
          more.disabled = false;
          more.classList.remove("hidden");
          status.textContent = "Could not load more results. Try Show more results again.";
        }
        return;
      }
      const { q, filters } = state;
      const idMatch = q.match(BILL_ID);
      if (idMatch) {
        const ident = `${idMatch[1].toUpperCase()} ${idMatch[2]}`;
        good.sort((a, b) =>
          Number((b.meta?.title ?? "").startsWith(ident)) -
          Number((a.meta?.title ?? "").startsWith(ident)));
      }
      if (good.length) remember(q);
      const anyFilter = Object.keys(filters).length > 0;
      box.insertAdjacentHTML("beforeend", good
            .map(
              (r) => `
        <a href="${esc(r.url)}" class="block px-1 py-3 text-spruce no-underline hover:bg-fog">
          ${metaLine(r.filters)}<span class="font-display font-bold text-lake underline">${esc(r.meta?.title ?? r.url)}</span>
          <span class="mt-0.5 block text-small">…${r.excerpt}…</span>
        </a>`,
            )
            .join(""));
      state.count += good.length;
      if (!box.children.length) box.innerHTML = `<div class="px-1 py-3">
             <p>Nothing matches “${q.replace(/[<>&]/g, "")}”${anyFilter ? " with these filters" : ""}.</p>
             <p class="mt-2 flex flex-wrap gap-x-5 gap-y-1">
               ${anyFilter ? '<button type="button" data-clear-filters class="min-h-11 font-bold text-lake underline">Clear filters</button>' : ""}
               <a href="/my-reps/" class="underline">Find your lawmakers</a>
               <a href="https://docs.legis.wisconsin.gov/search?q=${encodeURIComponent(q)}" class="underline">Search the official record</a>
             </p>
           </div>`;
      box.classList.remove("hidden");
      more.disabled = false;
      more.classList.toggle("hidden", state.offset >= state.candidates.length);
      status.textContent = state.count
        ? `${state.count} matches shown, ordered by relevance.${state.offset < state.candidates.length ? " More results available." : ""}`
        : box.querySelector(":scope > a") ? "District shortcut shown." : "No results.";
    }
    more.addEventListener("click", () => loadMore(results));

    input.addEventListener("input", () => {
      ++seq;
      more.classList.add("hidden");
      clearTimeout(timer);
      timer = setTimeout(run, 300);
    });
    document.getElementById("search-form").addEventListener("submit", e => {
      e.preventDefault();
      clearTimeout(timer);
      run();
    });
    const restoreSearch = () => {
      const params = new URLSearchParams(location.search);
      input.value = params.get("q") ?? "";
      const type = chips.some(c => c.dataset.typeChip === params.get("type")) ? params.get("type") : "";
      for (const c of chips) c.setAttribute("aria-pressed", String(c.dataset.typeChip === type));
      fSession.value = params.get("session") ?? "";
      fOutcome.value = params.get("outcome") ?? "";
      if (input.value) input.focus();
      run();
    };
    window.addEventListener("popstate", restoreSearch);
    restoreSearch();
  </script>

<script>
  import { savedDistrict, saveDistrict, forgetDistrict } from "../lib/district";
  import { forgetCityDistrict, resolveCity, savedCityDistrict } from "../lib/cityDistrict";
  import { districtForAddress, districtForBrowser, LOOKUP_LOAD_ERROR } from "../lib/lookup";
  import { esc } from "../lib/html";
  import { attachSuggest } from "../scripts/addressSuggest";
  import { partyWord } from "../lib/format";
  import type { RepSlim, RepSummaries, RepSummary, Reps } from "../lib/wire";
  import type { answers as Answers } from "../lib/repAnswers";

  // Show saved representatives inline using browser storage and static JSON.
  const form = document.getElementById("home-addr-form") as HTMLFormElement | null;
  const addr = document.getElementById("home-addr") as HTMLInputElement | null;
  const addrStatus = document.getElementById("home-addr-status");
  const geoBtn = document.getElementById("home-geo");

  const heading = document.getElementById("home-addr-heading");
  const cardSaved = document.getElementById("home-addr-saved");
  const districtsLine = document.getElementById("home-addr-districts");
  // the prompt-state pieces, toggled as a set
  const promptEls = ["home-addr-intro", "home-addr-form", "home-addr-privacy"]
    .map((id) => document.getElementById(id));
  if (form && addr) attachSuggest(addr, () => form.requestSubmit());

  const showSaved = (d: { ad: number; sd: number }) => {
    if (heading) heading.textContent = "Your districts";
    if (districtsLine) {
      const c = savedCityDistrict();
      const city = c && (c.t === "milwaukee" ? "Milwaukee" : c.t === "westalliswi" ? "West Allis" : null);
      districtsLine.textContent = `Assembly District ${d.ad} and Senate District ${d.sd}.`
        + (city ? ` ${city} Common Council District ${c.d}.` : "");
    }
    for (const el of promptEls) el?.classList.add("hidden");
    cardSaved?.classList.remove("hidden");
    if (addrStatus) addrStatus.textContent = "";
  };
  const showPrompt = () => {
    if (heading) heading.textContent = "Find your lawmakers";
    for (const el of promptEls) el?.classList.remove("hidden");
    cardSaved?.classList.add("hidden");
    addr?.focus();
  };

  const settle = (d: { ad: number; sd: number }) => {
    saveDistrict(d);
    showSaved(d);
    render(d);
  };

  document.getElementById("home-addr-change")?.addEventListener("click", showPrompt);
  document.getElementById("home-addr-forget")?.addEventListener("click", () => {
    forgetDistrict();
    forgetCityDistrict();
    document.getElementById("my-reps-home")?.classList.add("hidden");
    showPrompt();
    if (addrStatus) addrStatus.textContent = "Forgotten.";
  });

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!addr?.value.trim()) return;
    if (addrStatus) addrStatus.textContent = "Looking up your address…";
    // the boundary file can fail to load; say so rather than hang
    let result;
    try {
      result = await districtForAddress(addr.value.trim());
    } catch {
      if (addrStatus) addrStatus.textContent = LOOKUP_LOAD_ERROR;
      return;
    }
    if ("error" in result) {
      if (addrStatus) addrStatus.textContent = result.error;
      return;
    }
    await resolveCity(result.lng, result.lat);
    settle(result.district);
  });

  geoBtn?.addEventListener("click", async () => {
    if (addrStatus) addrStatus.textContent = "Asking your browser for your location…";
    let result;
    try {
      result = await districtForBrowser();
    } catch {
      if (addrStatus) addrStatus.textContent = LOOKUP_LOAD_ERROR;
      return;
    }
    if ("error" in result) {
      if (addrStatus) addrStatus.textContent = result.error;
      return;
    }
    await resolveCity(result.lng, result.lat);
    settle(result.district);
    // browser locations can be off by blocks; say so instead of
    // silently saving no council district
    if (addrStatus && !savedCityDistrict()) {
      addrStatus.textContent =
        "No covered city at your browser's location. If you live in Milwaukee or "
        + "West Allis, enter your street address instead; it is more precise.";
    }
  });

  const saved = savedDistrict();
  if (saved) {
    showSaved(saved);
    render(saved);
  }

  // the same questions, in the same words, as My reps and each lawmaker's
  // page; the homepage asks the two that say the most at a glance
  const GLANCE = new Set(["voting", "recent"]);
  const PORTRAIT_FALLBACK =
    '<svg width="56" height="56" viewBox="0 0 48 48" aria-hidden="true" class="shrink-0 rounded-full">' +
    '<circle cx="24" cy="24" r="24" fill="#E6EBE7"/><circle cx="24" cy="19" r="7.5" fill="#848E88"/>' +
    '<rect x="10" y="30.5" width="28" height="24" rx="12" fill="#848E88"/></svg>';

  function card(answers: typeof Answers, house: "assembly" | "senate", district: number, slim: RepSlim | undefined, full: RepSummary | undefined, summaries: RepSummaries | null): string {
    if (!slim) return "";
    const chamber = house === "assembly" ? "Assembly" : "Senate";
    const title = house === "assembly" ? "representative" : "state senator";
    const headingId = `home-rep-${house}`;
    const portrait = slim.image
      ? `<img src="${esc(slim.image)}" alt="" width="56" height="56" loading="lazy" decoding="async" class="h-14 w-14 shrink-0 rounded-full bg-fog object-cover object-[50%_20%]">`
      : PORTRAIT_FALLBACK;
    const questions = full
      ? answers(full, {
          house, district, typical: summaries?.typical?.[house], phase: summaries?.phase, general: "", mine: false,
        })
          .filter((a) => GLANCE.has(a.id))
          .map((a) => `<div class="flex flex-col gap-1.5 border-t border-rule pt-4"><h4 class="t-question">${esc(a.q)}</h4>${a.html}</div>`)
          .join("")
      : "";
    return (
      `<section class="sheet flex min-w-0 flex-col gap-4 break-words p-5 sm:p-6" aria-labelledby="${headingId}">` +
      '<div class="flex flex-wrap items-center gap-4">' + portrait +
      '<div class="min-w-0 flex-[1_1_12rem]">' +
      `<h3 id="${headingId}" class="t-section text-[1.375rem]"><a href="/legislators/${esc(slim.slug)}/" class="text-spruce no-underline hover:underline">${esc(slim.name)}</a></h3>` +
      `<p class="text-granite">Your ${title} for <a href="/districts/${house}-${district}/" class="underline">${chamber} District ${district}</a>.` +
      `${slim.party ? ` ${esc(partyWord(slim.party))}.` : ""}</p>` +
      '</div></div>' +
      questions +
      `<p class="border-t border-rule pt-4"><a href="/legislators/${esc(slim.slug)}/" class="font-bold underline">Full record</a></p>` +
      '</section>'
    );
  }

  function render(saved: { ad: number; sd: number }) {
    const section = document.getElementById("my-reps-home")!;
    const cards = document.getElementById("my-reps-cards")!;
    // the answer wording loads only for readers with a saved district
    Promise.all([
      fetch("/data/reps.json").then((r) => r.json()),
      fetch("/data/rep-summaries.json").then((r) => r.json()).catch(() => null),
      import("../lib/repAnswers"),
    ])
      .then(([reps, summaries, { answers }]: [Reps, RepSummaries | null, { answers: typeof Answers }]) => {
        const html =
          card(answers, "assembly", saved.ad, reps.assembly?.[saved.ad], summaries?.assembly?.[saved.ad], summaries) +
          card(answers, "senate", saved.sd, reps.senate?.[saved.sd], summaries?.senate?.[saved.sd], summaries);
        if (html) {
          cards.innerHTML = html;
          section.classList.remove("hidden");
        }
      })
      .catch(() => {});
  }
</script>
</Base>
