---
import Base from "../layouts/Base.astro";

const links = [
  ["/", "Home"],
  ["/bills/", "Bills"],
  ["/legislators/", "State lawmakers"],
  ["/calendar/#hearings", "Hearings"],
  ["/money/", "Campaign money"],
  ["/my-reps/", "Find your lawmakers"],
];
---

<Base
  title="Page not found"
  description="That page doesn't exist. Find bills, lawmakers and hearings from here."
  layout="wide"
>
  <div class="flex max-w-[40rem] flex-col gap-3 py-4">
    <img src="/mark.svg" alt="" width="56" height="60" />
    <h1 class="t-display">We can't find that page</h1>
    <p class="sm:text-lead">
      If you followed a link here, the bill or lawmaker may have moved when a new session started.
      Searching usually finds it.
    </p>
    <form action="/" method="get" class="mt-2 flex flex-wrap gap-2">
      <label class="basis-full text-small font-bold" for="q404">Search bills, lawmakers and money</label>
      <input
        id="q404"
        name="q"
        type="search"
        placeholder="Try “child marriage”"
        class="min-h-12 min-w-0 flex-1 basis-60 rounded-[0.625rem] border-2 border-edge bg-white px-3 text-body focus:border-lake"
        autocomplete="off"
      />
      <button type="submit" class="btn btn-primary">Search</button>
    </form>
    <nav class="mt-4" aria-labelledby="elsewhere-heading">
      <h2 id="elsewhere-heading" class="t-question">Or start from</h2>
      <ul class="mt-1 flex flex-wrap gap-x-6" role="list">
        {links.map(([href, label]) => (
          <li><a href={href} class="inline-flex min-h-11 items-center underline">{label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</Base>
