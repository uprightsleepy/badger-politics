---
import Base from "../../layouts/Base.astro";
import MoneyView from "../../components/MoneyView.astro";
import { moneyOverview } from "../../lib/db";
import { fmtDate } from "../../lib/format";

const all = moneyOverview();
const newestYear = Number((all.last ?? "2026").slice(0, 4));
const currentCycle = newestYear % 2 ? newestYear + 1 : newestYear;
const cycles: number[] = [];
for (let y = currentCycle; y >= 2008; y -= 2) cycles.push(y);
const views = [
  { key: "all", label: "All time", m: all, cycle: undefined as string | undefined },
  ...cycles.map((y) => ({
    key: String(y),
    label: y === currentCycle ? `${y} (current)` : String(y),
    m: moneyOverview({ start: `${y - 1}-01-01`, end: `${y}-12-31` }),
    cycle: String(y),
  })),
];
---

<Base
  title="Campaign money"
  description="Who funds Wisconsin legislators: top committees, top fundraisers, and small-dollar shares, filterable by election cycle."
>
  <h1 class="text-2xl font-bold">Campaign money</h1>
  <p class="mt-1 max-w-3xl text-sm text-navy-700">
    The money invested in Wisconsin's sitting legislators: every
    contribution reported to each member's campaign committees since they
    took office, from Wisconsin Ethics Commission filings
    {all.last && ` through ${fmtDate(all.last)}`}. Electronic records begin in
    2008. <a href="/money/committees/" class="underline">Browse all contributing committees</a> ·
    <a href="/about/#money" class="underline">How this data works</a>
  </p>
  <p class="mt-2 max-w-3xl rounded-lg border border-gold-500 bg-gold-100 px-3 py-2 text-sm">
    Coverage note: {all.covered} of {all.sitting} sitting legislators are
    linked to their campaign committee so far. Totals and rankings cover only
    those {all.covered}. The rest are a coverage gap, not zero fundraising.
  </p>

  <div class="mt-4 flex flex-wrap gap-2" role="group" aria-label="Filter by election cycle">
    {views.map((v) => (
      <button
        type="button"
        data-cycle-btn={v.key}
        aria-pressed={v.key === "all" ? "true" : "false"}
        class="rounded-full border border-navy-600 bg-white px-3 py-2 text-sm font-semibold
               hover:ring-2 hover:ring-navy-600 focus-visible:ring-2 focus-visible:ring-navy-600
               aria-pressed:border-navy-800 aria-pressed:bg-navy-800 aria-pressed:text-white"
      >
        {v.label}
      </button>
    ))}
  </div>
  <p id="cycle-status" role="status" class="sr-only"></p>

  {views.map((v) => (
    <div data-money-view={v.key} hidden={v.key !== "all"}>
      <MoneyView m={v.m} cycle={v.cycle} />
    </div>
  ))}

  <p class="mt-6 max-w-3xl text-xs text-navy-600">
    Source: Wisconsin Ethics Commission campaign finance filings
    (campaignfinance.wi.gov), refreshed nightly. Cycle views count a member's
    receipts only after they took office; the campaign that first elected
    them is not included. Committee donors are grouped by their registered
    CFIS entity id, never by name matching. Individual donors are shown only
    in aggregate.
    <a href="/about/#money" class="underline"> Full methodology</a>
  </p>

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>("[data-cycle-btn]");
    const status = document.getElementById("cycle-status")!;
    buttons.forEach((b) =>
      b.addEventListener("click", () => {
        buttons.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
        document.querySelectorAll<HTMLElement>("[data-money-view]").forEach((v) => {
          v.hidden = v.dataset.moneyView !== b.dataset.cycleBtn;
        });
        status.textContent = `Showing ${b.textContent!.trim()}`;
      }),
    );
  </script>
</Base>
