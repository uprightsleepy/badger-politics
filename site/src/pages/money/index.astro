---
import Base from "../../layouts/Base.astro";
import SourceStrip from "../../components/SourceStrip.astro";
import MoneyView from "../../components/MoneyView.astro";
import MoneyFilters from "../../components/MoneyFilters.astro";
import StateCampaignMoney from "../../components/StateCampaignMoney.astro";
import campaigns from "../../../../pipeline/importer/state_campaigns.json";
import { moneyOverview, stateCampaignMoney } from "../../lib/db";
import { currentMoneyCycle, moneyPeriods, moneyViews } from "../../lib/money-periods";

const all = moneyOverview({ inOffice: 0 });
const governors = campaigns.filter((c) => c.office === "Wisconsin governor").map(stateCampaignMoney);
const periods = moneyPeriods();
const current = String(currentMoneyCycle());
---
<Base title="Campaign Money" description="Wisconsin campaign receipts and spending by reporting period, with available history and coverage gaps.">
  <h1 class="text-2xl font-bold">Campaign Money</h1>
  <SourceStrip sources={[{ label: "Wisconsin Ethics Commission", href: "https://campaignfinance.wi.gov" }]} through={null} />
  <MoneyFilters fragmentBase="/money/views/" />
  <section id="governor-campaigns" class="mt-6" aria-labelledby="governor-money">
    <h2 id="governor-money" class="text-xl font-bold">Governor campaigns</h2>
    <p class="mt-1 max-w-3xl text-sm text-navy-700">
      Reported spending and receipts for the state campaign committees tracked here.
      Federal campaigns and outside-group spending are separate. This is not a complete candidate list.
      The legislative service filter does not apply to these committees.
    </p>
    {periods.map((period) => {
      const selected = governors.filter((c) => period.key === "all" || String(c.cycle) === period.key);
      return <div data-money-period={period.key} hidden={period.key !== current} data-pagefind-ignore={period.key !== current}>
        {selected.length ? <div class="mt-4 grid items-start gap-4 lg:grid-cols-2">
          {selected.map((c) => <StateCampaignMoney campaign={c} title={c.candidate} />)}
        </div> : <p class="mt-3 text-sm text-navy-600">Governor campaign records have not been collected for {period.label}. This is a coverage gap.</p>}
      </div>;
    })}
  </section>
  <h2 class="mt-8 text-xl font-bold">Legislative campaigns</h2>
  <p class="mt-1 max-w-3xl text-sm text-navy-700">
    Receipts to verified campaign committees of today's legislators. The current two-year period is shown by default,
    including collected receipts before taking office. Select earlier periods or all available history above.
    <a href="/money/committees/" class="underline" data-money-link> Browse contributing committees</a> ·
    <a href="/about/#money" class="underline"> How this data works</a>
  </p>
  <p class="mt-2 max-w-3xl rounded-lg border border-gold-500 bg-gold-100 px-3 py-2 text-sm">
    Coverage note: {all.covered} of {all.sitting} sitting legislators have collected receipt history.
    Totals and rankings cover that subset. Missing records do not mean zero fundraising.
  </p>
  <div data-money-views>
    {moneyViews().filter((view) => view.isDefault).map((view) => (
      <div data-money-period={view.period.key} data-money-scope={view.scope}>
        <MoneyView m={moneyOverview(view.bounds)} view={view} />
      </div>
    ))}
  </div>
  <p class="mt-6 max-w-3xl text-xs text-navy-600">
    Reported receipts include loans, transfers, refunds, and in-kind support; they do not establish cash on hand.
    All available history begins no earlier than July 2008 and may have gaps.
    Committee donors are grouped by official entity ID. Individual donors are aggregated here.
    <a href="/about/#money" class="underline"> Full methodology</a>
  </p>
</Base>
