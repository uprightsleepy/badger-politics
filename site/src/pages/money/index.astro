---
import Base from "../../layouts/Base.astro";
import MoneyView from "../../components/MoneyView.astro";
import MoneyFilters from "../../components/MoneyFilters.astro";
import StateCampaignMoney from "../../components/StateCampaignMoney.astro";
import campaigns from "../../../../pipeline/importer/state_campaigns.json";
import { meta, moneyOverview, stateCampaignMoney } from "../../lib/db";
import { fmtDate } from "../../lib/format";
import { currentMoneyCycle, moneyPeriods, moneyViews } from "../../lib/money-periods";

const all = moneyOverview({ inOffice: 0 });
const governors = campaigns.filter((c) => c.office === "Wisconsin governor").map(stateCampaignMoney);
const periods = moneyPeriods();
const current = String(currentMoneyCycle());
const pulledOn = meta().imported_at?.slice(0, 10);
const missing = all.sitting - all.covered;
---
<Base
  title="Campaign money"
  description="Wisconsin campaign receipts and spending by reporting period, with available history and coverage gaps."
  layout="wide"
>
  <header class="flex max-w-[47.5rem] flex-col gap-2.5">
    <h1 class="t-display">Campaign money</h1>
    <p class="sm:text-lead">
      Who gives to Wisconsin's state lawmakers and governor candidates, from the campaign finance
      reports filed with the Wisconsin Ethics Commission.
    </p>
    <p class="text-small text-granite">
      {missing > 0
        ? `We have receipts for ${all.covered.toLocaleString()} of the ${all.sitting.toLocaleString()} sitting legislators, so totals and rankings cover those ${all.covered.toLocaleString()}. A missing record doesn't mean no money was raised, and party totals aren't compared until every member is covered.`
        : `We have receipts for all ${all.sitting.toLocaleString()} sitting legislators.`}
      {" "}<a href="/about/#money" class="underline">How this data works</a>
    </p>
  </header>

  <div class="mt-7">
    <MoneyFilters fragmentBase="/money/views/" />
  </div>

  <section id="governor-campaigns" class="mt-10" aria-labelledby="governor-money">
    <h2 id="governor-money" class="t-section">Governor campaigns</h2>
    <p class="mt-2 max-w-[47.5rem] text-small text-granite">
      Reported spending and receipts for the state campaign committees we track. This isn't every
      candidate, and federal campaigns and outside spending are separate. The legislative-office filter
      doesn't apply here.
    </p>
    {periods.map((period) => {
      const selected = governors.filter((c) => period.key === "all" || String(c.cycle) === period.key);
      return <div data-money-period={period.key} hidden={period.key !== current} data-pagefind-ignore={period.key !== current ? "all" : undefined}>
        {selected.length ? <div class="mt-4 grid items-start gap-5 lg:grid-cols-2">
          {selected.map((c) => <StateCampaignMoney campaign={c} title={c.candidate} />)}
        </div> : <p class="mt-3">Governor campaign records aren't collected for {period.label.replace(" · Current", "")}. That's a gap in our records, not a sign of no money.</p>}
      </div>;
    })}
  </section>

  <section class="mt-12" aria-labelledby="legislative-money">
    <h2 id="legislative-money" class="t-section">Legislative campaigns</h2>
    <p class="mb-6 mt-2 flex flex-wrap gap-x-6 gap-y-2">
      <a href="/money/committees/" class="font-bold underline" data-money-link>Every committee that gives to lawmakers</a>
      <a href="/money/independent/" class="font-bold underline">Outside spending, filing by filing</a>
    </p>
    <div data-money-views>
      {moneyViews().filter((view) => view.isDefault).map((view) => (
        <div data-money-period={view.period.key} data-money-scope={view.scope}>
          <MoneyView m={moneyOverview(view.bounds)} view={view} level="h3" />
        </div>
      ))}
    </div>
  </section>

  <p class="mt-12 max-w-[47.5rem] text-fine text-granite">
    Reported receipts include loans, transfers, refunds and in-kind support; they don't show cash on hand.
    Our history starts no earlier than July 2008 and may have gaps. Committee donors are grouped by the
    Commission's entity ID; individual donors are counted together. From the
    {" "}<a href="https://campaignfinance.wi.gov" class="underline">Wisconsin Ethics Commission</a>{pulledOn && `, checked ${fmtDate(pulledOn)}`}.
    {" "}<a href="/about/#money" class="underline">Full methodology</a>
  </p>
</Base>
