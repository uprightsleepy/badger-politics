---
import Base from "../../../layouts/Base.astro";
import SourceStrip from "../../../components/SourceStrip.astro";
import OrgLogo from "../../../components/OrgLogo.astro";
import MoneyFilters from "../../../components/MoneyFilters.astro";
import DonorMoneyView from "../../../components/DonorMoneyView.astro";
import { moneyViews } from "../../../lib/money-periods";
import { donorCommittees, cfTypeOf } from "../../../lib/db";
import { fmtMoney, fmtDate, personSlug, roleAbbr } from "../../../lib/format";

export function getStaticPaths() {
  return donorCommittees().map((c) => ({
    params: { id: String(c.entityId) },
    props: { committee: c },
  }));
}
const { committee } = Astro.props;
const kind = cfTypeOf(committee.entityId);
---

<Base
  title={committee.name}
  filters={{ type: "Campaign money" }}
  breadcrumbs={[
    { name: "Money", url: "/money/" },
    { name: "Committees", url: "/money/committees/" },
  ]}
  description={`${committee.name}: reported receipts to sitting Wisconsin legislators, by reporting period.`}
>
  <p class="text-sm text-navy-600">
    <a href="/money/" class="underline">Campaign money</a> ·
    <a href="/money/committees/" class="underline">Contributing committees</a>
  </p>
  <div class="mt-2 flex flex-wrap items-center gap-3">
    <OrgLogo entityId={committee.entityId} name={committee.name} />
    <h1 class="text-2xl font-bold">{committee.name}</h1>
    {kind && (
      <span class="rounded-full bg-navy-50 px-2.5 py-0.5 text-xs font-semibold text-navy-700">{kind}</span>
    )}
  </div>
  <p class="mt-1 max-w-3xl text-sm text-navy-700">
    What this committee has given to sitting Wisconsin legislators, from Ethics Commission filings, with full-period receipts by default and an optional service filter.
  </p>
  <SourceStrip
    sources={[{ label: "Wisconsin Ethics Commission (CFIS)", href: "https://cfis.wi.gov" }]}
    through={null}
  />

  <MoneyFilters />
  {moneyViews().map((view) => <div data-money-period={view.period.key} data-money-scope={view.scope} hidden={!view.isDefault}>
    <DonorMoneyView entityId={committee.entityId} name={committee.name} view={view} />
  </div>)}
</Base>
