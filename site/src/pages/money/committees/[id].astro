---
import Base from "../../../layouts/Base.astro";
import OrgLogo from "../../../components/OrgLogo.astro";
import PartyChip from "../../../components/PartyChip.astro";
import { donorCommittees, donorCommitteeFor } from "../../../lib/db";
import { fmtMoney, fmtDate, personSlug, roleAbbr } from "../../../lib/format";

export function getStaticPaths() {
  return donorCommittees().map((c) => ({
    params: { id: String(c.entityId) },
    props: { committee: c },
  }));
}
const { committee } = Astro.props;
const { recipients, byParty } = donorCommitteeFor(committee.entityId);
---

<Base
  title={committee.name}
  description={`${committee.name} has given ${fmtMoney(committee.total)} to ${committee.recipients} sitting Wisconsin legislators.`}
>
  <p class="text-sm text-navy-600">
    <a href="/money/" class="underline">Campaign money</a> ·
    <a href="/money/committees/" class="underline">Contributing committees</a>
  </p>
  <div class="mt-2 flex items-center gap-3">
    <OrgLogo entityId={committee.entityId} name={committee.name} />
    <h1 class="text-2xl font-bold">{committee.name}</h1>
  </div>

  <div class="mt-4 grid max-w-3xl gap-3 sm:grid-cols-3">
    <div class="rounded-lg border border-navy-100 bg-white p-4">
      <p class="text-2xl font-bold">{fmtMoney(committee.total)}</p>
      <p class="text-sm text-navy-600">
        given across {committee.n.toLocaleString()} receipts,
        {fmtDate(committee.first)} to {fmtDate(committee.last)}
      </p>
    </div>
    <div class="rounded-lg border border-navy-100 bg-white p-4">
      <p class="text-2xl font-bold">{committee.recipients}</p>
      <p class="text-sm text-navy-600">sitting legislators received money while in office</p>
    </div>
    <div class="rounded-lg border border-navy-100 bg-white p-4">
      <p class="mb-1 text-sm text-navy-600">given to legislators, by their party</p>
      {byParty.map((p) => (
        <p class="flex items-center gap-2 text-sm">
          <PartyChip party={p.party} size="sm" decorative />
          <span class="min-w-0 flex-1 truncate">{p.party ?? "Unknown"}</span>
          <span class="font-semibold">{fmtMoney(p.total)}</span>
        </p>
      ))}
    </div>
  </div>

  <section class="mt-6 max-w-3xl">
    <h2 class="text-xl font-bold">Recipients</h2>
    <ol class="mt-2 divide-y divide-navy-100 rounded-lg border border-navy-100 bg-white text-sm">
      {recipients.map((r, i) => (
        <li class="flex items-center gap-2 px-4 py-1.5">
          <span class="w-6 shrink-0 text-right text-xs text-navy-600" aria-hidden="true">{i + 1}.</span>
          <PartyChip party={r.party} size="sm" />
          <a href={`/legislators/${personSlug(r.id)}/`} class="min-w-0 flex-1 truncate py-1 underline">
            {r.name}
          </a>
          <span class="sr-only shrink-0 text-xs text-navy-600 sm:not-sr-only sm:inline">
            {roleAbbr(r.chamber)} {r.district}
          </span>
          <span class="sr-only shrink-0 text-xs text-navy-600 md:not-sr-only md:inline">
            {r.n} receipt{r.n > 1 ? "s" : ""}
          </span>
          <span class="w-24 shrink-0 text-right font-semibold">{fmtMoney(r.total)}</span>
        </li>
      ))}
    </ol>
  </section>

  <p class="mt-6 max-w-3xl text-xs text-navy-600">
    Source: Wisconsin Ethics Commission campaign finance filings, CFIS filer
    id {committee.entityId}. Totals count receipts to sitting legislators
    only, from each member's time in office; giving to former members,
    challengers, or before a member took office is not shown. A committee's
    money comes from its own contributors; a contribution is not an
    endorsement of any particular vote.
    <a href="/about/#money" class="underline"> Full methodology</a>
  </p>
</Base>
