---
import Base from "../../../layouts/Base.astro";
import FilterBar from "../../../components/FilterBar.astro";
import MoneyFilters from "../../../components/MoneyFilters.astro";
import CommitteeList from "../../../components/CommitteeList.astro";
import { moneyViews } from "../../../lib/money-periods";
import { donorCommittees, cfTypeOf } from "../../../lib/db";

const committees = donorCommittees();
// Larger types come first; missing registry types remain an explicit coverage gap.
const UNKNOWN = "Type unknown";
const typeCounts = new Map<string, number>();
for (const c of committees) {
  const key = cfTypeOf(c.entityId) ?? UNKNOWN;
  typeCounts.set(key, (typeCounts.get(key) ?? 0) + 1);
}
const typeFacets = [...typeCounts]
  .sort((a, b) =>
    a[0] === UNKNOWN ? 1 : b[0] === UNKNOWN ? -1 : b[1] - a[1],
  )
  .map(([key, count]) => ({ key, label: key, count }));
---

<Base
  title="Contributing Committees"
  description="Every PAC, party and political committee that has given at least $1,000 to sitting Wisconsin legislators, with their full recipient lists."
>
  <p class="text-sm text-navy-600"><a href="/money/" class="underline">Campaign money</a></p>
  <h1 class="mt-1 text-2xl font-bold">Contributing Committees</h1>
  <p class="mt-1 max-w-3xl text-sm text-navy-700">
    Every political committee that has given at least $1,000 to sitting
    legislators in the collected history, plus retained historical profiles.
    Amounts and recipient counts follow the selected reporting period.
  </p>
  <MoneyFilters fragmentBase="/money/committees/views/" />
  <FilterBar
    id="committee-filter"
    statusId="committee-filter-status"
    label="Filter committees by name"
    placeholder="Filter by name…"
    facetAttr="ctype"
    facetLabel="Filter by the kind of committee"
    facets={typeFacets}
  />
  <div data-money-views>
    {moneyViews().filter((view) => view.isDefault).map((view) => (
      <div data-money-period={view.period.key} data-money-scope={view.scope}>
        <CommitteeList view={view} unknownType={UNKNOWN} />
      </div>
    ))}
  </div>
  <p id="committee-no-match" class="mt-4 hidden rounded-lg border border-navy-100 bg-white p-4 text-sm text-navy-600"></p>

  <script>
    import { initRowFilter } from "../../../scripts/rowFilter";
    const selector = "[data-money-period]:not([hidden]) [data-committee-row]";
    const apply = initRowFilter({
      input: "committee-filter",
      rows: selector,
      status: "committee-filter-status",
      noMatch: "committee-no-match",
      noun: "committees",
      facetAttr: "ctype",
    });
    const refresh = () => {
      const rows = [...document.querySelectorAll<HTMLElement>(selector)];
      document.querySelectorAll<HTMLButtonElement>('[data-facet-for="ctype"]').forEach((chip) => {
        const kind = chip.dataset.facet;
        const count = kind ? rows.filter((r) => r.dataset.ctype === kind).length : rows.length;
        chip.textContent = `${kind || "All"} ${count.toLocaleString()}`;
      });
      apply();
    };
    document.addEventListener("money-period-change", refresh);
    refresh();
  </script>
</Base>
