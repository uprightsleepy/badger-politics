---
import Base from "../../../layouts/Base.astro";
import OrgLogo from "../../../components/OrgLogo.astro";
import { donorCommittees } from "../../../lib/db";
import { fmtMoney } from "../../../lib/format";

const committees = donorCommittees();
---

<Base
  title="Contributing committees"
  description="Every PAC, party and political committee that has given at least $1,000 to sitting Wisconsin legislators, with their full recipient lists."
>
  <p class="text-sm text-navy-600"><a href="/money/" class="underline">Campaign money</a></p>
  <h1 class="mt-1 text-2xl font-bold">Contributing committees</h1>
  <p class="mt-1 max-w-3xl text-sm text-navy-700">
    Every political committee that has given at least $1,000 to sitting
    legislators while in office, from Ethics Commission filings. Each links
    to its full recipient list.
  </p>
  <div class="mt-4">
    <label class="mb-1 block text-sm font-semibold" for="committee-filter">Filter committees by name</label>
    <input
      type="search"
      id="committee-filter"
      placeholder="Filter by name…"
      class="w-full max-w-md rounded-lg border border-navy-100 bg-white px-3 py-2 text-sm"
    />
    <p id="committee-filter-status" role="status" class="mt-2 text-sm text-navy-600"></p>
  </div>
  <ul class="mt-4 divide-y divide-navy-100 rounded-lg border border-navy-100 bg-white text-sm">
    {committees.map((c) => (
      <li data-committee-row data-text={c.name.toLowerCase()}>
        <a href={`/money/committees/${c.entityId}/`} class="flex items-center gap-3 px-4 py-2 hover:bg-navy-50">
          <OrgLogo entityId={c.entityId} name={c.name} />
          <span class="min-w-0 flex-1 truncate underline">{c.name}</span>
          <span class="sr-only shrink-0 text-xs text-navy-600 sm:not-sr-only sm:inline">
            {c.recipients} legislator{c.recipients > 1 ? "s" : ""}
          </span>
          <span class="w-24 shrink-0 text-right font-semibold">{fmtMoney(c.total)}</span>
        </a>
      </li>
    ))}
  </ul>
  <p id="committee-no-match" class="mt-4 hidden rounded-lg border border-navy-100 bg-white p-4 text-sm text-navy-600"></p>

  <script>
    import { initRowFilter } from "../../../scripts/rowFilter";
    initRowFilter({
      input: "committee-filter",
      rows: "[data-committee-row]",
      status: "committee-filter-status",
      noMatch: "committee-no-match",
      noun: "committees",
    });
  </script>
</Base>
