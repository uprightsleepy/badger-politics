---
import Base from "../../../layouts/Base.astro";
import { independentExpenditures, independentExpenditureTotals, conduitFlows } from "../../../lib/db";
import ScrollPanel from "../../../components/ScrollPanel.astro";
import { fmtMoney, fmtDate } from "../../../lib/format";

const spends = independentExpenditures(800);
const conduits = conduitFlows(60);
// totals cover every filing, not just the rows listed below
const totals = independentExpenditureTotals();
const sumOf = (stance: string) => totals.find((t) => t.stance === stance)?.total ?? 0;
const countOf = (stance: string) => totals.find((t) => t.stance === stance)?.n ?? 0;
const forTotal = sumOf("FOR");
const againstTotal = sumOf("AGAINST");
const filingCount = countOf("FOR") + countOf("AGAINST");
// One ad buy is filed twice — supporting one candidate and opposing the
// other — with the same filer, date and amount. Showing both as separate
// rows doubles the apparent number of filings, so pair them into one.
type Spend = (typeof spends)[number];
interface Card {
  date: string; amount: number; filer_name: string | null; filer_type: string | null;
  office: string | null; district: string | null;
  supporting: string[]; opposing: string[];
}
const cards: Card[] = [];
const pairKey = (s: Spend) =>
  [s.date, s.amount, s.filer_entity_id, s.related_office, s.related_district].join("|");
const index = new Map<string, Card>();
for (const s of spends) {
  const key = pairKey(s);
  let card = index.get(key);
  if (!card) {
    card = {
      date: s.date, amount: s.amount, filer_name: s.filer_name, filer_type: s.filer_type,
      office: s.related_office, district: s.related_district, supporting: [], opposing: [],
    };
    index.set(key, card);
    cards.push(card);
  }
  const side = s.stance === "FOR" ? card.supporting : card.opposing;
  if (s.related_name && !side.includes(s.related_name)) side.push(s.related_name);
}

const raceOf = (office: string | null, district: string | null) =>
  [office, district].filter(Boolean).join(" ") || "Race not named in the filing";

// group by the race the filing names, so a reader sees a contest at once
const byRace = new Map<string, Card[]>();
for (const c of cards) {
  const race = raceOf(c.office, c.district);
  if (!byRace.has(race)) byRace.set(race, []);
  byRace.get(race)!.push(c);
}
// Per race: each stance-and-target line exactly as filed with the
// Commission -- "supporting X, $N across k filings" -- summed with no
// splitting or reallocation. A paired ad buy is two filings in the
// source, one for each side, and appears in each line the way the
// Commission's own records carry it. Names are grouped after trimming
// and case-folding only; differently named payees stay separate.
const linesByRace = new Map<string, Map<string, { stance: string; name: string; total: number; n: number }>>();
for (const sp of spends) {
  if (!sp.related_name || !sp.stance) continue;
  const race = raceOf(sp.related_office, sp.related_district);
  if (!linesByRace.has(race)) linesByRace.set(race, new Map());
  const by = linesByRace.get(race)!;
  const key = `${sp.stance}|${sp.related_name.trim().toLowerCase()}`;
  const row = by.get(key) ?? { stance: sp.stance, name: sp.related_name.trim(), total: 0, n: 0 };
  row.total += sp.amount;
  row.n += 1;
  by.set(key, row);
}

const races = [...byRace.entries()]
  .map(([race, rows]) => ({
    race, rows,
    total: rows.reduce((t, r) => t + r.amount, 0),
    summary: [...(linesByRace.get(race)?.values() ?? [])].sort((a, b) => b.total - a.total),
  }))
  .sort((a, b) => b.total - a.total);
---

<Base
  title="Spending for and against candidates"
  description="Independent expenditures in Wisconsin: money spent to support or oppose candidates by committees other than the candidates themselves."
>
  <p class="text-sm text-navy-600"><a href="/money/" class="underline">Campaign money</a></p>
  <h1 class="mt-1 text-2xl font-bold">Spending for and against candidates</h1>
  <p class="mt-1 max-w-3xl text-sm text-navy-700">
    Committees other than a candidate's own can spend unlimited amounts to
    support or oppose that candidate, as long as they do not coordinate with
    them. This is <strong>express advocacy</strong>, and it never appears in
    the candidate's own fundraising totals — so a race can be far more
    expensive than the candidates' filings suggest. Spending
    <em>for</em> one candidate and <em>against</em> their opponent are two
    halves of the same strategy: a group backing a candidate for governor
    will often file both kinds in the same race.
  </p>

  {filingCount === 0 ? (
    <p class="mt-6 rounded-lg border border-navy-100 bg-white p-4 text-sm text-navy-700">
      No express advocacy is recorded in the filings we hold for this period.
      Committees register only after crossing the state's reporting
      threshold, so spending below it never appears at all.
    </p>
  ) : (
    <>
      <div class="mt-4 flex flex-wrap gap-6 rounded-lg border border-navy-100 bg-white p-4 text-sm">
        <p><span class="block text-xs text-navy-600">Spent supporting</span>
          <span class="text-xl font-bold text-moss-600">{fmtMoney(forTotal)}</span></p>
        <p><span class="block text-xs text-navy-600">Spent opposing</span>
          <span class="text-xl font-bold text-badger-700">{fmtMoney(againstTotal)}</span></p>
        <p><span class="block text-xs text-navy-600">Filings</span>
          <span class="text-xl font-bold">{filingCount.toLocaleString()}</span></p>
      </div>

      {spends.length < filingCount && (
        <p class="mt-2 text-xs text-navy-600">
          Totals above cover all {filingCount.toLocaleString()} filings; the
          races below list the {spends.length.toLocaleString()} most recent.
        </p>
      )}
      {races.map(({ race, rows, total, summary }) => (
        <details class="mt-4 rounded-lg border border-navy-100 bg-white" open={total === races[0].total}>
          <summary class="flex cursor-pointer flex-wrap items-baseline gap-x-3 px-4 py-3">
            <span class="text-lg font-bold">{race}</span>
            <span class="text-sm text-navy-600">
              {fmtMoney(total)} across {rows.length.toLocaleString()} ad buy{rows.length === 1 ? "" : "s"}
            </span>
          </summary>
          <div class="border-t border-navy-100 p-3">
            {summary.length > 0 && (
              <ul class="mb-3 max-w-xl space-y-1 text-sm">
                {summary.slice(0, 8).map((l) => (
                  <li class="flex flex-wrap items-baseline gap-x-2">
                    <span
                      class={`shrink-0 rounded-full px-2 py-0.5 text-xs font-bold ${
                        l.stance === "FOR" ? "bg-moss-50 text-moss-600" : "bg-badger-50 text-badger-700"
                      }`}
                    >
                      {l.stance === "FOR" ? "Supporting" : "Opposing"}
                    </span>
                    <span class="min-w-0 flex-1 truncate">{l.name}</span>
                    <span class="shrink-0 font-semibold tabular-nums">{fmtMoney(l.total)}</span>
                    <span class="shrink-0 text-xs text-navy-600">{l.n.toLocaleString()} filing{l.n === 1 ? "" : "s"}</span>
                  </li>
                ))}
              </ul>
            )}
                        <ScrollPanel label={`Spending in ${race}`} max="max-h-[26rem]" count={rows.length}>
              <ul class="divide-y divide-navy-100">
                {rows.map((c) => (
                  <li class="px-3 py-2 text-sm">
                    <div class="flex flex-wrap items-baseline gap-x-3">
                      <span class="w-24 shrink-0 text-xs tabular-nums text-navy-600">{fmtDate(c.date)}</span>
                      <span class="min-w-0 flex-1 truncate text-xs text-navy-600" title={c.filer_name ?? ""}>
                        {c.filer_name ?? "committee not named"}{c.filer_type ? ` · ${c.filer_type}` : ""}
                      </span>
                      <span class="shrink-0 font-semibold tabular-nums">{fmtMoney(c.amount)}</span>
                    </div>
                    <div class="mt-1 flex flex-wrap gap-x-4 gap-y-1">
                      {c.supporting.length > 0 && (
                        <p class="flex min-w-0 items-baseline gap-1.5">
                          <span class="shrink-0 rounded-full bg-moss-50 px-2 py-0.5 text-xs font-bold text-moss-600">FOR</span>
                          <span class="min-w-0 truncate" title={c.supporting.join(", ")}>{c.supporting.join(", ")}</span>
                        </p>
                      )}
                      {c.opposing.length > 0 && (
                        <p class="flex min-w-0 items-baseline gap-1.5">
                          <span class="shrink-0 rounded-full bg-badger-50 px-2 py-0.5 text-xs font-bold text-badger-700">AGAINST</span>
                          <span class="min-w-0 truncate" title={c.opposing.join(", ")}>{c.opposing.join(", ")}</span>
                        </p>
                      )}
                    </div>
                  </li>
                ))}
              </ul>
            </ScrollPanel>
          </div>
        </details>
      ))}
    </>
  )}

  {conduits.length > 0 && (
    <section class="mt-10">
      <h2 class="text-xl font-bold">Conduit pass-throughs</h2>
      <p class="mt-1 max-w-3xl text-sm text-navy-600">
        A conduit collects earmarked money from individuals and forwards it
        to a candidate. The conduit files the transaction, but the money is
        not the conduit's own — the individuals chose the recipient. Shown
        by where the money actually landed.
      </p>
      <ul class="mt-3 space-y-1">
        {conduits.map((c) => (
          <li class="flex flex-wrap items-baseline gap-x-3 rounded-lg border border-navy-100 bg-white px-4 py-2 text-sm">
            <span class="min-w-0 flex-1 truncate font-semibold">{c.conduit}</span>
            <span class="shrink-0 text-navy-600">→</span>
            <span class="min-w-0 flex-1 truncate">{c.recipient}</span>
            <span class="shrink-0 text-xs text-navy-600">{c.n.toLocaleString()} gifts</span>
            <span class="shrink-0 font-semibold tabular-nums">{fmtMoney(c.total)}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  <p class="mt-8 max-w-3xl text-xs text-navy-600">
    Source: Wisconsin Ethics Commission campaign finance filings
    (campaignfinance.wi.gov). Committees register and report only after
    crossing statutory thresholds, and contributions below the itemization
    threshold are reported as totals rather than by donor, so these figures
    are the itemized, reported record — not necessarily all money spent.
    <a href="/about/#money" class="underline"> Full methodology</a>
  </p>
</Base>
