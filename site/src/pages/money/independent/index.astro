---
/** Outside spending on Wisconsin candidates, one filing at a time.
 *
 * No sums, no per-candidate rollups: every row is one filing exactly as
 * the Ethics Commission holds it -- who spent, how much, paid to whom,
 * for or against which campaign, and the report it was filed on. An
 * earlier version totaled these by stance and by campaign, and the
 * totals raised more questions than they answered; the records
 * themselves are unambiguous, so they are the page.
 *
 * Every row carries the Commission's own transaction ID and links the
 * report it came from, so any figure here can be checked against the
 * official system in two clicks.
 */
import Base from "../../../layouts/Base.astro";
import FilterBar from "../../../components/FilterBar.astro";
import SourceStrip from "../../../components/SourceStrip.astro";
import { independentExpenditures, conduitFlows } from "../../../lib/db";
import { fmtMoney, fmtDate } from "../../../lib/format";

// every filing, not a sample: the whole point is completeness
const filings = independentExpenditures(100000);
const conduits = conduitFlows(60);
const latest = filings[0]?.date ?? null;
const officialUrl = (entityId: number) =>
  `https://campaignfinance.wi.gov/browse-data/registrant/${entityId}`;
const facets = [
  { key: "for", label: "Supporting a campaign" },
  { key: "against", label: "Opposing a campaign" },
].map((f) => ({
  ...f,
  count: filings.filter((t) => t.stance.toLowerCase() === f.key).length,
}));
---

<Base
  title="Outside spending on Wisconsin candidates"
  description="Every independent-expenditure filing in Wisconsin, one record at a time, with the Ethics Commission's transaction IDs and links to the reports they were filed on."
  breadcrumbs={[{ name: "Money", url: "/money/" }]}
>
  <p class="text-sm text-navy-600"><a href="/money/" class="underline">Campaign money</a></p>
  <h1 class="mt-1 text-2xl font-bold">Outside spending, filing by filing</h1>
  <p class="mt-1 max-w-3xl text-sm text-navy-700">
    Groups other than a candidate's own committee can spend unlimited
    amounts on ads about that candidate, as long as they don't coordinate
    with the campaign. The Ethics Commission calls each such purchase an
    <strong>independent expenditure</strong>; the group filing it records
    whether the ad supports or opposes a campaign. Below is every one we
    hold, exactly as filed: nothing is added up. Each row carries the
    Commission's transaction ID and links to the report it appeared on and
    to the filer's official page.
  </p>
  <SourceStrip
    sources={[{
      label: "Wisconsin Ethics Commission filings",
      href: "https://campaignfinance.wi.gov/browse-data/transactions",
    }]}
    through={latest}
  />

  <div class="mt-4">
    <FilterBar
      id="filing-filter"
      statusId="filing-filter-status"
      label="Filter filings"
      placeholder="e.g. Crowley, Believe in Wisconsin, Beacon Media…"
      facetAttr="stance"
      facetLabel="Filed as"
      facets={facets}
    />
  </div>

  <ul class="mt-3 divide-y divide-navy-100 rounded-lg border border-navy-100 bg-white text-sm">
    {filings.map((t) => (
      <li
        data-filing-row
        data-text={`${t.filer_name ?? ""} ${t.related_name ?? ""} ${t.purpose ?? ""} ${t.other_name ?? ""} ${t.related_office ?? ""} ${t.id}`.toLowerCase()}
        data-stance={t.stance.toLowerCase()}
        class="px-4 py-2"
      >
        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-0.5">
          <span class="w-24 shrink-0 text-xs tabular-nums text-navy-600">{fmtDate(t.date)}</span>
          <span class="min-w-0 flex-1">
            <a href={officialUrl(t.filer_entity_id)} class="underline">
              {t.filer_name ?? "committee not named"}
            </a>
            {t.filer_type && <span class="text-xs text-navy-600"> &middot; {t.filer_type}</span>}
          </span>
          <span class="shrink-0 font-semibold tabular-nums">{fmtMoney(t.amount)}</span>
        </div>
        <p class="mt-0.5 flex flex-wrap items-baseline gap-x-2 gap-y-0.5 sm:pl-[6.75rem]">
          <span
            class={`shrink-0 rounded-full px-2 py-0.5 text-xs font-bold ${
              t.stance === "FOR" ? "bg-moss-50 text-moss-600" : "bg-badger-50 text-badger-700"
            }`}
          >
            {t.stance === "FOR" ? "Supporting" : "Opposing"}
          </span>
          <span class="min-w-0">{t.related_name}</span>
          {t.related_office && (
            <span class="text-xs text-navy-600">
              ({[t.related_office, t.related_district].filter(Boolean).join(" ")})
            </span>
          )}
        </p>
        <p class="mt-0.5 text-xs text-navy-600 sm:pl-[6.75rem]">
          {t.other_name && <>Paid to {t.other_name}{t.purpose ? ` for ${t.purpose.toLowerCase()}` : ""} &middot; </>}
          Commission transaction ID <span class="font-semibold tabular-nums">{t.id}</span>
          {t.report_id != null && (
            <>
              {" "}&middot;{" "}
              <a href={`https://campaignfinance.wi.gov/browse-data/report/${t.report_id}`} class="underline">
                {t.report_name ?? "filed report"} &#8599;
              </a>
            </>
          )}
        </p>
      </li>
    ))}
  </ul>
  <p id="filing-no-match" class="mt-3 hidden rounded-lg border border-navy-100 bg-white p-4 text-sm text-navy-600">
    No filings match. Try a shorter word, or clear the filter.
  </p>

  {conduits.length > 0 && (
    <section class="mt-10">
      <h2 class="text-xl font-bold">Conduit pass-throughs</h2>
      <p class="mt-1 max-w-3xl text-sm text-navy-600">
        A conduit collects earmarked money from individuals and forwards it
        to a candidate. The conduit files the transaction, but the money is
        not the conduit's own — the individuals chose the recipient. Shown
        by where the money actually landed.
      </p>
      <ul class="mt-3 space-y-1">
        {conduits.map((c) => (
          <li class="flex flex-wrap items-baseline gap-x-3 rounded-lg border border-navy-100 bg-white px-4 py-2 text-sm">
            <span class="min-w-0 flex-1 truncate font-semibold">{c.conduit}</span>
            <span class="shrink-0 text-navy-600">→</span>
            <span class="min-w-0 flex-1 truncate">{c.recipient}</span>
            <span class="shrink-0 text-xs text-navy-600">{c.n.toLocaleString()} gifts</span>
            <span class="shrink-0 font-semibold tabular-nums">{fmtMoney(c.total)}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  <p class="mt-8 max-w-3xl text-xs text-navy-600">
    Source: Wisconsin Ethics Commission campaign finance filings, browsable
    at <a href="https://campaignfinance.wi.gov/browse-data/transactions" class="underline">campaignfinance.wi.gov</a>.
    Committees register and report only after crossing statutory
    thresholds, so spending below them never appears in any filing.
    <a href="/about/#money" class="underline"> Full methodology</a>
  </p>

  <script>
    import { initRowFilter } from "../../../scripts/rowFilter";
    initRowFilter({
      input: "filing-filter",
      rows: "[data-filing-row]",
      status: "filing-filter-status",
      noMatch: "filing-no-match",
      noun: "filings",
      facetAttr: "stance",
    });
  </script>
</Base>
