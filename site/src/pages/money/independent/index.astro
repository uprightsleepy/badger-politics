---
/** Outside spending on Wisconsin candidates, one filing at a time.
 *
 * No sums, no per-candidate rollups: every row is one filing exactly as
 * the Ethics Commission holds it -- who spent, how much, paid to whom,
 * for or against which campaign, and the report it was filed on. An
 * earlier version totaled these by stance and by campaign, and the
 * totals raised more questions than they answered; the records
 * themselves are unambiguous, so they are the page.
 *
 * Every row carries the Commission's own transaction ID and links the
 * report it came from, so any figure here can be checked against the
 * official system in two clicks.
 */
import Base from "../../../layouts/Base.astro";
import FilterBar from "../../../components/FilterBar.astro";
import StanceChip from "../../../components/StanceChip.astro";
import { independentExpenditures, conduitFlows, meta } from "../../../lib/db";
import { fmtMoney, fmtDate } from "../../../lib/format";

// every filing, not a sample: the whole point is completeness
const filings = independentExpenditures(100000);
const conduits = conduitFlows(60);
const latest = filings[0]?.date ?? null;
const pulledOn = meta().imported_at?.slice(0, 10);
const officialUrl = (entityId: number) =>
  `https://campaignfinance.wi.gov/browse-data/registrant/${entityId}`;
const facets = [
  { key: "for", label: "Supporting a campaign" },
  { key: "against", label: "Opposing a campaign" },
].map((f) => ({
  ...f,
  count: filings.filter((t) => t.stance.toLowerCase() === f.key).length,
}));
---

<Base
  title="Outside spending on Wisconsin candidates"
  description="Every independent-expenditure filing in Wisconsin, one record at a time, with the Ethics Commission's transaction IDs and links to the reports they were filed on."
  breadcrumbs={[{ name: "Money", url: "/money/" }]}
  layout="wide"
>
  <header class="flex max-w-[47.5rem] flex-col gap-2.5">
    <a href="/money/" class="self-start text-small underline">Campaign money</a>
    <h1 class="t-display">Outside spending, filing by filing</h1>
    <p class="sm:text-lead">
      Groups other than a candidate's own committee can spend any amount on ads about that candidate,
      as long as they don't coordinate with the campaign. Here is every such filing we have, exactly as
      filed. Nothing is added up.
    </p>
    <p class="text-small text-granite">
      The Ethics Commission calls each purchase an “independent expenditure,” and the
      group that files it says whether the ad supports or opposes a campaign. Each row has the Commission's
      transaction ID and links to the report it was on and to the filer's official page.
      {latest && ` The newest filing is from ${fmtDate(latest)}.`}
    </p>
  </header>

  <div class="mt-4 max-w-[47.5rem]">
    <FilterBar
      wide
      id="filing-filter"
      statusId="filing-filter-status"
      label="Find a filing"
      placeholder="A group, candidate or vendor"
      facetAttr="stance"
      facetLabel="Show filings that are"
      facets={facets}
    />
  </div>

  <ul class="mt-3 max-w-[60rem] border-b border-rule" role="list">
    {filings.map((t) => (
      <li
        data-filing-row
        data-text={`${t.filer_name ?? ""} ${t.related_name ?? ""} ${t.purpose ?? ""} ${t.other_name ?? ""} ${t.related_office ?? ""} ${t.related_district ?? ""} ${t.id}`.toLowerCase()}
        data-stance={t.stance.toLowerCase()}
        class="flex flex-col gap-1.5 border-t border-rule py-3"
      >
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <span class="min-w-0 flex-1 [overflow-wrap:anywhere]">
            <a href={officialUrl(t.filer_entity_id)} class="font-bold underline">{t.filer_name ?? "Committee not named"}</a>{t.filer_type && <span class="text-small text-granite">, {t.filer_type}</span>}
          </span>
          <span class="shrink-0 font-display font-bold tabular-nums">{fmtMoney(t.amount)}</span>
        </div>
        <p class="flex flex-wrap items-center gap-x-2 gap-y-1">
          <StanceChip stance={t.stance} />
          <span class="min-w-0">
            {t.related_name}
            {(t.related_office || t.related_district) && (
              <span class="text-small text-granite"> ({[t.related_office, t.related_district].filter(Boolean).join(" ")})</span>
            )}
          </span>
        </p>
        <p class="text-small text-granite">
          {fmtDate(t.date)}.
          {t.other_name && <> Paid to {t.other_name}{t.purpose ? ` for ${t.purpose.toLowerCase()}` : ""}.</>}
          {" "}Transaction ID <span class="tabular-nums">{t.id}</span>{t.report_id != null && <>, on <a href={`https://campaignfinance.wi.gov/browse-data/report/${t.report_id}`} class="underline">{t.report_name ?? "the filed report"}</a></>}.
        </p>
      </li>
    ))}
  </ul>
  <p id="filing-no-match" class="mt-4 hidden text-granite"></p>

  {conduits.length > 0 && (
    <section class="mt-12 max-w-[60rem]" aria-labelledby="conduits-heading">
      <h2 id="conduits-heading" class="t-section">Money passed through conduits</h2>
      <p class="mt-2 max-w-[47.5rem] text-small text-granite">
        A conduit collects money that individuals have set aside for a candidate and passes it on. The
        conduit files the transaction, but the money isn't its own: the individuals chose who gets it.
        Shown by where the money ended up.
      </p>
      <ul class="mt-3 border-b border-rule" role="list">
        {conduits.map((c) => (
          <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-t border-rule py-2.5">
            <span class="min-w-0 flex-1 [overflow-wrap:anywhere]">
              <span class="font-bold">{c.conduit}</span> to {c.recipient}
              <span class="block text-small text-granite">{c.n.toLocaleString()} {c.n === 1 ? "gift" : "gifts"}</span>
            </span>
            <span class="shrink-0 font-display font-bold tabular-nums">{fmtMoney(c.total)}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  <p class="mt-10 max-w-[47.5rem] text-fine text-granite">
    From the Wisconsin Ethics Commission's campaign finance filings, which you can search in
    {" "}<a href="https://campaignfinance.wi.gov/browse-data/transactions" class="underline">the Commission's transaction browser</a>{pulledOn && `; checked ${fmtDate(pulledOn)}`}.
    Committees register and report only after crossing amounts set by law, so spending below them never
    appears in any filing. <a href="/about/#money" class="underline">Full methodology</a>
  </p>

  <script>
    import { initRowFilter } from "../../../scripts/rowFilter";
    initRowFilter({
      input: "filing-filter",
      rows: "[data-filing-row]",
      status: "filing-filter-status",
      noMatch: "filing-no-match",
      noun: "filings",
      facetAttr: "stance",
    });
  </script>
</Base>
