---
/** Every full veto, partial veto and override attempt, per session,
 * straight from the official bill histories. */
import Base from "../../layouts/Base.astro";
import BillLine from "../../components/BillLine.astro";
import MoreRows from "../../components/MoreRows.astro";
import { vetoTracker, vetoMessageUrl, meta } from "../../lib/db";
import { billSlug, chamberName, fmtDate } from "../../lib/format";
const bienniums = vetoTracker();
const pulledOn = meta().imported_at?.slice(0, 10);
const plural = (n: number, one: string, many: string) => `${n.toLocaleString()} ${n === 1 ? one : many}`;
const SHOWN = 10;
const newest = bienniums[0];
---

<Base
  title="Vetoes"
  description="Every gubernatorial veto, partial veto, and override attempt, from the official bill histories."
  layout="wide"
>
  <header class="flex max-w-[47.5rem] flex-col gap-2.5">
    <h1 class="t-display">Vetoes</h1>
    {newest ? (
      <p class="sm:text-lead">
        In the {newest.biennium}–{newest.biennium + 1} session, the governor vetoed
        {" "}<span class="figure">{plural(newest.fullVetoes.length, "bill", "bills")}</span> and signed
        {" "}<span class="figure">{newest.partialVetoes.length.toLocaleString()}</span> with a partial veto.
        {newest.attempts.length > 0
          ? ` Lawmakers tried to override a veto ${newest.attempts.length === 1 ? "once" : `${newest.attempts.length.toLocaleString()} times`}.`
          : " Lawmakers haven't tried to override any of them."}
      </p>
    ) : (
      <p class="sm:text-lead">No vetoes are recorded for the sessions on this site.</p>
    )}
    <p class="text-small text-granite">
      A Wisconsin governor can veto a whole bill or, on a bill that spends money, strike parts of it and
      sign the rest (<a href="/partial-veto/" class="underline">how the partial veto works</a>). Overriding a
      veto takes a two-thirds vote in both chambers; an attempt that passes only one doesn't become law.
    </p>
  </header>

  {bienniums.map((b) => (
    <section class="mt-12 max-w-[60rem]" aria-labelledby={`session-${b.biennium}`}>
      <h2 id={`session-${b.biennium}`} class="t-section">{b.biennium}–{b.biennium + 1} session</h2>

      {b.attempts.length > 0 && (
        <section class="mt-6" aria-labelledby={`attempts-${b.biennium}`}>
          <h3 id={`attempts-${b.biennium}`} class="t-question text-[1.1875rem]">Override attempts: {b.attempts.length.toLocaleString()}</h3>
          <p class="mt-1 text-small text-granite">Each line is the official history's own wording.</p>
          <ul class="mt-2 border-b border-rule" role="list">
            {b.attempts.map((a) => (
              <BillLine href={`/bills/${a.session_id}/${billSlug(a.identifier)}/`} identifier={a.identifier} title={a.title} date={fmtDate(a.date)}>
                {a.description}.
                {a.vote && <> <a href={`/votes/${a.vote.id}/`} class="underline">{chamberName(a.vote.chamber)} roll call, {a.vote.yes} to {a.vote.no}</a></>}
              </BillLine>
            ))}
          </ul>
        </section>
      )}

      {b.fullVetoes.length > 0 && (
        <section class="mt-8" aria-labelledby={`vetoed-${b.biennium}`}>
          <h3 id={`vetoed-${b.biennium}`} class="t-question text-[1.1875rem]">Vetoed bills: {b.fullVetoes.length.toLocaleString()}</h3>
          <p class="mt-1 text-small text-granite">Newest first, with the governor's veto message where the Legislature publishes one.</p>
          <div class="mt-2">
            <MoreRows rest={Math.max(0, b.fullVetoes.length - SHOWN)} label={`vetoed bills, ${b.biennium}–${b.biennium + 1}`}>
              {b.fullVetoes.slice(0, SHOWN).map((v) => {
                const msg = vetoMessageUrl(v.bill_id);
                return (
                  <BillLine href={`/bills/${v.session_id}/${billSlug(v.identifier)}/`} identifier={v.identifier} title={v.title} date={fmtDate(v.date)}>
                    {msg && <a href={msg} class="underline">The governor's veto message</a>}
                  </BillLine>
                );
              })}
              <Fragment slot="rest">
                {b.fullVetoes.slice(SHOWN).map((v) => {
                  const msg = vetoMessageUrl(v.bill_id);
                  return (
                    <BillLine href={`/bills/${v.session_id}/${billSlug(v.identifier)}/`} identifier={v.identifier} title={v.title} date={fmtDate(v.date)}>
                      {msg && <a href={msg} class="underline">The governor's veto message</a>}
                    </BillLine>
                  );
                })}
              </Fragment>
            </MoreRows>
          </div>
        </section>
      )}

      {b.partialVetoes.length > 0 && (
        <section class="mt-8" aria-labelledby={`partial-${b.biennium}`}>
          <h3 id={`partial-${b.biennium}`} class="t-question text-[1.1875rem]">Signed with a partial veto: {b.partialVetoes.length.toLocaleString()}</h3>
          <p class="mt-1 text-small text-granite">In act order. The parts the governor struck are in the veto message.</p>
          <ul class="mt-2 border-b border-rule" role="list">
            {b.partialVetoes.map((l) => {
              const msg = vetoMessageUrl(l.bill_id);
              return (
                <BillLine href={`/bills/${l.session_id}/${billSlug(l.identifier)}/`} identifier={l.identifier} title={l.title} lead={`Act ${l.act}`} date={l.approved ? fmtDate(l.approved) : ""}>
                  {msg && <a href={msg} class="underline">The governor's veto message</a>}
                </BillLine>
              );
            })}
          </ul>
        </section>
      )}
    </section>
  ))}

  <p class="mt-12 max-w-[47.5rem] text-fine text-granite">
    From each bill's official history at the
    {" "}<a href="https://docs.legis.wisconsin.gov" class="underline">Wisconsin Legislature</a>{pulledOn && `, checked ${fmtDate(pulledOn)}`}.
    {" "}<a href="/governors-desk/" class="underline">Everything the governor decided this session</a>
  </p>
</Base>
