---
/** A member's complete voting record, paged. The profile shows the most
 * recent 200; a long career runs to thousands, and putting them all in one
 * document produced a 2.9 MB page. These are noindex like roll calls --
 * derived lists whose substance lives on the bill pages -- but crawlable,
 * so they give search engines a link path into old sessions. */
import Base from "../../../../layouts/Base.astro";
import VoteRow from "../../../../components/VoteRow.astro";
import Pager from "../../../../components/Pager.astro";
import { people, personVoteCount, personVotes } from "../../../../lib/db";
import { chamberName, personSlug, roleAbbr } from "../../../../lib/format";
import { PER_PAGE, pageBounds, pageCount } from "../../../../lib/paging";

export function getStaticPaths() {
  return people().flatMap((p) => {
    const total = personVoteCount(p.id);
    const pages = pageCount(total);
    return Array.from({ length: pages }, (_, i) => ({
      params: { slug: personSlug(p.id), page: String(i + 1) },
      props: { person: p, page: i + 1, pages, total },
    }));
  });
}

const { person, page, pages, total } = Astro.props;
const rows = personVotes(person.id, PER_PAGE, (page - 1) * PER_PAGE);
const base = `/legislators/${personSlug(person.id)}`;
const seat = person.district != null ? `, ${roleAbbr(person.chamber)} ${person.district}` : "";
const { first, last } = pageBounds(page, total);
---

<Base
  title={`${person.name}${seat}: every vote, page ${page} of ${pages}`}
  description={`Votes ${first.toLocaleString()}–${last.toLocaleString()} of ${total.toLocaleString()} cast by ${person.name} in the Wisconsin ${chamberName(person.chamber)}, from the official roll calls.`}
  noindex
  searchable={false}
  layout="wide"
  breadcrumbs={[
    { name: "Legislators", url: "/legislators/" },
    { name: person.name, url: `${base}/` },
  ]}
>
  <div class="flex max-w-[47.5rem] flex-col gap-2.5">
    <a href={`${base}/`} class="self-start text-small underline">{person.name}</a>
    <h1 class="t-display">Every vote</h1>
    <p class="sm:text-lead">
      {total.toLocaleString()} roll call votes, newest first. Showing
      {" "}{first.toLocaleString()} to {last.toLocaleString()}.
    </p>
  </div>

  <ul class="mt-6 flex max-w-[47.5rem] flex-col border-y border-rule py-1">
    {rows.map((v) => <VoteRow v={v} />)}
  </ul>

  <Pager page={page} pages={pages} href={(n) => `${base}/votes/${n}/`} label="Vote record pages" />
</Base>
