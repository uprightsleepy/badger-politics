---
/** Every sitting state lawmaker, by chamber and district: who holds each
 * chamber's seats in a sentence, then one row per lawmaker linking their
 * page. Filtering happens in the browser over rows that are all present,
 * so a filtered view never hides anyone from search engines or from no-JS. */
import Base from "../../layouts/Base.astro";
import FilterBar from "../../components/FilterBar.astro";
import Portrait from "../../components/Portrait.astro";
import { sittingPeople, electionFor } from "../../lib/db";
import { partyWord, personSlug, seatsSentence } from "../../lib/format";
import { ballotStatus } from "../../lib/ballot";

const members = sittingPeople();
const onBallot = new Map(
  members.map((m) => [m.id, ballotStatus(electionFor(m.id)).kind === "on-ballot"]),
);
const chambers = [
  { key: "upper", label: "Senate", seats: 33, slug: "senate", one: "senator", rows: members.filter((m) => m.chamber === "upper") },
  { key: "lower", label: "Assembly", seats: 99, slug: "assembly", one: "representative", rows: members.filter((m) => m.chamber === "lower") },
];
// a member with no district on record can't be placed, so then the open
// seats can't be named either
const vacant = (rows: typeof members, seats: number) => {
  if (rows.some((m) => m.district == null)) return [];
  const held = new Set(rows.map((m) => m.district));
  return Array.from({ length: seats }, (_, i) => i + 1).filter((d) => !held.has(d));
};
const count = (pred: (m: (typeof members)[number]) => boolean) => members.filter(pred).length;
const facets = [
  { key: "all", label: "Everyone", n: members.length },
  { key: "party:Democratic", label: "Democrats", n: count((m) => m.party === "Democratic") },
  { key: "party:Republican", label: "Republicans", n: count((m) => m.party === "Republican") },
  { key: "ballot", label: "On the 2026 ballot", n: count((m) => !!onBallot.get(m.id)) },
].filter((f) => f.key === "all" || f.n > 0);
---

<Base
  title="State lawmakers"
  description="Every member of the Wisconsin Assembly and Senate: how they voted, the bills they led, their committees, attendance and campaign money."
  layout="wide"
>
  <header class="flex max-w-[47.5rem] flex-col gap-2.5">
    <h1 class="t-display">State lawmakers</h1>
    <p class="sm:text-lead">
      Wisconsin's Legislature has 132 seats: 33 in the Senate and 99 in the Assembly. Each lawmaker's
      page has how they vote, the bills they've led, their committees and their campaign money.
    </p>
    <p>
      Not sure who yours are? <a href="/my-reps/" class="underline">Find your lawmakers</a>.
      Looking for Washington? <a href="/federal/" class="underline">Members of Congress from Wisconsin</a>.
    </p>
  </header>

  <div class="mt-4 max-w-[47.5rem]">
    <FilterBar
      wide
      id="member-filter"
      statusId="member-count"
      label="Find a lawmaker"
      placeholder="Name or district number"
    >
      <div class="mt-3 flex flex-wrap gap-2" role="group" aria-label="Show lawmakers">
        {facets.map((f) => (
          <button type="button" data-member-facet={f.key} aria-pressed={f.key === "all" ? "true" : "false"} class="chip">
            {f.label} <span class="figure">{f.n.toLocaleString()}</span>
          </button>
        ))}
      </div>
    </FilterBar>
  </div>

  {chambers.map((c) => {
    const empty = vacant(c.rows, c.seats);
    return (
      <section class="mt-8" aria-labelledby={`${c.slug}-heading`}>
        <h2 id={`${c.slug}-heading`} class="t-section">{c.label}</h2>
        <p class="mt-2 max-w-[47.5rem]">
          {seatsSentence(c.label, c.seats, c.rows.map((m) => m.party))}
          {empty.length > 0 && (
            <>
              {" "}
              {empty.map((d, i) => (
                <>{i > 0 && (i === empty.length - 1 ? (empty.length > 2 ? ", and " : " and ") : ", ")}<a href={`/districts/${c.slug}-${d}/`} class="underline">{c.label} District {d}</a></>
              ))}
              {empty.length === 1 ? " is vacant." : " are vacant."}
            </>
          )}
        </p>
        <ul class="mt-4 grid gap-x-8 border-b border-rule sm:grid-cols-2 lg:grid-cols-3" role="list" data-no-rep-highlight>
          {c.rows.map((m) => (
            <li
              class="border-t border-rule"
              data-member
              data-party={m.party ?? ""}
              data-ballot={onBallot.get(m.id) ? "1" : "0"}
              data-seat={`${c.key}-${m.district}`}
              data-text={`${m.name} ${m.district ?? ""}`.toLowerCase()}
            >
              <a href={`/legislators/${personSlug(m.id)}/`} class="flex min-h-11 items-center gap-3 py-3">
                <Portrait src={m.image_url} name={m.name} size={44} />
                <span class="min-w-0">
                  <span class="block font-bold text-lake underline [overflow-wrap:anywhere]">{m.name}</span>
                  <span class="block text-small text-spruce">
                    {m.district != null ? `District ${m.district}.` : "District not recorded."} {partyWord(m.party)}.{onBallot.get(m.id) && " On the 2026 ballot."}
                  </span>
                  <span class="mt-1 block" data-mine data-pagefind-ignore hidden><span class="mine text-small">{c.key === "upper" ? "Your state senator" : "Your representative"}</span></span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    );
  })}
  <p id="member-no-match" class="mt-4 hidden text-granite"></p>

  <p class="mt-12 max-w-[47.5rem] text-fine text-granite">
    From the <a href="https://legis.wisconsin.gov/" class="underline">Wisconsin Legislature's</a> member records.
    Ballot status from the <a href="https://elections.wi.gov/" class="underline">Wisconsin Elections Commission</a>.
  </p>

<script>
  import { initRowFilter, paintChips } from "../../scripts/rowFilter";
  import { savedDistrict } from "../../lib/district";

  // The text filter, live count, empty state and browser-restore re-apply
  // are the shared list filter's. This page's own: one chip row that
  // matches on either party or ballot status, and hiding a chamber
  // section whose members are all filtered out. Nothing is fetched and
  // nothing is hidden from a crawler: every member stays in the HTML.
  const chips = [...document.querySelectorAll<HTMLButtonElement>("[data-member-facet]")];
  let facet = "all";
  const matchesFacet = (row: HTMLElement) =>
    facet === "all" ||
    (facet === "ballot" && row.dataset.ballot === "1") ||
    (facet.startsWith("party:") && row.dataset.party === facet.slice(6));

  const apply = initRowFilter({
    input: "member-filter",
    rows: "[data-member]",
    status: "member-count",
    noMatch: "member-no-match",
    noun: "lawmakers",
    extra: matchesFacet,
  });
  const hideEmptySections = () => {
    for (const section of document.querySelectorAll("main section")) {
      const own = [...section.querySelectorAll<HTMLElement>("[data-member]")];
      if (own.length) {
        section.classList.toggle("hidden", own.every((r) => r.classList.contains("sorted-hidden")));
      }
    }
  };

  for (const chip of chips) {
    chip.addEventListener("click", () => {
      facet = chip.dataset.memberFacet ?? "all";
      paintChips(chips, (c) => c === chip);
      apply();
      hideEmptySections();
    });
  }
  // "Clear filters" clears this page's chips too, and shows while any filter is on
  const input = document.getElementById("member-filter") as HTMLInputElement;
  const clear = document.querySelector<HTMLButtonElement>('[data-filter-clear="member-filter"]');
  const syncClear = () => clear?.classList.toggle("hidden", !input.value && facet === "all");
  for (const chip of chips) chip.addEventListener("click", syncClear);
  clear?.addEventListener("click", () => {
    facet = "all";
    paintChips(chips, (c) => c.dataset.memberFacet === "all");
    apply();
    hideEmptySections();
    syncClear();
  });
  input.addEventListener("input", () => {
    hideEmptySections();
    syncClear();
  });
  hideEmptySections();
  window.addEventListener("pageshow", hideEmptySections);
  window.addEventListener("popstate", hideEmptySections);

  // the reader's own two lawmakers, from the district saved on this device
  const saved = savedDistrict();
  if (saved) {
    for (const seat of [`upper-${saved.sd}`, `lower-${saved.ad}`]) {
      document.querySelector(`[data-seat="${seat}"] [data-mine]`)?.removeAttribute("hidden");
    }
  }
</script>
</Base>
