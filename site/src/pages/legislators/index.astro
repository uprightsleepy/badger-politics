---
import Base from "../../layouts/Base.astro";
import PartyChip from "../../components/PartyChip.astro";
import Portrait from "../../components/Portrait.astro";
import { sittingPeople, electionFor } from "../../lib/db";
import { personSlug } from "../../lib/format";
const members = sittingPeople();
// filtering happens in the browser over rows that are all present, so a
// filtered view never hides anyone from search engines or from no-JS
const onBallot = new Map(
  members.map((m) => {
    const e = electionFor(m.id);
    return [m.id, e?.cycle_year === 2026 && e.on_ballot === 1];
  }),
);
const senate = members.filter((m) => m.chamber === "upper");
const assembly = members.filter((m) => m.chamber === "lower");

function breakdown(rows: typeof members, seatCount: number) {
  const dem = rows.filter((m) => m.party === "Democratic").length;
  const rep = rows.filter((m) => m.party === "Republican").length;
  const other = rows.length - dem - rep;
  const occupied = new Set(rows.map((m) => m.district));
  const vacant = Array.from({ length: seatCount }, (_, i) => i + 1).filter(
    (d) => !occupied.has(d),
  );
  const majority = rep > dem ? "Republican majority" : dem > rep ? "Democratic majority" : "Even split";
  return { dem, rep, other, vacant, majority, total: seatCount };
}
---

<Base
  title="Legislators"
  description="Every member of the Wisconsin Assembly and Senate: how they voted, the bills they led, their committees, attendance and campaign money."
>
  <h1 class="text-2xl font-bold">Wisconsin Legislators</h1>
  <p class="mt-1 text-sm text-navy-600">
    Looking for Washington instead? <a href="/federal/" class="underline">Wisconsin's U.S. senators and House members &rarr;</a>
  </p>
  <p class="mt-1 text-sm text-navy-600">
    Don't know your district? <a href="/my-reps/" class="underline">Find your legislators</a>.
  </p>

  <div class="sticky top-0 z-20 -mx-4 mt-4 border-b border-navy-100 bg-paper/95 px-4 py-3 backdrop-blur" data-pagefind-ignore>
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
      <label class="sr-only" for="member-filter">Filter legislators by name or district</label>
      <input
        type="search"
        id="member-filter"
        placeholder="Name or district number"
        class="min-w-0 flex-1 rounded-lg border border-navy-100 bg-white px-3 py-2 text-sm sm:max-w-xs sm:flex-none"
      />
      <div class="flex flex-wrap gap-1.5" role="group" aria-label="Filter legislators">
        {[
          ["all", "Everyone"],
          ["party:Republican", "Republicans"],
          ["party:Democratic", "Democrats"],
          ["ballot", "On the 2026 ballot"],
        ].map(([key, label]) => (
          <button
            type="button"
            data-member-facet={key}
            aria-pressed={key === "all" ? "true" : "false"}
            class={`shrink-0 rounded-full border px-3 py-1 text-xs font-semibold ${
              key === "all" ? "border-navy-800 bg-navy-800 text-white" : "border-navy-100 bg-white"
            }`}
          >{label}</button>
        ))}
      </div>
      <p id="member-count" role="status" class="text-sm text-navy-600"></p>
    </div>
  </div>
  {[
    { label: "Senate", rows: senate, seats: 33 },
    { label: "Assembly", rows: assembly, seats: 99 },
  ].map((chamber) => {
    const b = breakdown(chamber.rows, chamber.seats);
    return (
    <section class="mt-6">
      <h2 class="text-xl font-bold">{chamber.label} · {chamber.rows.length} of {b.total} seats</h2>
      <div class="mt-2 rounded-lg border border-navy-100 bg-white p-3">
        <div class="flex h-3 overflow-hidden rounded-full" role="img" aria-label={`${b.rep} Republicans, ${b.dem} Democrats${b.other ? `, ${b.other} other` : ""}${b.vacant.length ? `, ${b.vacant.length} vacant` : ""}`}>
          <div class="bg-badger-600" style={`width: ${(b.rep / b.total) * 100}%`}></div>
          <div class="bg-gold-500" style={`width: ${(b.other / b.total) * 100}%`}></div>
          <div class="bg-navy-100" style={`width: ${(b.vacant.length / b.total) * 100}%`}></div>
          <div class="ml-auto bg-navy-600" style={`width: ${(b.dem / b.total) * 100}%`}></div>
        </div>
        <p class="mt-2 flex flex-wrap gap-x-4 text-sm">
          <span class="font-semibold text-badger-700">{b.rep} Republicans</span>
          <span class="font-semibold text-navy-700">{b.dem} Democrats</span>
          {b.other > 0 && <span class="font-semibold">{b.other} other</span>}
          <span class={b.vacant.length ? "font-semibold" : "text-navy-600"}>
            {b.vacant.length
              ? `${b.vacant.length} vacant: District ${b.vacant.join(", ")}`
              : "no vacancies"}
          </span>
          <span class="ml-auto text-navy-600">{b.majority}</span>
        </p>
      </div>
      <ul class="mt-2 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
        {chamber.rows.map((m) => (
          <li
            data-member
            data-party={m.party ?? ""}
            data-ballot={onBallot.get(m.id) ? "1" : "0"}
            data-text={`${m.name} ${m.district ?? ""}`.toLowerCase()}
          >
            <a
              href={`/legislators/${personSlug(m.id)}/`}
              class="flex h-full items-center gap-3 rounded-lg border border-navy-100 bg-white p-3 hover:border-navy-600"
            >
              <Portrait src={m.image_url} name={m.name} size={40} className="sm:h-12 sm:w-12" />
              <span class="min-w-0 flex-1">
                <span class="block truncate font-semibold">{m.name}</span>
                <span class="mt-0.5 flex flex-wrap items-center gap-x-1.5 gap-y-0.5 text-xs text-navy-600">
                  <PartyChip party={m.party} size="sm" />
                  District {m.district}
                  {onBallot.get(m.id) && (
                    <span class="rounded-full bg-gold-100 px-1.5 py-0.5 font-semibold text-navy-800">
                      On the ballot
                    </span>
                  )}
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
    );
  })}
  <p id="member-no-match" class="mt-3 hidden rounded-lg border border-navy-100 bg-white p-4 text-sm text-navy-600"></p>

<script>
  import { initRowFilter, paintChips } from "../../scripts/rowFilter";

  // The text filter, live count, empty state and browser-restore re-apply
  // are the shared list filter's. This page's own: one chip row that
  // matches on either party or ballot status, and hiding a chamber
  // heading whose members are all filtered out. Nothing is fetched and
  // nothing is hidden from a crawler: every member stays in the HTML.
  const chips = [...document.querySelectorAll<HTMLButtonElement>("[data-member-facet]")];
  let facet = "all";
  const matchesFacet = (row: HTMLElement) =>
    facet === "all" ||
    (facet === "ballot" && row.dataset.ballot === "1") ||
    (facet.startsWith("party:") && row.dataset.party === facet.slice(6));

  const apply = initRowFilter({
    input: "member-filter",
    rows: "[data-member]",
    status: "member-count",
    noMatch: "member-no-match",
    noun: "legislators",
    extra: matchesFacet,
  });
  const hideEmptySections = () => {
    for (const section of document.querySelectorAll("section")) {
      const own = [...section.querySelectorAll<HTMLElement>("[data-member]")];
      if (own.length) {
        section.classList.toggle("hidden", own.every((r) => r.classList.contains("sorted-hidden")));
      }
    }
  };

  for (const chip of chips) {
    chip.addEventListener("click", () => {
      facet = chip.dataset.memberFacet ?? "all";
      paintChips(chips, (c) => c === chip);
      apply();
      hideEmptySections();
    });
  }
  document.getElementById("member-filter")!.addEventListener("input", hideEmptySections);
</script>
</Base>
