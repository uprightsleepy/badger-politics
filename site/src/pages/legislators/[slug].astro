---
import Base from "../../layouts/Base.astro";
import VoteHeatmap from "../../components/VoteHeatmap.astro";
import MoneyTimeline from "../../components/MoneyTimeline.astro";
import FollowButton from "../../components/FollowButton.astro";
import MaybeLink from "../../components/MaybeLink.astro";
import OrgLogo from "../../components/OrgLogo.astro";
import VoteRow from "../../components/VoteRow.astro";
import {
  people,
  personVotes,
  personSponsorships,
  electionFor,
  chamberVoteDays,
  personVoteDays,
  termsFor,
  partyAgreement,
  electionHistoryFor,
  moneyFor,
  personIdByName,
  hasDonorPage,
} from "../../lib/db";
import {
  COMPENSATION,
  personSlug,
  partyStyle,
  chamberName,
  fmtDate,
  fmtMoney,
  monthYear,
  billSlug,
  STATUS_LABELS,
  STATUS_STYLES,
} from "../../lib/format";
import { mergeServiceSpans, buildHeatDays } from "../../lib/service";

export function getStaticPaths() {
  return people().map((p) => ({
    params: { slug: personSlug(p.id) },
    props: { person: p },
  }));
}
const { person } = Astro.props;
const votes = personVotes(person.id, 3000);
const sponsorships = personSponsorships(person.id);
const election = electionFor(person.id);
const sitting = person.current_role === "Representative" || person.current_role === "Senator";
const opponents = election?.opponents.filter((o) => o.ballot_status !== "Deny") ?? [];

// Attendance heatmap: a chamber's voting day counts only when it falls
// inside one of this person's recorded service terms for that chamber.
// Recalls and resignations end terms mid-biennium; out-of-office gaps
// (e.g. between a recall and a comeback) never show as missed votes.
const terms = termsFor(person.id);
const serviceSpans = mergeServiceSpans(terms);

const mine = personVoteDays(person.id);
const heatDays = buildHeatDays(terms, mine, chamberVoteDays());
const heatYears = [...new Set(heatDays.map((d) => Number(d.date.slice(0, 4))))].sort(
  (a, b) => b - a,
);
const missedTotal = heatDays.reduce((s, d) => s + Math.max(0, d.total - d.cast - d.nv), 0);
const votesTotal = heatDays.reduce((s, d) => s + d.total, 0);

// Running tally of their sponsored bills by stage; counts recompute from
// live statuses every nightly rebuild, so they track bills through stages.
const agreement = partyAgreement(person.id, person.party);
const money = sitting ? moneyFor(person.id) : null;
const history = sitting ? electionHistoryFor(person.chamber, person.district) : [];
const surname = person.name.split(" ").pop()!.toLowerCase();
const primarySponsored = sponsorships.filter((s) => s.is_primary);
const TALLY_ORDER = [
  "enacted",
  "vetoed",
  "passed",
  "passed_chamber",
  "in_committee",
  "introduced",
  "failed_sjr1",
];
const tally = TALLY_ORDER.map((status) => ({
  status,
  bills: primarySponsored.filter((s) => s.status === status),
})).filter((t) => t.bills.length > 0);
---

<Base title={person.name} description={`${person.current_role ?? "Legislator"}, ${chamberName(person.chamber)} District ${person.district}`}>
  <div class="flex flex-wrap items-center gap-3">
    <h1 class="text-2xl font-bold">{person.name}</h1>
    <span class="ml-auto flex items-center gap-3">
      <FollowButton kind="legislators" id={personSlug(person.id)} />
      <a href={`/feeds/legislators/${personSlug(person.id)}.xml`} class="text-xs underline">Atom feed</a>
    </span>
  </div>
  <p class="mt-1 text-sm">
    <span class={`mr-1 rounded-full px-2 py-0.5 text-xs font-bold ${partyStyle(person.party)}`}>
      {person.party ?? "—"}
    </span>
    {person.current_role} · {chamberName(person.chamber)}
    {person.district != null && ` District ${person.district}`}
  </p>
  <div class="mt-4 flex flex-col gap-6 md:flex-row">
    <aside class="w-full shrink-0 md:w-64" aria-label={`About ${person.name}`}>
      <div class="rounded-lg border border-navy-100 bg-white p-4">
        {person.image_url && (
          <img
            src={person.image_url}
            alt={`Portrait of ${person.name}`}
            width="120"
            height="150"
            loading="lazy"
            class="mb-3 rounded"
          />
        )}
        {serviceSpans.length > 0 && (
          <div class="mt-3 rounded bg-navy-50 p-3 text-sm">
            <h2 class="font-bold">Service</h2>
            {serviceSpans.map((s) => (
              <p class="mt-1">
                {chamberName(s.chamber)}
                {s.district != null && ` District ${s.district}`}:{" "}
                {monthYear(s.start)} to {s.end ? monthYear(s.end) : "present"}
                {s.end_label && (
                  <span class="block text-xs text-navy-600">
                    {s.end_url ? (
                      <a href={s.end_url} class="underline">{s.end_label}</a>
                    ) : (
                      s.end_label
                    )}
                  </span>
                )}
              </p>
            ))}
            <p class="mt-1 text-xs text-navy-600">
              From the Legislature's service records. Records begin 2009 for
              the longest-serving members.
            </p>
          </div>
        )}
        {sitting && election && (
          <div class="mt-3 rounded bg-navy-50 p-3 text-sm">
            <h2 class="font-bold">Up for reelection: Nov {election.cycle_year}</h2>
            {election.on_ballot === 1 && <p class="mt-1">On the ballot ✓</p>}
            {election.on_ballot === 0 && (
              <p class="mt-1 font-semibold text-badger-700">Not running (retiring)</p>
            )}
            {election.on_ballot == null && <p class="mt-1">Candidate list pending</p>}
            {opponents.length > 0 && (
              <p class="mt-1">
                {election.on_ballot === 0 ? "Candidates" : "Challengers"}:{" "}
                {opponents.map((o, i) => {
                  const pid = personIdByName(o.name);
                  return (
                    <>
                      {i > 0 && ", "}
                      {pid ? (
                        <a href={`/legislators/${personSlug(pid)}/`} class="underline">{o.name}</a>
                      ) : (
                        o.name
                      )}
                      {` (${o.party[0] ?? "?"})`}
                    </>
                  );
                })}
              </p>
            )}
            {election.on_ballot === 1 && opponents.length === 0 && (
              <p class="mt-1">No opponents have qualified so far.</p>
            )}
            <p class="mt-1 text-xs text-navy-600">
              Status comes from the Wisconsin Elections Commission's ballot access
              report. The final ballot is certified after the August primary.
            </p>
          </div>
        )}
        {agreement.length > 0 && (
          <div class="mt-3 rounded bg-navy-50 p-3 text-sm">
            <h2 class="font-bold">Votes with party majority</h2>
            {agreement.slice(0, 3).map((a) => (
              <p class="mt-1">
                {a.session}: <strong>{a.pct.toFixed(1)}%</strong>
                <span class="text-xs text-navy-600"> of {a.n.toLocaleString()} floor votes</span>
              </p>
            ))}
            <p class="mt-1 text-xs text-navy-600">
              How often their aye or nay matched most of their own party.
            </p>
          </div>
        )}
        {history.length > 0 && (
          <div class="mt-3 rounded bg-navy-50 p-3 text-sm">
            <h2 class="font-bold">Election results for this seat</h2>
            {history.map((h) => (
              <div class="mt-2">
                <p class="text-xs font-semibold text-navy-600">November {h.year}</p>
                {h.candidates.map((c) => {
                  const isThem = c.candidate.toLowerCase().includes(surname);
                  const pct = h.total ? ((c.votes / h.total) * 100).toFixed(1) : "0";
                  const pid = personIdByName(c.candidate);
                  return (
                    <p class={isThem ? "font-bold" : ""}>
                      {pid && pid !== person.id ? (
                        <a href={`/legislators/${personSlug(pid)}/`} class="underline">{c.candidate}</a>
                      ) : (
                        c.candidate
                      )}
                      {c.party && ` (${c.party[0]})`}: {pct}%
                      <span class="text-xs text-navy-600"> · {c.votes.toLocaleString()}</span>
                    </p>
                  );
                })}
              </div>
            ))}
            <p class="mt-1 text-xs text-navy-600">
              Official WEC canvass results for {chamberName(person.chamber)} District
              {" "}{person.district}. District lines changed in 2024.
            </p>
          </div>
        )}
        {sitting && (
          <div class="mt-3 rounded bg-navy-50 p-3 text-sm">
            <h2 class="font-bold">Compensation</h2>
            <p class="mt-1">
              Salary: <strong>${COMPENSATION.salary.toLocaleString()}</strong>/year
              <span class="text-xs text-navy-600"> (set by statute, same for every member)</span>
            </p>
            <p class="mt-1">
              Per diem rate:{" "}
              {person.chamber === "lower"
                ? `$${COMPENSATION.assembly.overnight}/overnight or $${COMPENSATION.assembly.day}/day trip`
                : `$${COMPENSATION.senate.overnight}/day (${COMPENSATION.senate.note})`}
            </p>
            <p class="mt-1 text-xs text-navy-600">
              What each member actually claims varies. Per-member claim records
              come from the chief clerks once a year.
            </p>
          </div>
        )}
      </div>
    </aside>

    <div class="min-w-0 flex-1">
      <section>
        <h2 class="text-xl font-bold">Sponsored bills · {primarySponsored.length}</h2>
        <div class="mt-2 flex flex-wrap gap-2 text-sm">
          {tally.map((t) => (
            <a
              href={`#status-${t.status}`}
              aria-label={`Jump to ${t.bills.length} bills: ${STATUS_LABELS[t.status].toLowerCase()}`}
              class={`rounded-full px-3 py-1 font-semibold hover:ring-2 hover:ring-navy-600 focus-visible:ring-2 focus-visible:ring-navy-600 ${STATUS_STYLES[t.status]}`}
            >
              {t.bills.length} {STATUS_LABELS[t.status].toLowerCase()}
            </a>
          ))}
        </div>
        <div class="mt-3 space-y-2">
          {tally.map((t) => (
            <details id={`status-${t.status}`} class="rounded-lg border border-navy-100 bg-white" open={t.status === "enacted"}>
              <summary class="flex cursor-pointer items-center gap-2 px-3 py-2">
                <span class="font-semibold">{STATUS_LABELS[t.status]}</span>
                <span class="text-sm text-navy-600">{t.bills.length} bills</span>
              </summary>
              <div
                class="max-h-72 overflow-y-auto border-t border-navy-100"
                role="region"
                tabindex="0"
                aria-label={`${STATUS_LABELS[t.status]} bills`}
              >
              <ul class="space-y-1 p-3 text-sm">
                {t.bills.map((s) => (
                  <li class="flex items-center gap-2">
                    <a href={`/bills/${s.session_id}/${billSlug(s.identifier)}/`} class="w-16 shrink-0 py-1 font-semibold underline">
                      {s.identifier}
                    </a>
                    <span class="min-w-0 flex-1 truncate">{s.title}</span>
                    <span class="shrink-0 text-xs text-navy-600">{s.session_id}</span>
                  </li>
                ))}
              </ul>
              </div>
            </details>
          ))}
        </div>
      </section>

      {sitting && (
        <section class="mt-6">
          <h2 class="text-xl font-bold">Campaign money</h2>
          {money === null ? (
            <p class="mt-2 rounded-lg border border-navy-100 bg-white p-4 text-sm text-navy-700">
              This legislator's campaign committee isn't linked in our data yet,
              so no fundraising is shown. This is a coverage gap, not a report
              of zero fundraising. <a href="/about/#money" class="underline">How this data works</a>
            </p>
          ) : money.total === 0 ? (
            <p class="mt-2 rounded-lg border border-navy-100 bg-white p-4 text-sm text-navy-700">
              No contributions reported to this legislator's committee since
              they took office ({monthYear(money.entry)}).
              <a href="/about/#money" class="underline"> How this data works</a>
            </p>
          ) : (
            <div class="mt-2 rounded-lg border border-navy-100 bg-white p-4 text-sm">
              <p>
                <span class="text-2xl font-bold">{fmtMoney(money.total)}</span>
                <span class="text-navy-600">
                  {" "}raised across {money.n.toLocaleString()} reported receipts
                  since taking office, {monthYear(money.entry)} to {fmtDate(money.last)}
                </span>
              </p>
              <MoneyTimeline quarters={money.quarters} entry={money.entry} terms={terms} />
              <div class="mt-3 grid gap-4 sm:grid-cols-2">
                {money.committees.length > 0 && (
                  <div class="min-w-0">
                    <h3 class="font-bold">Top contributing committees</h3>
                    <p class="text-xs text-navy-600">PACs, party and other political committees</p>
                    <ul class="mt-1 space-y-1">
                      {money.committees.map((c) => (
                        <li class="flex items-center gap-2">
                          <OrgLogo entityId={c.entityId} name={c.name} />
                          <MaybeLink href={hasDonorPage(c.entityId) ? `/money/committees/${c.entityId}/` : null}>
                            {c.name}
                          </MaybeLink>
                          <span class="shrink-0 font-semibold">{fmtMoney(c.total)}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
                {money.occupations.length > 0 && (
                  <div class="min-w-0">
                    <h3 class="font-bold">Top occupations of individual donors</h3>
                    <p class="text-xs text-navy-600">
                      as reported by donors; individuals gave {fmtMoney(money.individualTotal)} in total
                    </p>
                    <ul class="mt-1 space-y-0.5">
                      {money.occupations.map((o) => (
                        <li class="flex items-baseline gap-2">
                          <span class="min-w-0 flex-1 truncate">{o.occupation}</span>
                          <span class="shrink-0 font-semibold">{fmtMoney(o.total)}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
              <p class="mt-3 text-xs text-navy-600">
                Source: Wisconsin Ethics Commission campaign finance filings
                (campaignfinance.wi.gov), refreshed nightly. Wisconsin law bars
                corporations from contributing to candidates; money comes from
                individuals and political committees.
                Totals cover this legislator's candidate committees while in
                office, including any runs for other offices. Electronic
                records begin in 2008, so the longest-serving members' totals
                start there.
                <a href="/about/#money" class="underline"> Full methodology</a>
              </p>
            </div>
          )}
        </section>
      )}

      {heatYears.length > 0 && (
        <section class="mt-6">
          <h2 class="text-xl font-bold">Floor attendance</h2>
          <p class="mt-1 text-sm text-navy-600">
            Every day the chamber held recorded floor votes:
            {votesTotal.toLocaleString()} votes across {heatDays.length} voting days,
            {missedTotal > 0 ? `${missedTotal} missed` : "none missed"}.
          </p>
          <div class="mt-1 flex flex-wrap items-center gap-3 text-xs text-navy-600">
            <span class="flex items-center gap-1"><span class="hm-cell h-2.5 w-2.5 rounded-[2px] bg-moss-600"></span> voted all</span>
            <span class="flex items-center gap-1"><span class="hm-cell h-2.5 w-2.5 rounded-[2px] bg-gold-600"></span> present, not voting</span>
            <span class="flex items-center gap-1"><span class="hm-cell hm-miss h-2.5 w-2.5 rounded-[2px]"></span> missed votes (striped)</span>
            <span class="flex items-center gap-1"><span class="hm-cell h-2.5 w-2.5 rounded-[2px] bg-gray-300"></span> no floor votes</span>
            {serviceSpans.length > 1 && (
              <span class="flex items-center gap-1"><span class="hm-cell h-2.5 w-2.5 rounded-[2px] bg-navy-100"></span> not in office</span>
            )}
          </div>
          <div class="mt-3 space-y-2">
            {heatYears.map((year, i) => (
              <details class="rounded-lg border border-navy-100 bg-white px-3 py-2" open={i < 2}>
                <summary class="cursor-pointer text-sm font-semibold">{year}</summary>
                <div class="mt-2">
                  <VoteHeatmap year={year} days={heatDays.filter((d) => d.date.startsWith(String(year)))} />
                </div>
              </details>
            ))}
          </div>
        </section>
      )}

      <section class="mt-6">
        <h2 class="text-xl font-bold">Vote history · {votes.length.toLocaleString()}</h2>
        <div
          class="mt-2 max-h-[32rem] overflow-y-auto rounded-lg border border-navy-100 bg-white"
          role="region"
          tabindex="0"
          aria-label="Recent votes"
        >
          <ul class="space-y-1 p-3 text-sm">
            {votes.slice(0, 200).map((v) => <VoteRow v={v} />)}
          </ul>
        </div>
        {votes.length > 200 && (
          <details class="mt-2 rounded-lg border border-navy-100 bg-white">
            <summary class="cursor-pointer px-3 py-2 text-sm font-semibold">
              Show all {votes.length.toLocaleString()} votes ({(votes.length - 200).toLocaleString()} more)
            </summary>
            <div
              class="max-h-[32rem] overflow-y-auto border-t border-navy-100"
              role="region"
              tabindex="0"
              aria-label="Earlier votes"
            >
              <ul class="space-y-1 p-3 text-sm">
                {votes.slice(200).map((v) => <VoteRow v={v} />)}
              </ul>
            </div>
          </details>
        )}
      </section>
    </div>
  </div>

  <script>
    // status pills jump to a details strip; open it so the target isn't collapsed
    document.querySelectorAll<HTMLAnchorElement>("a[href^='#status-']").forEach((a) => {
      a.addEventListener("click", () => {
        document.querySelector(a.getAttribute("href")!)?.setAttribute("open", "");
      });
    });
  </script>
</Base>
