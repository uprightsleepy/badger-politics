---
/** The Legislature's own subject index, every heading as it prints it,
 * grouped by first letter as the index is. Filtering hides rows in place,
 * so every heading stays in the page and the search index. */
import Base from "../../layouts/Base.astro";
import FilterBar from "../../components/FilterBar.astro";
import { subjectIndex } from "../../lib/db";

const subjects = subjectIndex();
const groups = Map.groupBy(subjects, (s) => (/[a-z]/i.test(s.title[0]) ? s.title[0].toUpperCase() : "#"));
const plural = (n: number, one: string, many: string) => `${n.toLocaleString()} ${n === 1 ? one : many}`;
---

<Base
  title="Bills by subject"
  description="Browse Wisconsin legislation by the Legislature's own subject index: every heading, every session since 2009."
  layout="wide"
>
  <header class="flex max-w-[47.5rem] flex-col gap-2.5">
    <h1 class="t-display">Bills by subject</h1>
    <p class="sm:text-lead">
      The Legislature's own subject index, covering every session since 2009, with each heading as the
      index prints it: {plural(subjects.length, "heading", "headings")}, grouped by first letter.
    </p>
  </header>

  <div class="mt-4 max-w-[47.5rem]">
    <FilterBar wide id="subject-filter" statusId="subject-filter-status" label="Find a subject" placeholder="Housing, elections, taxation" />
  </div>

  <div class="mt-3 border-b border-rule">
    {[...groups.entries()].map(([letter, group]) => (
      <details class="subject-group border-t border-rule" data-subject-group>
        <summary class="flex min-h-12 cursor-pointer items-baseline gap-3 py-2">
          <span class="t-section w-8">{letter === "#" ? <><span aria-hidden="true">#</span><span class="sr-only">Numbers</span></> : letter}</span>
          <span class="text-small text-granite" data-group-count data-all={plural(group.length, "subject", "subjects")}>
            {plural(group.length, "subject", "subjects")}
          </span>
        </summary>
        <ul class="subject-cols pb-4" role="list" aria-label={letter === "#" ? "Subjects starting with a number" : `Subjects starting with ${letter}`}>
          {group.map((s) => (
            <li data-subject-row data-text={s.title.toLowerCase()}>
              <a href={`/subjects/${s.slug}/`} class="inline-flex min-h-11 items-center underline">{s.title}</a>
              <span class="text-small text-granite">{plural(s.n, "bill", "bills")}</span>
            </li>
          ))}
        </ul>
      </details>
    ))}
  </div>
  <p id="subject-no-match" class="mt-4 hidden text-granite"></p>

  <script>
    import { initRowFilter } from "../../scripts/rowFilter";
    const input = document.getElementById("subject-filter") as HTMLInputElement;
    const groups = [...document.querySelectorAll<HTMLDetailsElement>("[data-subject-group]")];
    // while filtering, open the letters with matches and hide the rest;
    // clearing the filter returns every letter to closed
    const regroup = () => {
      const filtering = input.value.trim() !== "";
      for (const group of groups) {
        const rows = group.querySelectorAll("[data-subject-row]");
        const shown = group.querySelectorAll("[data-subject-row]:not(.sorted-hidden)").length;
        const count = group.querySelector<HTMLElement>("[data-group-count]")!;
        group.hidden = filtering && shown === 0;
        group.open = filtering && shown > 0;
        count.textContent = filtering ? `${shown.toLocaleString()} of ${rows.length.toLocaleString()} shown` : count.dataset.all!;
      }
    };
    initRowFilter({
      input: "subject-filter",
      rows: "[data-subject-row]",
      status: "subject-filter-status",
      noMatch: "subject-no-match",
      noun: "subjects",
    });
    input.addEventListener("input", regroup);
    window.addEventListener("pageshow", regroup);
    regroup();
  </script>
</Base>

<style>
  .subject-group > summary {
    list-style: none;
  }
  .subject-group > summary::-webkit-details-marker {
    display: none;
  }
  .subject-group > summary .t-section {
    color: var(--color-lake);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .subject-cols {
    display: grid;
    column-gap: 2rem;
  }
  .subject-cols li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.5rem;
    min-width: 0;
  }
  .subject-cols a {
    overflow-wrap: anywhere;
  }
  @media (min-width: 40rem) {
    .subject-cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .subject-cols {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
