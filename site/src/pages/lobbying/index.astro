---
import Base from "../../layouts/Base.astro";
import FilterBar from "../../components/FilterBar.astro";
import { lobbyingOrgs, mostLobbiedBills, builtSessions } from "../../lib/db";
import { STATUS_LABELS, billSlug, shortTitle } from "../../lib/format";

const orgs = lobbyingOrgs();
const currentSession = builtSessions().find((s) => s.id === "2025")?.id ?? builtSessions()[0].id;
const topBills = mostLobbiedBills(currentSession, 20);
---

<Base
  title="Lobbying"
  description="Which organizations registered an interest on which Wisconsin bills, from the Ethics Commission's Eye on Lobbying records."
>
  <h1 class="text-2xl font-bold">Lobbying registrations</h1>
  <p class="mt-1 max-w-3xl text-sm text-navy-700">
    Organizations that registered an interest in legislation with the Wisconsin
    Ethics Commission. A registration means the organization paid lobbyists to
    communicate about the bill — it is <strong>not</strong> a for-or-against
    position. Every row links to the official record at
    <a href="https://lobbying.wi.gov" class="underline">lobbying.wi.gov</a>.
  </p>

  <section class="mt-6">
    <h2 class="text-xl font-bold">Most-lobbied bills of the 2025–26 session</h2>
    <ul class="mt-3 space-y-1">
      {topBills.map((b) => (
        <li class="flex flex-wrap items-baseline gap-x-3 rounded-lg border border-navy-100 bg-white px-4 py-2 text-sm">
          <a href={`/bills/${currentSession}/${billSlug(b.identifier)}/`} class="w-20 shrink-0 font-bold underline">{b.identifier}</a>
          <span class="min-w-0 flex-1 truncate">{shortTitle(b.title)}</span>
          <span class="shrink-0 text-xs text-navy-600">{b.status ? (STATUS_LABELS[b.status] ?? b.status) : ""}</span>
          <span class="w-16 shrink-0 text-right text-xs tabular-nums text-navy-600">{b.orgs} orgs</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-6">
    <h2 class="text-xl font-bold">Organizations · {orgs.length}</h2>
    <FilterBar
      id="org-filter"
      statusId="org-filter-status"
      label="Filter organizations"
      placeholder="e.g. hospital, realtors, union…"
    />
    <ul class="mt-3 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
      {orgs.map((o) => (
        <li data-org-row data-text={o.name.toLowerCase()}>
          <a
            href={`/lobbying/${o.id}/`}
            class="flex h-full flex-col justify-between gap-2 rounded-lg border border-navy-100 bg-white p-3 hover:border-navy-600 hover:bg-navy-50"
          >
            <span class="font-semibold leading-snug underline decoration-navy-300 underline-offset-2">
              {o.name}
            </span>
            <span class="text-xs text-navy-600">
              <strong class="tabular-nums text-ink">{o.bills.toLocaleString()}</strong>
              {" "}bill{o.bills === 1 ? "" : "s"} registered
            </span>
          </a>
        </li>
      ))}
    </ul>
    <p id="org-no-match" class="mt-4 hidden rounded-lg border border-navy-100 bg-white p-4 text-sm text-navy-600"></p>
  </section>

  <script>
    import { initRowFilter } from "../../scripts/rowFilter";
    initRowFilter({
      input: "org-filter",
      rows: "[data-org-row]",
      status: "org-filter-status",
      noMatch: "org-no-match",
      noun: "organizations",
    });
  </script>
</Base>
