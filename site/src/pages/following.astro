---
import Base from "../layouts/Base.astro";
---

<Base
  title="Following"
  description="Bills and legislators you follow, with what changed since your last visit. Stored on this device only."
>
  <h1 class="text-2xl font-bold">Following</h1>
  <p class="mt-1 max-w-3xl text-sm text-navy-700">
    Follows live in this browser only; the site never learns what you
    follow. For updates anywhere, every bill and legislator also has an
    Atom feed you can add to any feed reader.
  </p>

  <div id="follow-empty" hidden class="mt-4 max-w-3xl rounded-lg border border-navy-100 bg-white p-4 text-sm">
    You aren't following anything yet. Use the Follow button on any bill or
    legislator page, then check back here to see what changed.
  </div>

  <section id="follow-bills-section" hidden class="mt-6">
    <h2 class="text-xl font-bold">Bills</h2>
    <p id="follow-changed-note" hidden class="mt-1 text-sm font-semibold text-moss-600"></p>
    <ul id="follow-bills" class="mt-2 divide-y divide-navy-100 rounded-lg border border-navy-100 bg-white text-sm"></ul>
  </section>

  <section id="follow-legislators-section" hidden class="mt-6">
    <h2 class="text-xl font-bold">Legislators</h2>
    <ul id="follow-legislators" class="mt-2 divide-y divide-navy-100 rounded-lg border border-navy-100 bg-white text-sm"></ul>
  </section>

  <p id="follow-status" role="status" class="sr-only"></p>

  <script>
    import { getFollows, toggleFollow, lastSeen, markSeen } from "../scripts/follows";

    const esc = (s: string) => s.replace(/[<>&"]/g, (c) =>
      ({ "<": "&lt;", ">": "&gt;", "&": "&amp;", '"': "&quot;" })[c]!);

    async function billRow(id: string, seen: string | null): Promise<string> {
      const [session, slug] = [id.slice(0, id.indexOf("-")), id.slice(id.indexOf("-") + 1)];
      try {
        const b = await (await fetch(`/api/v1/bills/${session}/${slug}.json`)).json();
        const changed = seen && b.latest_action_date && b.latest_action_date > seen;
        return `<li class="flex flex-wrap items-center gap-x-3 gap-y-1 px-4 py-2${changed ? " border-l-4 border-moss-600" : ""}">
          <a href="/bills/${session}/${slug}/" class="w-20 shrink-0 py-1 font-bold underline">${esc(b.identifier)}</a>
          <span class="min-w-0 flex-1 truncate">${esc(b.title ?? "")}</span>
          ${changed ? `<span class="shrink-0 rounded-full bg-moss-50 px-2 py-0.5 text-xs font-semibold text-moss-600">new action</span>` : ""}
          <span class="shrink-0 text-xs text-navy-600">${esc(b.latest_action_desc ?? "")} (${esc(b.latest_action_date ?? "")})</span>
          <button type="button" data-unfollow-bill="${esc(id)}" class="shrink-0 py-1 text-xs underline">unfollow</button>
        </li>`;
      } catch {
        return `<li class="px-4 py-2 text-navy-600">Couldn't load ${esc(id)}
          <button type="button" data-unfollow-bill="${esc(id)}" class="ml-2 py-1 text-xs underline">unfollow</button></li>`;
      }
    }

    async function render() {
      const follows = getFollows();
      const seen = lastSeen();
      const empty = document.getElementById("follow-empty")!;
      const billsSection = document.getElementById("follow-bills-section")!;
      const legsSection = document.getElementById("follow-legislators-section")!;
      empty.hidden = follows.bills.length > 0 || follows.legislators.length > 0;
      billsSection.hidden = follows.bills.length === 0;
      legsSection.hidden = follows.legislators.length === 0;

      if (follows.bills.length) {
        const rows = await Promise.all(follows.bills.map((id) => billRow(id, seen)));
        document.getElementById("follow-bills")!.innerHTML = rows.join("");
        const changed = document.querySelectorAll("#follow-bills .border-moss-600").length;
        const note = document.getElementById("follow-changed-note")!;
        note.hidden = !seen || changed === 0;
        note.textContent = changed
          ? `${changed} of your bills ${changed > 1 ? "have" : "has"} new action since your last visit${seen ? ` (${seen})` : ""}.`
          : "";
        document.getElementById("follow-status")!.textContent =
          `${follows.bills.length} followed bills loaded${changed ? `, ${changed} with new action` : ""}.`;
      }

      if (follows.legislators.length) {
        const rows = await Promise.all(follows.legislators.map(async (id) => {
          try {
            const p = await (await fetch(`/api/v1/legislators/${id}.json`)).json();
            return `<li class="flex flex-wrap items-center gap-x-3 gap-y-1 px-4 py-2">
              <a href="/legislators/${esc(id)}/" class="min-w-0 flex-1 truncate py-1 font-semibold underline">${esc(p.name ?? id)}</a>
              <button type="button" data-unfollow-leg="${esc(id)}" class="shrink-0 py-1 text-xs underline">unfollow</button>
            </li>`;
          } catch {
            return `<li class="px-4 py-2"><a href="/legislators/${esc(id)}/" class="underline">View profile</a>
              <button type="button" data-unfollow-leg="${esc(id)}" class="ml-2 py-1 text-xs underline">unfollow</button></li>`;
          }
        }));
        document.getElementById("follow-legislators")!.innerHTML = rows.join("");
      }

      document.querySelectorAll<HTMLButtonElement>("[data-unfollow-bill]").forEach((b) =>
        b.addEventListener("click", () => {
          toggleFollow("bills", b.dataset.unfollowBill!);
          render();
        }));
      document.querySelectorAll<HTMLButtonElement>("[data-unfollow-leg]").forEach((b) =>
        b.addEventListener("click", () => {
          toggleFollow("legislators", b.dataset.unfollowLeg!);
          render();
        }));
    }

    render().then(markSeen);
  </script>
</Base>
