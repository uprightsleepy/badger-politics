---
/** Committee hearings and election days on one month grid, with the
 * reader's own city council meetings added on this device when an
 * address is saved. The grid is drawn by script from /data/calendar.json;
 * the hearings list and the session schedule below it are static. */
import Base from "../layouts/Base.astro";
import HearingsList from "../components/HearingsList.astro";
import SCHEDULE from "../data/session-schedule.json";
import { fmtDate } from "../lib/format";

const longDate = (iso: string) =>
  new Date(`${iso}T12:00:00Z`).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" });
---

<Base
  title="Calendar"
  description="Interactive calendar of Wisconsin Legislature hearings and election days, with the session schedule and the full upcoming hearings list."
  layout="wide"
>
  <header class="flex max-w-[47.5rem] flex-col gap-2.5">
    <h1 class="t-display">Calendar</h1>
    <p class="sm:text-lead">
      Committee hearings at the Capitol and Wisconsin's election days, on one calendar. Choose a day to
      see what's on it.
    </p>
    <p id="city-hint" class="text-small text-granite" data-pagefind-ignore>
      Saved an address on <a href="/my-reps/" class="underline">Find your lawmakers</a> in Milwaukee or
      West Allis? Your city's council meetings appear here too, on this device only.
    </p>
    <ul class="mt-2 flex flex-wrap gap-3" role="list">
      <li><a href="/calendar/hearings.ics" class="btn btn-secondary">Add hearings to your calendar</a></li>
      <li><a href="/calendar/election-days.ics" class="btn btn-secondary">Add election days to your calendar</a></li>
    </ul>
    <p class="text-small"><a href="/testify/" class="underline">How to testify at a hearing</a></p>
  </header>

  <div class="cal mt-8">
    <div class="min-w-0">
      {/* with very large text the next button drops below rather than spilling */}
      <div class="flex flex-wrap items-center justify-between gap-3">
        <button id="prev" type="button" class="btn btn-secondary px-3" aria-label="Previous month">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
          <span class="hidden sm:inline">Previous</span>
        </button>
        <h2 id="month-label" aria-live="polite" class="t-section grow text-center text-[1.375rem]"></h2>
        <button id="next" type="button" class="btn btn-secondary px-3" aria-label="Next month">
          <span class="hidden sm:inline">Next</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
        </button>
      </div>
      {/* full bleed on phones so each day is at least 44px wide at 320px */}
      <div class="-mx-5 mt-4 grid grid-cols-7 text-center text-small font-bold text-granite sm:mx-0" aria-hidden="true">
        {["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"].map((d) => <div class="py-1">{d}</div>)}
      </div>
      <div id="grid" class="-mx-5 mt-1 grid grid-cols-7 gap-px overflow-hidden border-y border-rule bg-rule sm:mx-0 sm:rounded-[0.75rem] sm:border-x"></div>
      <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-1.5 text-small text-granite" role="list" data-pagefind-ignore>
        <li class="flex items-center gap-2"><span class="mark mark-election" aria-hidden="true"></span> Election day</li>
        <li class="flex items-center gap-2"><span class="mark mark-hearing" aria-hidden="true"></span> Committee hearing at the Capitol</li>
        <li class="flex items-center gap-2"><span class="mark mark-council" aria-hidden="true"></span> Your city council's meeting, with a saved address</li>
      </ul>
    </div>

    <section id="day-panel" aria-labelledby="day-label" tabindex="-1" class="hidden min-w-0">
      <h2 id="day-label" class="t-section text-[1.375rem]"></h2>
      <ul id="day-events" class="mt-3 border-b border-rule" role="list"></ul>
    </section>
  </div>

  <div class="mt-14">
    <HearingsList />
  </div>

  <section class="mt-14 max-w-[47.5rem]" aria-labelledby="schedule-heading">
    <h2 id="schedule-heading" class="t-section">Session schedule</h2>
    <p class="mt-2">
      The Legislature meets to vote during set floorperiods. Bills still waiting when the last
      general-business floorperiod ends fail, and the {SCHEDULE.session} session ends at noon on
      {" "}{longDate(SCHEDULE.session_end)}.
    </p>
    <p class="mt-2 text-small text-granite">
      The schedule is set by <a href={SCHEDULE.source_url} class="underline">enrolled 2025 Senate Joint Resolution 1</a>.
    </p>
    <details class="mt-3">
      <summary class="inline-flex min-h-11 cursor-pointer items-center font-display font-bold text-lake underline">Show the full session schedule</summary>
      <ul class="mt-2 grid gap-x-8 border-b border-rule sm:grid-cols-2" role="list">
        {SCHEDULE.floorperiods.map((f) => (
          <li class="border-t border-rule py-2">
            <span class="tabular-nums">{fmtDate(f.start)} to {fmtDate(f.end)}</span>
            {"label" in f && f.label && (
              <span class="block text-small font-bold text-granite">{f.label}</span>
            )}
          </li>
        ))}
      </ul>
    </details>
  </section>

  <script>
    import { esc, safeHref } from "../lib/html";
    import { savedPollingPlace } from "../lib/pollingPlace";
    import { savedCityDistrict } from "../lib/cityDistrict";

    let events: Record<
      string,
      { type: string; label: string; detail?: string; url?: string;
        links?: { label: string; url: string }[] }[]
    > = {};
    let year = 0;
    let month = 0; // 0-based

    const grid = document.getElementById("grid")!;
    const label = document.getElementById("month-label")!;
    const panel = document.getElementById("day-panel")!;
    const dayLabel = document.getElementById("day-label")!;
    const dayEvents = document.getElementById("day-events")!;
    const NEW_TAB = '<span class="sr-only"> (opens in a new tab)</span>';
    const KIND: Record<string, string> = {
      election: "Election day",
      hearing: "Committee hearing at the Capitol",
      council: "City council meeting",
    };

    function iso(y: number, m: number, d: number) {
      return `${y}-${String(m + 1).padStart(2, "0")}-${String(d).padStart(2, "0")}`;
    }

    function pollingBlock(): string {
      const place = savedPollingPlace();
      if (!place) {
        return `<p class="mt-2 text-small">Look up your polling place once on MyVote, then <a class="underline" href="/my-reps/#polling">save it here</a> to see it on every election day.</p>`;
      }
      return `<p class="mt-2">Your saved polling place: <strong>${esc(place)}</strong>. <a class="underline" href="/my-reps/#polling">Change it</a></p>`
        + `<p class="mt-0.5 text-small text-granite">Check it on MyVote before you go. Locations can change.</p>`;
    }

    function linksBlock(links: { label: string; url: string }[]): string {
      const anchors = links
        .map((l) => {
          const href = safeHref(l.url);
          return href
            ? `<li><a class="underline" target="_blank" rel="noopener" href="${esc(href)}">${esc(l.label)}${NEW_TAB}</a></li>`
            : `<li>${esc(l.label)}</li>`;
        })
        .join("");
      return `<ul class="mt-2 flex flex-wrap gap-x-5 gap-y-1">${anchors}</ul>` + pollingBlock();
    }

    function showDay(date: string, focus = true) {
      const list = events[date] ?? [];
      dayLabel.textContent = new Date(date + "T12:00:00").toLocaleDateString("en-US", {
        weekday: "long", month: "long", day: "numeric", year: "numeric",
      });
      dayEvents.innerHTML = list.length
        ? list
            .map((e) => {
              // the title carries the official-notice link itself; the
              // label, detail, and url are scraped data and never trusted
              const href = safeHref(e.url);
              const title = href
                ? `<a class="underline" target="_blank" rel="noopener" href="${esc(href)}">${esc(e.label)}<span class="sr-only"> official notice, opens in a new tab</span></a>`
                : esc(e.label);
              return `
        <li class="border-t border-rule py-3">
          <p class="flex items-center gap-2 text-small font-bold text-granite"><span class="mark mark-${esc(e.type)}" aria-hidden="true"></span>${esc(KIND[e.type] ?? "Event")}</p>
          <p class="mt-1 font-display font-bold">${title}</p>
          ${e.detail ? `<p class="text-small text-granite">${esc(e.detail)}</p>` : ""}
          ${e.links?.length ? linksBlock(e.links) : ""}
          ${e.type === "hearing" ? `<p class="mt-1 text-small text-granite">Confirm against the official notice before you go.</p>` : ""}
          ${e.type === "council" ? `<p class="mt-1 text-small text-granite">Open to the public. Confirm the time and place on the posted agenda.</p>` : ""}
        </li>`;
            })
            .join("")
        : `<li class="border-t border-rule py-3 text-granite">Nothing scheduled.</li>`;
      panel.classList.remove("hidden");
      if (!focus) return; // opened for the reader, not by the reader
      panel.focus({ preventScroll: true });
      const smooth = matchMedia("(prefers-reduced-motion: no-preference)").matches;
      panel.scrollIntoView({ behavior: smooth ? "smooth" : "auto", block: "nearest" });
    }

    function render() {
      label.textContent = new Date(year, month, 1).toLocaleDateString("en-US", {
        month: "long", year: "numeric",
      });
      grid.innerHTML = "";
      const firstDow = new Date(year, month, 1).getDay();
      const daysInMonth = new Date(year, month + 1, 0).getDate();
      const today = new Date();
      const todayIso = iso(today.getFullYear(), today.getMonth(), today.getDate());
      for (let i = 0; i < firstDow; i++) {
        grid.appendChild(Object.assign(document.createElement("div"), { className: "min-h-16 bg-limestone sm:min-h-24" }));
      }
      for (let d = 1; d <= daysInMonth; d++) {
        const date = iso(year, month, d);
        const dayList = events[date] ?? [];
        const isToday = date === todayIso;
        // only event days are interactive; plain days stay out of the tab order
        const cell = document.createElement(dayList.length ? "button" : "div");
        cell.className =
          "flex min-h-16 flex-col items-start gap-1 bg-white p-1.5 text-left text-small sm:min-h-24 sm:p-2 " +
          (isToday ? "ring-2 ring-inset ring-spruce " : "") +
          (dayList.length ? "cursor-pointer hover:bg-fog" : "");
        if (isToday) cell.dataset.today = "";
        const hearings = dayList.filter((e) => e.type === "hearing").length;
        const elections = dayList.filter((e) => e.type === "election").length;
        const councils = dayList.filter((e) => e.type === "council").length;
        // phones get shape markers (words don't fit 45px cells); the
        // aria-label carries the counts either way
        const marks =
          (elections ? `<span class="mark mark-election"></span>` : "") +
          (councils ? `<span class="mark mark-council"></span>` : "") +
          `<span class="mark mark-hearing"></span>`.repeat(Math.min(hearings, 3));
        // words from 640px up; they wrap rather than clip in narrow cells
        const line = (kind: string, text: string) =>
          `<span class="hidden w-full items-baseline gap-1.5 leading-tight sm:flex"><span class="mark mark-${kind}"></span><span class="min-w-0">${text}</span></span>`;
        cell.innerHTML =
          `<span class="font-display font-bold">${d}</span>` +
          (marks ? `<span class="flex flex-wrap items-center gap-1 sm:hidden" aria-hidden="true">${marks}</span>` : "") +
          (elections ? line("election", "Election day") : "") +
          (councils ? line("council", "Council meeting") : "") +
          (hearings ? line("hearing", `${hearings} hearing${hearings > 1 ? "s" : ""}`) : "");
        if (dayList.length) {
          cell.setAttribute("type", "button");
          const spoken = new Date(date + "T12:00:00").toLocaleDateString("en-US", {
            weekday: "long", month: "long", day: "numeric",
          });
          const parts = [];
          if (elections) parts.push("election day");
          if (councils) parts.push(`${councils} council meeting${councils > 1 ? "s" : ""}`);
          if (hearings) parts.push(`${hearings} hearing${hearings > 1 ? "s" : ""}`);
          cell.setAttribute("aria-label", `${spoken}${isToday ? ", today" : ""}, ${parts.join(", ")}`);
          cell.addEventListener("click", () => showDay(date));
        }
        grid.appendChild(cell);
      }
    }

    document.getElementById("prev")!.addEventListener("click", () => {
      month--; if (month < 0) { month = 11; year--; } render();
    });
    document.getElementById("next")!.addEventListener("click", () => {
      month++; if (month > 11) { month = 0; year++; } render();
    });

    label.textContent = "Loading calendar…";
    fetch("/data/calendar.json")
      .then((r) => r.json())
      .then(async (data) => {
        events = data;
        // the reader's own council meetings, only where their saved
        // address lookup landed; nothing without a saved address
        const saved = savedCityDistrict();
        if (saved) {
          try {
            const councils = await fetch("/data/council-meetings.json").then((r) => r.json());
            const mine = councils[saved.t];
            if (mine) {
              const hint = document.getElementById("city-hint");
              if (hint) hint.textContent =
                `Your saved address is in ${mine.city}, so its council meetings are shown here, on this device only.`;
            }
            for (const m of mine?.meetings ?? []) {
              (events[m.date] ??= []).push({
                type: "council",
                label: `${mine.city} Common Council meeting`,
                detail: [m.time, m.location].filter(Boolean).join(" · "),
                url: m.url,
              });
            }
          } catch {
            // a device-only extra; the calendar stands without it
          }
        }
        const now = new Date();
        year = now.getFullYear();
        month = now.getMonth();
        render();
        // today is already the highlighted day, so its panel opens with
        // the page rather than waiting for a click
        showDay(iso(year, month, now.getDate()), false);
      })
      .catch(() => {
        label.textContent = "Calendar unavailable";
        grid.innerHTML =
          `<p class="col-span-7 bg-white p-4">Couldn't load the calendar. ` +
          `Try the <a class="underline" href="/calendar/#hearings">hearings list</a> instead.</p>`;
      });
  </script>
</Base>

<style>
  .cal {
    display: grid;
    gap: 2rem;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 64rem) {
    .cal {
      grid-template-columns: minmax(0, 1fr) 22rem;
      column-gap: 3.5rem;
      align-items: start;
    }
  }
  /* event markers are told apart by shape, not color: a square for
     election days, a dot for hearings, a ring for council meetings */
  :global(.mark) {
    display: inline-block;
    width: 0.625rem;
    height: 0.625rem;
    flex-shrink: 0;
  }
  :global(.mark-election) {
    background: var(--color-spruce);
  }
  :global(.mark-hearing) {
    background: var(--color-lake);
    border-radius: 9999px;
  }
  :global(.mark-council) {
    border: 2px solid var(--color-spruce);
    border-radius: 9999px;
  }
  @media (forced-colors: active) {
    :global(.mark-election),
    :global(.mark-hearing) {
      forced-color-adjust: none;
      background: CanvasText;
    }
    :global(.mark-council) {
      border-color: CanvasText;
    }
    /* the hairlines between days and today's ring are drawn with fills and
       shadows, which forced colors drop; outlines survive */
    :global(#grid > *) {
      outline: 1px solid CanvasText;
      outline-offset: -1px;
    }
    :global(#grid > [data-today]) {
      outline: 3px solid Highlight;
      outline-offset: -3px;
    }
  }
</style>
