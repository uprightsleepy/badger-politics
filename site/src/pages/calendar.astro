---
import Base from "../layouts/Base.astro";
---

<Base title="Civic calendar" description="Interactive calendar of Wisconsin Legislature hearings and statewide election days.">
  <h1 class="text-2xl font-bold">Civic calendar</h1>
  <p class="mt-1 text-sm text-navy-700">
    Committee hearings and election days.
    <a href="/calendar/hearings.ics" class="underline">Subscribe (hearings)</a> ·
    <a href="/calendar/election-days.ics" class="underline">election days</a>
  </p>

  <div class="mt-4 rounded-lg border border-navy-100 bg-white p-4">
    <div class="flex items-center justify-between">
      <button id="prev" class="rounded-lg border border-navy-100 px-3 py-1 hover:bg-navy-50" aria-label="Previous month">←</button>
      <h2 id="month-label" class="text-lg font-bold"></h2>
      <button id="next" class="rounded-lg border border-navy-100 px-3 py-1 hover:bg-navy-50" aria-label="Next month">→</button>
    </div>
    <div class="mt-3 grid grid-cols-7 gap-px text-center text-xs font-semibold text-navy-600">
      {["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"].map((d) => <div>{d}</div>)}
    </div>
    <div id="grid" class="mt-1 grid grid-cols-7 gap-px rounded bg-navy-100"></div>
  </div>

  <section id="day-panel" class="mt-4 hidden rounded-lg border border-navy-100 bg-white p-4">
    <h2 id="day-label" class="font-bold"></h2>
    <ul id="day-events" class="mt-2 space-y-2 text-sm"></ul>
  </section>

  <script>
    let events: Record<string, { type: string; label: string; detail?: string; url?: string }[]> = {};
    let year = 0;
    let month = 0; // 0-based

    const grid = document.getElementById("grid")!;
    const label = document.getElementById("month-label")!;
    const panel = document.getElementById("day-panel")!;
    const dayLabel = document.getElementById("day-label")!;
    const dayEvents = document.getElementById("day-events")!;

    function iso(y: number, m: number, d: number) {
      return `${y}-${String(m + 1).padStart(2, "0")}-${String(d).padStart(2, "0")}`;
    }

    function showDay(date: string) {
      const list = events[date] ?? [];
      dayLabel.textContent = new Date(date + "T12:00:00").toLocaleDateString("en-US", {
        weekday: "long", month: "long", day: "numeric", year: "numeric",
      });
      dayEvents.innerHTML = list.length
        ? list
            .map(
              (e) => `
        <li class="rounded border ${e.type === "election" ? "border-gold-500 bg-gold-100" : "border-navy-100"} p-2">
          <span class="font-semibold">${e.type === "election" ? "🗳️ " : ""}${e.label}</span>
          ${e.detail ? `<span class="text-navy-600"> — ${e.detail}</span>` : ""}
          ${e.url ? ` <a class="underline" href="${e.url}">official notice</a>` : ""}
          ${e.type === "hearing" ? `<p class="mt-1 text-xs text-navy-600">Confirm against the official notice before attending.</p>` : ""}
        </li>`,
            )
            .join("")
        : "<li class='text-navy-600'>Nothing scheduled.</li>";
      panel.classList.remove("hidden");
      panel.scrollIntoView({ behavior: "smooth", block: "nearest" });
    }

    function render() {
      label.textContent = new Date(year, month, 1).toLocaleDateString("en-US", {
        month: "long", year: "numeric",
      });
      grid.innerHTML = "";
      const firstDow = new Date(year, month, 1).getDay();
      const daysInMonth = new Date(year, month + 1, 0).getDate();
      const today = new Date();
      const todayIso = iso(today.getFullYear(), today.getMonth(), today.getDate());
      for (let i = 0; i < firstDow; i++) {
        grid.appendChild(Object.assign(document.createElement("div"), { className: "min-h-16 bg-paper" }));
      }
      for (let d = 1; d <= daysInMonth; d++) {
        const date = iso(year, month, d);
        const dayList = events[date] ?? [];
        const cell = document.createElement("button");
        cell.type = "button";
        cell.className =
          "min-h-16 bg-white p-1 text-left align-top text-xs hover:bg-navy-50 " +
          (date === todayIso ? "ring-2 ring-inset ring-navy-600 " : "") +
          (dayList.length ? "" : "cursor-default");
        cell.setAttribute("aria-label", `${date}: ${dayList.length} events`);
        const hearings = dayList.filter((e) => e.type === "hearing").length;
        const elections = dayList.filter((e) => e.type === "election").length;
        cell.innerHTML =
          `<span class="font-semibold">${d}</span>` +
          (elections ? `<span class="mt-0.5 block truncate rounded bg-gold-100 px-1 font-semibold">🗳️ Election day</span>` : "") +
          (hearings
            ? `<span class="mt-0.5 block truncate rounded bg-navy-50 px-1">${hearings} hearing${hearings > 1 ? "s" : ""}</span>`
            : "");
        if (dayList.length) cell.addEventListener("click", () => showDay(date));
        grid.appendChild(cell);
      }
    }

    document.getElementById("prev")!.addEventListener("click", () => {
      month--; if (month < 0) { month = 11; year--; } render();
    });
    document.getElementById("next")!.addEventListener("click", () => {
      month++; if (month > 11) { month = 0; year++; } render();
    });

    fetch("/data/calendar.json")
      .then((r) => r.json())
      .then((data) => {
        events = data;
        const now = new Date();
        year = now.getFullYear();
        month = now.getMonth();
        render();
      });
  </script>
</Base>
