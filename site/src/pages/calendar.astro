---
import Base from "../layouts/Base.astro";
import HearingsList from "../components/HearingsList.astro";
import SCHEDULE from "../data/session-schedule.json";
import { fmtDate } from "../lib/format";
---

<Base title="Civic Calendar" description="Interactive calendar of Wisconsin Legislature hearings and election days, with the session schedule and the full upcoming hearings list.">
  <h1 class="text-2xl font-bold">Civic Calendar</h1>
  <p class="mt-1 text-sm text-navy-700">
    Committee hearings and election days.
    <a href="/calendar/hearings.ics" class="underline">Subscribe (hearings)</a> ·
    <a href="/calendar/election-days.ics" class="underline">election days</a> ·
    <a href="/testify/" class="underline">how to testify</a>
  </p>
  <p class="mt-1 text-xs text-navy-600" data-pagefind-ignore>
    Saved an address on <a href="/my-reps/" class="underline">Your Reps</a> in
    Milwaukee or West Allis? Your city's council meetings appear here too, on
    this device only.
  </p>

  <div class="mt-4 rounded-lg border border-navy-100 bg-white p-4">
    <div class="flex items-center justify-between">
      <button id="prev" class="rounded-lg border border-navy-100 px-3 py-1 hover:bg-navy-50" aria-label="Previous month">←</button>
      <h2 id="month-label" aria-live="polite" class="text-lg font-bold"></h2>
      <button id="next" class="rounded-lg border border-navy-100 px-3 py-1 hover:bg-navy-50" aria-label="Next month">→</button>
    </div>
    <div class="mt-3 grid grid-cols-7 gap-px text-center text-xs font-semibold text-navy-600">
      {["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"].map((d) => <div>{d}</div>)}
    </div>
    <div id="grid" class="mt-1 grid grid-cols-7 gap-px rounded bg-navy-100"></div>
    <p class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-xs text-navy-600" data-pagefind-ignore>
      <span class="flex items-center gap-1"><span class="h-2 w-2 rounded-full bg-gold-500"></span> Election day</span>
      <span class="flex items-center gap-1"><span class="h-1.5 w-1.5 rounded-full bg-navy-600"></span> State: committee hearing</span>
      <span class="flex items-center gap-1"><span class="h-2 w-2 rounded-full bg-moss-600"></span> City: your council's meeting, with a saved address</span>
    </p>
  </div>

  <section id="day-panel" aria-labelledby="day-label" tabindex="-1" class="mt-4 hidden rounded-lg border border-navy-100 bg-white p-4">
    <h2 id="day-label" class="font-bold"></h2>
    <ul id="day-events" class="mt-2 space-y-2 text-sm"></ul>
  </section>

  <section class="mt-8">
    <h2 class="text-xl font-bold">Session schedule</h2>
    <p class="mt-1 max-w-3xl text-sm text-navy-700">
      The {SCHEDULE.session} floorperiods as scheduled by
      <a href={SCHEDULE.source_url} class="underline">enrolled 2025 Senate Joint Resolution 1</a>.
      Bills still pending when the final general-business floorperiod ends
      formally fail; the biennial session period ends at noon on {fmtDate(SCHEDULE.session_end)}.
    </p>
    <ul class="mt-3 grid grid-cols-1 gap-1 sm:grid-cols-2 lg:grid-cols-3">
      {SCHEDULE.floorperiods.map((f) => (
        <li class="rounded-lg border border-navy-100 bg-white px-3 py-2 text-sm">
          <span class="tabular-nums">{fmtDate(f.start)} – {fmtDate(f.end)}</span>
          {"label" in f && f.label && (
            <span class="block text-xs font-semibold text-badger-700">{f.label}</span>
          )}
        </li>
      ))}
    </ul>
  </section>

  <div class="mt-8">
    <HearingsList />
  </div>

  <script>
    import { esc, safeHref } from "../lib/html";
    import { savedPollingPlace } from "../lib/pollingPlace";
    import { savedCityDistrict } from "../lib/cityDistrict";

    let events: Record<
      string,
      { type: string; label: string; detail?: string; url?: string;
        links?: { label: string; url: string }[] }[]
    > = {};
    let year = 0;
    let month = 0; // 0-based

    const grid = document.getElementById("grid")!;
    const label = document.getElementById("month-label")!;
    const panel = document.getElementById("day-panel")!;
    const dayLabel = document.getElementById("day-label")!;
    const dayEvents = document.getElementById("day-events")!;

    function iso(y: number, m: number, d: number) {
      return `${y}-${String(m + 1).padStart(2, "0")}-${String(d).padStart(2, "0")}`;
    }

    function pollingBlock(): string {
      const place = savedPollingPlace();
      if (!place) {
        return `<p class="mt-1 text-xs text-navy-700">Look up your polling place once on MyVote, then <a class="underline" href="/my-reps/#polling">save it here</a> to see it on every election day.</p>`;
      }
      return `<p class="mt-1 text-sm">📍 Your saved polling place: <strong>${place.replace(/[<>&]/g, "")}</strong> <a class="text-xs underline" href="/my-reps/#polling">change</a></p>`
        + `<p class="mt-0.5 text-xs text-navy-700">Double-check on MyVote before voting. Locations can change.</p>`;
    }

    function linksBlock(links: { label: string; url: string }[]): string {
      const anchors = links
        .map((l) => {
          const href = safeHref(l.url);
          return href
            ? `<a class="py-1 font-semibold underline" target="_blank" rel="noopener" href="${esc(href)}">${esc(l.label)} ↗</a>`
            : `<span class="font-semibold">${esc(l.label)}</span>`;
        })
        .join("");
      return `<p class="mt-1 flex flex-wrap gap-x-4 gap-y-1">${anchors}</p>` + pollingBlock();
    }

    function showDay(date: string) {
      const list = events[date] ?? [];
      dayLabel.textContent = new Date(date + "T12:00:00").toLocaleDateString("en-US", {
        weekday: "long", month: "long", day: "numeric", year: "numeric",
      });
      dayEvents.innerHTML = list.length
        ? list
            .map((e) => {
              const emoji = e.type === "election" ? '<span aria-hidden="true">🗳️ </span>' : "";
              // the title carries the official-notice link itself; the
              // label, detail, and url are scraped data and never trusted
              const href = safeHref(e.url);
              const title = href
                ? `<a class="py-1 font-semibold underline" target="_blank" rel="noopener" href="${esc(href)}">${emoji}${esc(e.label)}<span class="sr-only"> official notice, opens in a new tab</span></a>`
                : `<span class="font-semibold">${emoji}${esc(e.label)}</span>`;
              return `
        <li class="rounded border ${e.type === "election" ? "border-gold-500 bg-gold-100" : e.type === "council" ? "border-moss-600" : "border-navy-100"} p-2">
          ${e.type === "hearing" ? `<span class="mr-1 rounded bg-navy-50 px-1 text-xs font-semibold">State</span>` : ""}${e.type === "council" ? `<span class="mr-1 rounded bg-moss-50 px-1 text-xs font-semibold">City</span>` : ""}${title}
          ${e.detail ? `<span class="text-navy-600"> · ${esc(e.detail)}</span>` : ""}
          ${e.links?.length ? linksBlock(e.links) : ""}
          ${e.type === "hearing" ? `<p class="mt-1 text-xs text-navy-600">Confirm against the official notice before attending.</p>` : ""}
          ${e.type === "council" ? `<p class="mt-1 text-xs text-navy-600">Open to the public; confirm time and place on the posted agenda.</p>` : ""}
        </li>`;
            })
            .join("")
        : "<li class='text-navy-600'>Nothing scheduled.</li>";
      panel.classList.remove("hidden");
      panel.focus({ preventScroll: true });
      const smooth = matchMedia("(prefers-reduced-motion: no-preference)").matches;
      panel.scrollIntoView({ behavior: smooth ? "smooth" : "auto", block: "nearest" });
    }

    function render() {
      label.textContent = new Date(year, month, 1).toLocaleDateString("en-US", {
        month: "long", year: "numeric",
      });
      grid.innerHTML = "";
      const firstDow = new Date(year, month, 1).getDay();
      const daysInMonth = new Date(year, month + 1, 0).getDate();
      const today = new Date();
      const todayIso = iso(today.getFullYear(), today.getMonth(), today.getDate());
      for (let i = 0; i < firstDow; i++) {
        grid.appendChild(Object.assign(document.createElement("div"), { className: "min-h-16 bg-paper" }));
      }
      for (let d = 1; d <= daysInMonth; d++) {
        const date = iso(year, month, d);
        const dayList = events[date] ?? [];
        // only event days are interactive; plain days stay out of the tab order
        const cell = document.createElement(dayList.length ? "button" : "div");
        cell.className =
          "min-h-16 bg-white p-1 text-left align-top text-xs " +
          (date === todayIso ? "ring-2 ring-inset ring-navy-600 " : "") +
          (dayList.length ? "hover:bg-navy-50" : "");
        const hearings = dayList.filter((e) => e.type === "hearing").length;
        const elections = dayList.filter((e) => e.type === "election").length;
        const councils = dayList.filter((e) => e.type === "council").length;
        // phones get dot markers (text chips don't fit 45px cells); the
        // aria-label carries the counts either way
        const dots =
          (elections ? `<span class="h-2 w-2 rounded-full bg-gold-500"></span>` : "") +
          (councils ? `<span class="h-2 w-2 rounded-full bg-moss-600"></span>` : "") +
          `<span class="h-1.5 w-1.5 rounded-full bg-navy-600"></span>`.repeat(Math.min(hearings, 3));
        cell.innerHTML =
          `<span class="font-semibold">${d}</span>` +
          (dots ? `<span class="mt-0.5 flex items-center gap-0.5 sm:hidden" aria-hidden="true">${dots}</span>` : "") +
          (elections ? `<span class="mt-0.5 hidden truncate rounded bg-gold-100 px-1 font-semibold sm:block">🗳️ Election day</span>` : "") +
          (councils
            ? `<span class="mt-0.5 hidden truncate rounded bg-moss-50 px-1 font-semibold sm:block">Council meeting</span>`
            : "") +
          (hearings
            ? `<span class="mt-0.5 hidden truncate rounded bg-navy-50 px-1 sm:block">${hearings} hearing${hearings > 1 ? "s" : ""}</span>`
            : "");
        if (dayList.length) {
          cell.setAttribute("type", "button");
          const spoken = new Date(date + "T12:00:00").toLocaleDateString("en-US", {
            weekday: "long", month: "long", day: "numeric",
          });
          const parts = [];
          if (elections) parts.push("election day");
          if (councils) parts.push(`${councils} council meeting${councils > 1 ? "s" : ""}`);
          if (hearings) parts.push(`${hearings} hearing${hearings > 1 ? "s" : ""}`);
          cell.setAttribute("aria-label", `${spoken}, ${parts.join(", ")}`);
          cell.addEventListener("click", () => showDay(date));
        }
        grid.appendChild(cell);
      }
    }

    document.getElementById("prev")!.addEventListener("click", () => {
      month--; if (month < 0) { month = 11; year--; } render();
    });
    document.getElementById("next")!.addEventListener("click", () => {
      month++; if (month > 11) { month = 0; year++; } render();
    });

    label.textContent = "Loading calendar…";
    fetch("/data/calendar.json")
      .then((r) => r.json())
      .then(async (data) => {
        events = data;
        // the reader's own council meetings, only where their saved
        // address lookup landed; nothing without a saved address
        const saved = savedCityDistrict();
        if (saved) {
          try {
            const councils = await fetch("/data/council-meetings.json").then((r) => r.json());
            const mine = councils[saved.t];
            for (const m of mine?.meetings ?? []) {
              (events[m.date] ??= []).push({
                type: "council",
                label: `${mine.city} Common Council meeting`,
                detail: [m.time, m.location].filter(Boolean).join(" · "),
                url: m.url,
              });
            }
          } catch {
            // a device-only extra; the calendar stands without it
          }
        }
        const now = new Date();
        year = now.getFullYear();
        month = now.getMonth();
        render();
      })
      .catch(() => {
        label.textContent = "Calendar unavailable";
        grid.innerHTML =
          `<p class="col-span-7 bg-white p-4 text-sm">Couldn't load the calendar. ` +
          `Try the <a class="underline" href="/calendar/#hearings">hearings list</a> instead.</p>`;
      });
  </script>
</Base>
