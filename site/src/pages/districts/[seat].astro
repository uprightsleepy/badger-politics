---
/** One legislative seat: who holds it now, where it sits (Wisconsin nests
 * three Assembly districts inside each Senate district), whether it is on
 * the ballot, everyone who has held it, and its official results. */
import Base from "../../layouts/Base.astro";
import FollowButton from "../../components/FollowButton.astro";
import Portrait from "../../components/Portrait.astro";
import ElectionResult from "../../components/ElectionResult.astro";
import SeatMapFigure from "../../components/SeatMapFigure.astro";
import {
  seatTerms, sittingPeople, electionFor, electionHistoryFor, lastMarginFor, ballotPhase,
  writeInPending, meta, serviceRecordsBegin, districtDemographicsFor, CURRENT_MAP,
} from "../../lib/db";
import { personSlug, monthYear, chamberName, partyWord, fmtDate } from "../../lib/format";
import { safeHref } from "../../lib/html";
import { mergeServiceSpans } from "../../lib/service";
import { article, ballotStatus, mapsNote, nameList, seatOffice, withParty, writeInSentence } from "../../lib/ballot";

export function getStaticPaths() {
  const seats = [
    ...Array.from({ length: 99 }, (_, i) => ({ chamber: "lower", slug: "assembly", district: i + 1 })),
    ...Array.from({ length: 33 }, (_, i) => ({ chamber: "upper", slug: "senate", district: i + 1 })),
  ];
  return seats.map((s) => ({
    params: { seat: `${s.slug}-${s.district}` },
    props: { chamber: s.chamber, district: s.district },
  }));
}
const { chamber, district } = Astro.props;
// the shape map is keyed the way the URL is: assembly-14 / senate-5
const seatKey = `${chamber === "upper" ? "senate" : "assembly"}-${district}`;
const seatName = `${chamberName(chamber)} District ${district}`;
const isSenate = chamber === "upper";
// Senate District n holds Assembly Districts 3n-2, 3n-1 and 3n
const senateOf = Math.ceil(district / 3);
const assemblyIn = [3 * district - 2, 3 * district - 1, 3 * district];

const holder = sittingPeople().find((p) => p.chamber === chamber && p.district === district);
const election = holder ? electionFor(holder.id) : undefined;
const opponents = election?.opponents.filter((o) => o.ballot_status !== "Deny") ?? [];
const ballot = ballotStatus(election);
const phase = ballotPhase();
const openPrimaries = writeInPending(seatOffice(chamber, district));
const history = electionHistoryFor(chamber, district);
const lastMargin = lastMarginFor(chamber, district);

// one lineage entry per continuous stint: rows grouped per person, then
// biennium-boundary rows merged exactly like the profile's Service card
const rows = seatTerms(chamber, district);
const byPerson = new Map<string, typeof rows>();
for (const r of rows) {
  if (!byPerson.has(r.person_id)) byPerson.set(r.person_id, []);
  byPerson.get(r.person_id)!.push(r);
}
const lineage = [...byPerson.entries()]
  .flatMap(([pid, personRows]) =>
    mergeServiceSpans(
      personRows.map((r) => ({
        chamber, district, start: r.start, end: r.end,
        end_label: r.end_label, end_url: r.end_url,
      })),
    ).map((span) => ({
      person_id: pid,
      name: personRows[0].name,
      party: personRows[0].party,
      ...span,
    })),
  )
  .sort((a, b) => (a.start < b.start ? 1 : -1));
// when the current holder's present stint began, for the lead
const since = holder ? lineage.find((s) => s.person_id === holder.id && !s.end)?.start : undefined;
// the records begin with the 2009 session: a stint that starts there may
// have started earlier
const recordsBegin = serviceRecordsBegin();
const sinceAtLeast = !!since && !!recordsBegin && since <= recordsBegin;

// ---- words (shared ones live in lib/ballot.ts) ----
/** "January 2025" */
const monthLong = (iso: string) =>
  new Date(`${iso.slice(0, 10)}T00:00:00Z`).toLocaleDateString("en-US", { month: "long", year: "numeric", timeZone: "UTC" });
const others = nameList(
  opponents.map((o) => withParty(o.name, o.party) + (o.ballot_status === "Challenged" ? " (ballot access challenged)" : "")),
);
const writeInLine = openPrimaries.length ? ` ${writeInSentence(openPrimaries)}` : "";
let ballotLine = "";
if (holder && ballot.kind === "on-ballot") {
  ballotLine =
    phase === "general"
      ? opponents.length
        ? `${holder.name} is on the November ${ballot.year} ballot, running against ${others}.`
        : openPrimaries.length
          ? `${holder.name} is on the November ${ballot.year} ballot. No other nominee for this seat is settled yet.`
          : `${holder.name} is on the November ${ballot.year} ballot, running unopposed.`
      : `${holder.name} is on the ${ballot.year} ballot.` + (opponents.length ? ` Also running for this seat: ${others}.` : "");
  ballotLine += writeInLine;
} else if (holder && ballot.kind === "not-running") {
  ballotLine = `${holder.name} isn't on the November ${ballot.year} ballot.` +
    (opponents.length ? ` Running for this seat: ${others}.` : "") + writeInLine;
} else if (holder && ballot.kind === "pending") {
  ballotLine = `The Elections Commission hasn't posted yet whether ${holder.name} is running in ${ballot.year}.`;
} else if (ballot.kind === "future") {
  ballotLine = `This seat is next on the ballot in November ${ballot.year}.`;
}
const marginLine = lastMargin
  ? lastMargin.margin === null
    ? `In ${lastMargin.year}, the winner ran unopposed.`
    : `In ${lastMargin.year}, the race was decided by ${lastMargin.margin.toFixed(1)} points.`
  : "";
const pulledOn = meta().imported_at?.slice(0, 10);

// Census ACS figures, shown only for a release on the current map
const people = districtDemographicsFor(chamber, district);
const num = (v: number, digits = 0) =>
  v.toLocaleString("en-US", { minimumFractionDigits: digits, maximumFractionDigits: digits });
const pct = (v: number) => `${num(v, 1)}%`;
const points = (m: number) => `${num(m, 1)} points`;
const dollars = (v: number) => (v >= 250001 ? "$250,000 or more" : `$${num(v)}`);
const peopleRows = people
  ? ([
      ["population", "People", (v: number) => num(v), (m: number) => num(m)],
      ["median_age", "Median age", (v: number) => `${num(v, 1)} years`, (m: number) => `${num(m, 1)} years`],
      ["age_65_plus_pct", "Age 65 and older", pct, points],
      // Census top-codes the median at $250,001 and gives it no margin
      ["median_household_income", "Median household income", dollars,
        (m: number, v: number) => (v >= 250001 ? "n/a" : `$${num(m)}`)],
      ["bachelors_pct", "Adults 25 and older with a bachelor's degree or more", pct, points],
      ["owner_occupied_pct", "Homes lived in by their owners", pct, points],
    ] as const).flatMap(([measure, label, show, margin]) => {
      const f = people.figures[measure];
      return f ? [{ label, value: show(f.estimate), moe: margin(f.moe, f.estimate) }] : [];
    })
  : [];
---

<Base
  title={seatName}
  breadcrumbs={[{ name: "Districts", url: "/districts/" }]}
  filters={{ type: "District" }}
  description={`${seatName}: the current member, everyone who has held the seat since 2009, and official election results.`}
  layout="wide"
>
  <div class="seat">
    <header class="s-head flex max-w-[47.5rem] flex-col gap-2.5">
      <a href="/districts/" class="self-start text-small underline">All districts</a>
      <h1 class="t-display">{seatName}</h1>
      <p class="sm:text-lead">
        {holder ? (
          <>Represented by <a href={`/legislators/${personSlug(holder.id)}/`} class="underline">{holder.name}</a>{holder.party ? `, ${article(partyWord(holder.party))} ${partyWord(holder.party)},` : ""}{since ? (sinceAtLeast ? ` since at least ${monthLong(since)}.` : ` since ${monthLong(since)}.`) : "."}</>
        ) : (
          "This seat is empty right now."
        )}
        {" "}
        {isSenate ? (
          <>
            It holds three Assembly districts:{" "}
            {assemblyIn.map((ad, i) => (
              <>{i > 0 && (i === assemblyIn.length - 1 ? " and " : ", ")}<a href={`/districts/assembly-${ad}/`} class="underline">Assembly District {ad}</a></>
            ))}.
          </>
        ) : (
          <>
            It's one of three Assembly districts in{" "}
            <a href={`/districts/senate-${senateOf}/`} class="underline">Senate District {senateOf}</a>.
          </>
        )}
      </p>
      <p data-mine-seat={seatKey} data-pagefind-ignore hidden>
        <span class="mine">This is your district</span>
      </p>
    </header>

    <aside class="s-rail flex flex-col gap-5" data-pagefind-ignore>
      <div class="flex flex-col gap-2">
        <FollowButton kind="districts" id={seatKey} label={`Follow ${seatName}`} variant="primary" />
        <p class="text-fine text-granite">Following saves it on this device.</p>
      </div>
      <SeatMapFigure seatKey={seatKey} seatName={seatName} />
    </aside>

    <div class="s-body flex max-w-[47.5rem] flex-col gap-10">
      {holder && (
        <section class="sheet flex flex-col gap-4 p-5 sm:p-7" aria-labelledby="member-heading" data-no-rep-highlight>
          <div class="flex flex-wrap items-center gap-4">
            <Portrait src={holder.image_url} name={holder.name} size={64} />
            <div class="min-w-0 flex-[1_1_12rem]">
              <h2 id="member-heading" class="t-section text-[1.375rem]">
                <a href={`/legislators/${personSlug(holder.id)}/`} class="text-spruce no-underline hover:underline">{holder.name}</a>
              </h2>
              <p class="text-granite">
                {isSenate ? "State senator" : "State representative"}{holder.party && `. ${partyWord(holder.party)}`}.
              </p>
            </div>
          </div>
          {(ballotLine || marginLine) && (
            <div class="flex flex-col gap-1.5 border-t border-rule pt-4">
              <h3 class="t-question">On the ballot</h3>
              {ballotLine && (
                <p>
                  {ballotLine}
                  {ballot.kind !== "future" && ballot.kind !== "none" && (
                    <> <a href={`/elections/2026/${seatKey}/`} class="underline">See the race</a></>
                  )}
                </p>
              )}
              {marginLine && <p class="text-small text-granite">{marginLine}</p>}
            </div>
          )}
          <p class="border-t border-rule pt-4">
            <a href={`/legislators/${personSlug(holder.id)}/`} class="font-bold underline">Their full record</a>
          </p>
        </section>
      )}

      {people && (
        <section aria-labelledby="people-heading">
          <h2 id="people-heading" class="t-section">Who lives here</h2>
          <p class="mt-2 text-small text-granite">
            Census Bureau survey estimates for {people.acsYear - 4} to {people.acsYear}, counted within this
            district's {CURRENT_MAP} lines. Each figure is give or take its margin of error (90% confidence).
          </p>
          <div class="mt-3 overflow-x-auto" role="region" tabindex="0" aria-labelledby="people-caption">
            <table class="w-full max-w-[36rem] text-left tabular-nums">
              <caption id="people-caption" class="sr-only">{seatName}: Census estimates, {people.acsYear - 4} to {people.acsYear}</caption>
              <thead>
                <tr class="border-b border-edge text-small">
                  <th scope="col" class="py-2 pr-4 font-bold">Measure</th>
                  <th scope="col" class="py-2 pr-4 text-right font-bold whitespace-nowrap">Estimate</th>
                  <th scope="col" class="py-2 text-right font-bold whitespace-nowrap">Give or take</th>
                </tr>
              </thead>
              <tbody>
                {peopleRows.map((r) => (
                  <tr class="border-b border-rule">
                    <th scope="row" class="py-2 pr-4 font-normal">{r.label}</th>
                    <td class="py-2 pr-4 text-right whitespace-nowrap">{r.value}</td>
                    <td class="py-2 text-right text-granite whitespace-nowrap">{r.moe}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="mt-3 text-fine text-granite">
            Source: U.S. Census Bureau,{" "}
            <a href={`https://api.census.gov/data/${people.acsYear}/acs/acs5/profile.html`} class="underline">{people.acsYear - 4}–{people.acsYear} American Community Survey 5-year Data Profiles</a>,
            {" "}tabulated by the Census Bureau to the {CURRENT_MAP} state legislative districts
            (<a href={`https://www.census.gov/programs-surveys/acs/technical-documentation/table-and-geography-changes/${people.acsYear}/geography-changes.html`} class="underline">geography notes</a>).
            This product uses the Census Bureau Data API but is not endorsed or certified by the Census Bureau.
          </p>
        </section>
      )}

      <section aria-labelledby="held-heading">
        <h2 id="held-heading" class="t-section">Who has held this seat</h2>
        <p class="mt-2 text-small text-granite">
          From the Legislature's service records, which begin with the 2009 session. District lines
          were redrawn in 2011, 2022 and 2024, so the area this seat covers has changed over time.
        </p>
        <ol class="mt-4 border-y border-rule" role="list" data-no-rep-highlight>
          {lineage.map((s, i) => (
            <li class:list={["flex flex-col gap-0.5 py-3", i > 0 && "border-t border-rule"]}>
              <p class="flex flex-wrap items-baseline gap-x-2">
                <a href={`/legislators/${personSlug(s.person_id)}/`} class="font-display font-bold underline">{s.name}</a>
                {s.party && <span class="text-granite">{partyWord(s.party)}</span>}
              </p>
              <p class="text-small">{monthYear(s.start)} to {s.end ? monthYear(s.end) : "now"}</p>
              {s.end_label && (
                <p class="text-fine text-granite">
                  {safeHref(s.end_url) ? <a href={safeHref(s.end_url)} class="underline">{s.end_label}</a> : s.end_label}
                </p>
              )}
            </li>
          ))}
        </ol>
        {lineage.length === 0 && <p class="mt-3 text-granite">No service records for this seat yet.</p>}
      </section>

      {history.length > 0 && (
        <section aria-labelledby="results-heading">
          <h2 id="results-heading" class="t-section">Election results</h2>
          <p class="mt-2 text-small text-granite">
            Official general-election counts from the Wisconsin Elections Commission. Shares are of all
            votes cast, including write-ins. Results before 2024 are labeled with the maps they were held
            under, when this district number covered different ground.
          </p>
          <div class="mt-4 flex flex-col">
            {history.map((h) => (
              <ElectionResult id={`results-${h.year}`} title={`November ${h.year}`} note={mapsNote(h.year) ?? undefined} candidates={h.candidates} total={h.total} />
            ))}
          </div>
        </section>
      )}

      <p class="text-fine text-granite">
        Boundaries from the Legislative Technology Services Bureau's 2024 maps. Results from the
        {" "}<a href="https://elections.wi.gov" class="underline">Wisconsin Elections Commission</a>.
        {pulledOn && ` Checked ${fmtDate(pulledOn)}.`}
      </p>
    </div>
  </div>
</Base>

<style>
  .seat {
    display: grid;
    gap: 2rem;
    grid-template-areas: "head" "rail" "body";
    grid-template-columns: minmax(0, 1fr);
  }
  .s-head { grid-area: head; }
  .s-rail { grid-area: rail; }
  .s-body { grid-area: body; }
  @media (min-width: 64rem) {
    .seat {
      grid-template-areas: "head rail" "body rail";
      grid-template-columns: minmax(0, 1fr) 20rem;
      grid-template-rows: auto 1fr;
      column-gap: 3.5rem;
    }
    .s-rail {
      align-self: start;
    }
  }
</style>
