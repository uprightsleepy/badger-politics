---
/** Every seat, the way Wisconsin draws them: each Senate district holds
 * three Assembly districts (3n-2, 3n-1 and 3n inside Senate District n),
 * so the list is 33 groups of four seats. Each seat is one link, to its
 * page; the holder and party are written out inside it. */
import Base from "../../layouts/Base.astro";
import FilterBar from "../../components/FilterBar.astro";
import { sittingPeople, type Person } from "../../lib/db";
import { partyWord } from "../../lib/format";

const holders = new Map(sittingPeople().map((p) => [`${p.chamber}-${p.district}`, p]));
const SENATE = Array.from({ length: 33 }, (_, i) => i + 1);
const assemblyIn = (sd: number) => [3 * sd - 2, 3 * sd - 1, 3 * sd];
const seat = (chamber: "upper" | "lower", d: number) => ({
  chamber,
  d,
  name: `${chamber === "upper" ? "Senate" : "Assembly"} District ${d}`,
  href: `/districts/${chamber === "upper" ? "senate" : "assembly"}-${d}/`,
  holder: holders.get(`${chamber}-${d}`) as Person | undefined,
});
const groups = SENATE.map((sd) => ({
  senate: seat("upper", sd),
  assembly: assemblyIn(sd).map((ad) => seat("lower", ad)),
}));
const holderText = (h: Person | undefined) =>
  h ? `${h.name}${h.party ? `, ${partyWord(h.party)}` : ""}` : "Vacant";
---

<Base
  title="Districts"
  description="Every Wisconsin legislative seat: who holds it now, everyone who has held it since 2009, and its official election results."
  layout="wide"
>
  <header class="flex max-w-[47.5rem] flex-col gap-2.5">
    <h1 class="t-display">Districts</h1>
    <p class="sm:text-lead">
      Wisconsin has 33 Senate districts, and each one holds three Assembly districts. So every
      address has one state senator and one representative.
    </p>
    <p data-district-finder>
      Not sure which are yours? <a href="/my-reps/" class="underline">Find your lawmakers</a>.
    </p>
  </header>

  <div class="mt-4 max-w-[47.5rem]">
    <FilterBar
      wide
      id="district-filter"
      statusId="district-filter-status"
      label="Find a district or lawmaker"
      placeholder="District number or name"
    />
  </div>

  <ol class="district-groups mt-3 border-t border-rule" role="list">
    {groups.map((g) => (
      <li
        class="district-group border-b border-rule py-3"
        data-district-row
        data-text={[g.senate, ...g.assembly]
          .map((s) => `${s.name} ${s.holder?.name ?? "vacant"}`)
          .join(" ")
          .toLowerCase()}
      >
        <h2 class="t-question">
          <a href={g.senate.href} class="seat-link">
            <span class="underline">{g.senate.name}</span>
            <span class="seat-holder">{holderText(g.senate.holder)}</span>
          </a>
        </h2>
        <ul class="ml-1 border-l-2 border-rule pl-3" role="list">
          {g.assembly.map((s) => (
            <li>
              <a href={s.href} class="seat-link">
                <span class="font-display font-bold underline">{s.name}</span>
                <span class="seat-holder">{holderText(s.holder)}</span>
              </a>
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ol>
  <p id="district-no-match" class="mt-4 hidden text-granite"></p>

  <script>
    import { MINE_CLASS, savedDistrict } from "../../lib/district";
    import { initRowFilter } from "../../scripts/rowFilter";

    initRowFilter({
      input: "district-filter",
      rows: "[data-district-row]",
      status: "district-filter-status",
      noMatch: "district-no-match",
      noun: "Senate districts",
    });

    // once districts are saved there's nothing left to find: show theirs
    const saved = savedDistrict();
    const finder = document.querySelector("[data-district-finder]");
    if (saved && finder) {
      const chip = `${MINE_CLASS} underline`;
      finder.innerHTML =
        `Yours: <a href="/districts/assembly-${saved.ad}/" class="${chip}">Assembly District ${saved.ad}</a>` +
        ` and <a href="/districts/senate-${saved.sd}/" class="${chip}">Senate District ${saved.sd}</a>.`;
    }
  </script>
</Base>

<style>
  /* one target per seat: the district's name, then who holds it */
  .seat-link {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.25rem 0;
    color: var(--color-lake);
    text-decoration: none;
  }
  .seat-holder {
    font: 400 var(--text-small) / var(--text-small--line-height) var(--font-sans);
    color: var(--color-spruce);
  }
  .seat-link:hover .seat-holder {
    text-decoration: underline;
  }
  @media (min-width: 48rem) {
    .district-groups {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 2.5rem;
    }
  }
  @media (min-width: 64rem) {
    .district-groups {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  /* the row filter hides groups with this class */
  .district-group:global(.sorted-hidden) {
    display: none;
  }
</style>
