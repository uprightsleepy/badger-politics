---
/** The complete roll-call history, paginated the way the state
 * legislators' vote pages are. A rest param keeps page 1 at the bare
 * path. Excluded from site search: fifteen years of motion text would
 * drown every other result for a senator's name. */
import Base from "../../../../layouts/Base.astro";
import PartyChip from "../../../../components/PartyChip.astro";
import Pager from "../../../../components/Pager.astro";
import FederalVoteRow from "../../../../components/FederalVoteRow.astro";
import { federalMembers, federalVoteKey, federalVotesFor } from "../../../../lib/db";
import { FEDERAL_VOTES_PER_PAGE as PER_PAGE, pageCount } from "../../../../lib/paging";

export function getStaticPaths() {
  return federalMembers()
    .flatMap((m) => {
      const total = federalVotesFor(federalVoteKey(m)).length;
      const pages = pageCount(total, PER_PAGE);
      return Array.from({ length: pages }, (_, i) => ({
        params: { slug: m.slug, page: i === 0 ? undefined : String(i + 1) },
        props: { member: m, page: i + 1, pages },
      }));
    });
}

const { member, page, pages } = Astro.props;
const all = federalVotesFor(federalVoteKey(member));
const votes = all.slice((page - 1) * PER_PAGE, page * PER_PAGE);
const base = `/federal/${member.slug}/votes/`;
---

<Base
  title={`${member.name}: every Senate roll call${page > 1 ? `, page ${page}` : ""}`}
  description={`Every U.S. Senate roll call cast by ${member.name} of Wisconsin, from the Senate's official records. Page ${page} of ${pages}.`}
  searchable={false}
  breadcrumbs={[
    { name: "Federal delegation", url: "/federal/" },
    { name: member.name, url: `/federal/${member.slug}/` },
  ]}
>
  <p class="text-sm text-navy-600">
    <a href={`/federal/${member.slug}/`} class="underline">&larr; {member.name}</a>
  </p>
  <h1 class="mt-2 flex flex-wrap items-center gap-3 text-2xl font-bold">
    Every Roll Call
    <PartyChip party={member.party} />
  </h1>
  <p class="mt-1 text-sm text-navy-700">
    {all.length.toLocaleString()} votes, newest first. Each links to the
    chamber's official record; bills link to congress.gov.
  </p>

  <ul class="mt-3 divide-y divide-navy-100 rounded-lg border border-navy-100 bg-white text-sm">
    {votes.map((v) => (
      <FederalVoteRow v={v} />
    ))}
  </ul>

  <Pager
    page={page}
    pages={pages}
    href={(n) => (n === 1 ? base : `${base}${n}/`)}
    label="roll calls"
  />
</Base>
