---
/** One senator's Senate record, career-deep: every Congress they have
 * served, from the Senate's own per-vote XML.
 *
 * Attribution is the Senate's LIS member id on every position, so there
 * is no matching step to get wrong. "Missed" means recorded as Not
 * Voting -- the Senate's files make no excused/absent distinction, and
 * the page says what it counts. The full roll-call list lives on
 * paginated pages; this one carries the summary a constituent actually
 * asks for: how much, how often missed, and what lately.
 */
import Base from "../../layouts/Base.astro";
import SourceStrip from "../../components/SourceStrip.astro";
import PartyChip from "../../components/PartyChip.astro";
import { federalMembers, federalVotesFor, federalCongressStats } from "../../lib/db";
import { fmtDate } from "../../lib/format";
import { documentUrlFragment, congressLabel } from "../../lib/federal";

export function getStaticPaths() {
  return federalMembers().map((m) => ({ params: { slug: m.slug }, props: { member: m } }));
}

const { member } = Astro.props;
// each chamber's files stamp their own id: LIS for senators, bioguide
// for House members
const voteKey = member.chamber === "senate" ? member.lis_id! : member.bioguide;
const votes = federalVotesFor(voteKey);
const byCongress = federalCongressStats(voteKey);
const missed = byCongress.reduce((s, c) => s + c.missed, 0);
const latest = votes[0]?.date ?? null;
const sinceYear = byCongress.at(-1)?.first.slice(0, 4);
const recent = votes.slice(0, 25);

const castStyle = (cast: string) =>
  ["Yea", "Aye", "Guilty"].includes(cast)
    ? "bg-moss-50 text-moss-600"
    : ["Nay", "No", "Not Guilty"].includes(cast)
      ? "bg-badger-50 text-badger-700"
      : "bg-navy-50 text-navy-600";
---

<Base
  title={`${member.name}, ${member.chamber === "senate" ? "U.S. Senator" : `U.S. Representative, WI-${member.district}`}`}
  description={`${member.name}'s complete U.S. Senate voting record since ${sinceYear}, from the Senate's official roll calls: ${votes.length.toLocaleString()} votes, ${missed} missed.`}
  breadcrumbs={[{ name: "Federal delegation", url: "/federal/" }]}
  filters={{ type: "Legislator", chamber: member.chamber === "senate" ? "U.S. Senate" : "U.S. House", party: member.party }}
>
  <p class="text-sm text-navy-600">
    <a href="/federal/" class="underline">&larr; Federal delegation</a>
  </p>
  <h1 class="mt-2 flex flex-wrap items-center gap-3 text-2xl font-bold">
    {member.name}
    <PartyChip party={member.party} />
  </h1>
  <p class="mt-1 text-sm text-navy-700">
    {member.chamber === "senate"
      ? "U.S. Senator for Wisconsin"
      : `U.S. Representative for Wisconsin's ${member.district}th district`} since {sinceYear} &middot; term ends {member.term_end.slice(0, 4)} &middot;
    <a href={`https://www.congress.gov/member/${member.slug}/${member.bioguide}`} class="underline">
      official profile &#8599;
    </a>
  </p>
  <SourceStrip
    sources={[
      member.chamber === "senate"
        ? { label: "U.S. Senate", href: "https://www.senate.gov/legislative/votes_new.htm" }
        : { label: "U.S. House Clerk", href: "https://clerk.house.gov/Votes" },
    ]}
    through={latest}
  />

  <dl class="mt-4 grid max-w-md grid-cols-2 gap-x-6 gap-y-3 rounded-lg border border-navy-100 bg-white p-4 text-sm">
    <div>
      <dt class="text-xs font-semibold uppercase tracking-wide text-navy-600">Roll calls since {sinceYear}</dt>
      <dd class="mt-0.5 text-xl font-bold tabular-nums">{votes.length.toLocaleString()}</dd>
    </div>
    <div>
      <dt class="text-xs font-semibold uppercase tracking-wide text-navy-600">Recorded Not Voting</dt>
      <dd class={`mt-0.5 text-xl font-bold tabular-nums ${missed > 0 ? "text-badger-700" : "text-moss-600"}`}>
        {missed.toLocaleString()}
        <span class="text-sm font-normal text-navy-600">
          {" "}({((missed / Math.max(votes.length, 1)) * 100).toFixed(1)}%)
        </span>
      </dd>
    </div>
  </dl>

  <section class="mt-6">
    <h2 class="text-xl font-bold">Congress by Congress</h2>
    <div class="mt-2 max-w-xl overflow-x-auto">
      <table class="w-full rounded-lg border border-navy-100 bg-white text-sm">
        <caption class="sr-only">{member.name}'s roll calls and missed votes per Congress</caption>
        <thead>
          <tr class="text-left text-xs font-semibold uppercase tracking-wide text-navy-600">
            <th scope="col" class="px-4 py-2">Congress</th>
            <th scope="col" class="px-4 py-2 text-right">Roll calls</th>
            <th scope="col" class="px-4 py-2 text-right">Missed</th>
          </tr>
        </thead>
        <tbody>
          {byCongress.map((c) => (
            <tr class="border-t border-navy-100">
              <td class="px-4 py-1.5">{congressLabel(c.congress)}</td>
              <td class="px-4 py-1.5 text-right tabular-nums">{c.total.toLocaleString()}</td>
              <td class={`px-4 py-1.5 text-right tabular-nums ${c.missed > 0 ? "text-badger-700" : "text-navy-600"}`}>
                {c.missed.toLocaleString()}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="mt-6">
    <h2 class="text-xl font-bold">Latest roll calls</h2>
    <ul
      class="scroll-body mt-2 max-h-[26rem] divide-y divide-navy-100 overflow-y-auto rounded-lg border border-navy-100 bg-white text-sm"
      role="region"
      tabindex="0"
      aria-label={`${member.name}'s latest roll calls, scrollable`}
    >
      {recent.map((v) => (
        <li class="px-4 py-2">
          <div class="flex items-baseline gap-x-3">
            <span class={`shrink-0 whitespace-nowrap rounded-full px-2 py-0.5 text-xs font-bold ${castStyle(v.vote_cast)}`}>
              {v.vote_cast === "Not Voting" ? "NV" : v.vote_cast}
            </span>
            <span class="min-w-0 flex-1">
              {v.title ?? v.question}
              {v.document && (
                documentUrlFragment(v.congress, v.document) ? (
                  <a
                    href={`https://www.congress.gov/bill/${v.congress}th-congress/${documentUrlFragment(v.congress, v.document)}`}
                    class="ml-1 whitespace-nowrap text-xs underline"
                  >
                    {v.document}
                  </a>
                ) : (
                  <span class="ml-1 whitespace-nowrap text-xs text-navy-600">{v.document}</span>
                )
              )}
            </span>
            <a href={v.source_url} class="shrink-0 whitespace-nowrap py-1 text-xs underline">{fmtDate(v.date)} &#8599;</a>
          </div>
          <p class="mt-0.5 pl-12 text-xs text-navy-600">{v.result} &middot; {v.yeas}&ndash;{v.nays}</p>
        </li>
      ))}
    </ul>
    <p class="mt-2 text-sm">
      <a href={`/federal/${member.slug}/votes/`} class="font-semibold underline">
        All {votes.length.toLocaleString()} roll calls since {sinceYear} &rarr;
      </a>
    </p>
  </section>
</Base>
