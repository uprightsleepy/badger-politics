---
/** Wisconsin's members of Congress: each one's party, how often they
 * miss votes, and their latest roll calls, from official records. */
import Base from "../../layouts/Base.astro";
import { federalMembers, federalVoteKey, federalVotesFor, federalCongressStats, federalLatestVoteDate, meta } from "../../lib/db";
import { fmtDate, partyWord } from "../../lib/format";
import { castWords, congressLabel, longDate, ordinal } from "../../lib/federal";

const members = federalMembers();
const senators = members.filter((m) => m.chamber === "senate");
const house = members.filter((m) => m.chamber === "house");
const latest = federalLatestVoteDate();
const pulledOn = meta().imported_at?.slice(0, 10);
const current = (m: (typeof members)[number]) => federalCongressStats(federalVoteKey(m))[0];
const pct = (n: number, of: number) => (of ? `${((n / of) * 100).toFixed(1)}%` : "0%");
---

<Base
  title="Members of Congress from Wisconsin"
  description="How every member of Wisconsin's congressional delegation votes, from the Senate's and House Clerk's official roll-call records."
  filters={{ type: "Legislator", chamber: "U.S. Congress" }}
  layout="wide"
>
  <header class="flex max-w-[47.5rem] flex-col gap-2.5">
    <h1 class="t-display">Members of Congress from Wisconsin</h1>
    <p class="sm:text-lead">
      Wisconsin's two U.S. senators and eight House members, with every floor vote each has cast, from
      their chamber's official records, and their campaign money from the FEC.
    </p>
    <p class="text-small text-granite">
      Federal bills and hearings are on <a href="https://www.congress.gov" class="underline">congress.gov</a>,
      and every federal campaign filing is at <a href="https://www.fec.gov" class="underline">fec.gov</a>.
    </p>
  </header>

  {senators.length > 0 && (
    <section class="mt-10" aria-labelledby="senate-heading">
      <h2 id="senate-heading" class="t-section">Senators</h2>
      <div class="mt-4 grid gap-5 lg:grid-cols-2">
        {senators.map((s) => {
          const stats = current(s);
          const recent = federalVotesFor(federalVoteKey(s)).slice(0, 3);
          return (
            <article class="sheet flex min-w-0 flex-col gap-3 p-5 sm:p-6" aria-labelledby={`sen-${s.slug}`}>
              <h3 id={`sen-${s.slug}`} class="t-section text-[1.375rem]">
                <a href={`/federal/${s.slug}/`} class="underline">{s.name}</a>
              </h3>
              <p class="text-granite">{partyWord(s.party)}. Term ends {longDate(s.term_end)}.</p>
              {stats && (
                <p>
                  Missed <span class="figure">{stats.missed.toLocaleString()}</span> of {stats.total.toLocaleString()} roll calls in
                  the {congressLabel(stats.congress)}{stats.total ? ` (${pct(stats.missed, stats.total)})` : ""}.
                </p>
              )}
              {recent.length > 0 && (
                <div>
                  <h4 class="text-small font-bold text-granite">Latest votes</h4>
                  <ul class="mt-1 border-b border-rule text-small" role="list">
                    {recent.map((v) => (
                      <li class="border-t border-rule py-2">
                        <span class="font-bold">{castWords(v.vote_cast)}</span> on {v.title ?? v.question}.
                        {" "}<span class="text-granite">{fmtDate(v.date)}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              <p class="text-small"><a href={`/federal/${s.slug}/`} class="underline">Every vote and their campaign money<span class="sr-only">: {s.name}</span></a></p>
            </article>
          );
        })}
      </div>
    </section>
  )}

  {house.length > 0 && (
    <section class="mt-12 max-w-[60rem]" aria-labelledby="house-heading">
      <h2 id="house-heading" class="t-section">House of Representatives</h2>
      <p class="mt-2 text-small text-granite">
        By district. Every member's House roll calls, from the House Clerk's records, back to their first term.
      </p>
      <ul class="mt-3 border-b border-rule" role="list">
        {house.map((m) => {
          const stats = current(m);
          return (
            <li class="flex flex-col gap-0.5 border-t border-rule py-3 sm:flex-row sm:gap-5">
              <span class="shrink-0 font-display font-bold sm:w-28 sm:pt-0.5">{ordinal(m.district ?? 0)} District</span>
              <div class="min-w-0 flex-1">
                <p><a href={`/federal/${m.slug}/`} class="font-bold underline">{m.name}</a>, {partyWord(m.party)}</p>
                <p class="text-small text-granite">
                  {stats ? `Missed ${stats.missed.toLocaleString()} of ${stats.total.toLocaleString()} roll calls in the ${congressLabel(stats.congress)}. ` : ""}
                  <a href={`https://www.congress.gov/member/${m.slug}/${m.bioguide}`} class="underline">Official profile<span class="sr-only"> of {m.name}</span></a>
                </p>
              </div>
            </li>
          );
        })}
      </ul>
    </section>
  )}

  <p class="mt-12 max-w-[47.5rem] text-fine text-granite">
    Roll calls from the <a href="https://www.senate.gov/legislative/votes_new.htm" class="underline">U.S. Senate</a> and the
    {" "}<a href="https://clerk.house.gov/Votes" class="underline">U.S. House Clerk</a>{latest && `, the latest from ${fmtDate(latest)}`}{pulledOn && `; checked ${fmtDate(pulledOn)}`}.
  </p>
</Base>
