---
import Base from "../../layouts/Base.astro";

import { GLOSSARY } from "../../lib/glossary";
---

<Base
  title="Glossary"
  description="Plain-language definitions of the legislative jargon used across Wisconsin bill histories, roll calls, and this site."
>
  <h1 class="text-2xl font-bold">Glossary</h1>
  <p class="mt-1 max-w-3xl text-sm text-navy-700">
    The Legislature's records use terms of art; bill histories and motions on
    this site quote them verbatim. Plain-language translations below, for the
    Legislature's own description of its process, see the
    <a href="https://docs.legis.wisconsin.gov/document/help/process" class="underline">official overview</a>.
  </p>

  <dl class="mt-6 max-w-3xl space-y-3">
    {GLOSSARY.map(({ id, term, definition }) => (
      <div id={id} class="scroll-mt-4 rounded-lg border border-navy-100 bg-white p-4">
        <dt class="font-bold">{term}</dt>
        <dd class="mt-1 text-sm text-navy-700">{definition}</dd>
      </div>
    ))}
  </dl>
</Base>
