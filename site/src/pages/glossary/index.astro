---
/** Every definition on the site, in one list. Each entry keeps its anchor
 * (/glossary/#public-hearing), which the inline term popovers link to. */
import Base from "../../layouts/Base.astro";
import FilterBar from "../../components/FilterBar.astro";
import { GLOSSARY } from "../../lib/glossary";
---

<Base
  title="Words the Legislature uses"
  description="Plain-language definitions of the legislative terms used in Wisconsin bill histories, roll calls and this site."
  layout="wide"
>
  <header class="flex max-w-[47.5rem] flex-col gap-2.5">
    <h1 class="t-display">Words the Legislature uses</h1>
    <p class="sm:text-lead">
      Bill histories and motions on this site quote the Legislature's records word for word, and those
      records use terms of art. Here is what each one means, in plain words.
    </p>
    <p class="text-small text-granite">
      For the Legislature's own description of how a bill moves, see its
      {" "}<a href="https://docs.legis.wisconsin.gov/document/help/process" class="underline">official overview</a>.
    </p>
  </header>

  <div class="mt-4 max-w-[47.5rem]">
    <FilterBar wide id="term-filter" statusId="term-filter-status" label="Find a term" placeholder="A word or phrase" />
  </div>

  <dl class="mt-3 max-w-[47.5rem] border-b border-rule">
    {GLOSSARY.map(({ id, term, definition }) => (
      <div id={id} class="gl-entry border-t border-rule py-4" data-entry data-text={`${term} ${definition}`.toLowerCase()}>
        <dt class="t-question">{term}</dt>
        <dd class="mt-1">{definition}</dd>
      </div>
    ))}
  </dl>
  <p id="term-no-match" class="mt-4 hidden text-granite"></p>

  <script>
    import { initRowFilter } from "../../scripts/rowFilter";
    initRowFilter({
      input: "term-filter",
      rows: "[data-entry]",
      status: "term-filter-status",
      noMatch: "term-no-match",
      noun: "terms",
    });
  </script>
</Base>

<style>
  .gl-entry {
    scroll-margin-top: 6rem;
  }
  /* the entry a term popover or a link points at */
  .gl-entry:target {
    background: var(--color-lake-tint);
    box-shadow: inset 4px 0 0 var(--color-lake);
    padding-inline: 1rem;
  }
  @media (forced-colors: active) {
    .gl-entry:target {
      outline: 2px solid Highlight;
    }
  }
</style>
