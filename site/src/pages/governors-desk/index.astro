---
/** What the governor did with the bills the Legislature passed this
 * session: signed, vetoed, still waiting, and every override roll call,
 * straight from the official bill statuses. */
import Base from "../../layouts/Base.astro";
import BillLine from "../../components/BillLine.astro";
import MoreRows from "../../components/MoreRows.astro";
import { governorsDesk, governorInfo, lawsFor, vetoTracker, meta } from "../../lib/db";
import { billSlug, chamberName, fmtDate, partyWord } from "../../lib/format";
import { safeHref } from "../../lib/html";

const desk = governorsDesk();
const gov = governorInfo();
const pulledOn = meta().imported_at?.slice(0, 10);
const pct = (votes: number, total: number) =>
  total > 0 ? `${((votes / total) * 100).toFixed(1)}%` : null;
const plural = (n: number, one: string, many: string) => `${n.toLocaleString()} ${n === 1 ? one : many}`;
const reached = desk.enacted.length + desk.vetoed.length + desk.awaiting.length;
const session = `${desk.biennium}–${desk.biennium + 1}`;
const SHOWN = 10;
type Row = (typeof desk.enacted)[number];
const href = (b: Row) => `/bills/${b.session_id}/${billSlug(b.identifier)}/`;
// the date of the governor's own action, from the official history: the
// signing date for acts, the veto date for vetoes (latest action otherwise)
const signedOn = new Map(lawsFor(desk.biennium).map((l) => [l.bill_id, l.approved]));
const vetoedOn = new Map(
  (vetoTracker().find((b) => b.biennium === desk.biennium)?.fullVetoes ?? []).map((v) => [v.bill_id, v.date]),
);
const byDate = (when: Map<string, string | null>) => (rows: Row[]) =>
  rows
    .map((b) => ({ ...b, when: when.get(b.id) ?? b.latest_action_date }))
    .sort((a, b) => (b.when ?? "").localeCompare(a.when ?? "") || a.identifier.localeCompare(b.identifier, "en", { numeric: true }));
const vetoed = byDate(vetoedOn)(desk.vetoed);
const enacted = byDate(signedOn)(desk.enacted);
const approvedRunning = gov?.candidates2026.filter((c) => c.ballot_status === "Approve").length ?? 0;
const runnerUp = gov?.lastElection?.runnerUp;
---

<Base
  title="Governor's decisions"
  description="Wisconsin bills awaiting the governor's signature, signed into law, vetoed, and veto-override votes, straight from official bill histories."
  layout="wide"
>
  <header class="flex max-w-[47.5rem] flex-col gap-2.5">
    <h1 class="t-display">Governor's decisions</h1>
    <p class="sm:text-lead">
      {reached > 0 ? (
        <>
          Of the <span class="figure">{reached.toLocaleString()}</span> bills that passed both chambers in the {session} session,
          the governor signed <span class="figure">{desk.enacted.length.toLocaleString()}</span> into law and vetoed
          {" "}<span class="figure">{desk.vetoed.length.toLocaleString()}</span>.
          {desk.awaiting.length > 0 && ` ${plural(desk.awaiting.length, "is", "are")} still waiting for a decision.`}
        </>
      ) : `No bills have reached the governor in the ${session} session yet.`}
    </p>
    <p class="text-small text-granite">
      Resolutions aren't counted: they never go to the governor. <a href="/vetoes/" class="underline">Vetoes, session by session</a>
      {" "}and <a href="/partial-veto/" class="underline">how the partial veto works</a>.
    </p>
  </header>

  {gov && (
    <section class="sheet mt-8 flex max-w-[47.5rem] flex-col gap-2 p-5 sm:p-7" aria-labelledby="governor-heading">
      <h2 id="governor-heading" class="t-section text-[1.375rem]">Governor {gov.name}</h2>
      <p class="text-granite">{gov.party ? `${partyWord(gov.party)}.` : "Party not recorded."}</p>
      {gov.lastElection && (
        <p>
          Elected in November {gov.lastElection.year} with {pct(gov.lastElection.votes, gov.lastElection.total)} of the
          {" "}{gov.lastElection.total.toLocaleString()} votes cast{runnerUp
            ? `, ahead of ${runnerUp.candidate.split(" / ")[0]} with ${pct(runnerUp.votes, gov.lastElection.total)}`
            : ""}, in the certified canvass.
        </p>
      )}
      {gov.notRunning && (
        <p>
          Not running for reelection in 2026.
          {approvedRunning > 0 && ` ${plural(approvedRunning, "candidate is", "candidates are")} on the ballot for governor.`}
          {" "}<a href="/elections/2026/" class="underline">The 2026 ballot</a>
        </p>
      )}
    </section>
  )}

  {desk.awaiting.length > 0 && (
    <section class="mt-12 max-w-[60rem]" aria-labelledby="awaiting-heading">
      <h2 id="awaiting-heading" class="t-section">Waiting for the governor: {desk.awaiting.length.toLocaleString()}</h2>
      <p class="mt-2 text-small text-granite">Passed both chambers, and not yet signed or vetoed. Newest first.</p>
      <ul class="mt-3 border-b border-rule" role="list">
        {desk.awaiting.map((b) => (
          <BillLine href={href(b)} identifier={b.identifier} title={b.title} date={b.latest_action_date ? fmtDate(b.latest_action_date) : ""}>{b.latest_action_desc}</BillLine>
        ))}
      </ul>
    </section>
  )}

  <section class="mt-12 max-w-[60rem]" aria-labelledby="overrides-heading">
    <h2 id="overrides-heading" class="t-section">Votes to override a veto: {desk.overrides.length.toLocaleString()}</h2>
    <p class="mt-2 max-w-[47.5rem] text-small text-granite">
      Overriding a veto takes a two-thirds vote in each chamber. The motion is the journal's own wording,
      and each vote links to its roll call.
    </p>
    {desk.overrides.length === 0 ? (
      <p class="mt-3">No override votes this session.</p>
    ) : (
      <div class="mt-3">
        <MoreRows rest={Math.max(0, desk.overrides.length - SHOWN)} label="override votes">
          {desk.overrides.slice(0, SHOWN).map((o) => (
            <BillLine href={`/bills/${o.session_id}/${billSlug(o.identifier)}/`} identifier={o.identifier} title={o.title} date={o.date ? fmtDate(o.date) : ""}>
              {chamberName(o.chamber)}: {o.result === "pass" ? "the override passed" : "the override failed"}, {o.yes_count} to {o.no_count}.
              {" "}“{o.motion}”{" "}<a href={`/votes/${o.id}/`} class="underline">Roll call</a>
              {safeHref(o.source_url) && <>{" "}<a href={safeHref(o.source_url)} class="underline">Official record</a></>}
            </BillLine>
          ))}
          <Fragment slot="rest">
            {desk.overrides.slice(SHOWN).map((o) => (
              <BillLine href={`/bills/${o.session_id}/${billSlug(o.identifier)}/`} identifier={o.identifier} title={o.title} date={o.date ? fmtDate(o.date) : ""}>
                {chamberName(o.chamber)}: {o.result === "pass" ? "the override passed" : "the override failed"}, {o.yes_count} to {o.no_count}.
                {" "}“{o.motion}”{" "}<a href={`/votes/${o.id}/`} class="underline">Roll call</a>
                {safeHref(o.source_url) && <>{" "}<a href={safeHref(o.source_url)} class="underline">Official record</a></>}
              </BillLine>
            ))}
          </Fragment>
        </MoreRows>
      </div>
    )}
  </section>

  {[
    { id: "vetoed", label: "Vetoed", rows: vetoed, note: "By the date of the veto, newest first." },
    { id: "enacted", label: "Signed into law", rows: enacted, note: "By the date the governor signed, newest first. Each act's number is on its page and in the list of new laws." },
  ].map((s) => (
    <section class="mt-12 max-w-[60rem]" aria-labelledby={`${s.id}-heading`}>
      <h2 id={`${s.id}-heading`} class="t-section">{s.label}: {s.rows.length.toLocaleString()}</h2>
      <p class="mt-2 text-small text-granite">{s.note}</p>
      {s.rows.length === 0 ? (
        <p class="mt-3">None yet this session.</p>
      ) : (
        <div class="mt-3">
          <MoreRows rest={Math.max(0, s.rows.length - SHOWN)} label={s.label.toLowerCase()}>
            {s.rows.slice(0, SHOWN).map((b) => (
              <BillLine href={href(b)} identifier={b.identifier} title={b.title} date={b.when ? fmtDate(b.when) : ""} />
            ))}
            <Fragment slot="rest">
              {s.rows.slice(SHOWN).map((b) => (
                <BillLine href={href(b)} identifier={b.identifier} title={b.title} date={b.when ? fmtDate(b.when) : ""} />
              ))}
            </Fragment>
          </MoreRows>
        </div>
      )}
    </section>
  ))}

  <p class="mt-12 max-w-[47.5rem] text-fine text-granite">
    From each bill's <a href="https://docs.legis.wisconsin.gov" class="underline">official history</a>, linked on
    every bill page; the governor's election result is the Wisconsin Elections Commission's certified
    canvass{pulledOn && `. Checked ${fmtDate(pulledOn)}`}.
  </p>
</Base>
