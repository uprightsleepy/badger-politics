---
import Base from "../../layouts/Base.astro";
import RollCall from "../../components/RollCall.astro";
import { builtSessions, billsFor, votesFor, voteSplit } from "../../lib/db";
import { billSlug, chamberName, clip, fmtDate, shortTitle } from "../../lib/format";

export function getStaticPaths() {
  return builtSessions().flatMap((session) =>
    billsFor(session.id).flatMap((b) =>
      votesFor(b.id).map((event) => ({
        params: { id: event.id },
        props: { event, bill: b, sessionId: session.id },
      })),
    ),
  );
}
const { event, bill, sessionId } = Astro.props;
const split = voteSplit(event.id);
// the same bill's other roll calls: suspension then passage on one day is
// common, and the pair reads differently than either vote alone
const siblings = votesFor(bill.id).filter((v) => v.id !== event.id);

// Every one of these pages carried the sitewide fallback description, and
// motions repeat across votes, so the tally and date are what make a given
// roll call identifiable in a result listing.
const motion = event.motion ?? "vote";
const tally = event.yes_count != null ? `${event.yes_count}-${event.no_count ?? 0}` : "";
const outcome = event.result === "pass" ? "Passed" : "Failed";
const seoTitle = `${bill.identifier} roll call, ${fmtDate(event.date)}: ${clip(motion, 26)}`;
const seoDescription = [
  `${chamberName(event.chamber)} roll call on ${bill.identifier}, ${fmtDate(event.date)}.`,
  `${motion}: ${outcome}${tally ? ` ${tally}` : ""}.`,
  `How every member voted. ${shortTitle(bill.title)}`,
]
  .filter(Boolean)
  .join(" ");
---

<Base
  title={seoTitle}
  description={seoDescription}
  searchable={false}
  noindex
  breadcrumbs={[
    { name: "Bills", url: "/bills/" },
    { name: bill.identifier, url: `/bills/${sessionId}/${billSlug(bill.identifier)}/` },
  ]}
>
  <p class="text-sm text-navy-600">
    <a href={`/bills/${sessionId}/${billSlug(bill.identifier)}/`} class="underline">
      ← {bill.identifier}: {bill.title?.slice(0, 90)}
    </a>
  </p>
  {siblings.length > 0 && (
    <p class="mt-1 text-xs text-navy-600" data-pagefind-ignore>
      Other roll calls on this bill:{" "}
      {siblings.map((v, i) => (
        <>
          {i > 0 && " · "}
          <a href={`/votes/${v.id}/`} class="underline">
            {chamberName(v.chamber)} {fmtDate(v.date)}{v.motion ? `, ${clip(v.motion, 28)}` : ""}
          </a>
        </>
      ))}
    </p>
  )}
  <h1 class="mt-2 flex flex-wrap items-center gap-3 text-2xl font-bold">
    Roll call vote
    {split?.label && (
      <span class={`rounded-full px-3 py-0.5 text-sm font-semibold ${split.label === "Party-line" ? "bg-badger-50 text-badger-700" : "bg-moss-50 text-moss-600"}`}>
        {split.label}
      </span>
    )}
  </h1>
  {split && (
    <p class="mt-1 text-sm text-navy-600">
      Among members casting an Aye or Nay: Democrats {split.dem.yes} Aye–{split.dem.no} Nay,
      Republicans {split.rep.yes} Aye–{split.rep.no} Nay.
      {split.label === "Party-line" && " The parties' majorities took opposite positions."}
      {split.label === "Bipartisan" && " Majorities of both parties voted the same way."}
    </p>
  )}
  <div class="mt-4">
    <RollCall event={event} compact headingLevel="h2" />
  </div>
</Base>
