---
/** One roll call on its own page: the bill it was on, how each party
 * voted in a sentence, the roll call with every member's vote, and the
 * bill's other roll calls. */
import Base from "../../layouts/Base.astro";
import RollCall from "../../components/RollCall.astro";
import { builtSessions, billsFor, votesFor, voteSplit } from "../../lib/db";
import { billSlug, chamberName, clip, fmtDate, identifierLong, partySplitSentence, shortTitle } from "../../lib/format";

export function getStaticPaths() {
  return builtSessions().flatMap((session) =>
    billsFor(session.id).flatMap((b) =>
      votesFor(b.id).map((event) => ({
        params: { id: event.id },
        props: { event, bill: b, sessionId: session.id },
      })),
    ),
  );
}
const { event, bill, sessionId } = Astro.props;
const split = voteSplit(event.id);
// the same bill's other roll calls: suspension then passage on one day is
// common, and the pair reads differently than either vote alone
const siblings = votesFor(bill.id).filter((v) => v.id !== event.id);
const billHref = `/bills/${sessionId}/${billSlug(bill.identifier)}/`;
const title = shortTitle(bill.title);

// Every one of these pages carried the sitewide fallback description, and
// motions repeat across votes, so the tally and date are what make a given
// roll call identifiable in a result listing.
const motion = event.motion ?? "vote";
const tally = event.yes_count != null ? `${event.yes_count}-${event.no_count ?? 0}` : "";
const outcome = event.result === "pass" ? "Passed" : "Failed";
const seoTitle = `${bill.identifier} roll call, ${fmtDate(event.date)}: ${clip(motion, 26)}`;
const seoDescription = [
  `${chamberName(event.chamber)} roll call on ${bill.identifier}, ${fmtDate(event.date)}.`,
  `${motion}: ${outcome}${tally ? ` ${tally}` : ""}.`,
  `How every member voted. ${title}`,
]
  .filter(Boolean)
  .join(" ");
// the outcome and tally only as recorded: an unfamiliar result or a missing
// count is left out rather than guessed (the roll call's own page has more)
const result = (v: (typeof siblings)[number]) => {
  const word = v.result === "pass" ? "Passed" : v.result === "fail" ? "Failed" : "";
  const counts = v.yes_count != null && v.no_count != null ? `${v.yes_count} to ${v.no_count}` : "";
  return word && counts ? `${word}, ${counts}.` : word ? `${word}.` : counts ? `${counts}.` : "";
};
---

<Base
  title={seoTitle}
  description={seoDescription}
  searchable={false}
  noindex
  breadcrumbs={[
    { name: "Bills", url: "/bills/" },
    { name: bill.identifier, url: billHref },
  ]}
  layout="wide"
>
  <header class="flex max-w-[47.5rem] flex-col gap-2.5">
    <a href={billHref} class="inline-flex min-h-11 items-center self-start text-small underline">{bill.identifier}</a>
    <h1 class="t-display">Roll call on {identifierLong(bill.identifier)}</h1>
    {title && <p class="sm:text-lead">{title}</p>}
    {split && <p>{partySplitSentence(split)}</p>}
  </header>

  <div class="mt-6 max-w-[60rem]">
    <RollCall event={event} compact headingLevel="h2" />
  </div>

  {siblings.length > 0 && (
    <section class="mt-10 max-w-[47.5rem]" aria-labelledby="others-heading" data-pagefind-ignore>
      <h2 id="others-heading" class="t-section">Other roll calls on this bill</h2>
      <ul class="mt-3 border-b border-rule" role="list">
        {siblings.map((v) => (
          <li class="flex flex-col border-t border-rule py-2 sm:flex-row sm:gap-5">
            <span class="shrink-0 pt-1 text-small text-granite sm:w-28 sm:pt-3">{fmtDate(v.date)}</span>
            <span class="min-w-0">
              <a href={`/votes/${v.id}/`} class="inline-flex min-h-11 items-center underline">{chamberName(v.chamber)}: {v.motion ?? "Roll call"}</a>
              {result(v) && <span class="block text-small text-granite">{result(v)}</span>}
            </span>
          </li>
        ))}
      </ul>
      <p class="mt-3"><a href={billHref} class="inline-flex min-h-11 items-center underline">Everything that happened to {bill.identifier}</a></p>
    </section>
  )}
</Base>
