---
/** Page 1 of a session's bills. This used to render all 2,749 proposals in
 * one 2 MB document behind a client-side filter. The views by status are
 * real links to per-status pages: same one-tap behaviour, but each view is
 * a shareable URL a crawler can reach, and no page carries the whole
 * session. */
import Base from "../../../layouts/Base.astro";
import BillList from "../../../components/BillList.astro";
import BillViews from "../../../components/BillViews.astro";
import FilterBar from "../../../components/FilterBar.astro";
import Pager from "../../../components/Pager.astro";
import { builtSessions, billsFor } from "../../../lib/db";
import { sessionPlainName } from "../../../lib/format";
import { sessionCounts } from "../../../lib/billRows";
import { PER_PAGE, pageBounds, pageCount } from "../../../lib/paging";

export function getStaticPaths() {
  return builtSessions().map((session) => ({
    params: { session: session.id },
    props: { session },
  }));
}

const { session } = Astro.props;
const bills = billsFor(session.id);
const pages = pageCount(bills.length);
const { last } = pageBounds(1, bills.length);
const name = session.name ?? session.id;
const plain = sessionPlainName(session.id, name);
const c = sessionCounts(session.id);
const n = (x: number) => x.toLocaleString();
// counts out of the session's total: what became of them, in route order
const outcomes = [
  `${n(c.enacted)} became law`,
  c.vetoed ? `${n(c.vetoed)} ${c.vetoed === 1 ? "was" : "were"} vetoed` : "",
  c.noHearing ? `${n(c.noHearing)} never got a public hearing` : "",
].filter(Boolean);
const lead =
  `${n(c.total)} ${c.total === 1 ? "bill or resolution" : "bills and resolutions"}. ` +
  (outcomes.length > 1
    ? `${outcomes.slice(0, -1).join(", ")}${outcomes.length > 2 ? "," : ""} and ${outcomes.at(-1)}.`
    : `${outcomes[0]}.`);
---

<Base
  title={`Bills in the ${plain}`}
  description={`All ${n(bills.length)} bills and resolutions of the ${name}: where each one stands, its latest action, and links to every roll call.`}
  breadcrumbs={[{ name: "Bills", url: "/bills/" }]}
  layout="wide"
>
  <header class="flex max-w-[47.5rem] flex-col gap-2.5">
    <a href="/bills/" class="self-start text-small underline">All sessions</a>
    <h1 class="t-display">Bills in the {plain}</h1>
    <p class="sm:text-lead">{lead}</p>
    {session.data_quality === "partial" && (
      <p class="text-small text-granite">
        Partial records: individual roll call votes aren't available for this session.
      </p>
    )}
  </header>

  <div class="mt-7">
    <BillViews sessionId={session.id} current="all" />
  </div>

  <div class="mt-4">
    <FilterBar
      wide
      id="bill-filter"
      statusId="filter-status"
      label="Find a bill on this page"
      placeholder="Number or words from its title"
    />
  </div>
  <p class="text-small text-granite">
    {pages > 1 ? `Showing 1–${n(last)} of ${n(bills.length)}.` : `Showing all ${n(bills.length)}.`}
  </p>

  <BillList bills={bills.slice(0, PER_PAGE)} class="mt-3" />
  <p id="no-match" class="mt-4 hidden text-granite"></p>

  <Pager
    page={1}
    pages={pages}
    href={(p) => (p === 1 ? `/bills/${session.id}/` : `/bills/${session.id}/page/${p}/`)}
    label="Bill list pages"
  />

  <script>
    import { initRowFilter } from "../../../scripts/rowFilter";
    // scoped to the rows on this page; the status views are their own URLs
    initRowFilter({
      input: "bill-filter",
      rows: "[data-bill-row]",
      status: "filter-status",
      noMatch: "no-match",
      noun: "bills on this page",
    });
  </script>
</Base>
