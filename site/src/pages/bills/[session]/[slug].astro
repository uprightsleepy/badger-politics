---
import Base from "../../../layouts/Base.astro";
import FollowButton from "../../../components/FollowButton.astro";
import StatusBadge from "../../../components/StatusBadge.astro";
import Stepper from "../../../components/Stepper.astro";
import RollCall from "../../../components/RollCall.astro";
import SponsorNames from "../../../components/SponsorNames.astro";
import {
  builtSessions,
  billsFor,
  actionsFor,
  sponsorsFor,
  votesFor,
  lobbyingFor,
  documentsFor,
  subjectsForBill,
  personIdByName,
} from "../../../lib/db";
import {
  billSlug, fmtDate, personSlug, chamberName, subjectDisplay, subjectSlug,
} from "../../../lib/format";
import { linkifyAction } from "../../../lib/actionLinks";

export function getStaticPaths() {
  return builtSessions().flatMap((session) =>
    billsFor(session.id).map((b) => ({
      params: { session: session.id, slug: billSlug(b.identifier) },
      props: { bill: b, sessionName: session.name ?? session.id },
    })),
  );
}

const { bill, sessionName } = Astro.props;
const actions = actionsFor(bill.id);
const sponsors = sponsorsFor(bill.id);
const votes = votesFor(bill.id);
const lobbying = lobbyingFor(bill.id);
const primary = sponsors.filter((s) => s.is_primary);
const cosponsors = sponsors.filter((s) => !s.is_primary);
const chairId = personIdByName(bill.committee_chair_at_death);
const fiscalEstimates = documentsFor(bill.id).filter((d) =>
  d.note.toLowerCase().includes("fiscal estimate"),
);
const subjects = subjectsForBill(bill.id);
// "AB 12: Fiscal Estimate From DOA" -> "Fiscal Estimate From DOA"
const fiscalLabel = (note: string) => note.replace(/^[A-Z]+\s*\d+:\s*/, "");
---

<Base title={`${bill.identifier} (${sessionName})`} description={bill.title ?? undefined}>
  <article data-pagefind-body class="mx-auto max-w-3xl">
    <p class="text-sm text-navy-600">
      <a href="/bills/" class="underline">Bills</a> · {sessionName}
    </p>
    <div class="mt-1 flex flex-wrap items-center gap-3">
      <h1 class="text-3xl font-bold tracking-tight">{bill.identifier}</h1>
      <StatusBadge status={bill.status} />
      {bill.text_url && (
        <a href={bill.text_url} class="text-sm underline" data-pagefind-ignore>
          Official bill text
        </a>
      )}
      <span class="ml-auto flex items-center gap-3" data-pagefind-ignore>
        <FollowButton kind="bills" id={bill.id} />
        <a href={`/feeds/bills/${bill.id}.xml`} class="text-xs underline">Atom feed</a>
      </span>
    </div>
    <p class="mt-2 text-lg text-navy-700">{bill.title}</p>
    {subjects.length > 0 && (
      <p class="mt-2 flex flex-wrap gap-x-2 gap-y-1 text-xs" data-pagefind-ignore>
        {subjects.map((s) => (
          <a
            href={`/subjects/${subjectSlug(s.subject)}/`}
            class="rounded-full bg-navy-50 px-2.5 py-1 text-navy-700 hover:bg-navy-100"
          >
            {subjectDisplay(s.subject)}
          </a>
        ))}
      </p>
    )}

    <div class="mt-6 rounded-lg border border-navy-100 bg-white p-4">
      <Stepper status={bill.status} chamber={bill.chamber} classification={bill.classification} />
    </div>

    {bill.died_without_hearing === 1 && (
      <aside class="mt-4 rounded-lg border border-badger-600/30 bg-badger-50 p-4">
        <h2 class="font-bold text-badger-700">Hearing: none</h2>
        <p class="mt-1 text-sm">
          This bill died at the end of the session without ever receiving a public
          hearing. It sat in the <strong>{bill.committee_at_death}</strong> committee
          {bill.committee_chair_at_death && (
            <span>
              {" "}(chair:{" "}
              {chairId ? (
                <a href={`/legislators/${personSlug(chairId)}/`} class="underline">{bill.committee_chair_at_death}</a>
              ) : (
                bill.committee_chair_at_death
              )})
            </span>
          )}.
          <a href={`/hearing-none/${bill.session_id}/`} class="underline">
            See every bill that died this way
          </a>
        </p>
      </aside>
    )}

    {bill.lrb_analysis && (
      <section class="mt-6">
        <h2 class="text-xl font-bold">What this bill does</h2>
        <p class="text-xs text-navy-600">
          Plain-language analysis by the nonpartisan Legislative Reference Bureau
        </p>
        <div
          class="mt-2 max-h-80 overflow-y-auto rounded-lg border border-navy-100 bg-white"
          role="region"
          tabindex="0"
          aria-label="Legislative Reference Bureau analysis"
        >
          <div class="space-y-3 p-4 leading-relaxed">
            {bill.lrb_analysis.split(/\n+/).slice(0, 40).map((para) => <p>{para}</p>)}
          </div>
        </div>
      </section>
    )}

    {fiscalEstimates.length > 0 && (
      <section class="mt-4">
        <h2 class="text-lg font-bold">What it would cost</h2>
        <p class="text-xs text-navy-600">
          Fiscal estimates filed by state agencies, as official PDFs
        </p>
        <ul class="mt-2 flex flex-wrap gap-x-5 gap-y-1 text-sm">
          {fiscalEstimates.map((d) => (
            <li>
              <a href={d.url} class="py-1 underline">{fiscalLabel(d.note)}</a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="mt-6">
      <h2 class="text-xl font-bold">Sponsors</h2>
      <div class="mt-2 space-y-1 text-sm" data-pagefind-ignore>
        {primary.length > 0 && (
          <p>
            <strong>Introduced by:</strong>{" "}
            <SponsorNames sponsors={primary} />
          </p>
        )}
        {cosponsors.length > 0 && (
          <details>
            <summary class="cursor-pointer text-navy-700 underline">
              {cosponsors.length} cosponsors
            </summary>
            <p class="mt-1">
              <SponsorNames sponsors={cosponsors} />
            </p>
          </details>
        )}
      </div>
    </section>

    {lobbying.length > 0 && (
      <section class="mt-6" data-pagefind-ignore>
        <h2 class="text-xl font-bold">Registered lobbying interests · {lobbying.length}</h2>
        <p class="text-xs text-navy-600">
          Organizations that registered lobbying activity on this bill with the
          Wisconsin Ethics Commission. Registration means interest, not a
          position for or against.
          {lobbying[0].source_url && (
            <a href={lobbying[0].source_url} class="underline"> Official record</a>
          )}
        </p>
        <ul class="mt-2 grid gap-x-4 gap-y-1 rounded-lg border border-navy-100 bg-white p-3 text-sm sm:grid-cols-2">
          {lobbying.map((l) => (
            <li class="truncate">
              <a
                href={`https://lobbying.wi.gov/Who/PrincipalInformation/2025REG/Information/${l.principal_id}`}
                class="hover:underline"
              >
                {l.principal}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {votes.length > 0 && (
      <section class="mt-6" data-pagefind-ignore>
        <h2 class="text-xl font-bold">Votes</h2>
        <div class="mt-2 space-y-4">
          {votes.map((event) => <RollCall event={event} />)}
        </div>
      </section>
    )}

    <section class="mt-6" data-pagefind-ignore>
      <h2 class="text-xl font-bold">Full history</h2>
      <div
        class="mt-3 max-h-96 overflow-y-auto pl-2"
        role="region"
        tabindex="0"
        aria-label="Bill history timeline"
      >
      <ol class="border-l-2 border-navy-100 pl-4">
        {actions.map((a) => (
          <li class="relative mb-3">
            <span class="absolute -left-[1.4rem] top-1.5 h-2.5 w-2.5 rounded-full bg-navy-600"></span>
            <span class="text-xs font-semibold text-navy-600">
              {fmtDate(a.date)} · {chamberName(a.chamber)}
            </span>
            <p class="text-sm" set:html={linkifyAction(a.description, bill.session_id)} />
          </li>
        ))}
      </ol>
      </div>
    </section>
  </article>
</Base>
