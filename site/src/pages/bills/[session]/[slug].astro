---
import Base from "../../../layouts/Base.astro";
import FollowButton from "../../../components/FollowButton.astro";
import StatusBadge from "../../../components/StatusBadge.astro";
import Stepper from "../../../components/Stepper.astro";
import RollCall from "../../../components/RollCall.astro";
import SponsorNames from "../../../components/SponsorNames.astro";
import {
  builtSessions,
  billsFor,
  actionsFor,
  sponsorsFor,
  votesFor,
  lobbyingFor,
  documentsFor,
  subjectsForBill,
  personIdByName,
  vetoMessageUrl,
} from "../../../lib/db";
import {
  billSlug, clip, fmtDate, lrbParagraphs, personSlug, chamberName, sessionYear, shortTitle,
  subjectDisplay, subjectSlug, STATUS_LABELS,
} from "../../../lib/format";
import JsonLd from "../../../components/JsonLd.astro";
import { linkifyAction } from "../../../lib/actionLinks";

export function getStaticPaths() {
  return builtSessions().flatMap((session) =>
    billsFor(session.id).map((b) => ({
      params: { session: session.id, slug: billSlug(b.identifier) },
      props: { bill: b, sessionName: session.name ?? session.id },
    })),
  );
}

const { bill, sessionName } = Astro.props;
const actions = actionsFor(bill.id);
const sponsors = sponsorsFor(bill.id);
const votes = votesFor(bill.id);
const lobbying = lobbyingFor(bill.id);
const primary = sponsors.filter((s) => s.is_primary);
const cosponsors = sponsors.filter((s) => !s.is_primary);
const chairId = personIdByName(bill.committee_chair_at_death);
const fiscalEstimates = documentsFor(bill.id).filter((d) =>
  d.note.toLowerCase().includes("fiscal estimate"),
);
const subjects = subjectsForBill(bill.id);
// "AB 12: Fiscal Estimate From DOA" -> "Fiscal Estimate From DOA"
const fiscalLabel = (note: string) => note.replace(/^[A-Z]+\s*\d+:\s*/, "");

// plain-language fate explainer: docs.legis never says "this bill is dead"
const vetoMsg = bill.status === "vetoed" || bill.status === "enacted"
  ? vetoMessageUrl(bill.id) : null;
const partialVeto = actions.some((a) => /partial veto/i.test(a.description));
const isBill = bill.classification === "bill";

// "AB 656 (2025)" alone tells a searcher nothing; almost nobody searches a
// bill number. Lead with the identifier for those who do, then the subject
// for everyone else. The year disambiguates a number that recurs each
// biennium.
const subject = shortTitle(bill.title);
const seoTitle = subject
  ? `${bill.identifier} (${sessionYear(bill.session_id)}): ${clip(subject, 40)}`
  : `${bill.identifier} (${sessionName})`;
// status and session make the near-identical housekeeping bills distinct
const seoDescription = [
  `${sessionName}.`,
  `${STATUS_LABELS[bill.status ?? ""] ?? "Introduced"}.`,
  subject,
]
  .filter(Boolean)
  .join(" ");
const passedChamberName = bill.chamber === "upper" ? "Senate" : "Assembly";
const otherChamberName = bill.chamber === "upper" ? "Assembly" : "Senate";
---

<Base
  title={seoTitle}
  description={seoDescription}
  filters={{
    type: isBill ? "Bill" : "Resolution",
    session: sessionName,
    outcome: STATUS_LABELS[bill.status ?? ""] ?? "Introduced",
    chamber: passedChamberName,
  }}
  breadcrumbs={[
    { name: "Bills", url: "/bills/" },
    { name: sessionName, url: `/bills/${bill.session_id}/` },
  ]}
>
  <JsonLd
    data={{
      "@type": "Legislation",
      name: `${bill.identifier}: ${subject}`,
      legislationIdentifier: bill.identifier,
      legislationType: bill.classification ?? "bill",
      legislationJurisdiction: "Wisconsin, United States",
      legislationLegislatedBy: {
        "@type": "GovernmentOrganization",
        name: "Wisconsin State Legislature",
      },
      ...(bill.status === "enacted" ? { legislationPassedBy: {
        "@type": "GovernmentOrganization",
        name: "Wisconsin State Legislature",
      } } : {}),
      inLanguage: "en-US",
      isBasedOn: bill.text_url ?? undefined,
      about: subjects.map((s) => subjectDisplay(s.subject)),
      description: seoDescription,
    }}
  />
  <article class="mx-auto max-w-3xl">
    <p class="text-sm text-navy-600">
      <a href="/bills/" class="underline">Bills</a> · {sessionName}
    </p>
    <div class="mt-1 flex flex-wrap items-center gap-3">
      <h1 class="text-3xl font-bold tracking-tight">{bill.identifier}</h1>
      <StatusBadge status={bill.status} />
      {bill.text_url && (
        <a href={bill.text_url} class="text-sm underline" data-pagefind-ignore>
          Official bill text
        </a>
      )}
      <span class="ml-auto flex items-center gap-3" data-pagefind-ignore>
        <FollowButton kind="bills" id={bill.id} />
        <a href={`/feeds/bills/${bill.id}.xml`} class="text-xs underline">Atom feed</a>
      </span>
    </div>
    <p class="mt-2 text-lg text-navy-700">{bill.title}</p>
    {subjects.length > 0 && (
      <p class="mt-2 flex flex-wrap gap-x-2 gap-y-1 text-xs" data-pagefind-ignore>
        {subjects.map((s) => (
          <a
            href={`/subjects/${subjectSlug(s.subject)}/`}
            class="rounded-full bg-navy-50 px-2.5 py-1 text-navy-700 hover:bg-navy-100"
          >
            {subjectDisplay(s.subject)}
          </a>
        ))}
      </p>
    )}

    <div class="mt-6 rounded-lg border border-navy-100 bg-white p-4">
      <h2 class="sr-only">At a glance</h2>
      <dl class="mb-4 grid gap-x-6 gap-y-3 border-b border-navy-100 pb-4 text-sm sm:grid-cols-2 lg:grid-cols-4">
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wide text-navy-600">Status</dt>
          <dd class="mt-0.5 font-bold">{STATUS_LABELS[bill.status ?? ""] ?? "Introduced"}</dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wide text-navy-600">Public hearing</dt>
          <dd class={`mt-0.5 font-bold ${bill.died_without_hearing === 1 ? "text-badger-700" : ""}`}>
            {bill.died_without_hearing === 1 ? "Never held" : "See history"}
          </dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wide text-navy-600">Introduced by</dt>
          <dd class="mt-0.5 font-bold">
            {primary.length > 0
              ? `${primary[0].name}${primary.length > 1 ? ` +${primary.length - 1}` : ""}`
              : "Not recorded"}
          </dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wide text-navy-600">Last action</dt>
          <dd class="mt-0.5 font-bold">
            {bill.latest_action_date ? fmtDate(bill.latest_action_date) : "None recorded"}
          </dd>
        </div>
      </dl>
      <Stepper status={bill.status} chamber={bill.chamber} classification={bill.classification} />
      <p class="mt-2 text-right text-xs text-navy-600">
        Unfamiliar terms? <a href="/glossary/" class="inline-block py-1 underline">Glossary</a>
      </p>
    </div>

    {bill.status === "failed_sjr1" && bill.died_without_hearing !== 1 && (
      <aside class="mt-4 rounded-lg border border-navy-100 bg-navy-50 p-4 text-sm">
        <p>
          <strong>This {isBill ? "bill" : "proposal"} is dead.</strong> The
          Legislature's session schedule, set by Senate Joint Resolution 1 at
          the session's start, fixes a last day for floor action, and any
          proposal still pending on that day fails automatically. That is how
          most {isBill ? "bills" : "proposals"} end. Taking the idea up again
          would require a new {isBill ? "bill" : "proposal"} in a future
          session. <a href="/glossary/" class="underline">Glossary</a>
        </p>
      </aside>
    )}
    {bill.status === "passed_chamber" && (
      <aside class="mt-4 rounded-lg border border-navy-100 bg-navy-50 p-4 text-sm">
        <p>
          <strong>This {isBill ? "bill" : "proposal"} passed the
          {" "}{passedChamberName} but is dead.</strong> The
          {" "}{otherChamberName} never took it up before the session's floor
          deadline, so it failed with the session's end, passing one house is
          not enough. <a href="/glossary/" class="underline">Glossary</a>
        </p>
      </aside>
    )}
    {bill.status === "vetoed" && (
      <aside class="mt-4 rounded-lg border border-navy-100 bg-navy-50 p-4 text-sm">
        <p>
          <strong>The governor vetoed this bill</strong>, blocking it from
          becoming law after both chambers passed it. The Legislature can
          override a veto only with a two-thirds vote of each chamber.
          {vetoMsg && (
            <>
              {" "}<a href={vetoMsg} class="underline">Read the governor's veto message</a>.
            </>
          )}
          {" "}<a href="/vetoes/" class="underline">All vetoes this session</a>
        </p>
      </aside>
    )}
    {bill.status === "enacted" && partialVeto && (
      <aside class="mt-4 rounded-lg border border-navy-100 bg-navy-50 p-4 text-sm">
        <p>
          <strong>Signed with a partial veto:</strong> the governor struck
          parts of this bill and signed the rest into law, a power unique to
          Wisconsin's governor on appropriation bills.
          {vetoMsg && (
            <>
              {" "}<a href={vetoMsg} class="underline">Read the veto message</a>.
            </>
          )}
          {" "}<a href="/partial-veto/" class="underline">How the partial veto works</a>
        </p>
      </aside>
    )}

    {bill.died_without_hearing === 1 && (
      <aside class="mt-4 rounded-lg border border-badger-600/30 bg-badger-50 p-4">
        <h2 class="font-bold text-badger-700">Hearing: none</h2>
        <p class="mt-1 text-sm">
          This bill died at the end of the session without ever receiving a public
          hearing. It sat in the <strong>{bill.committee_at_death}</strong> committee
          {bill.committee_chair_at_death && (
            <span>
              {" "}(chair:{" "}
              {chairId ? (
                <a href={`/legislators/${personSlug(chairId)}/`} class="underline">{bill.committee_chair_at_death}</a>
              ) : (
                bill.committee_chair_at_death
              )})
            </span>
          )}.
          <a href={`/hearing-none/${bill.session_id}/`} class="underline">
            See every bill that died this way
          </a>
        </p>
      </aside>
    )}

    {bill.lrb_analysis && (
      <section class="mt-6">
        <h2 class="text-xl font-bold">What this bill does</h2>
        <p class="text-xs text-navy-600">
          Plain-language analysis by the nonpartisan Legislative Reference Bureau
        </p>
        <div
          class="mt-2 max-h-80 overflow-y-auto rounded-lg border border-navy-100 bg-white scroll-body"
          role="region"
          tabindex="0"
          aria-label="Legislative Reference Bureau analysis"
        >
          <div class="space-y-3 p-4 leading-relaxed">
            {lrbParagraphs(bill.lrb_analysis).slice(0, 40).map((para) => <p>{para}</p>)}
          </div>
        </div>
      </section>
    )}

    {fiscalEstimates.length > 0 && (
      <section class="mt-4">
        <h2 class="text-lg font-bold">What it would cost</h2>
        <p class="text-xs text-navy-600">
          Fiscal estimates filed by state agencies, as official PDFs
        </p>
        <ul class="mt-2 flex flex-wrap gap-x-5 gap-y-1 text-sm">
          {fiscalEstimates.map((d) => (
            <li>
              <a href={d.url} class="py-1 underline">{fiscalLabel(d.note)}</a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="mt-6">
      <h2 class="text-xl font-bold">Sponsors</h2>
      <div class="mt-2 space-y-1 text-sm" data-pagefind-ignore>
        {primary.length > 0 && (
          <p>
            <strong>Introduced by:</strong>{" "}
            <SponsorNames sponsors={primary} />
          </p>
        )}
        {cosponsors.length > 0 && (
          <details>
            <summary class="cursor-pointer text-navy-700 underline">
              {cosponsors.length} cosponsors
            </summary>
            <p class="mt-1">
              <SponsorNames sponsors={cosponsors} />
            </p>
          </details>
        )}
      </div>
    </section>

    {lobbying.length > 0 && (
      <section class="mt-6" data-pagefind-ignore>
        <h2 class="text-xl font-bold">Registered lobbying interests · {lobbying.length}</h2>
        <p class="text-xs text-navy-600">
          Organizations that registered lobbying activity on this bill with the
          Wisconsin Ethics Commission. Registration means interest, not a
          position for or against.
          {lobbying[0].source_url && (
            <a href={lobbying[0].source_url} class="underline"> Official record</a>
          )}
        </p>
        <ul class="mt-2 grid gap-x-4 gap-y-1 rounded-lg border border-navy-100 bg-white p-3 text-sm sm:grid-cols-2">
          {lobbying.map((l) => (
            <li class="truncate">
              <a
                href={`https://lobbying.wi.gov/Who/PrincipalInformation/2025REG/Information/${l.principal_id}`}
                class="hover:underline"
              >
                {l.principal}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {votes.length > 0 && (
      <section class="mt-6" data-pagefind-ignore>
        <h2 class="text-xl font-bold">Votes</h2>
        {votes.some((v) => /suspend/i.test(v.motion ?? "")) && (
          <p class="mt-1 max-w-3xl text-sm text-navy-600">
            Suspending the rules (to take a vote immediately) needs a
            two-thirds majority, a higher bar than passing the bill, which
            needs a simple majority. That's why a suspension motion can show
            more Ayes than the passage vote that follows it.
            {" "}<a href="/glossary/" class="underline">Glossary</a>
          </p>
        )}
        <div class="mt-2 space-y-4">
          {votes.map((event) => <RollCall event={event} />)}
        </div>
      </section>
    )}

    <section class="mt-6" data-pagefind-ignore>
      <h2 class="text-xl font-bold">Full history</h2>
      <div
        class="mt-3 max-h-96 overflow-y-auto pl-2 scroll-body scroll-on-paper"
        role="region"
        tabindex="0"
        aria-label="Bill history timeline"
      >
      <ol class="border-l-2 border-navy-100 pl-4">
        {actions.map((a) => (
          <li class="relative mb-3">
            <span class="absolute -left-[1.4rem] top-1.5 h-2.5 w-2.5 rounded-full bg-navy-600"></span>
            <span class="text-xs font-semibold text-navy-600">
              {fmtDate(a.date)} · {chamberName(a.chamber)}
            </span>
            <p class="text-sm" set:html={linkifyAction(a.description, bill.session_id)} />
          </li>
        ))}
      </ol>
      </div>
    </section>
  </article>
</Base>
