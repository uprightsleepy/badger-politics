---
import Base from "../../../layouts/Base.astro";
import FollowButton from "../../../components/FollowButton.astro";
import RollCall from "../../../components/RollCall.astro";
import Route from "../../../components/Route.astro";
import PlainText from "../../../components/PlainText.astro";
import TermsOnPage from "../../../components/TermsOnPage.astro";
import TermPopovers from "../../../components/TermPopovers.astro";
import { companionsFor,
  builtSessions,
  billsFor,
  actionsFor,
  sponsorsFor,
  votesFor,
  documentsFor,
  subjectsForBill,
  personIdByName,
  vetoMessageUrl,
  meta,
} from "../../../lib/db";
import {
  billSlug, clip, fmtDate, lrbParagraphs, personSlug, chamberName, sessionYear, shortTitle,
  subjectDisplay, subjectSlug, STATUS_LABELS, identifierLong, sessionPlainName, partyWord, partyPlural,
} from "../../../lib/format";
import { tellStory, plainHistory, sessionClosed } from "../../../lib/billStory";
import type { TermId } from "../../../lib/glossary";
import JsonLd from "../../../components/JsonLd.astro";
import { linkifyAction } from "../../../lib/actionLinks";
import { LEGISCAN_LICENSE_URL, isLegiscan, legiscanBillUrl } from "../../../lib/legiscan";

export function getStaticPaths() {
  return builtSessions().flatMap((session) =>
    billsFor(session.id).map((b) => ({
      params: { session: session.id, slug: billSlug(b.identifier) },
      props: { bill: b, sessionName: session.name ?? session.id },
    })),
  );
}

const { bill, sessionName } = Astro.props;
const companions = companionsFor(bill.id);
const actions = actionsFor(bill.id);
const sponsors = sponsorsFor(bill.id);
const votes = votesFor(bill.id);
const primary = sponsors.filter((s) => s.is_primary);
const cosponsors = sponsors.filter((s) => !s.is_primary);
const chairId = personIdByName(bill.committee_chair_at_death);
const fiscalEstimates = documentsFor(bill.id).filter((d) =>
  d.note.toLowerCase().includes("fiscal estimate"),
);
const subjects = subjectsForBill(bill.id);
// "AB 12: Fiscal Estimate From DOA" -> "Fiscal Estimate From DOA"
const fiscalLabel = (note: string) => note.replace(/^[A-Z]+\s*\d+:\s*/, "");

const vetoMsg = bill.status === "vetoed" || bill.status === "enacted"
  ? vetoMessageUrl(bill.id) : null;
const isBill = bill.classification === "bill";

// The story is judged as of the snapshot, not the build clock, so the same
// data always tells the same story.
const asOf = (meta().imported_at ?? new Date().toISOString()).slice(0, 10);
const story = tellStory(bill, actions, asOf);
const history = plainHistory(bill, actions);
const p = story.progress;
// a one-house resolution that passed its chamber is adopted
const status = story.status;

// "AB 656 (2025)" alone tells a searcher nothing; almost nobody searches a
// bill number. Lead with the identifier for those who do, then the subject
// for everyone else. The year disambiguates a number that recurs each
// biennium.
const subject = shortTitle(bill.title);
const plainSubject = subject.replace(/\.\s*$/, "") || identifierLong(bill.identifier);
const seoTitle = subject
  ? `${bill.identifier} (${sessionYear(bill.session_id)}): ${clip(subject, 40)}`
  : `${bill.identifier} (${sessionName})`;
// status and session make the near-identical housekeeping bills distinct
const seoDescription = [
  `${sessionName}.`,
  `${STATUS_LABELS[status] ?? "Introduced"}.`,
  subject,
]
  .filter(Boolean)
  .join(" ");
const passedChamberName = bill.chamber === "upper" ? "Senate" : "Assembly";

// ---- what the summary heading says depends on how it ended ----
const lrb = bill.lrb_analysis ? lrbParagraphs(bill.lrb_analysis).slice(0, 40) : [];
const summaryHeading =
  status === "enacted" || status === "adopted"
    ? "What it does"
    : story.stopped || status === "vetoed"
      ? "What it would have done"
      : "What it would do";

// ---- who's behind it ----
const fullName = (s: (typeof sponsors)[number]) => s.full_name ?? s.name;
const authorNoun = (() => {
  const chambers = new Set(primary.map((s) => s.chamber));
  if (chambers.size === 1 && chambers.has("lower")) return "representatives";
  if (chambers.size === 1 && chambers.has("upper")) return "senators";
  return "lawmakers";
})();
const partyLine = (() => {
  const counts = new Map<string, number>();
  let unknown = 0;
  for (const s of primary) {
    if (s.party) counts.set(s.party, (counts.get(s.party) ?? 0) + 1);
    else unknown++;
  }
  const sorted = [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
  const parts: string[] = [];
  if (sorted.length === 1 && unknown === 0) {
    parts.push(`All ${primary.length} are ${partyPlural(sorted[0][0])}.`);
  } else if (sorted.length) {
    const phrases = sorted.map(([party, n]) =>
      n === 1 ? `1 is a ${partyWord(party)}` : `${n} are ${partyPlural(party)}`,
    );
    parts.push(`${phrases.slice(0, -1).join(", ")}${phrases.length > 1 ? " and " : ""}${phrases.at(-1)}.`);
  }
  if (unknown) parts.push(`${unknown} ${unknown === 1 ? "has" : "have"} no party on record.`);
  return parts.join(" ");
})();
const introLine = actions[0]?.description ?? "";
const committeeIntro = /^Introduced by (?:the )?((?:Joint |Senate |Assembly )?Committee on [^,;]+)/i.exec(introLine);
const whoLines: string[] = [];
if (primary.length === 1) {
  const a = primary[0];
  whoLines.push(`${fullName(a)}${a.party ? `, a ${partyWord(a.party)},` : ""} is its [[author|author]].`);
} else if (primary.length > 1) {
  whoLines.push(`${primary.length} ${authorNoun} are its [[author|authors]]. ${partyLine}`);
} else if (committeeIntro) {
  whoLines.push(
    `The ${committeeIntro[1].replace(/^committee/i, "Committee")} introduced it${/request of (?:the )?governor/i.test(introLine) ? " at the governor's request" : ""}.`,
  );
} else {
  whoLines.push(isLegiscan(bill) ? "The record doesn't name its authors." : "The official record doesn't name its authors.");
}
if (cosponsors.length) {
  whoLines.push(
    `${cosponsors.length} more ${cosponsors.length === 1 ? "lawmaker" : "lawmakers"} [[cosponsor|signed on in support]].`,
  );
}
const sponsorLabel = (s: (typeof sponsors)[number]) =>
  [s.party ? partyWord(s.party) : null, s.chamber ? chamberName(s.chamber) : null].filter(Boolean).join(", ");

// ---- the companion bill, in one sentence ----
// what happened to the companion, judged on its own record
const companionFate = (c: (typeof companions)[number]): string => {
  const over = sessionClosed(c.session_id, asOf);
  switch (c.status) {
    case "enacted": return "That version became law.";
    case "vetoed": return "That version was vetoed.";
    case "passed": return "That version passed both chambers.";
    case "passed_chamber": return over ? "That version passed one chamber, then stopped." : "That version has passed one chamber.";
    case "failed_sjr1": return "That version died when the session ended.";
    case "adopted": return "That version was adopted.";
    default: return over ? "That version stopped in committee." : "That version is in committee.";
  }
};

// ---- the fine print under the status ----
const lastAction = actions.at(-1);
const officialLatest = bill.latest_action_desc ?? lastAction?.description ?? null;
const officialDate = bill.latest_action_date ?? lastAction?.date ?? null;
const officialMarked = officialLatest
  ? officialLatest.replace(/Senate Joint Resolution 1\b/, "[[sjr1|Senate Joint Resolution 1]]")
  : null;
const inCommittee = story.stops.find((s) => s.state === "here")?.key === "committee";
// the importer's record of where a bill died unheard; it may be the second
// chamber's committee, so it carries its own chamber
const deathCommittee = bill.committee_at_death
  ? /^joint/i.test(bill.committee_at_death)
    ? bill.committee_at_death
    : `${chamberName(bill.committee_chamber_at_death ?? bill.chamber)} Committee on ${bill.committee_at_death}`
  : null;

// ---- terms this page uses, in the order a reader meets them ----
const terms: TermId[] = [...story.terms];
if (officialMarked?.includes("[[sjr1|")) terms.push("sjr1");
if (lrb.length) terms.push("lrb");
if (primary.length) terms.push("author");
if (cosponsors.length) terms.push("cosponsor");
if (fiscalEstimates.length) terms.push("fiscal-estimate");
if (votes.length) terms.push("roll-call");
const usedTerms = [...new Set(terms)];
const hasSuspension = votes.some((v) => /suspend/i.test(v.motion ?? ""));
const pulledOn = meta().imported_at?.slice(0, 10);
// a bill whose record came from LegiScan says so wherever it quotes that
// record, and credits it at the foot (lib/legiscan)
const fromLegiscan = isLegiscan(bill);
const legiscanUrl = legiscanBillUrl(bill.session_id, bill.identifier);
const record = fromLegiscan ? "LegiScan's copy of the record" : "the official record";
---

<Base
  title={seoTitle}
  description={seoDescription}
  layout="wide"
  filters={{
    type: isBill ? "Bill" : "Resolution",
    session: sessionName,
    outcome: STATUS_LABELS[status] ?? "Introduced",
    chamber: passedChamberName,
  }}
  breadcrumbs={[
    { name: "Bills", url: "/bills/" },
    { name: sessionName, url: `/bills/${bill.session_id}/` },
  ]}
>
  <JsonLd
    data={{
      "@type": "Legislation",
      name: `${bill.identifier}: ${subject}`,
      legislationIdentifier: bill.identifier,
      legislationType: bill.classification ?? "bill",
      legislationJurisdiction: "Wisconsin, United States",
      legislationLegislatedBy: {
        "@type": "GovernmentOrganization",
        name: "Wisconsin State Legislature",
      },
      ...(bill.status === "enacted" ? { legislationPassedBy: {
        "@type": "GovernmentOrganization",
        name: "Wisconsin State Legislature",
      } } : {}),
      inLanguage: "en-US",
      isBasedOn: bill.text_url ?? undefined,
      about: subjects.map((s) => subjectDisplay(s.subject)),
      description: seoDescription,
    }}
  />
  {/* search results lead with the bill number, then what it is about */}
  <meta data-pagefind-meta="title[content]" content={`${bill.identifier}: ${clip(plainSubject, 100)}`} />

  <article class="bill">
    <header class="b-head flex max-w-[47.5rem] flex-col gap-2.5">
      <a href={`/bills/${bill.session_id}/`} class="self-start text-small underline">
        Bills from the {sessionPlainName(bill.session_id, sessionName)}
      </a>
      <p class="t-label text-granite">
        {identifierLong(bill.identifier)}
      </p>
      <h1 class="t-display">{plainSubject}</h1>
      {subjects.length > 0 && (
        <p class="text-small text-granite" data-pagefind-ignore>
          Topics:{" "}
          {subjects.map((s, i) => (
            <>{i > 0 && ", "}<a href={`/subjects/${subjectSlug(s.subject)}/`} class="underline">{subjectDisplay(s.subject)}</a></>
          ))}
        </p>
      )}
    </header>

    <section class="b-status sheet flex flex-col gap-6 p-5 sm:px-8 sm:py-7" aria-labelledby="status-heading">
      <div class="flex max-w-[42.5rem] flex-col gap-2">
        <h2 id="status-heading" class="t-status">{story.headline}</h2>
        <p class="sm:text-lead"><PlainText text={story.body.join(" ")} /></p>
      </div>
      <Route stops={story.stops} stopped={story.stopped} label={`How far this ${isBill ? "bill" : "proposal"} got`} />
      <div class="flex flex-col gap-1.5 border-t border-rule pt-3.5 text-fine text-granite">
        {officialMarked && (
          <p>
            Latest entry in {record}{officialDate && `, ${fmtDate(officialDate)}`}: <PlainText text={`“${officialMarked}”`} />
          </p>
        )}
        {bill.died_without_hearing === 1 && deathCommittee ? (
          <p>
            It never got a hearing in the {deathCommittee}.
            {bill.committee_chair_at_death && (
              <>
                {" "}The committee's chair at the time was{" "}
                {chairId ? (
                  <a href={`/legislators/${personSlug(chairId)}/`} class="underline">{bill.committee_chair_at_death}</a>
                ) : (
                  bill.committee_chair_at_death
                )}. Chairs decide which bills get a hearing.
              </>
            )}
            {" "}<a href={`/hearing-none/${bill.session_id}/`} class="underline">See every bill that never got a hearing this session</a>.
          </p>
        ) : inCommittee && story.stopped && p.committee && (
          <p>It sat with the {p.committee}.</p>
        )}
        {(status === "vetoed" || p.partialVeto) && (
          <p>
            {vetoMsg && <><a href={vetoMsg} class="underline">Read the governor's veto message</a>{" · "}</>}
            <a href={status === "vetoed" ? "/vetoes/" : "/partial-veto/"} class="underline">
              {status === "vetoed" ? "All vetoes this session" : "How the partial veto works"}
            </a>
          </p>
        )}
      </div>
    </section>

    <div class="rail">
      <div class="b-actions flex flex-col gap-6" data-pagefind-ignore>
        <div
          data-sponsor-note
          data-authors={primary.length}
          hidden
          class="flex flex-col gap-1.5 rounded-2xl bg-prairie-tint px-5 py-4"
        >
          <p class="t-question" data-sponsor-note-title></p>
          <p class="text-body" data-sponsor-note-text></p>
        </div>
        <div class="flex flex-col gap-2.5">
          {/* following reads the JSON API and feeds, which never carry
              LegiScan's records (lib/legiscan) */}
          {!fromLegiscan && (
            <FollowButton kind="bills" id={bill.id} label={`Follow this ${isBill ? "bill" : "proposal"}`} variant="primary" />
          )}
          {bill.text_url && (
            <a href={bill.text_url} class="btn btn-secondary w-full">Read the {isBill ? "bill" : "proposal"}</a>
          )}
          {!fromLegiscan && (
            <p class="text-small text-granite">
              Following saves it on this device. New actions show on your <a href="/following/" class="underline">Following page</a>.
              You can also <a href={`/feeds/bills/${bill.id}.xml`} class="underline">get updates in a feed reader</a>.
            </p>
          )}
        </div>
        {companions.length > 0 && (
          <p class="border-t border-rule pt-4">
            {companions.map((c, i) => (
              <>
                {i > 0 && " "}
                The same {isBill ? "bill" : "proposal"} was also filed in the {c.identifier.startsWith("S") ? "Senate" : "Assembly"} as{" "}
                <a href={`/bills/${c.session_id}/${billSlug(c.identifier)}/`} class="underline">{c.identifier}</a>.{" "}
                {companionFate(c)}
              </>
            ))}
          </p>
        )}
      </div>
      <div class="hidden lg:block">
        <TermsOnPage terms={usedTerms} headingId="terms-heading-rail" />
      </div>
    </div>

    <div class="b-body flex flex-col gap-9">
      {lrb.length > 0 && (
        <section class="flex max-w-[45rem] flex-col gap-3" aria-labelledby="summary">
          <h2 id="summary" class="t-section scroll-mt-4">{summaryHeading}</h2>
          <p class="text-small text-granite">
            Summary by the <PlainText text="[[lrb|Legislative Reference Bureau]]" />, the Legislature's nonpartisan drafting office. It's their wording, not ours.
          </p>
          {lrb.slice(0, 2).map((para) => <p>{para}</p>)}
          {lrb.length > 2 && (
            <details class="group flex flex-col">
              <summary class="inline-flex min-h-11 cursor-pointer list-none items-center font-display font-bold text-lake underline underline-offset-4 [&::-webkit-details-marker]:hidden">
                <span class="group-open:hidden">Read the full summary</span>
                <span class="hidden group-open:inline">Show less</span>
              </summary>
              <div class="mt-1 flex flex-col gap-3">
                {lrb.slice(2).map((para) => <p>{para}</p>)}
              </div>
            </details>
          )}
        </section>
      )}

      <section class="flex max-w-[45rem] flex-col gap-3" aria-labelledby="sponsors">
        <h2 id="sponsors" class="t-section scroll-mt-4">Who's behind it</h2>
        {whoLines.map((line) => <p><PlainText text={line} /></p>)}
        {sponsors.length > 0 && (
          <details class="group" data-pagefind-ignore>
            <summary class="inline-flex min-h-11 cursor-pointer list-none items-center font-display font-bold text-lake underline underline-offset-4 [&::-webkit-details-marker]:hidden">
              <span class="group-open:hidden">See all {sponsors.length === 1 ? "the details" : `${sponsors.length} names`}</span>
              <span class="hidden group-open:inline">Hide the names</span>
            </summary>
            <div class="mt-2 grid gap-6 sm:grid-cols-2">
              {[
                { title: primary.length === 1 ? "Author" : "Authors", rows: primary, role: "author" },
                { title: "Signed on in support", rows: cosponsors, role: "supporter" },
              ].filter((g) => g.rows.length).map((g) => (
                <div>
                  <h3 class="t-label mb-1">{g.title} <span class="font-semibold text-granite">({g.rows.length})</span></h3>
                  <ul class="text-small" data-sponsor-list>
                    {g.rows.map((s) => (
                      <li
                        class="py-1"
                        data-sponsor-slug={s.person_id ? personSlug(s.person_id) : undefined}
                        data-sponsor-role={g.role}
                        data-sponsor-name={fullName(s)}
                      >
                        {s.person_id ? (
                          <a href={`/legislators/${personSlug(s.person_id)}/`} class="underline">{fullName(s)}</a>
                        ) : (
                          fullName(s)
                        )}
                        {sponsorLabel(s) && <span class="text-granite"> · {sponsorLabel(s)}</span>}
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </details>
        )}
      </section>

      {fiscalEstimates.length > 0 && (
        <section class="flex max-w-[45rem] flex-col gap-2" aria-labelledby="cost">
          <h2 id="cost" class="t-section scroll-mt-4">What it would cost</h2>
          <p>
            State agencies filed a <PlainText text="[[fiscal-estimate|cost estimate]]" />. Each opens as a PDF from the Legislature.
          </p>
          <ul class="flex flex-col">
            {fiscalEstimates.map((d) => (
              <li>
                <a href={d.url} class="inline-flex min-h-11 items-center underline">{fiscalLabel(d.note)}</a>
              </li>
            ))}
          </ul>
        </section>
      )}

      {votes.length > 0 && (
        <section class="flex max-w-[47.5rem] flex-col" aria-labelledby="votes" data-pagefind-ignore>
          <h2 id="votes" class="t-section mb-2 scroll-mt-4">How lawmakers voted</h2>
          <p class="mb-3">
            {votes.length === 1 ? "There was one" : `There were ${votes.length}`} <PlainText text="[[roll-call|roll call]]" /> {votes.length === 1 ? "vote" : "votes"} on this {isBill ? "bill" : "proposal"}.
            {hasSuspension && (
              <> Taking a bill up right away needs two-thirds of the members, a higher bar than passing it, so that vote can draw more yeses than the final one.</>
            )}
          </p>
          {votes.map((event) => <RollCall event={event} />)}
        </section>
      )}

      <section class="flex max-w-[47.5rem] flex-col" aria-labelledby="history" data-pagefind-ignore>
        <h2 id="history" class="t-section mb-2 scroll-mt-4">What happened</h2>
        <ol class="flex flex-col">
          {history.map((e) => (
            <li class="grid gap-0.5 border-t border-rule py-3.5 sm:grid-cols-[13.75rem_minmax(0,1fr)] sm:gap-4">
              <p class="font-display text-[0.875rem] font-semibold tabular-nums text-granite sm:text-[0.9375rem] sm:leading-normal">{e.when}</p>
              <p>{e.official ? <>“{e.text}” <span class="text-small text-granite">(the official wording)</span></> : e.text}</p>
            </li>
          ))}
        </ol>
        <details class="group border-t border-rule pt-3.5">
          <summary class="inline-flex min-h-11 cursor-pointer list-none items-center font-display font-bold text-lake underline underline-offset-4 [&::-webkit-details-marker]:hidden">
            <span class="group-open:hidden">See {record}, word for word</span>
            <span class="hidden group-open:inline">Hide {record}</span>
          </summary>
          <div
            class="mt-3 max-h-96 overflow-y-auto pl-2 scroll-body scroll-on-paper"
            role="region"
            tabindex="0"
            aria-label="Official bill history"
          >
            <ol class="border-l-2 border-rule pl-4">
              {actions.map((a) => (
                <li class="relative mb-3">
                  <span class="absolute -left-[1.4rem] top-1.5 h-2.5 w-2.5 rounded-full bg-granite"></span>
                  <span class="text-fine font-semibold text-granite">
                    {fmtDate(a.date)} · {chamberName(a.chamber)}
                  </span>
                  <p class="text-small" set:html={linkifyAction(a.description, bill.session_id)} />
                </li>
              ))}
            </ol>
          </div>
        </details>
      </section>

      <div class="lg:hidden">
        <TermsOnPage terms={usedTerms} />
      </div>

      {fromLegiscan ? (
        <p class="text-fine text-granite">
          This bill's record comes from <a href={legiscanUrl} class="underline">LegiScan</a>, used under the
          {" "}<a href={LEGISCAN_LICENSE_URL} class="underline">Creative Commons Attribution 4.0 license</a>{pulledOn && `, checked ${fmtDate(pulledOn)}`}.
          We retell its history in plain words; the record itself is above, word for word.{" "}
          <a href={legiscanUrl} class="underline">See this bill on LegiScan</a>
        </p>
      ) : (
        <p class="text-fine text-granite">
          From the Wisconsin Legislature's official record{pulledOn && `, checked ${fmtDate(pulledOn)}`}.{" "}
          <a href={bill.text_url ?? "https://docs.legis.wisconsin.gov"} class="underline">See the source</a>
        </p>
      )}
    </div>
    <TermPopovers terms={usedTerms} />
  </article>
</Base>

<style>
  /* One column in reading order on phones. From 1024px the rail (actions,
     then terms) sits beside the whole page; the terms list is rendered in
     the rail there and after the body on phones, so tab order always
     follows what's on screen. */
  .bill {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  @media (min-width: 64rem) {
    .bill {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(18.75rem, 22.5rem);
      grid-template-rows: auto auto 1fr;
      grid-template-areas:
        "head rail"
        "status rail"
        "body rail";
      column-gap: 3rem;
      row-gap: 2.25rem;
    }
    .rail {
      grid-area: rail;
      display: flex;
      flex-direction: column;
      gap: 2rem;
      align-self: start;
    }
    .b-head { grid-area: head; }
    .b-status { grid-area: status; }
    .b-body { grid-area: body; }
  }
</style>
