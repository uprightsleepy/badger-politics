---
/** One status within a session: "bills that became law in 2025-26", and
 * so on. These are the pages the filter chips used to produce only in the
 * browser: same view, but a real URL that can be shared, linked and
 * crawled. A rest param keeps page 1 at the bare path. */
import Base from "../../../../../layouts/Base.astro";
import BillList from "../../../../../components/BillList.astro";
import BillViews from "../../../../../components/BillViews.astro";
import Pager from "../../../../../components/Pager.astro";
import { builtSessions, billsFor } from "../../../../../lib/db";
import { STATUS_PLAIN, sessionPlainName } from "../../../../../lib/format";
import { sessionCounts } from "../../../../../lib/billRows";
import { PER_PAGE, pageBounds, pageCount } from "../../../../../lib/paging";

export function getStaticPaths() {
  return builtSessions().flatMap((session) => {
    const byStatus = new Map<string, number>();
    for (const b of billsFor(session.id)) {
      const key = b.status ?? "introduced";
      byStatus.set(key, (byStatus.get(key) ?? 0) + 1);
    }
    return [...byStatus].flatMap(([status, total]) => {
      const pages = pageCount(total);
      return Array.from({ length: pages }, (_, i) => ({
        params: {
          session: session.id,
          status,
          page: i === 0 ? undefined : String(i + 1),
        },
        props: { session, status, page: i + 1, pages, total },
      }));
    });
  });
}

const { session, status, page, pages, total } = Astro.props;
const bills = billsFor(session.id)
  .filter((b) => (b.status ?? "introduced") === status)
  .slice((page - 1) * PER_PAGE, page * PER_PAGE);

const name = session.name ?? session.id;
const plain = sessionPlainName(session.id, name);
const label = STATUS_PLAIN[status] ?? status;
const base = `/bills/${session.id}/status/${status}/`;
const { first, last } = pageBounds(page, total);
const all = sessionCounts(session.id).total;

// what the stored status means, in a sentence; the route on each row says
// exactly where that bill stopped
const MEANS: Record<string, string> = {
  introduced: "Introduced, with no committee recorded yet.",
  in_committee: "Sent to a committee, and not passed by either chamber.",
  passed_chamber:
    "Passed one chamber but not the other. A resolution only one chamber votes on is adopted by that vote.",
  passed: "Passed both chambers, with no decision by the governor recorded yet.",
  enacted: "Passed both chambers and became law.",
  vetoed: "Passed both chambers, then vetoed by the governor.",
  adopted: "Resolutions adopted by both chambers. Resolutions don't go to the governor.",
  failed_sjr1: "Not finished when the session's last voting day passed, so stopped there.",
};
const n = (x: number) => x.toLocaleString();
---

<Base
  title={`${label} · ${plain}${page > 1 ? ` · page ${page}` : ""}`}
  description={`The ${n(total)} bills and resolutions of the ${name} with the status "${label}", from each bill's official history.`}
  breadcrumbs={[
    { name: "Bills", url: "/bills/" },
    { name, url: `/bills/${session.id}/` },
  ]}
  layout="wide"
>
  {/* search results name the session: the heading alone doesn't */}
  <meta data-pagefind-meta="title[content]" content={`${label} · ${plain}`} />
  <header class="flex max-w-[47.5rem] flex-col gap-2.5">
    <a href={`/bills/${session.id}/`} class="self-start text-small underline">All bills in the {plain}</a>
    <p class="t-label text-granite">{plain[0].toUpperCase() + plain.slice(1)}</p>
    <h1 class="t-display">{label}</h1>
    <p class="sm:text-lead">
      {n(total)} of the session's {n(all)} {all === 1 ? "bill or resolution" : "bills and resolutions"}.
      {" "}{MEANS[status] ?? ""}
    </p>
    {pages > 1 && (
      <p class="text-small text-granite">
        Page {page} of {pages}: {n(first)} to {n(last)}.
      </p>
    )}
  </header>

  <div class="mt-7">
    <BillViews sessionId={session.id} current={status} firstPage={page === 1} />
  </div>

  <BillList bills={bills} class="mt-6" />

  <Pager
    page={page}
    pages={pages}
    href={(p) => (p === 1 ? base : `${base}${p}/`)}
    label="Pages of this list"
  />
</Base>
