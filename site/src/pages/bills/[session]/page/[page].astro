---
/** Pages 2..N of a session's bills. Self-canonical: these hold different
 * bills from page 1, so canonicalising them away would tell search engines
 * those bills do not exist. */
import Base from "../../../../layouts/Base.astro";
import BillList from "../../../../components/BillList.astro";
import BillViews from "../../../../components/BillViews.astro";
import Pager from "../../../../components/Pager.astro";
import { builtSessions, billsFor } from "../../../../lib/db";
import { sessionPlainName } from "../../../../lib/format";
import { PER_PAGE, pageBounds, pageCount } from "../../../../lib/paging";

export function getStaticPaths() {
  return builtSessions().flatMap((session) => {
    const pages = pageCount(billsFor(session.id).length);
    // page 1 is the session index itself
    return Array.from({ length: Math.max(0, pages - 1) }, (_, i) => ({
      params: { session: session.id, page: String(i + 2) },
      props: { session, page: i + 2, pages },
    }));
  });
}

const { session, page, pages } = Astro.props;
const all = billsFor(session.id);
const bills = all.slice((page - 1) * PER_PAGE, page * PER_PAGE);
const { first, last } = pageBounds(page, all.length);
const name = session.name ?? session.id;
const plain = sessionPlainName(session.id, name);
---

<Base
  title={`Bills in the ${plain}, page ${page}`}
  description={`Bills ${first.toLocaleString()}–${last.toLocaleString()} of ${all.length.toLocaleString()} in the ${name}: where each one stands and its latest action, from the official record.`}
  breadcrumbs={[
    { name: "Bills", url: "/bills/" },
    { name, url: `/bills/${session.id}/` },
  ]}
  layout="wide"
>
  <header class="flex max-w-[47.5rem] flex-col gap-2.5">
    <a href="/bills/" class="self-start text-small underline">All sessions</a>
    <h1 class="t-display">Bills in the {plain}</h1>
    <p class="sm:text-lead">
      Page {page} of {pages}: bills {first.toLocaleString()} to {last.toLocaleString()} of
      {" "}{all.length.toLocaleString()}.
    </p>
  </header>

  <div class="mt-7">
    <BillViews sessionId={session.id} current="all" firstPage={false} />
  </div>

  <BillList bills={bills} class="mt-6" />

  <Pager
    page={page}
    pages={pages}
    href={(n) => (n === 1 ? `/bills/${session.id}/` : `/bills/${session.id}/page/${n}/`)}
    label="Bill list pages"
  />
</Base>
