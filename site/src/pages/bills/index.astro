---
import Base from "../../layouts/Base.astro";
import { allSessions, builtSessions, sessionStats } from "../../lib/db";
import { sessionPlainName } from "../../lib/format";
import { leadSentence } from "../../lib/billRows";
const built = new Set(builtSessions().map((s) => s.id));
const sessions = allSessions();
---

<Base
  description="Every bill and resolution before the Wisconsin Legislature, by session: where each one stands, who wrote it, and how lawmakers voted, from the official record."
  title="All bills"
  layout="wide"
>
  <header class="flex max-w-[47.5rem] flex-col gap-2.5">
    <h1 class="t-display">All bills</h1>
    <p class="sm:text-lead">
      Every bill and resolution introduced in the Wisconsin Legislature, by two-year session. Pick a
      session to see where each one stands.
    </p>
  </header>

  <ul class="mt-8 max-w-[47.5rem] border-y border-rule" role="list">
    {sessions.map((s, i) => {
      const stats = sessionStats(s.id);
      const plain = sessionPlainName(s.id, s.name ?? s.id);
      const heading = plain[0].toUpperCase() + plain.slice(1);
      return (
        <li class:list={["flex flex-col gap-1 py-5", i > 0 && "border-t border-rule"]}>
          <h2 class="t-question text-[1.1875rem]">
            {built.has(s.id) ? (
              <a href={`/bills/${s.id}/`} class="underline">{heading}</a>
            ) : (
              heading
            )}
          </h2>
          <p>
            {leadSentence({
              total: stats.bills,
              enacted: stats.enacted ?? 0,
              vetoed: stats.vetoed ?? 0,
              noHearing: stats.graveyard ?? 0,
            })}
          </p>
          {s.data_quality === "partial" && (
            <p class="text-small text-granite">
              Partial records: individual roll call votes aren't available for this session.
            </p>
          )}
          {!built.has(s.id) && (
            <p class="text-small text-granite">Pages for this session come with the full history build.</p>
          )}
        </li>
      );
    })}
  </ul>
</Base>
