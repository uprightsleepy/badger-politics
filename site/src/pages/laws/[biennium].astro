---
import Base from "../../layouts/Base.astro";
import FilterBar from "../../components/FilterBar.astro";
import BillLine from "../../components/BillLine.astro";
import { lawBienniums, lawsFor, meta } from "../../lib/db";
import { billSlug, chamberName, fmtDate } from "../../lib/format";

export function getStaticPaths() {
  return lawBienniums().map(({ biennium }) => ({
    params: { biennium: String(biennium) },
  }));
}
const biennium = Number(Astro.params.biennium);
const laws = lawsFor(biennium);
const partials = laws.filter((l) => l.partial).length;
const pulledOn = meta().imported_at?.slice(0, 10);
---

<Base
  title={`New laws, ${biennium}–${biennium + 1}`}
  breadcrumbs={[{ name: "New laws", url: "/laws/" }]}
  description={`All ${laws.length} Wisconsin Acts of the ${biennium}–${biennium + 1} legislative session.`}
  layout="wide"
>
  <header class="flex max-w-[47.5rem] flex-col gap-2.5">
    <a href="/laws/" class="self-start text-small underline">New laws</a>
    <h1 class="t-display">New laws, {biennium}–{biennium + 1}</h1>
    <p class="sm:text-lead">
      {laws.length.toLocaleString()} {laws.length === 1 ? "bill became a Wisconsin Act" : "bills became Wisconsin Acts"} this
      session{partials > 0 && `, ${partials.toLocaleString()} of them signed with a`}{partials > 0 && <> <a href="/partial-veto/" class="underline">partial veto</a></>}.
    </p>
    <p class="text-small text-granite">
      The final votes are each chamber's last recorded passage roll call. A chamber without one passed the
      bill without a roll call. Special sessions share the session's act numbers, so their acts are here too.
    </p>
  </header>

  <div class="mt-4 max-w-[47.5rem]">
    <FilterBar
      wide
      id="law-filter"
      statusId="law-filter-status"
      label="Find a law"
      placeholder="An act or bill number, or words from the title"
    />
  </div>
  <ol class="mt-3 max-w-[60rem] border-b border-rule" role="list">
    {laws.map((law) => (
      <BillLine
        data-law-row
        data-text={`act ${law.act} ${law.identifier} ${law.title ?? ""}`.toLowerCase()}
        class="law-row"
        href={`/bills/${law.session_id}/${billSlug(law.identifier)}/`}
        identifier={law.identifier}
        title={law.title}
        lead={`Act ${law.act}`}
        date={law.approved ? fmtDate(law.approved) : ""}
      >
        {law.partial ? "Signed with a partial veto." : "Signed."}
        {law.votes.length > 0 ? (
          <> Final votes: {law.votes.map((v, i) => (
            <>{i > 0 && " and "}<a href={`/votes/${v.id}/`} class="underline">{chamberName(v.chamber)}, {v.yes} to {v.no}</a></>
          ))}.</>
        ) : " Neither chamber recorded a roll call."}
      </BillLine>
    ))}
  </ol>
  <p id="law-no-match" class="mt-4 hidden text-granite"></p>

  <p class="mt-10 max-w-[47.5rem] text-fine text-granite">
    Act numbers and signing dates come word for word from each bill's history at the
    {" "}<a href="https://docs.legis.wisconsin.gov" class="underline">Wisconsin Legislature</a>{pulledOn && `, checked ${fmtDate(pulledOn)}`}.
  </p>

  <script>
    import { initRowFilter } from "../../scripts/rowFilter";
    initRowFilter({
      input: "law-filter",
      rows: "[data-law-row]",
      status: "law-filter-status",
      noMatch: "law-no-match",
      noun: "laws",
    });
  </script>
</Base>

<style>
  :global(.law-row.sorted-hidden) {
    display: none;
  }
</style>
