---
import Base from "../../layouts/Base.astro";
import LocalCoverageNotice from "../../components/LocalCoverageNotice.astro";
import { localBodies, localTenantStats } from "../../lib/db";
import { fmtDate } from "../../lib/format";

const bodies = localBodies();
const stats = new Map(bodies.map((b) => [b.tenant, localTenantStats(b.tenant)]));
const plural = (n: number, one: string, many: string) => `${n.toLocaleString()} ${n === 1 ? one : many}`;
---

<Base
  title="City councils"
  description="Wisconsin city council members' recorded votes, from each city's own legislative records."
  filters={{ type: "City Council" }}
  layout="wide"
>
  <header class="flex max-w-[47.5rem] flex-col gap-2.5">
    <h1 class="t-display">City councils</h1>
    <p class="sm:text-lead">
      Zoning, licenses, budgets and police oversight are decided in council chambers, not at the Capitol.
      These pages carry each member's recorded votes from the cities we cover, straight from the city's own
      legislative system.
    </p>
  </header>

  <ul class="mt-8 max-w-[47.5rem] border-b border-rule" role="list">
    {bodies.map((b) => {
      const s = stats.get(b.tenant);
      return (
        <li class="flex flex-col gap-1.5 border-t border-rule py-4">
          <a href={`/local/${b.slug}/`} class="inline-flex min-h-11 items-center self-start font-display text-[1.375rem] font-bold underline">{b.name}</a>
          {s && s.votes > 0 && (
            <p>
              {plural(s.votes, "recorded vote", "recorded votes")} on {plural(s.actions, "item", "items")} at
              {" "}{plural(s.meetings, "meeting", "meetings")}, {fmtDate(s.first)} to {fmtDate(s.last)}.
            </p>
          )}
          <LocalCoverageNotice tenant={b.tenant} />
          <p class="text-small"><a href={b.insite_url} class="inline-flex min-h-11 items-center underline">The city's own records<span class="sr-only"> for {b.city}</span></a></p>
        </li>
      );
    })}
  </ul>

  <p class="mt-8 max-w-[47.5rem] text-small text-granite">
    {plural(bodies.length, "council is", "councils are")} covered so far. New cities are added in order of
    population once their access rules and records are checked. Other cities, villages, school boards and
    county boards publish their records on their own sites.
    {" "}<a href="/about/" class="underline">How this site works</a>
  </p>
</Base>
