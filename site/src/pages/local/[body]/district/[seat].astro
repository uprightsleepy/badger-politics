---
/** A council district and its verified members. */
import Base from "../../../../layouts/Base.astro";
import Portrait from "../../../../components/Portrait.astro";
import LocalProfileNotice from "../../../../components/LocalProfileNotice.astro";
import LocalDistrictMap from "../../../../components/LocalDistrictMap.astro";
import LocalCoverageNotice from "../../../../components/LocalCoverageNotice.astro";
import SHAPES from "../../../../data/local-district-shapes.json";
import { localBodies, localMembers } from "../../../../lib/db";

export function getStaticPaths() {
  return localBodies().flatMap((body) =>
    Array.from({ length: body.seats }, (_, i) => ({
      params: { body: body.slug, seat: String(i + 1) },
      props: { body, seat: i + 1 },
    })),
  );
}
const { body, seat } = Astro.props;
const holders = localMembers(body.tenant).filter((m) => m.is_current && m.seat === seat);
const name = `${body.city} Common Council District ${seat}`;
const hasBoundary = `${body.slug}-${seat}` in SHAPES;
const names = holders.map((m) => m.name);
const list = names.length < 2 ? names.join("") : `${names.slice(0, -1).join(", ")} and ${names.at(-1)}`;
---

<Base
  title={name}
  description={`${name}: its council members, from the city's own records.`}
  filters={{ type: "City Council", city: body.city }}
  breadcrumbs={[
    { name: "City councils", url: "/local/" },
    { name: body.name, url: `/local/${body.slug}/` },
  ]}
  layout="wide"
>
  <div class="ldist">
    <header class="l-head flex max-w-[47.5rem] flex-col gap-2.5">
      <a href={`/local/${body.slug}/`} class="self-start text-small underline">{body.name}</a>
      <h1 class="t-display">{name}</h1>
      <p class="sm:text-lead">
        {holders.length > 0 ? `Represented by ${list}. ` : "No sitting member is on record for this district. "}
        It's one of {body.city}'s {body.seats} council districts. Council seats are nonpartisan.
      </p>
      <LocalCoverageNotice tenant={body.tenant} />
    </header>

    <aside class="l-rail" data-pagefind-ignore>
      <LocalDistrictMap body={body.slug} seat={seat} label={`District ${seat}`} city={body.city} />
    </aside>

    <div class="l-body flex max-w-[47.5rem] flex-col gap-8">
      {holders.length > 0 && (
        <section aria-labelledby="members-heading">
          <h2 id="members-heading" class="t-section">{holders.length === 1 ? "Its member" : "Its members"}</h2>
          <ul class="mt-3 grid gap-4 sm:grid-cols-2" role="list">
            {holders.map((m) => (
              <li class="sheet flex items-center gap-4 p-5">
                <Portrait src={m.image_url} name={m.name} size={56} />
                <a href={`/local/${body.slug}/${m.slug}/`} class="min-w-0 font-display text-[1.1875rem] font-bold underline [overflow-wrap:anywhere]">{m.name}</a>
              </li>
            ))}
          </ul>
          <p class="mt-3 text-small text-granite">From the council's own office records.</p>
          <div class="mt-1"><LocalProfileNotice tenant={body.tenant} /></div>
        </section>
      )}

      {hasBoundary ? (
        <p>
          Not sure which district you live in? <a href="/my-reps/" class="underline">Look up your address</a>;
          the answer stays on your device.
        </p>
      ) : (
        <p class="text-granite">District boundaries and address lookup for {body.city} aren't available here yet.</p>
      )}

      <p class="text-fine text-granite">
        From the <a href={body.insite_url} class="underline">{body.name}'s own records</a>.
      </p>
    </div>
  </div>
</Base>

<style>
  .ldist {
    display: grid;
    gap: 2rem;
    grid-template-areas: "head" "rail" "body";
    grid-template-columns: minmax(0, 1fr);
  }
  .l-head { grid-area: head; }
  .l-rail { grid-area: rail; }
  .l-body { grid-area: body; }
  @media (min-width: 64rem) {
    .ldist {
      grid-template-areas: "head rail" "body rail";
      grid-template-columns: minmax(0, 1fr) 20rem;
      grid-template-rows: auto 1fr;
      column-gap: 3.5rem;
    }
    .l-rail {
      align-self: start;
    }
  }
</style>
