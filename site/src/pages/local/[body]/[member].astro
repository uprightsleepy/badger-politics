---
/** One council member's voting record. Bounded like the legislator
 * profiles: recent votes in a scroll panel, votes with dissent in full, and
 * the clerk's page linked from every row. */
import Base from "../../../layouts/Base.astro";
import SourceStrip from "../../../components/SourceStrip.astro";
import ScrollPanel from "../../../components/ScrollPanel.astro";
import Portrait from "../../../components/Portrait.astro";
import FollowButton from "../../../components/FollowButton.astro";
import JsonLd from "../../../components/JsonLd.astro";
import { localBodies, localMembers, localMemberVotes, localMemberVoteStats, localMemberVotesWithDissent, localMemberTerms, localMemberships, localMemberOutcomes, localMemberMotions, localMemberMotionCount, localMemberAttendance } from "../../../lib/db";
import { fmtDate } from "../../../lib/format";

const RECENT = 300;

export function getStaticPaths() {
  return localBodies().flatMap((body) =>
    localMembers(body.tenant)
      .filter((m) => m.is_current || m.vote_count > 0)
      .map((m) => ({ params: { body: body.slug, member: m.slug }, props: { body, member: m } })),
  );
}
const { body, member } = Astro.props;
const stats = localMemberVoteStats(body.tenant, member.person_id);
const votes = localMemberVotes(body.tenant, member.person_id, RECENT);
const dissentVotes = localMemberVotesWithDissent(body.tenant, member.person_id);
const terms = localMemberTerms(body.tenant, member.person_id);
const committees = member.is_current ? localMemberships(body.tenant, member.person_id) : [];
const outcomes = localMemberOutcomes(body.tenant, member.person_id);
const soleNoes = dissentVotes.filter((v) => v.value === "No" && v.noes === 1);
const motionCount = localMemberMotionCount(body.tenant, member.person_id);
const motions = motionCount > 0 ? localMemberMotions(body.tenant, member.person_id, RECENT) : [];
const attendance = localMemberAttendance(body.tenant, member.person_id);
// the seat is filled at the April spring election of the year the term ends
const termEnd = member.is_current
  ? terms.map((t) => t.end).filter((e): e is string => !!e).sort().at(-1) ?? null
  : null;
const springYear = termEnd && termEnd.slice(5, 7) === "04" ? termEnd.slice(0, 4) : null;
const pct = (n: number, d: number) => (d > 0 ? `${Math.round((n / d) * 100)}%` : "");
// a presiding officer is recorded as Non-Voting, not Present, so no rate for the Chair
const rated = member.member_type !== "Chair";
const followId = `${body.slug}/${member.slug}`;
const role = member.seat != null
  ? `${body.city} Common Council, District ${member.seat}`
  : member.member_type === "Chair"
    ? `Presides over the ${body.name}`
    : body.name;

const CAST_STYLE: Record<string, string> = {
  Aye: "bg-moss-50 text-moss-600",
  No: "bg-badger-50 text-badger-700",
};
const castStyle = (v: string) => CAST_STYLE[v] ?? "bg-navy-50 text-navy-600";
---

<Base
  title={`${member.name}, ${body.city}${member.seat != null ? ` District ${member.seat}` : ""}`}
  description={`${member.name}'s complete ${body.name} voting record from the city's own legislative system: ${stats.total.toLocaleString()} recorded votes.`}
  filters={{ type: "City Council", city: body.city }}
  breadcrumbs={[
    { name: "City Councils", url: "/local/" },
    { name: body.name, url: `/local/${body.slug}/` },
  ]}
>
  <JsonLd
    data={{
      "@type": "Person",
      name: member.name,
      alternateName: member.record_name && member.record_name !== member.name ? member.record_name : undefined,
      jobTitle: member.seat != null
        ? `Alderperson, District ${member.seat}`
        : member.member_type === "Chair" ? "Mayor" : "Council member",
      email: member.email ?? undefined,
      telephone: member.phone ?? undefined,
      image: member.image_url ?? undefined,
      memberOf: { "@type": "GovernmentOrganization", name: body.name },
    }}
  />
  <p class="text-sm text-navy-600">
    <a href={`/local/${body.slug}/`} class="underline">&larr; {body.name}</a>
  </p>
  <div class="mt-1 flex flex-wrap items-center gap-3">
    <h1 class="text-2xl font-bold">{member.name}</h1>
    <span class="ml-auto flex items-center gap-3" data-pagefind-ignore>
      <FollowButton kind="council" id={followId} />
      <a href={`/feeds/local/${followId}.xml`} class="text-xs underline">Atom feed</a>
    </span>
  </div>
  <p class="mt-1 text-sm text-navy-700">
    {member.is_current ? "" : "Former member, "}
    {member.seat != null ? (
      <>{body.city} Common Council, <a href={`/local/${body.slug}/district/${member.seat}/`} class="underline">District {member.seat}</a></>
    ) : role}
    <span class="text-xs text-navy-600"> &middot; nonpartisan office</span>
    {member.record_name && member.record_name !== member.name && (
      <span class="text-xs text-navy-600">
        {" "}&middot; listed as &ldquo;{member.record_name}&rdquo; in the council's records
      </span>
    )}
    {member.seat_basis && (
      <span class="text-xs text-navy-600">
        {" "}&middot; district per <a href={member.seat_basis} class="underline">the city's roster</a>
      </span>
    )}
  </p>
  <SourceStrip
    sources={[{ label: `${body.name} records (Legistar)`, href: body.insite_url }]}
    through={stats.last}
  />

  <div class="mt-4 flex flex-col gap-6 md:flex-row">
    <aside class="w-full shrink-0 md:w-64" aria-label={`About ${member.name}`}>
      <div class="rounded-lg border border-navy-100 bg-white p-4">
        <Portrait src={member.image_url} name={member.name} size={120} className="mb-3 rounded" />
        {member.image_basis && (
          <p class="text-xs text-navy-600">
            Official portrait from <a href={member.image_basis} class="underline">the city's page</a>.
          </p>
        )}
        {terms.length > 0 && (
          <div class="mt-3 rounded bg-navy-50 p-3 text-sm">
            <h2 class="font-bold">Service</h2>
            {terms.map((t) => (
              <p class="mt-1">
                {t.title ?? "Member"}: {fmtDate(t.start)} to {t.end ? fmtDate(t.end) : "present"}
              </p>
            ))}
            <p class="mt-1 text-xs text-navy-600">From the council's own office records.</p>
          </div>
        )}
        {termEnd && (
          <div class="mt-3 rounded bg-navy-50 p-3 text-sm">
            <h2 class="font-bold">{springYear ? `Up for reelection: spring ${springYear}` : "Current term"}</h2>
            <p class="mt-1">Term ends {fmtDate(termEnd)}.</p>
            <p class="mt-1 text-xs text-navy-600">
              Per the council's office records{springYear ? "; council seats are filled at the April spring election" : ""}.
            </p>
          </div>
        )}
        {member.is_current && (member.email || member.phone) && (
          <div class="mt-3 rounded bg-navy-50 p-3 text-sm">
            <h2 class="font-bold">Contact</h2>
            {member.email && (
              <p class="mt-1 break-all">
                <a href={`mailto:${member.email}`} class="underline">{member.email}</a>
              </p>
            )}
            {member.phone && (
              <p class="mt-1">
                <a href={`tel:${member.phone.replace(/\D/g, "")}`} class="underline">{member.phone}</a>
              </p>
            )}
            <p class="mt-1 text-xs text-navy-600">
              Official office contacts, from the council's records and the city's page for the district.
            </p>
          </div>
        )}
        {attendance.meetings > 0 && (
          <div class="mt-3 rounded bg-navy-50 p-3 text-sm">
            <h2 class="font-bold">Attendance</h2>
            <p class="mt-1">
              {rated
                ? `Present at ${attendance.present.toLocaleString()} of ${attendance.meetings.toLocaleString()} meetings where the roll was called (${pct(attendance.present, attendance.meetings)}).`
                : `Listed at ${attendance.meetings.toLocaleString()} meetings where the roll was called; a presiding officer is recorded as Non-Voting rather than Present, so no rate is shown.`}
            </p>
            <ul class="mt-1 text-xs text-navy-600">
              {attendance.values.map((a) => (
                <li>{a.value}: {a.n.toLocaleString()}</li>
              ))}
            </ul>
            <p class="mt-1 text-xs text-navy-600">
              From the clerk's roll-call records, values exactly as recorded.
            </p>
          </div>
        )}
        {committees.length > 0 && (
          <div class="mt-3 rounded bg-navy-50 p-3 text-sm">
            <h2 class="font-bold">Committees · {committees.length}</h2>
            <ul class="mt-1 space-y-1">
              {committees.map((c) => (
                <li>
                  {c.body_url ? (
                    <a href={c.body_url} class="underline">{c.body_name}</a>
                  ) : (
                    c.body_name
                  )}
                  {c.role && c.role !== "Member" && (
                    <span class="ml-1 rounded-full bg-gold-100 px-1.5 py-0.5 text-xs font-semibold">{c.role}</span>
                  )}
                </li>
              ))}
            </ul>
            <p class="mt-1 text-xs text-navy-600">Current assignments, from the council's own records.</p>
          </div>
        )}
      </div>
    </aside>

    <div class="min-w-0 flex-1">
  <dl class="grid max-w-2xl gap-x-6 gap-y-3 rounded-lg border border-navy-100 bg-white p-4 text-sm sm:grid-cols-3">
    <div>
      <dt class="text-xs font-semibold uppercase tracking-wide text-navy-600">Recorded votes</dt>
      <dd class="mt-0.5 text-xl font-bold tabular-nums">{stats.total.toLocaleString()}</dd>
    </div>
    <div>
      <dt class="text-xs font-semibold uppercase tracking-wide text-navy-600">Voted No</dt>
      <dd class="mt-0.5 text-xl font-bold tabular-nums">{stats.noes.toLocaleString()}</dd>
    </div>
    <div>
      <dt class="text-xs font-semibold uppercase tracking-wide text-navy-600">Other than Aye/No</dt>
      <dd class="mt-0.5 text-xl font-bold tabular-nums">{stats.other.toLocaleString()}</dd>
    </div>
    <div>
      <dt class="text-xs font-semibold uppercase tracking-wide text-navy-600">On the losing side</dt>
      <dd class="mt-0.5 text-xl font-bold tabular-nums">
        {outcomes.lost.toLocaleString()}
        {outcomes.decided > 0 && <span class="ml-1 text-sm font-normal text-navy-600">{pct(outcomes.lost, outcomes.decided)}</span>}
      </dd>
    </div>
    <div>
      <dt class="text-xs font-semibold uppercase tracking-wide text-navy-600">Sole No votes</dt>
      <dd class="mt-0.5 text-xl font-bold tabular-nums">{soleNoes.length.toLocaleString()}</dd>
    </div>
    <div>
      <dt class="text-xs font-semibold uppercase tracking-wide text-navy-600">Attendance</dt>
      <dd class="mt-0.5 text-xl font-bold tabular-nums">
        {attendance.meetings > 0 && rated ? pct(attendance.present, attendance.meetings) : "n/a"}
        {attendance.meetings > 0 && rated && <span class="ml-1 text-sm font-normal text-navy-600">{attendance.present.toLocaleString()} of {attendance.meetings.toLocaleString()}</span>}
      </dd>
    </div>
  </dl>
  <p class="mt-1 max-w-2xl text-xs text-navy-600">
    "Other" is everything the clerk recorded besides Aye or No: excused,
    absent, abstaining, or presiding without a vote, shown on each row
    exactly as recorded. "On the losing side" counts Aye and No votes that
    ended opposite the clerk's recorded outcome, of
    {" "}{outcomes.decided.toLocaleString()} with an outcome on record.
    Attendance is meetings where the roll call records the member present,
    of the meetings where the roll was called with the member listed.
  </p>

  {soleNoes.length > 0 && (
    <section class="mt-6">
      <h2 class="text-xl font-bold">Sole No votes · {soleNoes.length.toLocaleString()}</h2>
      <p class="mt-1 max-w-3xl text-sm text-navy-600">
        Items where {member.name} cast the only No. Each links to the clerk's page.
      </p>
      <ScrollPanel label={`${member.name}'s sole No votes`} max="max-h-[24rem]" count={soleNoes.length}>
        <ul class="divide-y divide-navy-100 p-0 text-sm">
          {soleNoes.map((v) => (
            <li class="px-4 py-2">
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-0.5">
                <span class="w-24 shrink-0 text-xs tabular-nums text-navy-600">{fmtDate(v.date)}</span>
                {v.matter_url ? (
                  <a href={v.matter_url} class="shrink-0 font-bold underline">{v.matter_file ?? "item"}</a>
                ) : (
                  <span class="shrink-0 font-bold">{v.matter_file ?? "item"}</span>
                )}
                <span class="order-last min-w-0 basis-full break-words sm:order-none sm:flex-1">{v.title}</span>
                <span class="shrink-0 text-xs font-semibold tabular-nums">
                  <span class="text-moss-600">{v.ayes} Aye</span> &ndash; <span class="text-badger-700">1 No</span>
                </span>
              </div>
              <p class="mt-0.5 break-words text-xs text-navy-600 sm:pl-[6.75rem]">{v.action}</p>
            </li>
          ))}
        </ul>
      </ScrollPanel>
    </section>
  )}

  {dissentVotes.length > 0 && (
    <section class="mt-6">
      <h2 class="text-xl font-bold">Votes with dissent · {dissentVotes.length.toLocaleString()}</h2>
      <p class="mt-1 max-w-3xl text-sm text-navy-600">
        Every item where at least one member voted No and {member.name}'s
        position is on record, with the council's tally. Nearly everything
        passes with every member in favor, so a single No is what sets one
        record apart from another. Each links to the clerk's page.
      </p>
      <ScrollPanel label={`${member.name} on votes with dissent`} max="max-h-[28rem]" count={dissentVotes.length}>
        <ul class="divide-y divide-navy-100 p-0 text-sm">
          {dissentVotes.map((v) => (
            <li class="px-4 py-2">
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-0.5">
                <span class={`w-20 shrink-0 rounded-full px-2 py-0.5 text-center text-xs font-bold ${castStyle(v.value)}`}>{v.value}</span>
                <span class="w-24 shrink-0 text-xs tabular-nums text-navy-600">{fmtDate(v.date)}</span>
                {v.matter_url ? (
                  <a href={v.matter_url} class="shrink-0 font-bold underline">{v.matter_file ?? "item"}</a>
                ) : (
                  <span class="shrink-0 font-bold">{v.matter_file ?? "item"}</span>
                )}
                <span class="order-last min-w-0 basis-full break-words sm:order-none sm:flex-1">{v.title}</span>
                <span class="shrink-0 text-xs font-semibold tabular-nums">
                  <span class="text-moss-600">{v.ayes} Aye</span> &ndash; <span class="text-badger-700">{v.noes} No</span>
                </span>
              </div>
              <p class="mt-0.5 break-words text-xs text-navy-600 sm:pl-[12.5rem]">{v.action}</p>
            </li>
          ))}
        </ul>
      </ScrollPanel>
    </section>
  )}

  {motionCount > 0 && (
    <section class="mt-6">
      <h2 class="text-xl font-bold">Motions they moved · {motionCount.toLocaleString()}</h2>
      <p class="mt-1 max-w-3xl text-sm text-navy-600">
        Items where the council's record names {member.name} as the mover of
        the action taken{motionCount > RECENT ? `, the ${RECENT} most recent` : ""}.
        Each links to the clerk's page.
      </p>
      <ScrollPanel label={`Motions moved by ${member.name}`} max="max-h-[28rem]" count={Math.min(RECENT, motionCount)}>
        <ul class="divide-y divide-navy-100 p-0 text-sm">
          {motions.map((m) => (
            <li class="flex flex-wrap items-baseline gap-x-3 gap-y-0.5 px-4 py-1.5">
              <span class="w-24 shrink-0 text-xs tabular-nums text-navy-600">{fmtDate(m.date)}</span>
              {m.matter_url ? (
                <a href={m.matter_url} class="w-28 shrink-0 truncate font-semibold underline">{m.matter_file ?? "item"}</a>
              ) : (
                <span class="w-28 shrink-0 truncate font-semibold">{m.matter_file ?? "item"}</span>
              )}
              <span class="order-last min-w-0 basis-full truncate sm:order-none sm:flex-1">{m.title}</span>
              <span class="shrink-0 text-xs text-navy-600">{m.action}</span>
            </li>
          ))}
        </ul>
      </ScrollPanel>
    </section>
  )}

  <section class="mt-6">
    <h2 class="text-xl font-bold">Recent votes</h2>
    <p class="mt-1 max-w-3xl text-sm text-navy-600">
      The {Math.min(RECENT, stats.total).toLocaleString()} most recent of
      {" "}{stats.total.toLocaleString()} recorded votes; the complete
      record lives in the <a href={body.insite_url} class="underline">city's own system</a>{stats.total > 0 && (
        <>, and every recorded vote is <a href={`/local/${body.slug}/${member.slug}/votes/1/`} class="underline">paged here</a></>
      )}.
    </p>
    <ScrollPanel label={`${member.name}'s recent votes`} max="max-h-[32rem]" count={Math.min(RECENT, stats.total)}>
      <ul class="divide-y divide-navy-100 p-0 text-sm">
        {votes.map((v) => (
          <li class="flex flex-wrap items-baseline gap-x-3 gap-y-0.5 px-4 py-1.5">
            <span class={`w-20 shrink-0 rounded-full px-2 py-0.5 text-center text-xs font-bold ${castStyle(v.value)}`}>{v.value}</span>
            <span class="w-24 shrink-0 text-xs tabular-nums text-navy-600">{fmtDate(v.date)}</span>
            {v.matter_url ? (
              <a href={v.matter_url} class="w-28 shrink-0 truncate font-semibold underline">{v.matter_file ?? "item"}</a>
            ) : (
              <span class="w-28 shrink-0 truncate font-semibold">{v.matter_file ?? "item"}</span>
            )}
            <span class="order-last min-w-0 basis-full truncate sm:order-none sm:flex-1">{v.title}</span>
          </li>
        ))}
      </ul>
    </ScrollPanel>
  </section>
    </div>
  </div>
</Base>
