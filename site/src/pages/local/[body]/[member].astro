---
/** One council member's voting record: who they are and their term, plain
 * answers about their record with what each number is out of, then the
 * votes themselves (ties broken, sole no votes, votes with dissent, motions
 * and recent votes), each linking the clerk's record. */
import Base from "../../../layouts/Base.astro";
import Portrait from "../../../components/Portrait.astro";
import LocalProfileNotice from "../../../components/LocalProfileNotice.astro";
import LocalCoverageNotice from "../../../components/LocalCoverageNotice.astro";
import FollowButton from "../../../components/FollowButton.astro";
import JsonLd from "../../../components/JsonLd.astro";
import MoreRows from "../../../components/MoreRows.astro";
import YearChips from "../../../components/YearChips.astro";
import LocalVoteRow from "../../../components/LocalVoteRow.astro";
import { localBodies, localMembers } from "../../../lib/db";
import { RECENT, councilMemberProfile } from "../../../lib/council";
import { fmtDate } from "../../../lib/format";
import { longDate } from "../../../lib/federal";
import { safeHref } from "../../../lib/html";

export function getStaticPaths() {
  return localBodies().flatMap((body) =>
    localMembers(body.tenant)
      .filter((m) => m.is_current || m.vote_count > 0)
      .map((m) => ({ params: { body: body.slug, member: m.slug }, props: { body, member: m } })),
  );
}
const { body, member } = Astro.props;
const {
  stats, votes, dissentVotes, soleNoes, terms, committees, outcomes, motionCount, motions,
  attendance, termEnd, springYear, yearPages, presiding, rated, tieBreaks, joinedAyes,
  glossary, years,
} = councilMemberProfile(body.tenant, member);
const pct = (n: number, d: number) => (d > 0 ? `${Math.round((n / d) * 100)}%` : "");
const plural = (n: number, one: string, many: string) => `${n.toLocaleString()} ${n === 1 ? one : many}`;
const followId = `${body.slug}/${member.slug}`;
const termLabel = (t: string | null) =>
  t === "Ald." ? "Alderperson" : t === "President" ? "Council president" : (t ?? "Member");
const SHOWN = 10;
const first = <T,>(rows: T[]) => rows.slice(0, SHOWN);
const rest = <T,>(rows: T[]) => rows.slice(SHOWN);
const tally = (ayes: number, noes: number) => `${ayes} Aye, ${noes} No`;
const role = presiding
    ? `${member.is_current ? "Mayor" : "Former mayor"} of ${body.city}, presiding over the ${body.name}`
    : `${member.is_current ? "Member" : "Former member"} of the ${body.name}`;
const tel = member.phone ? `tel:${member.phone.replace(/\D/g, "")}` : null;
const imageBasis = safeHref(member.image_basis);
const seatBasis = safeHref(member.seat_basis);
---

<Base
  title={`${member.name}, ${body.city}${member.seat != null ? ` District ${member.seat}` : ""}`}
  description={`${member.name}'s ${body.name} voting record from the city's own legislative system: ${stats.total.toLocaleString()} recorded votes.`}
  filters={{ type: "City Council", city: body.city }}
  breadcrumbs={[
    { name: "City councils", url: "/local/" },
    { name: body.name, url: `/local/${body.slug}/` },
  ]}
  layout="wide"
>
  <JsonLd
    data={{
      "@type": "Person",
      name: member.name,
      alternateName: member.record_name && member.record_name !== member.name ? member.record_name : undefined,
      jobTitle: member.seat != null
        ? `Alderperson, District ${member.seat}`
        : presiding ? "Mayor" : "Council member",
      email: member.email ?? undefined,
      telephone: member.phone ?? undefined,
      image: member.image_url ?? undefined,
      memberOf: { "@type": "GovernmentOrganization", name: body.name },
    }}
  />
  <div class="council">
    <header class="c-head flex max-w-[47.5rem] flex-col gap-2.5">
      <a href={`/local/${body.slug}/`} class="self-start text-small underline">{body.name}</a>
      <h1 class="t-display">{member.name}</h1>
      <p class="sm:text-lead">
        {member.seat != null
          ? <>{member.is_current ? "Alderperson" : "Former alderperson"} for <a href={`/local/${body.slug}/district/${member.seat}/`} class="underline">District {member.seat}</a> on the {body.name}.</>
          : `${role}.`}
        {" "}A nonpartisan office.
        {termEnd && ` The current term ends ${longDate(termEnd)}${springYear ? `, so the seat is on the April ${springYear} spring ballot` : ""}.`}
      </p>
      {member.record_name && member.record_name !== member.name && (
        <p class="text-small text-granite">Listed as “{member.record_name}” in the council's records.</p>
      )}
      <LocalCoverageNotice tenant={body.tenant} />
    </header>

    <aside class="c-rail flex flex-col gap-5" data-pagefind-ignore aria-label={`About ${member.name}`}>
      <div class="flex flex-col gap-2">
        <FollowButton kind="council" id={followId} label={`Follow ${member.name}`} variant="primary" />
        <p class="text-fine text-granite">
          Following saves them on this device. You can also <a href={`/feeds/local/${followId}.xml`} class="underline">get updates in a feed reader</a>.
        </p>
      </div>

      <section class="sheet flex flex-col gap-4 p-5" aria-label="Portrait and contact">
        <div class="flex items-center gap-4">
          <Portrait src={member.image_url} name={member.name} size={80} />
          {imageBasis && <p class="text-fine text-granite">Official portrait from <a href={imageBasis} class="underline">the city's page</a>.</p>}
        </div>
        {member.is_current && (member.email || tel) && (
          <div class="flex flex-col gap-2">
            {member.email && <a href={`mailto:${member.email}`} class="btn btn-secondary w-full">Email <span class="font-sans font-normal [overflow-wrap:anywhere]">{member.email}</span></a>}
            {tel && <a href={tel} class="btn btn-secondary w-full">Call <span class="font-sans font-normal">{member.phone}</span></a>}
            <p class="text-fine text-granite">Official office contacts, from the council's records{member.seat != null && " and the city's page for the district"}.</p>
          </div>
        )}
        {member.is_current && <LocalProfileNotice tenant={body.tenant} />}
      </section>

      {terms.length > 0 && (
        <section class="flex flex-col gap-2" aria-labelledby="service-heading">
          <h2 id="service-heading" class="t-question">Service</h2>
          <ul class="border-b border-rule text-small" role="list">
            {terms.map((t) => (
              <li class="border-t border-rule py-2">{termLabel(t.title)}: {fmtDate(t.start)} to {t.end ? fmtDate(t.end) : "now"}</li>
            ))}
          </ul>
          <p class="text-fine text-granite">
            From the council's own office records.
            {seatBasis && <> The district is from <a href={seatBasis} class="underline">the city's roster</a>.</>}
          </p>
        </section>
      )}

      {committees.length > 0 && (
        <section class="flex flex-col gap-2" aria-labelledby="committees-heading">
          <h2 id="committees-heading" class="t-question">Committees: {committees.length.toLocaleString()}</h2>
          <ul class="border-b border-rule text-small" role="list">
            {committees.map((c) => {
              const href = safeHref(c.body_url);
              return (
                <li class="border-t border-rule py-2">
                  {href ? <a href={href} class="underline">{c.body_name}</a> : c.body_name}{c.role && /chair|president/i.test(c.role) && <span class="font-bold">, {c.role.toLowerCase()}</span>}
                </li>
              );
            })}
          </ul>
          <p class="text-fine text-granite">Current assignments, from the council's own records.</p>
        </section>
      )}
    </aside>

    <div class="c-body flex max-w-[47.5rem] flex-col gap-12">
      <section class="flex flex-col gap-5" aria-labelledby="record-heading">
        <h2 id="record-heading" class="t-section">Their record</h2>
        {attendance.meetings > 0 && (
          <div class="flex flex-col gap-1">
            <h3 class="t-question">Do they show up?</h3>
            <p>
              {rated
                ? <>Present at <span class="figure">{attendance.present.toLocaleString()}</span> of {attendance.meetings.toLocaleString()} meetings where the roll was called ({pct(attendance.present, attendance.meetings)}).</>
                : `Listed at ${attendance.meetings.toLocaleString()} meetings where the roll was called. A presiding mayor's attendance is recorded differently from city to city, so no rate is shown.`}
            </p>
            <p class="text-small text-granite">
              As the clerk recorded it: {attendance.values.map((a) => `${a.value} ${a.n.toLocaleString()}`).join(", ")}.
            </p>
          </div>
        )}
        <div class="flex flex-col gap-1">
          <h3 class="t-question">How often do they vote no?</h3>
          <p>
            {stats.total === 0
              ? "No recorded votes yet."
              : stats.noes === 0
                ? stats.total === 1 ? "Their one recorded vote wasn't a no." : `Never voted no in any of their ${stats.total.toLocaleString()} recorded votes.`
                : <>Voted no <span class="figure">{stats.noes.toLocaleString()}</span> {stats.noes === 1 ? "time" : "times"} in {plural(stats.total, "recorded vote", "recorded votes")}{soleNoes.length > 0
                  ? `, and cast the only no vote ${plural(soleNoes.length, "time", "times")}`
                  : ", and was never the only no vote"}.</>}
          </p>
          {stats.other > 0 && (
            <p class="text-small text-granite">
              {plural(stats.other, "vote was", "votes were")} something other than yes or no: excused, absent, abstaining,
              voting “present” or presiding without a vote, shown on each row as the clerk recorded it.
            </p>
          )}
        </div>
        {outcomes.decided > 0 && (
          <div class="flex flex-col gap-1">
            <h3 class="t-question">How often are they on the losing side?</h3>
            <p>
              <span class="figure">{outcomes.lost.toLocaleString()}</span> of their {outcomes.decided.toLocaleString()} yes-or-no votes on
              items with a recorded outcome ({pct(outcomes.lost, outcomes.decided)}) went the other way from the council's result.
            </p>
          </div>
        )}
        {presiding && (
          <div class="flex flex-col gap-1">
            <h3 class="t-question">When do they vote?</h3>
            <p>
              The mayor votes only to break a tie. {member.name} broke {tieBreaks.length === 1 ? "one tie" : `${tieBreaks.length.toLocaleString()} ties`} on
              record{joinedAyes > 0 ? `, and ${plural(joinedAyes, "more recorded Aye", "more recorded Ayes")} joined an already unanimous council` : ""}.
            </p>
          </div>
        )}
        {motionCount > 0 && (
          <div class="flex flex-col gap-1">
            <h3 class="t-question">What have they moved?</h3>
            <p>The council's record names {member.name} as the mover of {plural(motionCount, "item", "items")}.</p>
          </div>
        )}
        {glossary.length > 0 && (
          <details>
            <summary class="inline-flex min-h-11 cursor-pointer items-center font-display font-bold text-lake underline">What the words on this page mean</summary>
            <dl class="mt-2 grid gap-x-6 border-b border-rule sm:grid-cols-[max-content_1fr]">
              {glossary.map((g) => (
                <>
                  <dt class="border-t border-rule pt-2 font-bold sm:pb-2">{g.term}</dt>
                  <dd class="pb-2 sm:border-t sm:border-rule sm:pt-2">{g.meaning}</dd>
                </>
              ))}
            </dl>
            <p class="mt-2 text-small text-granite">
              Each row keeps the clerk's own words, and the linked pages have the full record; these are plain readings of them.
            </p>
          </details>
        )}
      </section>

      {tieBreaks.length > 0 && (
        <section aria-labelledby="ties-heading">
          <h2 id="ties-heading" class="t-section">Tie-breaking votes: {tieBreaks.length.toLocaleString()}</h2>
          <p class="mt-2 text-small text-granite">The other members split evenly; the mayor's vote decided. Newest first.</p>
          <div class="mt-3">
            <MoreRows rest={rest(tieBreaks).length} label="tie-breaking votes">
              {first(tieBreaks).map((v) => <LocalVoteRow v={v} tally={`The others split ${v.other_ayes} to ${v.other_noes}`} />)}
              <Fragment slot="rest">{rest(tieBreaks).map((v) => <LocalVoteRow v={v} tally={`The others split ${v.other_ayes} to ${v.other_noes}`} />)}</Fragment>
            </MoreRows>
          </div>
        </section>
      )}

      {soleNoes.length > 0 && (
        <section aria-labelledby="sole-heading">
          <h2 id="sole-heading" class="t-section">The only no vote: {soleNoes.length.toLocaleString()}</h2>
          <p class="mt-2 text-small text-granite">
            Items where {member.name} cast the only no. The vote is on the action named, which may be a
            referral or postponement rather than final passage.
          </p>
          <YearChips target="sole-no-list" label="Show the only-no votes from one year" years={years.soleNoes} />
          <div id="sole-no-list" class="mt-3">
            <MoreRows rest={rest(soleNoes).length} label="only-no votes">
              {first(soleNoes).map((v) => <LocalVoteRow v={v} dissent tally={tally(v.ayes, 1)} />)}
              <Fragment slot="rest">{rest(soleNoes).map((v) => <LocalVoteRow v={v} dissent tally={tally(v.ayes, 1)} />)}</Fragment>
            </MoreRows>
          </div>
        </section>
      )}

      {dissentVotes.length > 0 && (
        <section aria-labelledby="dissent-heading">
          <h2 id="dissent-heading" class="t-section">Votes where someone voted no: {dissentVotes.length.toLocaleString()}</h2>
          <p class="mt-2 text-small text-granite">
            {member.name}'s vote and the council's tally on every item with at least one no. The vote is on the
            action named, which may be a referral or postponement rather than final passage.
          </p>
          <YearChips target="dissent-list" label="Show the split votes from one year" years={years.dissent} />
          <div id="dissent-list" class="mt-3">
            <MoreRows rest={rest(dissentVotes).length} label="split votes">
              {first(dissentVotes).map((v) => <LocalVoteRow v={v} dissent tally={tally(v.ayes, v.noes)} />)}
              <Fragment slot="rest">{rest(dissentVotes).map((v) => <LocalVoteRow v={v} dissent tally={tally(v.ayes, v.noes)} />)}</Fragment>
            </MoreRows>
          </div>
        </section>
      )}

      {motionCount > 0 && (
        <section aria-labelledby="motions-heading">
          <h2 id="motions-heading" class="t-section">Items they moved: {motionCount.toLocaleString()}</h2>
          <p class="mt-2 text-small text-granite">
            Items the council's record names {member.name} as the mover of{motionCount > RECENT ? `, the ${RECENT} most recent` : ""}. Newest first.
          </p>
          <div class="mt-3">
            <MoreRows rest={rest(motions).length} label="items they moved">
              {first(motions).map((m) => <LocalVoteRow v={m} />)}
              <Fragment slot="rest">{rest(motions).map((m) => <LocalVoteRow v={m} />)}</Fragment>
            </MoreRows>
          </div>
        </section>
      )}

      <section aria-labelledby="recent-heading">
        <h2 id="recent-heading" class="t-section">Recent votes</h2>
        <p class="mt-2 text-small text-granite">
          {stats.total > RECENT
            ? `The ${RECENT.toLocaleString()} most recent of ${plural(stats.total, "recorded vote", "recorded votes")}, newest first.`
            : stats.total === 1 ? "Their one recorded vote." : `All ${stats.total.toLocaleString()} recorded votes, newest first.`}
          The complete record is in <a href={body.insite_url} class="underline">the city's own system</a>{stats.total > 0 && <>, and every vote we've collected is <a href={`/local/${body.slug}/${member.slug}/votes/1/`} class="underline">listed page by page</a></>}.
        </p>
        {yearPages.length > 1 && (
          <p class="mt-2 flex flex-wrap items-center gap-2 text-small" data-pagefind-ignore>
            <span class="text-granite">Start at a year:</span>
            {yearPages.map((y) => <a href={`/local/${body.slug}/${member.slug}/votes/${y.page}/`} class="chip tabular-nums">{y.year}</a>)}
          </p>
        )}
        <div class="mt-3">
          <MoreRows rest={rest(votes).length} label="recent votes">
            {first(votes).map((v) => <LocalVoteRow v={v} />)}
            <Fragment slot="rest">{rest(votes).map((v) => <LocalVoteRow v={v} />)}</Fragment>
          </MoreRows>
        </div>
      </section>

      <p class="text-fine text-granite">
        From the <a href={body.insite_url} class="underline">{body.name}'s own records</a>{stats.last && `, the latest from ${fmtDate(stats.last)}`}.
      </p>
    </div>
  </div>
</Base>

<style>
  .council {
    display: grid;
    gap: 2rem;
    grid-template-areas: "head" "rail" "body";
    grid-template-columns: minmax(0, 1fr);
  }
  .c-head { grid-area: head; }
  .c-rail { grid-area: rail; }
  .c-body { grid-area: body; }
  @media (min-width: 64rem) {
    .council {
      grid-template-areas: "head rail" "body rail";
      grid-template-columns: minmax(0, 1fr) 20rem;
      grid-template-rows: auto 1fr;
      column-gap: 3.5rem;
    }
    .c-rail {
      align-self: start;
    }
  }
</style>
