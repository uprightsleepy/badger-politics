---
import Base from "../../../layouts/Base.astro";
import SourceStrip from "../../../components/SourceStrip.astro";
import Portrait from "../../../components/Portrait.astro";
import { localBodies, localMembers, localTenantStats, localActionsWithDissent, localUpcomingMeetings } from "../../../lib/db";
import { fmtDate } from "../../../lib/format";
import { actionLabel, glossaryFor } from "../../../lib/localGloss";

export function getStaticPaths() {
  return localBodies().map((b) => ({ params: { body: b.slug }, props: { body: b } }));
}
const { body } = Astro.props;
const members = localMembers(body.tenant);
const stats = localTenantStats(body.tenant);
const dissent = localActionsWithDissent(body.tenant, 25);
const nextMeetings = localUpcomingMeetings().filter((m) => m.tenant === body.tenant);
const glossary = glossaryFor(dissent.map((a) => a.action));
const current = members.filter((m) => m.is_current);
const seated = current.filter((m) => m.seat != null);
const presiding = current.filter((m) => m.seat == null);
const former = members.filter((m) => !m.is_current && m.vote_count > 0);
const districts = [...new Set(seated.map((m) => m.seat!))].sort((a, b) => a - b);
---

<Base
  title={body.name}
  description={`Every recorded ${body.name} vote, member by member, from the city's own legislative records: ${stats?.votes.toLocaleString()} votes since ${fmtDate(stats?.first ?? null)}.`}
  filters={{ type: "City Council", city: body.city }}
  breadcrumbs={[{ name: "City Councils", url: "/local/" }]}
>
  <p class="text-sm text-navy-600"><a href="/local/" class="underline">City Councils</a></p>
  <h1 class="mt-1 text-2xl font-bold">{body.name}</h1>
  <p class="mt-1 max-w-3xl text-sm text-navy-700">
    {body.city} elects {body.seats === 15 ? "one alderperson from each of 15 districts" : `two alderpersons from each of ${body.seats} districts`}.
    Every recorded vote below comes from the city's own legislative
    system, and every item links to the clerk's page for it.
  </p>
  <SourceStrip
    sources={[{ label: `${body.name} records (Legistar)`, href: body.insite_url }]}
    through={stats?.last ?? null}
  />

  {nextMeetings.length > 0 ? (
    <div class="mt-3 max-w-2xl rounded-lg border border-moss-600 bg-white p-4 text-sm">
      <h2 class="font-bold">Next meeting</h2>
      {nextMeetings.map((m) => (
        <p class="mt-1">
          <a href={m.insite_url} class="font-semibold underline">{fmtDate(m.date)}{m.time ? `, ${m.time}` : ""}</a>
          {m.location && <span class="text-navy-600"> &middot; {m.location}</span>}
        </p>
      ))}
      <p class="mt-1 text-xs text-navy-600">
        Open to the public under Wisconsin's Open Meetings Law; the agenda is
        on the meeting page. The clerk lists the next meeting shortly before
        it is held, so far-out dates appear closer to the day.
      </p>
    </div>
  ) : (
    <p class="mt-3 text-xs text-navy-600" data-pagefind-ignore>
      No upcoming meeting is listed in the clerk's system yet; the next one
      appears here when posted.
    </p>
  )}

  {stats && (
    <dl class="mt-4 grid max-w-2xl gap-x-6 gap-y-3 rounded-lg border border-navy-100 bg-white p-4 text-sm sm:grid-cols-3">
      <div>
        <dt class="text-xs font-semibold uppercase tracking-wide text-navy-600">Recorded votes</dt>
        <dd class="mt-0.5 text-xl font-bold tabular-nums">{stats.votes.toLocaleString()}</dd>
      </div>
      <div>
        <dt class="text-xs font-semibold uppercase tracking-wide text-navy-600">Items acted on</dt>
        <dd class="mt-0.5 text-xl font-bold tabular-nums">{stats.actions.toLocaleString()}</dd>
      </div>
      <div>
        <dt class="text-xs font-semibold uppercase tracking-wide text-navy-600">Meetings</dt>
        <dd class="mt-0.5 text-xl font-bold tabular-nums">{stats.meetings.toLocaleString()}</dd>
      </div>
    </dl>
  )}

  <section class="mt-6">
    <h2 class="text-xl font-bold">Members</h2>
    <ul class="mt-2 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
      {districts.map((d) => (
        <li class="rounded-lg border border-navy-100 bg-white p-3">
          <p class="text-xs font-semibold uppercase tracking-wide text-navy-600">
            <a href={`/local/${body.slug}/district/${d}/`} class="underline">District {d}</a>
          </p>
          {seated.filter((m) => m.seat === d).map((m) => (
            <a href={`/local/${body.slug}/${m.slug}/`} class="mt-1.5 flex items-center gap-2 font-semibold underline">
              <Portrait src={m.image_url} name={m.name} size={40} />
              <span class="min-w-0 truncate">{m.name}</span>
            </a>
          ))}
        </li>
      ))}
      {presiding.map((m) => (
        <li class="rounded-lg border border-navy-100 bg-white p-3">
          <p class="text-xs font-semibold uppercase tracking-wide text-navy-600">
            Mayor, presiding (votes only to break a tie)
          </p>
          <a href={`/local/${body.slug}/${m.slug}/`} class="mt-1.5 flex items-center gap-2 font-semibold underline">
            <Portrait src={m.image_url} name={m.name} size={40} />
            <span class="min-w-0 truncate">{m.name}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-2 text-xs text-navy-600">
      Council seats in Wisconsin are nonpartisan, so no party is shown.
      Portraits and contacts come from the city's own pages for each district.
    </p>
  </section>

  {dissent.length > 0 && (
    <section class="mt-8">
      <h2 class="text-xl font-bold">Recent votes with dissent</h2>
      <p class="mt-1 max-w-3xl text-sm text-navy-600">
        Items where at least one member voted No. Nearly everything passes
        with every member in favor, so these are the votes that separate
        one member's record from another's; the unanimous ones are on each
        member's page. The vote is on the action shown with each row: a
        motion to refer or postpone is not the measure itself.
      </p>
      <ul class="mt-3 divide-y divide-navy-100 rounded-lg border border-navy-100 bg-white text-sm">
        {dissent.map((a) => (
          <li class="px-4 py-2">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-0.5">
              <span class="w-24 shrink-0 text-xs tabular-nums text-navy-600">{fmtDate(a.date)}</span>
              {a.matter_url ? (
                <a href={a.matter_url} class="shrink-0 font-bold underline">{a.matter_file ?? "item"}</a>
              ) : (
                <span class="shrink-0 font-bold">{a.matter_file ?? "item"}</span>
              )}
              <span class="order-last min-w-0 basis-full break-words sm:order-none sm:flex-1">{a.title ?? "Untitled item"}</span>
              <span class="shrink-0 font-semibold tabular-nums">
                <span class="text-moss-600">{a.ayes} Aye</span> &ndash; <span class="text-badger-700">{a.noes} No</span>
              </span>
            </div>
            <p class="mt-0.5 break-words text-xs text-navy-600 sm:pl-[6.75rem]">
              {actionLabel(a.action)}
              {" "}&middot; <a href={a.insite_url} class="underline">meeting record</a>
            </p>
          </li>
        ))}
      </ul>
      {glossary.length > 0 && (
        <details class="mt-3 max-w-3xl rounded-lg border border-navy-100 bg-white text-sm">
          <summary class="cursor-pointer px-4 py-2 font-semibold">What the words above mean</summary>
          <dl class="grid gap-x-4 gap-y-1 px-4 pb-3 sm:grid-cols-[max-content_1fr]">
            {glossary.map((g) => (
              <>
                <dt class="font-semibold">{g.term}</dt>
                <dd class="text-navy-700">{g.meaning}</dd>
              </>
            ))}
          </dl>
        </details>
      )}
    </section>
  )}

  {former.length > 0 && (
    <details class="mt-8 max-w-3xl rounded-lg border border-navy-100 bg-white">
      <summary class="cursor-pointer px-4 py-2 text-sm font-semibold">
        Former members with recorded votes · {former.length}
      </summary>
      <ul class="grid gap-x-4 gap-y-1 p-4 pt-1 text-sm sm:grid-cols-2">
        {former.map((m) => (
          <li>
            <a href={`/local/${body.slug}/${m.slug}/`} class="inline-block py-0.5 underline">{m.name}</a>
          </li>
        ))}
      </ul>
    </details>
  )}
</Base>
