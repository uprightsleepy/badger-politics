---
/** One city council: who sits for each district, the next meeting, how
 * much of the record is collected, and the latest split votes, all from
 * the city's own legislative system. */
import Base from "../../../layouts/Base.astro";
import Portrait from "../../../components/Portrait.astro";
import LocalProfileNotice from "../../../components/LocalProfileNotice.astro";
import LocalCoverageNotice from "../../../components/LocalCoverageNotice.astro";
import LocalVoteRow from "../../../components/LocalVoteRow.astro";
import MoreRows from "../../../components/MoreRows.astro";
import { localBodies, localMembers, localTenantStats, localActionsWithDissent, localUpcomingMeetings } from "../../../lib/db";
import { localMemberTerms } from "../../../lib/council";
import { fmtDate } from "../../../lib/format";
import { longDate } from "../../../lib/federal";
import { glossaryFor } from "../../../lib/localGloss";
import { safeHref } from "../../../lib/html";

export function getStaticPaths() {
  return localBodies().map((b) => ({ params: { body: b.slug }, props: { body: b } }));
}
const { body } = Astro.props;
const members = localMembers(body.tenant);
const stats = localTenantStats(body.tenant);
const DISSENT_LIMIT = 25;
const dissent = localActionsWithDissent(body.tenant, DISSENT_LIMIT);
const nextMeetings = localUpcomingMeetings().filter((m) => m.tenant === body.tenant);
const glossary = glossaryFor(dissent.map((a) => a.action));
const current = members.filter((m) => m.is_current);
const seated = current.filter((m) => m.seat != null);
const presiding = current.filter((m) => m.seat == null);
const former = members.filter((m) => !m.is_current && m.vote_count > 0);
const districts = [...new Set(seated.map((m) => m.seat!))].sort((a, b) => a - b);
const plural = (n: number, one: string, many: string) => `${n.toLocaleString()} ${n === 1 ? one : many}`;
const perSeat = Array.from({ length: body.seats }, (_, i) => seated.filter((m) => m.seat === i + 1).length);
const perDistrict = perSeat.length > 0 && perSeat.every((n) => n === perSeat[0]) ? perSeat[0] : 0;
const SHOWN = 10;
const isMayor = (m: (typeof members)[number]) => localMemberTerms(body.tenant, m.person_id).some((t) => t.title === "Mayor");
const mayor = presiding.find(isMayor);
---

<Base
  title={body.name}
  description={`${body.name} votes, member by member, from the city's own legislative records: ${stats?.votes.toLocaleString()} votes since ${fmtDate(stats?.first ?? null)}.`}
  filters={{ type: "City Council", city: body.city }}
  breadcrumbs={[{ name: "City councils", url: "/local/" }]}
  layout="wide"
>
  <header class="flex max-w-[47.5rem] flex-col gap-2.5">
    <a href="/local/" class="self-start text-small underline">City councils</a>
    <h1 class="t-display">{body.name}</h1>
    <p class="sm:text-lead">
      {seated.length > 0
        ? `${plural(seated.length, "alderperson represents", "alderpersons represent")} ${body.city}'s ${plural(body.seats, "district", "districts")}${perDistrict > 1 ? `, ${perDistrict} for each` : ""}`
        : `The council represents ${body.city}'s ${plural(body.seats, "district", "districts")}`}{mayor ? `, and Mayor ${mayor.name} presides` : ""}.
      {stats && stats.votes > 0 && ` Our records cover ${plural(stats.votes, "recorded vote", "recorded votes")} on ${plural(stats.actions, "item", "items")} at ${plural(stats.meetings, "meeting", "meetings")} since ${longDate(stats.first!)}.`}
    </p>
    <p class="text-small text-granite">
      Council seats are nonpartisan, so no party is shown. Every vote comes from the city's own legislative
      system, and every item links to the clerk's page for it.
    </p>
    <LocalCoverageNotice tenant={body.tenant} />
  </header>

  <section class="mt-8 max-w-[47.5rem]" aria-labelledby="next-heading">
    <h2 id="next-heading" class="t-section text-[1.375rem]">Next meeting</h2>
    {nextMeetings.length > 0 ? (
      <>
        {nextMeetings.map((m) => (
          <p class="mt-2">
            <a href={safeHref(m.insite_url) ?? body.insite_url} class="font-bold underline">
              {new Date(`${m.date}T12:00:00Z`).toLocaleDateString("en-US", { weekday: "long", month: "long", day: "numeric", year: "numeric", timeZone: "UTC" })}{m.time ? `, ${m.time}` : ""}
            </a>
            {m.location && <span class="block text-granite">{m.location}</span>}
          </p>
        ))}
        <p class="mt-2 text-small text-granite">
          Open to the public under Wisconsin's Open Meetings Law; the agenda is on the meeting page. The clerk
          lists each meeting shortly before it's held.
        </p>
      </>
    ) : (
      <p class="mt-2 text-granite" data-pagefind-ignore>
        The clerk hasn't listed the next meeting yet. It appears here once it's posted.
      </p>
    )}
  </section>

  <section class="mt-12 max-w-[60rem]" aria-labelledby="members-heading">
    <h2 id="members-heading" class="t-section">Members</h2>
    <p class="mt-2 text-small text-granite">
      By district. Portraits and contacts come from the city's published records.
      {body.tenant !== "madison" && current.length > 0 && current.every((m) => !m.image_url) && " Portraits aren't collected for this council yet."}
    </p>
    <div class="mt-1"><LocalProfileNotice tenant={body.tenant} /></div>
    <ul class="mt-4 grid gap-x-8 border-b border-rule sm:grid-cols-2 lg:grid-cols-3" role="list">
      {districts.map((d) => (
        <li class="flex flex-col gap-2 border-t border-rule py-3">
          <a href={`/local/${body.slug}/district/${d}/`} class="inline-flex min-h-11 items-center self-start font-display font-bold underline">District {d}</a>
          {seated.filter((m) => m.seat === d).map((m) => (
            <a href={`/local/${body.slug}/${m.slug}/`} class="flex min-h-11 items-center gap-3 underline">
              <Portrait src={m.image_url} name={m.name} size={40} />
              <span class="min-w-0 [overflow-wrap:anywhere]">{m.name}</span>
            </a>
          ))}
        </li>
      ))}
      {presiding.map((m) => (
        <li class="flex flex-col gap-2 border-t border-rule py-3">
          <span class="inline-flex min-h-11 items-center font-display font-bold">{isMayor(m) ? "Mayor, presiding" : "District not verified"}</span>
          <a href={`/local/${body.slug}/${m.slug}/`} class="flex min-h-11 items-center gap-3 underline">
            <Portrait src={m.image_url} name={m.name} size={40} />
            <span class="min-w-0 [overflow-wrap:anywhere]">{m.name}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {dissent.length > 0 && (
    <section class="mt-12 max-w-[60rem]" aria-labelledby="dissent-heading">
      <h2 id="dissent-heading" class="t-section">Recent votes where someone voted no</h2>
      <p class="mt-2 max-w-[47.5rem] text-small text-granite">
        {dissent.length < DISSENT_LIMIT
          ? dissent.length === 1 ? "The one item with a recorded no." : `All ${dissent.length.toLocaleString()} items with at least one recorded no, newest first.`
          : `The ${DISSENT_LIMIT.toLocaleString()} most recent items with at least one recorded no.`}
        {" "}The vote is on the action named with each item: a motion to refer or postpone isn't the measure itself.
      </p>
      <div class="mt-3">
        <MoreRows rest={Math.max(0, dissent.length - SHOWN)} label="recent split votes">
          {dissent.slice(0, SHOWN).map((a) => <LocalVoteRow v={a} tally={`${a.ayes} Aye, ${a.noes} No`} />)}
          <Fragment slot="rest">{dissent.slice(SHOWN).map((a) => <LocalVoteRow v={a} tally={`${a.ayes} Aye, ${a.noes} No`} />)}</Fragment>
        </MoreRows>
      </div>
      {glossary.length > 0 && (
        <details class="mt-4 max-w-[47.5rem]">
          <summary class="inline-flex min-h-11 cursor-pointer items-center font-display font-bold text-lake underline">What the council's words mean</summary>
          <dl class="mt-2 grid gap-x-6 border-b border-rule sm:grid-cols-[max-content_1fr]">
            {glossary.map((g) => (
              <>
                <dt class="border-t border-rule pt-2 font-bold sm:pb-2">{g.term}</dt>
                <dd class="pb-2 sm:border-t sm:border-rule sm:pt-2">{g.meaning}</dd>
              </>
            ))}
          </dl>
        </details>
      )}
    </section>
  )}

  {former.length > 0 && (
    <details class="mt-10 max-w-[47.5rem]">
      <summary class="inline-flex min-h-11 cursor-pointer items-center font-display font-bold text-lake underline">
        Former members with recorded votes: {former.length.toLocaleString()}
      </summary>
      <ul class="mt-2 grid gap-x-8 border-b border-rule sm:grid-cols-2" role="list">
        {former.map((m) => (
          <li class="border-t border-rule">
            <a href={`/local/${body.slug}/${m.slug}/`} class="inline-flex min-h-11 items-center underline">{m.name}</a>
          </li>
        ))}
      </ul>
    </details>
  )}

  <p class="mt-12 max-w-[47.5rem] text-fine text-granite">
    From the <a href={body.insite_url} class="underline">{body.name}'s own records</a>{stats?.last && `, the latest from ${fmtDate(stats.last)}`}.
  </p>
</Base>
