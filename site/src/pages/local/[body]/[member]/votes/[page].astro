---
/** A council member's complete voting record, paged like a legislator's.
 * The profile shows the most recent 300; a long career runs to tens of
 * thousands. noindex like the legislator pages: derived lists whose
 * substance is on the clerk's pages, but crawlable for a link path. */
import Base from "../../../../../layouts/Base.astro";
import Pager from "../../../../../components/Pager.astro";
import LocalVoteRow from "../../../../../components/LocalVoteRow.astro";
import { localBodies, localMembers, localMemberVotes, localMemberVoteYears } from "../../../../../lib/db";
import { PER_PAGE, pageBounds, pageCount, yearPageStarts } from "../../../../../lib/paging";

export function getStaticPaths() {
  return localBodies().flatMap((body) =>
    localMembers(body.tenant)
      .filter((m) => m.vote_count > 0)
      .flatMap((m) => {
        const pages = pageCount(m.vote_count);
        return Array.from({ length: pages }, (_, i) => ({
          params: { body: body.slug, member: m.slug, page: String(i + 1) },
          props: { body, member: m, page: i + 1, pages, total: m.vote_count },
        }));
      }),
  );
}

const { body, member, page, pages, total } = Astro.props;
const rows = localMemberVotes(body.tenant, member.person_id, PER_PAGE, (page - 1) * PER_PAGE);
const base = `/local/${body.slug}/${member.slug}`;
const { first, last } = pageBounds(page, total);
const yearPages = yearPageStarts(localMemberVoteYears(body.tenant, member.person_id));
---

<Base
  title={`${member.name}: every vote, page ${page} of ${pages}`}
  description={`Votes ${first.toLocaleString()} to ${last.toLocaleString()} of ${total.toLocaleString()} recorded for ${member.name} on the ${body.name}, from the city's own records.`}
  noindex
  searchable={false}
  breadcrumbs={[
    { name: "City Councils", url: "/local/" },
    { name: body.name, url: `/local/${body.slug}/` },
    { name: member.name, url: `${base}/` },
  ]}
>
  <p class="text-sm text-navy-600">
    <a href={`${base}/`} class="underline">&larr; {member.name}</a>
  </p>
  <h1 class="mt-1 text-2xl font-bold">Every Recorded Vote</h1>
  <p class="mt-1 text-sm text-navy-600">
    {total.toLocaleString()} recorded votes, newest first. Showing
    {" "}{first.toLocaleString()} to {last.toLocaleString()}. The vote is on the
    action named under each row, which is not always the measure itself.
    Each item links to the clerk's page.
  </p>
  {yearPages.length > 1 && (
    <p class="mt-1 text-sm text-navy-600" data-pagefind-ignore>
      Jump to a year:
      {yearPages.map((y) => (
        y.page === page
          ? <span class="ml-2 font-semibold tabular-nums">{y.year}</span>
          : <a href={`${base}/votes/${y.page}/`} class="ml-2 underline tabular-nums">{y.year}</a>
      ))}
    </p>
  )}

  <ul class="mt-4 divide-y divide-navy-100 rounded-lg border border-navy-100 bg-white text-sm">
    {rows.map((v) => (
      <LocalVoteRow v={v} />
    ))}
  </ul>

  <Pager page={page} pages={pages} href={(n) => `${base}/votes/${n}/`} label="Vote record pages" />
</Base>
