---
/** Paginated recorded votes; the clerk's pages remain the primary source. */
import Base from "../../../../../layouts/Base.astro";
import Pager from "../../../../../components/Pager.astro";
import LocalVoteRow from "../../../../../components/LocalVoteRow.astro";
import LocalCoverageNotice from "../../../../../components/LocalCoverageNotice.astro";
import { localBodies, localMembers } from "../../../../../lib/db";
import { localMemberVotes, localMemberVoteYears } from "../../../../../lib/council";
import { PER_PAGE, pageBounds, pageCount, yearPageStarts } from "../../../../../lib/paging";

export function getStaticPaths() {
  return localBodies().flatMap((body) =>
    localMembers(body.tenant)
      .filter((m) => m.vote_count > 0)
      .flatMap((m) => {
        const pages = pageCount(m.vote_count);
        return Array.from({ length: pages }, (_, i) => ({
          params: { body: body.slug, member: m.slug, page: String(i + 1) },
          props: { body, member: m, page: i + 1, pages, total: m.vote_count },
        }));
      }),
  );
}

const { body, member, page, pages, total } = Astro.props;
const rows = localMemberVotes(body.tenant, member.person_id, PER_PAGE, (page - 1) * PER_PAGE);
const base = `/local/${body.slug}/${member.slug}`;
const { first, last } = pageBounds(page, total);
const yearPages = yearPageStarts(localMemberVoteYears(body.tenant, member.person_id));
---

<Base
  title={`${member.name}: recorded votes, page ${page} of ${pages}`}
  description={`Votes ${first.toLocaleString()} to ${last.toLocaleString()} of ${total.toLocaleString()} recorded for ${member.name} on the ${body.name}, from the city's own records.`}
  noindex
  searchable={false}
  breadcrumbs={[
    { name: "City councils", url: "/local/" },
    { name: body.name, url: `/local/${body.slug}/` },
    { name: member.name, url: `${base}/` },
  ]}
  layout="wide"
>
  <header class="flex max-w-[47.5rem] flex-col gap-2.5">
    <a href={`${base}/`} class="self-start text-small underline">{member.name}</a>
    <h1 class="t-display">Recorded votes</h1>
    <p class="sm:text-lead">
      {total.toLocaleString()} recorded votes, newest first. This page has {first.toLocaleString()} to {last.toLocaleString()}.
    </p>
    <p class="text-small text-granite">
      The vote is on the action named with each item, which isn't always the measure itself. Each item links
      to the clerk's page.
    </p>
    <LocalCoverageNotice tenant={body.tenant} />
  </header>
  {yearPages.length > 1 && (
    <p class="mt-4 flex flex-wrap items-center gap-2 text-small" data-pagefind-ignore>
      <span class="text-granite">Start at a year:</span>
      {yearPages.map((y) => (
        <a href={`${base}/votes/${y.page}/`} class="chip tabular-nums" aria-current={y.page === page ? "page" : undefined}>{y.year}</a>
      ))}
    </p>
  )}

  <ul class="mt-6 max-w-[60rem] border-b border-rule" role="list">
    {rows.map((v) => (
      <LocalVoteRow v={v} />
    ))}
  </ul>

  <Pager page={page} pages={pages} href={(n) => `${base}/votes/${n}/`} label="Vote record pages" />
</Base>
