---
import Base from "../../layouts/Base.astro";
import PartyChip from "../../components/PartyChip.astro";
import {
  sittingPeople, electionFor, personIdByName, statewideRaces, statewideHistory,
  lastMarginFor, statewideCountiesFor,
} from "../../lib/db";
import { partyLetter, personSlug } from "../../lib/format";
const seats = sittingPeople()
  .map((p) => ({
    person: p,
    election: electionFor(p.id),
    margin: lastMarginFor(p.chamber, p.district),
  }))
  .filter((s) => s.election?.cycle_year === 2026);
const senate = seats.filter((s) => s.person.chamber === "upper");
const assembly = seats.filter((s) => s.person.chamber === "lower");

// cycle-at-a-glance, straight arithmetic on WEC data: retirements, seats
// with a single approved candidate so far, and seats that were close
const approvedCount = (s: (typeof seats)[number]) =>
  (s.election!.on_ballot === 1 ? 1 : 0) +
  s.election!.opponents.filter((o) => o.ballot_status === "Approve").length;
const openSeats = seats.filter((s) => s.election!.on_ballot === 0).length;
const singleCandidate = seats.filter((s) => approvedCount(s) <= 1).length;
const closeSeats = seats.filter(
  (s) => s.margin?.margin != null && s.margin.margin < 5,
).length;

const OFFICES: [string, string][] = [
  ["GOVERNOR", "Governor"],
  ["LIEUTENANT GOVERNOR", "Lieutenant Governor"],
  ["ATTORNEY GENERAL", "Attorney General"],
  ["SECRETARY OF STATE", "Secretary of State"],
  ["STATE TREASURER", "State Treasurer"],
];
const allStatewide = statewideRaces();
const history = statewideHistory();
// the governor and lieutenant governor run as one ticket in November;
// the certified 2022 contest is recorded under the joint heading
const historyFor = (office: string) =>
  history.filter(
    (h) =>
      h.office === office ||
      (office === "GOVERNOR" && h.office === "GOVERNOR / LIEUTENANT GOVERNOR"),
  );
// "Evers / Rodriguez (D)" column headers from a ticket's lead surname
const shortName = (candidate: string) =>
  candidate
    .split(" / ")
    .map((part) => part.replace(/\(write-in\)/i, "").trim().split(" ").pop())
    .join(" / ");

const statewide = OFFICES.map(([key, label]) => {
  const last = historyFor(key);
  let countyTable: {
    year: number;
    columns: { candidate: string; party: string | null }[];
    rows: { county: string; votes: number[] }[];
  } | null = null;
  if (last.length > 0) {
    const countyRows = statewideCountiesFor(last[0].office).filter(
      (c) => c.year === last[0].year,
    );
    if (countyRows.length > 0) {
      const columns = last.map((h) => ({ candidate: h.candidate, party: h.party }));
      const byCounty = new Map<string, Map<string, number>>();
      for (const c of countyRows) {
        if (!byCounty.has(c.county)) byCounty.set(c.county, new Map());
        byCounty.get(c.county)!.set(c.candidate, c.votes);
      }
      countyTable = {
        year: last[0].year,
        columns,
        rows: [...byCounty.keys()].sort().map((county) => ({
          county,
          votes: columns.map((col) => byCounty.get(county)!.get(col.candidate) ?? 0),
        })),
      };
    }
  }
  const rows = allStatewide.filter((r) => r.office === key);
  return {
    key, label,
    incumbent: rows[0]?.incumbent ?? null,
    retiring: rows[0]?.incumbent_noncandidacy === 1,
    approved: rows.filter((r) => r.ballot_status === "Approve"),
    otherFilings: rows.filter((r) => r.ballot_status !== "Approve").length,
    last,
    countyTable,
  };
});
---

<Base title="2026 elections" description="Everything on Wisconsin's November 2026 ballot: all five statewide constitutional offices and every legislative seat, with incumbents, retirements, and qualified candidates.">
  <h1 class="text-2xl font-bold">On the ballot: November 3, 2026</h1>
  <p class="mt-2 max-w-3xl text-navy-700">
    All five statewide constitutional offices, all 99 Assembly seats, and the
    17 odd-numbered Senate seats are on the ballot. Candidate status comes
    from the Wisconsin Elections Commission's ballot access report. The final
    ballot is certified after the August 11 primary.
  </p>
  <p class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm">
    <a href="https://myvote.wi.gov/en-us/Find-My-Polling-Place" class="py-1 font-semibold underline">Find where you vote ↗</a>
    <a href="https://myvote.wi.gov/en-us/Vote-Absentee-Guide" class="py-1 font-semibold underline">Vote absentee ↗</a>
    <a href="/calendar/election-days.ics" class="py-1 underline">Add election days to your calendar</a>
  </p>

  <p class="mt-3 max-w-3xl rounded-lg border border-navy-100 bg-white px-4 py-2 text-sm text-navy-700">
    The legislative cycle at a glance: <strong>{openSeats}</strong> open seats
    (incumbent not running) · <strong>{closeSeats}</strong> seats decided by
    under 5 points last time · <strong>{singleCandidate}</strong> seats with
    only one approved candidate so far.
  </p>

  <section class="mt-6">
    <h2 class="text-xl font-bold">Statewide offices</h2>
    <p class="mt-1 max-w-3xl text-sm text-navy-700">
      All five constitutional offices are on the ballot. Candidates and
      ballot status come from the WEC ballot-access report; past results are
      the WEC's certified canvasses.
    </p>
    <div class="mt-3 grid gap-3 lg:grid-cols-2">
      {statewide.map((o) => (
        <div class="rounded-lg border border-navy-100 bg-white p-4 text-sm">
          <h3 class="flex flex-wrap items-baseline gap-x-2 text-lg font-bold">
            {o.label}
            {o.incumbent && o.retiring && (
              <span class="rounded-full bg-badger-50 px-2 py-0.5 text-xs font-bold text-badger-700">open seat</span>
            )}
          </h3>
          {o.incumbent && (
            <p class="mt-1 text-navy-700">
              Incumbent: {o.incumbent}{o.retiring && " — not seeking reelection"}
            </p>
          )}
          <p class="mt-2 font-semibold">
            {o.approved.length} candidate{o.approved.length === 1 ? "" : "s"} approved for the ballot
            {o.otherFilings > 0 && (
              <span class="font-normal text-navy-600"> ({o.otherFilings} more filings not approved)</span>
            )}
          </p>
          <ul class="mt-1 space-y-0.5">
            {o.approved.map((c) => (
              <li class="flex flex-wrap items-baseline gap-x-2">
                <PartyChip party={c.party} />
                <span>{c.candidate}</span>
              </li>
            ))}
          </ul>
          {o.last.length > 0 && (
            <p class="mt-2 border-t border-navy-100 pt-2 text-xs text-navy-600">
              {o.last[0].year} result: {o.last.slice(0, 2).map((h) =>
                `${h.candidate} (${partyLetter(h.party)}) ${h.votes.toLocaleString()}`
              ).join(" — ")}
            </p>
          )}
          {o.key === "LIEUTENANT GOVERNOR" && (
            <p class="mt-2 border-t border-navy-100 pt-2 text-xs text-navy-600">
              Runs on one ticket with the governor in November; the 2022 result
              is recorded under the joint contest.
            </p>
          )}
          {o.countyTable && (
            <details class="mt-2 border-t border-navy-100 pt-2 text-xs">
              <summary class="cursor-pointer py-1 font-semibold text-navy-700">
                County-by-county, {o.countyTable.year} (certified)
              </summary>
              <div
                class="mt-1 max-h-80 overflow-y-auto"
                role="region"
                tabindex="0"
                aria-label={`${o.label}: certified ${o.countyTable.year} results by county`}
              >
                <table class="w-full text-left tabular-nums">
                  <thead>
                    <tr class="border-b border-navy-100">
                      <th scope="col" class="py-1 pr-2 font-semibold">County</th>
                      {o.countyTable.columns.map((c) => (
                        <th scope="col" class="py-1 pr-2 text-right font-semibold">
                          {shortName(c.candidate)} ({partyLetter(c.party)})
                        </th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {o.countyTable.rows.map((r) => (
                      <tr class="border-b border-navy-100/60">
                        <th scope="row" class="py-0.5 pr-2 font-normal">{r.county}</th>
                        {r.votes.map((v) => (
                          <td class="py-0.5 pr-2 text-right">{v.toLocaleString()}</td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </details>
          )}
        </div>
      ))}
    </div>
  </section>
  {[
    { label: "Senate (odd districts)", rows: senate },
    { label: "Assembly (all districts)", rows: assembly },
  ].map((chamber) => (
    <section class="mt-6">
      <h2 class="text-xl font-bold">{chamber.label}</h2>
      <ul class="mt-2 divide-y divide-navy-100 rounded-lg border border-navy-100 bg-white text-sm">
        {chamber.rows.map(({ person, election, margin }) => {
          const opponents = election!.opponents.filter((o) => o.ballot_status !== "Deny");
          return (
            <li class="flex flex-wrap items-baseline gap-x-3 px-4 py-2">
              <span class="w-10 shrink-0 font-bold">D{person.district}</span>
              <PartyChip party={person.party} />
              <a href={`/legislators/${personSlug(person.id)}/`} class="underline">{person.name}</a>
              {margin?.margin != null && margin.margin < 5 && (
                <span class="rounded-full bg-gold-100 px-2 py-0.5 text-xs font-bold text-navy-800">
                  +{margin.margin.toFixed(1)} in {margin.year}
                </span>
              )}
              {election!.on_ballot === 0 && (
                <span class="rounded-full bg-badger-50 px-2 py-0.5 text-xs font-bold text-badger-700">retiring</span>
              )}
              {election!.on_ballot === 1 && opponents.length === 0 && (
                <span class="text-xs text-navy-600">unopposed so far</span>
              )}
              {opponents.length > 0 && (
                <span class="min-w-0 flex-1 truncate text-navy-700">
                  {election!.on_ballot === 0 ? "Candidates: " : "Challengers: "}
                  {opponents.map((o, i) => {
                    const pid = personIdByName(o.name);
                    return (
                      <>
                        {i > 0 && ", "}
                        {pid ? (
                          <a href={`/legislators/${personSlug(pid)}/`} class="underline">{o.name}</a>
                        ) : (
                          o.name
                        )}
                        {` (${partyLetter(o.party)})`}
                      </>
                    );
                  })}
                </span>
              )}
            </li>
          );
        })}
      </ul>
    </section>
  ))}
</Base>
