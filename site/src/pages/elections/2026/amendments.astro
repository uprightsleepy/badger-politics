---
/** The constitutional amendment questions on the November 2026 ballot:
 * the exact ballot wording, the constitution's text as changed, and the
 * two Legislatures' votes that put each question there. */
import Base from "../../../layouts/Base.astro";
import { ballotMeasures, votesFor, meta } from "../../../lib/db";
import { billSlug, chamberName, fmtDate } from "../../../lib/format";
import { safeHref } from "../../../lib/html";

const measures = ballotMeasures(2026);
const pulledOn = meta().imported_at?.slice(0, 10);
const enrolledUrl = (sessionId: string, identifier: string) =>
  `https://docs.legis.wisconsin.gov/${sessionId}/related/enrolled/${billSlug(identifier)}`;
// journal-sourced records are committee reports; everything else is a floor vote
const floorVotes = (billId: string) =>
  votesFor(billId).filter((v) => !(v.source_url ?? "").includes("/journals/"));
const passages = (m: (typeof measures)[number]) => [
  { label: "First approval", sessionId: m.first_session_id, identifier: m.first_identifier, billId: m.first_bill_id },
  { label: "Second approval", sessionId: m.session_id, identifier: m.identifier, billId: m.bill_id },
];
// a created section carries no marks: the treatment line says it is all new
const marked = (m: (typeof measures)[number]) =>
  m.changes.some((c) => c.text.some((runs) => runs.some(([kind]) => kind !== "same")));
const count = ["no", "one", "two", "three", "four", "five", "six"][measures.length] ?? String(measures.length);
---

<Base
  title="Constitutional amendments, November 2026"
  description={`The ${count} Wisconsin constitutional amendment questions on the November 3, 2026 ballot: the exact wording, what each would change, and how every legislator voted to put it there.`}
  breadcrumbs={[{ name: "Elections", url: "/elections/2026/" }, { name: "2026", url: "/elections/2026/" }]}
  filters={{ type: "Race", session: "2026 election" }}
  layout="wide"
>
  <header class="flex max-w-[47.5rem] flex-col gap-2.5">
    <a href="/elections/2026/" class="self-start text-small underline">Everything on the 2026 ballot</a>
    <h1 class="t-display">Constitutional amendments, November 3, 2026</h1>
    {measures.length === 0 ? (
      <p class="sm:text-lead">
        The statewide ballot questions for this election aren't verified in our records yet. The
        {" "}<a href="https://elections.wi.gov" class="underline">Wisconsin Elections Commission</a> publishes
        them in its referendum notice.
      </p>
    ) : (
      <>
        <p class="sm:text-lead">
          Every Wisconsin voter will be asked {count} {measures.length === 1 ? "question" : "questions"} about
          changing the state constitution. A <strong>yes</strong> vote adopts the change; a <strong>no</strong>
          {" "}vote leaves the constitution as it is.
        </p>
        <p class="text-small text-granite">
          An amendment reaches the ballot only after two Legislatures in a row approve the same text. The
          governor has no role. Each question passes or fails on a simple majority of the votes cast on it.
        </p>
      </>
    )}
  </header>

  {measures.length > 1 && (
    <nav aria-label="Questions on the ballot" class="mt-8 max-w-[47.5rem]">
      <ol class="border-b border-rule" role="list">
        {measures.map((m) => (
          <li class="border-t border-rule">
            <a href={`#question-${m.number}`} class="flex min-h-11 items-center py-2 font-display font-bold underline">
              Question {m.number}: {m.title}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )}

  {measures.map((m) => (
    <section id={`question-${m.number}`} class="mt-12 max-w-[47.5rem] scroll-mt-4" aria-labelledby={`question-${m.number}-heading`}>
      <h2 id={`question-${m.number}-heading`} class="t-section">
        <span class="block text-small font-bold text-granite">Question {m.number}</span>
        {m.title}
      </h2>

      <figure class="mt-4 border-l-4 border-spruce py-1 pl-5">
        <blockquote class="text-lead">“{m.question}”</blockquote>
        <figcaption class="mt-3 text-small text-granite">
          The wording on the ballot, from the Elections Commission's
          {" "}<a href={safeHref(m.notice_url)} class="underline">referendum notice</a>.
        </figcaption>
      </figure>

      <h3 class="t-question mt-8">What it would change</h3>
      <p class="mt-1 text-small text-granite">
        The constitution's text as the Legislature approved it.
        {marked(m) && (
          <>
            {" "}<del class="amend-del">Struck-through text</del> would be removed and{" "}
            <ins class="amend-ins">underlined text</ins> would be added.
          </>
        )}
      </p>
      {m.changes.map((change) => (
        <div class="mt-3 border-l-4 border-edge pl-4">
          <p class="text-small font-bold text-granite">{change.treatment}</p>
          {/is created to read/.test(change.treatment) && (
            <p class="mt-1 text-small text-granite">
              This would be a new section of the constitution: all of the text below would be added.
            </p>
          )}
          {change.text.map((paragraph) => (
            <p class="mt-2">
              {paragraph.map(([kind, words]) =>
                kind === "del" ? <del class="amend-del"><span class="sr-only">[removed: </span>{words}<span class="sr-only">]</span></del>
                : kind === "ins" ? <ins class="amend-ins"><span class="sr-only">[added: </span>{words}<span class="sr-only">]</span></ins>
                : words,
              )}
            </p>
          ))}
        </div>
      ))}
      <p class="mt-3 text-small">
        <a href={enrolledUrl(m.session_id, m.identifier)} class="underline">The official enrolled text</a>
      </p>

      <h3 class="t-question mt-8">How it reached the ballot</h3>
      <div class="mt-3 grid gap-6 sm:grid-cols-2">
        {passages(m).map((p) => (
          <div class="flex min-w-0 flex-col gap-2 border-t border-rule pt-3">
            <h4 class="font-display font-bold">
              {p.label}: the {p.sessionId}–{Number(p.sessionId) + 1} Legislature
            </h4>
            <p>
              <a href={`/bills/${p.sessionId}/${billSlug(p.identifier)}/`} class="underline">
                {p.sessionId} {p.identifier}
              </a>
            </p>
            <ul class="flex flex-col gap-2 text-small" role="list">
              {floorVotes(p.billId).map((v) => (
                <li>
                  <span class="font-bold">{chamberName(v.chamber)}</span>, {fmtDate(v.date)}.
                  {" "}{v.result === "pass"
                    ? (v.motion && /pass|adopt|concur/i.test(v.motion) ? v.motion : `${v.motion ?? "Vote"}: passed`)
                    : `${v.motion ?? "Vote"}: failed`}{v.yes_count != null && `, ${v.yes_count} to ${v.no_count ?? 0}`}.
                  {" "}<a href={`/votes/${v.id}/`} class="underline">
                    {(v.source_url ?? "").includes("/votes/") ? "How each member voted" : "The vote record"}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  ))}

  {measures.length > 0 && (
    <p class="mt-12 max-w-[47.5rem] text-fine text-granite">
      Ballot wording from the Wisconsin Elections Commission's
      {" "}<a href={safeHref(measures[0].notice_url)} class="underline">referendum notice</a>; text and votes from the
      {" "}<a href="https://docs.legis.wisconsin.gov" class="underline">Wisconsin Legislature</a>{pulledOn && `; checked ${fmtDate(pulledOn)}`}.
    </p>
  )}
</Base>

<style>
  .amend-del {
    color: var(--color-granite);
    text-decoration: line-through;
    text-decoration-thickness: 2px;
  }
  .amend-ins {
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
    background: var(--color-fog);
  }
</style>
