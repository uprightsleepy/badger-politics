---
/** One legislative race, one page: the seat, who is running, and what
 * this district has done before.
 *
 * Everything here is a record. Candidates and ballot status are the
 * WEC's ballot-access report; past results are certified canvasses. No
 * polls, no forecasts, no ratings: where a seat looks competitive, that
 * claim is the certified margin from last time, labeled with its year.
 *
 * The 2024 maps redrew nearly every line, so results from before 2024
 * are labeled as the previous district: same number, different voters.
 * A results section renders automatically once certified 2026 rows
 * exist, so election night is a data import, not a redesign.
 */
import Base from "../../../layouts/Base.astro";
import FollowButton from "../../../components/FollowButton.astro";
import Portrait from "../../../components/Portrait.astro";
import ElectionResult from "../../../components/ElectionResult.astro";
import SeatMapFigure from "../../../components/SeatMapFigure.astro";
import {
  races2026, electionFor, electionHistoryFor, lastMarginFor, personIdByName, ballotPhase,
  writeInPending, meta,
} from "../../../lib/db";
import { chamberName, fmtDate, partyWord, personSlug } from "../../../lib/format";
import { ballotStatus, raceSentenceHtml, seatOffice, writeInSentence } from "../../../lib/ballot";
import { raceCard } from "../../../lib/share";

export function getStaticPaths() {
  return races2026().map((p) => ({
    params: {
      seat: `${p.chamber === "upper" ? "senate" : "assembly"}-${p.district}`,
    },
    props: { person: p },
  }));
}

const { person } = Astro.props;
const election = electionFor(person.id)!;
const seatKey = `${person.chamber === "upper" ? "senate" : "assembly"}-${person.district}`;
const seatName = `${chamberName(person.chamber)} District ${person.district}`;
const history = electionHistoryFor(person.chamber, person.district);
const margin = lastMarginFor(person.chamber, person.district);
const share = raceCard(person);

const approved = election.opponents.filter((o) => o.ballot_status === "Approve");
const pending = election.opponents.length - approved.length;
const ballot = ballotStatus(election);
const status = ballot.kind === "on-ballot" || ballot.kind === "not-running" ? ballot.kind : "pending";
const running = status === "on-ballot";
const open = status === "not-running";
const general = ballotPhase() === "general";
const phase = general ? "general" : "primary";
const openPrimaries = writeInPending(seatOffice(person.chamber, person.district));
const holderHref = `/legislators/${personSlug(person.id)}/`;
const others = approved.map((o) => {
  const pid = personIdByName(o.name);
  return { ...o, pid, href: pid ? `/legislators/${personSlug(pid)}/` : null };
});
const lead = raceSentenceHtml({
  holder: { name: person.name, party: person.party, href: holderHref },
  status,
  others,
  phase,
  unsettled: openPrimaries.length > 0,
});

// certified 2026 rows appear here after the canvass; until then the
// section simply doesn't exist
const results2026 = history.find((h) => h.year === 2026);
const past = history.filter((h) => h.year !== 2026);

const candidateCount = (running ? 1 : 0) + approved.length;
const description =
  `${seatName} in Wisconsin's November 3, 2026 election: ` +
  (open ? `open seat (${person.name} is not on the November ballot)`
    : running ? `${person.name} runs for reelection`
    : `${person.name}'s ballot status not yet posted`) +
  `, ${candidateCount} ${general ? "candidate" : "approved candidate"}${candidateCount === 1 ? "" : "s"}` +
  `${general ? " on the November ballot" : ""}, and official past results.`;
const marginLine = margin
  ? margin.margin === null
    ? `In ${margin.year}${margin.year < 2024 ? ", on the previous maps" : ""}, the winner ran unopposed.`
    : `In ${margin.year}${margin.year < 2024 ? ", on the previous maps" : ""}, this seat was decided by ${margin.margin.toFixed(1)} points.`
  : "";
const pulledOn = meta().imported_at?.slice(0, 10);
// how each candidate got onto the ballot, said once per kind
const howOn = (party: string | null) =>
  !general
    ? "Approved for the ballot by the Elections Commission."
    : party === "Independent" || !party
      ? "An independent candidate the Elections Commission approved."
      : `The ${party} nominee, from the certified August 11 primary.`;
---

<Base
  title={`${seatName} election, 2026`}
  description={description}
  image={share.image}
  imageAlt={share.alt}
  breadcrumbs={[
    { name: "Elections", url: "/elections/2026/" },
    { name: "2026", url: "/elections/2026/" },
  ]}
  filters={{ type: "Race", session: "2026 election", chamber: chamberName(person.chamber) }}
  layout="wide"
>
  <div class="race">
    <header class="r-head flex max-w-[47.5rem] flex-col gap-2.5">
      <a href="/elections/2026/" class="self-start text-small underline">2026 elections</a>
      <h1 class="t-display">{seatName}</h1>
      <p class="sm:text-lead" data-no-rep-highlight>
        {open && <strong>Open seat. </strong>}<Fragment set:html={lead} />
        {openPrimaries.length > 0 && ` ${writeInSentence(openPrimaries)}`}
      </p>
      <p class="text-small text-granite">
        Election day is Tuesday, November 3, 2026.
        {general
          ? " Each party's candidate won the certified August 11 primary."
          : " The final ballot is set after the August 11 primary."}
      </p>
      <p data-mine-seat={seatKey} data-pagefind-ignore hidden>
        <span class="mine">This is your district's race</span>
      </p>
    </header>

    <aside class="r-rail flex flex-col gap-5" data-pagefind-ignore data-no-rep-highlight>
      <div class="flex flex-col gap-2">
        <FollowButton kind="races" id={seatKey} label="Follow this race" variant="primary" />
        <p class="text-fine text-granite">Following saves it on this device.</p>
      </div>
      <SeatMapFigure seatKey={seatKey} seatName={seatName} />
      <p><a href={`/districts/${seatKey}/`} class="font-bold underline">About {seatName}: who has held it and its results</a></p>
    </aside>

    <div class="r-main flex max-w-[47.5rem] flex-col gap-10">
      {results2026 && (
        <section aria-labelledby="results-2026-heading">
          <h2 id="results-2026-heading" class="t-section">Official results</h2>
          <ElectionResult id="results-2026" title="November 2026" candidates={results2026.candidates} total={results2026.total} />
          <p class="text-fine text-granite">From the Elections Commission's certified canvass.</p>
        </section>
      )}

      <section aria-labelledby="candidates-heading" data-no-rep-highlight>
        <h2 id="candidates-heading" class="t-section">{general ? "On the ballot" : "Approved for the ballot"}</h2>
        <ul class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2" role="list">
          {running && (
            <li class="sheet flex flex-col gap-3 p-5">
              <div class="flex flex-wrap items-center gap-4">
                <Portrait src={person.image_url} name={person.name} size={56} />
                <div class="min-w-0 flex-[1_1_8rem] [overflow-wrap:anywhere]">
                  <h3 class="t-question text-[1.1875rem] [overflow-wrap:anywhere]">
                    <a href={holderHref} class="underline">{person.name}</a>
                  </h3>
                  <p class="text-granite">{person.party ? partyWord(person.party) : "Party not recorded"}. Holds this seat now.</p>
                </div>
              </div>
              <p class="text-small"><a href={holderHref} class="underline">Their record: votes, bills, committees and campaign money</a></p>
            </li>
          )}
          {others.map((o) => (
            <li class="sheet flex flex-col gap-3 p-5">
              <div class="flex flex-wrap items-center gap-4">
                <Portrait src={null} name={o.name} size={56} />
                <div class="min-w-0 flex-[1_1_8rem] [overflow-wrap:anywhere]">
                  <h3 class="t-question text-[1.1875rem] [overflow-wrap:anywhere]">
                    {o.href ? <a href={o.href} class="underline">{o.name}</a> : o.name}
                  </h3>
                  <p class="text-granite">{o.party ? partyWord(o.party) : "Party not recorded"}.</p>
                </div>
              </div>
              <p class="text-small">
                {o.href ? "A current or former legislator, with a record on their page." : howOn(o.party)}
              </p>
            </li>
          ))}
        </ul>
        {candidateCount === 0 && (
          <p class="mt-4">{general ? "No candidate is on the November ballot for this seat." : "No approved candidates on file yet."}</p>
        )}
        <p class="mt-4 text-small text-granite">
          We publish records, not campaign material, so a candidate without a legislative record has only
          their filing here.
          {!general && pending > 0 && ` ${pending} more ${pending === 1 ? "filing wasn't" : "filings weren't"} approved.`}
          {" "}Check your own ballot at <a href="https://myvote.wi.gov/en-us/My-Voter-Info" class="underline">MyVote Wisconsin</a>.
        </p>
      </section>
    </div>

    <div class="r-more flex max-w-[47.5rem] flex-col gap-10">

      {past.length > 0 && (
        <section aria-labelledby="past-heading">
          <h2 id="past-heading" class="t-section">How this seat has voted</h2>
          <p class="mt-2 text-small text-granite">
            {marginLine && `${marginLine} `}Certified results. Wisconsin's legislative maps were redrawn for
            2024, so earlier results are the previous District {person.district}: the same number over
            substantially different lines.
          </p>
          <div class="mt-4 flex flex-col">
            {past.map((h) => (
              <ElectionResult
                id={`results-${h.year}`}
                title={`November ${h.year}`}
                note={h.year < 2024 ? "previous maps" : undefined}
                candidates={h.candidates}
                total={h.total}
              />
            ))}
          </div>
        </section>
      )}

      <section aria-labelledby="vote-heading" class="flex flex-col gap-3">
        <h2 id="vote-heading" class="t-section">How to vote</h2>
        <ul class="flex flex-wrap gap-3" role="list">
          <li><a href="https://myvote.wi.gov/en-us/Find-My-Polling-Place" class="btn btn-secondary">Find where you vote</a></li>
          <li><a href="https://myvote.wi.gov/en-us/Vote-Absentee-Guide" class="btn btn-secondary">Vote absentee</a></li>
          <li><a href="/calendar/election-days.ics" class="btn btn-secondary">Add election days to your calendar</a></li>
        </ul>
      </section>

      <p class="text-fine text-granite">
        Candidates from the <a href="https://elections.wi.gov" class="underline">Wisconsin Elections Commission</a>'s
        ballot-access report{general && " and certified August 11 primary"}; past results from its certified
        canvasses{pulledOn && `; checked ${fmtDate(pulledOn)}`}.
      </p>
    </div>
  </div>
</Base>

<style>
  /* phones: who is running comes before the map and follow button */
  .race {
    display: grid;
    gap: 2.5rem;
    grid-template-areas: "head" "main" "rail" "more";
    grid-template-columns: minmax(0, 1fr);
  }
  .r-head { grid-area: head; }
  .r-main { grid-area: main; }
  .r-rail { grid-area: rail; }
  .r-more { grid-area: more; }
  @media (min-width: 64rem) {
    .race {
      grid-template-areas: "head rail" "main rail" "more rail";
      grid-template-columns: minmax(0, 1fr) 20rem;
      grid-template-rows: auto auto 1fr;
      column-gap: 3.5rem;
    }
    .r-rail {
      align-self: start;
    }
  }
</style>
