---
/** One homepage topic: our grouping of the Legislature's own subject
 * headings, each named and linked, then the bills filed under any of them. */
import Base from "../../layouts/Base.astro";
import BillsBySubject from "../../components/BillsBySubject.astro";
import { billsForSubject, subjectIndex } from "../../lib/db";
import { TOPICS, inTopic } from "../../lib/topics";
import { bySessionSpan, subjectLead } from "../../lib/subjectBills";

export function getStaticPaths() {
  return TOPICS.map((topic) => ({ params: { slug: topic.slug }, props: { topic } }));
}
const { topic } = Astro.props;
const headings = subjectIndex().filter((s) => s.subjects.some((h) => inTopic(topic, h)));
const seen = new Set<string>();
const bills = headings
  .flatMap((s) => s.subjects.flatMap((h) => billsForSubject(h)))
  .filter((b) => !seen.has(b.id) && seen.add(b.id));
const { bySession, sessionName, span } = bySessionSpan(bills);
const lead = bills.length ? subjectLead(bills) + span : "No bills in this build are filed under these headings.";
const n = (x: number) => x.toLocaleString();
---

<Base
  title={topic.label}
  filters={{ type: "Topic" }}
  description={`${n(bills.length)} Wisconsin bills and resolutions about ${topic.label.toLowerCase()}: ${topic.examples.toLowerCase()}. Gathered from ${n(headings.length)} headings in the Legislature's subject index.`}
  layout="wide"
>
  <header class="flex max-w-[47.5rem] flex-col gap-2.5">
    <h1 class="t-display">{topic.label}</h1>
    <p class="sm:text-lead">{lead}</p>
    <p class="text-small text-granite">
      {topic.examples}. This topic is our grouping of {n(headings.length)} headings from the Legislature's own
      subject index, listed below. A bill is here only if the Legislature filed it under one of them, and each
      count comes from the bill's official history.
    </p>
  </header>

  <section class="mt-8 max-w-[60rem]" aria-labelledby="headings-heading">
    <h2 id="headings-heading" class="t-section">Headings gathered here</h2>
    <ul class="mt-3 flex flex-wrap gap-2" role="list">
      {headings.map((s) => (
        <li>
          <a href={`/subjects/${s.slug}/`} class="inline-flex min-h-11 items-center rounded-full border border-edge px-3 text-small no-underline hover:underline">
            {s.title} <span class="ml-1.5 text-granite">{n(s.n)}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <BillsBySubject bills={bills} bySession={bySession} sessionName={sessionName} noun="topic" />
</Base>
