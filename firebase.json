{
  "hosting": {
    "public": "site/dist",
    "ignore": ["**/.*", "**/node_modules/**"],
    "trailingSlash": true,
    "headers": [
      {
        "source": "/_astro/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "**/*.@(html|json|xml|ics)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=3600, must-revalidate" }
        ]
      }
    ]
  }
}
